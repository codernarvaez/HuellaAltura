# HAMobile — copiar a `.env` (gitignored) para desarrollo local.
# En dispositivo físico usa la IP de tu máquina, no localhost.
# En producción / EAS: mismas claves como EAS Secrets o en eas.json (solo URLs públicas).

# auth-service — prefijo /api (login, me, register)
# Local:  http://127.0.0.1:8000/api
# Render: https://<geoguard-auth>.onrender.com/api
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api

# exped-service — prefijo /api/v1 (fincas, sync, labores, agroambiental)
# Local:  http://127.0.0.1:8031/api/v1
# Render: https://<geoguard-exped>.onrender.com/api/v1
EXPO_PUBLIC_EXPED_API_URL=http://127.0.0.1:8031/api/v1

# Mapbox runtime (pk. público). Nunca pongas sk. aquí.
# Mismo valor que PUBLIC_MAPBOX_ACCESS_TOKEN en HAFront/.env
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_public_token

# Build nativo (@rnmapbox/maps) — token secreto solo-descargas (scope DOWNLOADS:READ)
# Requerido por scripts/build-dev-apk.sh y el config plugin de @rnmapbox/maps
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=sk.your_downloads_token
