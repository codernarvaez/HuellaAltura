{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "huella-altura/dds/v1",
  "title": "Metadatos ERC-1155 de un certificado DDS (sin datos personales)",
  "type": "object",
  "required": ["name", "description", "properties"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "image": { "type": "string", "pattern": "^ipfs://" },
    "properties": {
      "type": "object",
      "required": ["kind", "codigoCertificado", "fincaId", "fincaVersion", "emitidoEn", "venceEn", "auditHash", "schema"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "DDS_CERT" },
        "codigoCertificado": { "type": "string" },
        "tenant": { "type": "string" },
        "fincaId": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
        "fincaVersion": { "type": "integer", "minimum": 1 },
        "emitidoEn": { "type": "string", "format": "date" },
        "venceEn": { "type": "string", "format": "date" },
        "auditHash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
        "fechaCorte": { "type": "string", "format": "date" },
        "documento": { "type": "string", "pattern": "^ipfs://" },
        "schema": { "const": "huella-altura/dds/v1" }
      }
    }
  }
}
