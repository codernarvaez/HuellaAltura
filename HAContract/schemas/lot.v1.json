{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "huella-altura/lot/v1",
  "title": "Metadatos ERC-1155 de un lote de café (PLAN §3.5)",
  "type": "object",
  "required": ["name", "description", "properties"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "image": { "type": "string", "pattern": "^ipfs://" },
    "properties": {
      "type": "object",
      "required": ["kind", "form", "state", "tenant", "origin", "variety", "harvestDate", "parents", "schema"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "LOT" },
        "form": { "enum": ["CHERRY", "PARCHMENT", "GREEN"] },
        "state": { "enum": ["HARVESTED", "PROCESSED", "DRIED", "HULLED", "GRADED", "PACKAGED", "EXPORTED"] },
        "tenant": { "type": "string" },
        "origin": {
          "type": "object",
          "required": ["fincaId", "fincaVersion", "ddsCertId"],
          "additionalProperties": false,
          "properties": {
            "fincaId": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
            "fincaVersion": { "type": "integer", "minimum": 0 },
            "ddsCertId": { "type": "string", "pattern": "^0x[0-9a-fA-F]+$" },
            "provincia": { "type": "string" }
          }
        },
        "variety": { "type": "string" },
        "harvestDate": { "type": "string", "format": "date" },
        "grams": { "type": "integer", "minimum": 1 },
        "phase": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
        },
        "parents": { "type": "array", "items": { "type": "string", "pattern": "^0x[0-9a-fA-F]+$" } },
        "previousCID": { "type": "string", "pattern": "^ipfs://" },
        "schema": { "const": "huella-altura/lot/v1" }
      }
    }
  }
}
