{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "huellaaltura.deployment/1",
  "title": "Despliegue de HAContract en una red: direcciones, ABI y metadatos públicos (sin secretos)",
  "type": "object",
  "required": [
    "format",
    "network",
    "chainId",
    "chain",
    "deployer",
    "admin",
    "deployedAt",
    "startBlock",
    "contracts",
    "abi",
    "generatedBy"
  ],
  "additionalProperties": false,
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "contract": {
      "type": "object",
      "required": ["proxy", "implementation", "abiHash"],
      "additionalProperties": false,
      "properties": {
        "proxy": { "$ref": "#/$defs/address" },
        "implementation": { "$ref": "#/$defs/address" },
        "abiHash": { "$ref": "#/$defs/hash" }
      }
    },
    "abi": { "type": "array", "minItems": 1, "items": { "type": "object" } }
  },
  "properties": {
    "format": { "const": "huellaaltura.deployment/1" },
    "network": { "type": "string", "minLength": 1 },
    "chainId": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "chain": {
      "type": "object",
      "required": ["name", "nativeCurrency", "rpcUrl", "explorerUrl", "kind"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "nativeCurrency": {
          "type": "object",
          "required": ["name", "symbol", "decimals"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "symbol": { "type": "string", "minLength": 1 },
            "decimals": { "type": "integer", "minimum": 0 }
          }
        },
        "rpcUrl": { "type": "string", "pattern": "^https?://" },
        "explorerUrl": { "type": "string", "pattern": "^(https://.+)?$" },
        "kind": { "enum": ["local", "testnet", "mainnet"] }
      }
    },
    "deployer": { "$ref": "#/$defs/address" },
    "admin": { "$ref": "#/$defs/address" },
    "deployedAt": { "type": "string", "format": "date-time" },
    "startBlock": { "type": "integer", "minimum": 0 },
    "contracts": {
      "type": "object",
      "required": ["CoffeeToken", "OriginRegistry", "TraceabilityController"],
      "additionalProperties": false,
      "properties": {
        "CoffeeToken": { "$ref": "#/$defs/contract" },
        "OriginRegistry": { "$ref": "#/$defs/contract" },
        "TraceabilityController": { "$ref": "#/$defs/contract" }
      }
    },
    "abi": {
      "type": "object",
      "required": ["CoffeeToken", "OriginRegistry", "TraceabilityController"],
      "additionalProperties": false,
      "properties": {
        "CoffeeToken": { "$ref": "#/$defs/abi" },
        "OriginRegistry": { "$ref": "#/$defs/abi" },
        "TraceabilityController": { "$ref": "#/$defs/abi" }
      }
    },
    "generatedBy": {
      "type": "object",
      "required": ["tool", "commit", "at"],
      "additionalProperties": false,
      "properties": {
        "tool": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 1 },
        "at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
