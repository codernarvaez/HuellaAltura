# Copia este archivo a .env y rellénalo. .env está en .gitignore: nunca lo subas.

# RPC de Polygon Amoy (chainId 80002). Para el servicio usa un proveedor (Alchemy/QuickNode/Infura);
# si se deja vacío se usa el público de publicnode.
AMOY_RPC_URL=
# RPC de Polygon PoS mainnet (chainId 137), solo para la Fase 7.
POLYGON_RPC_URL=

# Clave privada (0x...) de la cuenta que despliega. En Amoy necesita POL de prueba:
# https://faucet.polygon.technology
DEPLOYER_PRIVATE_KEY=

# Opcional: cuenta del chain-service; deploy.ts / grantRoles.ts le dan los roles operativos.
RELAYER_ADDRESS=
# Opcional: Safe multisig que queda como único admin tras el despliegue (PLAN §3.6).
SAFE_ADDRESS=

# JWT de Pinata (scopes mínimos: pinFileToIPFS) para fijar los documentos en IPFS.
PINATA_JWT=
# Gateway para leer los archivos (el dedicado de Pinata o uno público).
PINATA_GATEWAY=https://gateway.pinata.cloud

# Opcional: verificación del código en Polygonscan (Etherscan API v2).
ETHERSCAN_API_KEY=

# Opcional: reporte de gas en las pruebas (npm run test:gas).
REPORT_GAS=false
