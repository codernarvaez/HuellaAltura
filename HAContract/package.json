{
  "name": "hacontract",
  "version": "0.1.0",
  "private": true,
  "description": "Módulo blockchain de HuellaAltura: contratos de trazabilidad del café en Polygon Amoy + evidencias en IPFS (Pinata).",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "test:gas": "REPORT_GAS=true hardhat test",
    "lint": "solhint \"contracts/**/*.sol\"",
    "typecheck": "tsc --noEmit -p .",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:amoy": "hardhat run scripts/deploy.ts --network amoy",
    "demo:local": "hardhat run scripts/demoFlow.ts --network localhost",
    "demo:amoy": "hardhat run scripts/demoFlow.ts --network amoy",
    "roles:amoy": "hardhat run scripts/grantRoles.ts --network amoy",
    "accounts:local": "hardhat run scripts/setupRoles.ts --network localhost",
    "accounts:amoy": "hardhat run scripts/setupRoles.ts --network amoy",
    "demo:roles:local": "DEMO_SIGNERS=roles hardhat run scripts/demoFlow.ts --network localhost",
    "demo:roles:amoy": "DEMO_SIGNERS=roles hardhat run scripts/demoFlow.ts --network amoy",
    "upgrade:amoy": "hardhat run scripts/upgrade.ts --network amoy",
    "verify:amoy": "hardhat run scripts/verify.ts --network amoy",
    "export:front": "hardhat run scripts/exportFront.ts",
    "export:front:check": "EXPORT_CHECK=1 hardhat run scripts/exportFront.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@openzeppelin/hardhat-upgrades": "^3.9.1",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^18.0.5",
    "hardhat": "^2.29.1",
    "solhint": "^6.2.4",
    "ts-node": "^10.9.2",
    "typescript": "~5.9"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/contracts-upgradeable": "^5.6.1"
  }
}
