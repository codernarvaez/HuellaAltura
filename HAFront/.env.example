# Supabase — https://supabase.com/dashboard/project/_/settings/api
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Solo servidor — nunca exponer en el cliente (auth con MetaMask)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# URL pública del sitio (OAuth redirect)
PUBLIC_SITE_URL=http://127.0.0.1:4321

# Backends. Sin definir: `npm run dev` usa los contenedores locales (localhost:8000 / 8001)
# y un build de producción usa Render. docker-compose.yml ya los define.
# PUBLIC_AUTH_URL=http://localhost:8000
# PUBLIC_API_URL=http://localhost:8001
