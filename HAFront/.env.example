# Supabase — https://supabase.com/dashboard/project/_/settings/api
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Solo servidor — nunca exponer en el cliente (auth con MetaMask)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# URL pública del sitio (OAuth redirect)
PUBLIC_SITE_URL=http://127.0.0.1:4321

# Microservicios. En GitHub Actions vienen de secrets, no de Render.
PUBLIC_AUTH_API_URL=http://127.0.0.1:8000
PUBLIC_API_URL=http://127.0.0.1:8031

# Firebase Auth — consola del proyecto > Configuración del proyecto > Tu app web
# Mismos nombres que los GitHub secrets PUBLIC_FIREBASE_*
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
