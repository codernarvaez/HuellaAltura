# Supabase — https://supabase.com/dashboard/project/_/settings/api
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Solo servidor — nunca exponer en el cliente (auth con MetaMask)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# URL pública del sitio (OAuth redirect)
PUBLIC_SITE_URL=http://127.0.0.1:4321

# Red blockchain (T02). Las direcciones, el ABI y el bloque inicial salen de
# src/lib/chain/deployments/<PUBLIC_CHAIN_ID>.json (lo genera HAContract: npm run export:front).
# Se leen en tiempo de ejecución: la misma build sirve para cualquier red exportada.
PUBLIC_CHAIN_ID=31337
# Opcionales: si se dejan vacías se usan el RPC público y el startBlock del JSON y el gateway de Pinata.
# Fuera de la red local, el RPC y el gateway deben ser https.
PUBLIC_RPC_URL=
PUBLIC_IPFS_GATEWAY=
PUBLIC_FROM_BLOCK=
