---
const faqs = [
  {
    pregunta: "¿Cómo se garantiza la trazabilidad?",
    respuesta: "Cada evento relevante de la cadena queda registrado y vinculado al expediente de la finca, con evidencias geoespaciales y documentales auditables.",
  },
  {
    pregunta: "¿Es compatible con mis sistemas actuales?",
    respuesta: "Sí. La plataforma expone APIs para integrarse con ERPs agrícolas y sistemas de inventario o acopio existentes.",
  },
  {
    pregunta: "¿Qué aporta el cumplimiento EUDR?",
    respuesta: "Organiza productor, finca, polígono y evidencias agroambientales para facilitar la due diligence exigida en mercados europeos.",
  },
];
---
<section class="ha-atmosphere py-16 md:py-24">
  <div class="mx-auto max-w-3xl px-6">
    <div class="mb-10 text-center">
      <h2 class="font-display text-3xl text-primary md:text-4xl">Preguntas frecuentes</h2>
      <p class="mt-3 text-on-surface-variant">Lo esencial sobre trazabilidad y certificación digital.</p>
    </div>
    <div class="space-y-3">
      {faqs.map((faq) => (
        <details class="group overflow-hidden rounded-xl border border-outline-variant bg-white/80 shadow-sm">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 font-display text-lg text-primary transition hover:bg-surface-container-low">
            {faq.pregunta}
            <span class="material-symbols-outlined text-secondary transition-transform group-open:rotate-180">expand_more</span>
          </summary>
          <div class="border-t border-outline-variant/60 px-5 pb-5 pt-4 text-on-surface-variant leading-relaxed">
            {faq.respuesta}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
