---
const sectores = [
  {
    icon: "psychology_alt",
    titulo: "Agricultura de precisión",
    descripcion: "Datos e inteligencia para optimizar rendimientos con menor impacto.",
  },
  {
    icon: "eco",
    titulo: "Sostenibilidad rural",
    descripcion: "Evidencia de prácticas regenerativas y cumplimiento ambiental.",
  },
  {
    icon: "coffee",
    titulo: "Café y cacao especial",
    descripcion: "Trazabilidad de micro-lotes hasta tostadores e importadores.",
  },
  {
    icon: "hub",
    titulo: "Cadenas de suministro",
    descripcion: "Conexión entre productores, acopio, exportadores y retailers.",
  },
];
---
<section class="relative overflow-hidden ha-atmosphere-dark py-16 text-white md:py-24" id="sectores">
  <div class="relative z-10 mx-auto max-w-container-max px-6">
    <div class="mb-12 max-w-2xl">
      <span class="text-xs font-semibold uppercase tracking-[0.18em] text-secondary-container">Enfoque sectorial</span>
      <h2 class="font-display mt-3 text-3xl md:text-4xl">Especialistas en agrotech y sostenibilidad</h2>
    </div>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {sectores.map((s) => (
        <article class="rounded-2xl border border-white/10 bg-white/5 p-7 backdrop-blur-sm transition hover:border-secondary-container/50 hover:bg-white/10">
          <span class="material-symbols-outlined mb-5 text-3xl text-secondary-container">{s.icon}</span>
          <h3 class="font-display mb-2 text-xl">{s.titulo}</h3>
          <p class="text-sm leading-relaxed text-white/75">{s.descripcion}</p>
        </article>
      ))}
    </div>
  </div>
</section>
