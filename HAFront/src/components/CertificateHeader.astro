---
interface Props {
  declarationId: string;
}
const { declarationId } = Astro.props;
---

<header class="flex justify-between items-start mb-lg">
  <div class="flex items-center gap-md">
    <div class="w-16 h-16 bg-primary flex items-center justify-center rounded-xl">
      <span
        class="material-symbols-outlined text-white text-4xl"
        style="font-variation-settings: 'FILL' 1;"
      >
        verified_user
      </span>
    </div>
    <div>
      <h1 class="font-headline-md text-headline-md text-primary leading-tight">
        CERTIFICADO DE DILIGENCIA DEBIDA
      </h1>
      <p class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">
        REGLAMENTO DE DEFORESTACIÓN UE 2023/1115 (EUDR)
      </p>
    </div>
  </div>

  <div class="text-right">
    <p class="font-label-sm text-label-sm text-outline">ID DECLARACIÓN (DDS-ID)</p>
    <p class="font-label-md text-label-md font-bold text-on-surface">{declarationId}</p>
  </div>
</header>
