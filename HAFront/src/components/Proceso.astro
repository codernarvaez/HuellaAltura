---
const pasos = [
  {
    numero: "01",
    titulo: "Registro digital",
    descripcion: "Datos de finca, productor y georreferenciación bajo estándares EUDR.",
  },
  {
    numero: "02",
    titulo: "Monitoreo geoespacial",
    descripcion: "Validación satelital y agroambiental para reducir riesgos de deforestación.",
  },
  {
    numero: "03",
    titulo: "Certificación",
    descripcion: "Expediente auditable y certificados listos para due diligence comercial.",
  },
];
---
<section class="bg-background py-16 md:py-24">
  <div class="mx-auto max-w-container-max px-6">
    <div class="mb-12 text-center">
      <span class="text-xs font-semibold uppercase tracking-[0.18em] text-secondary">Ruta tecnológica</span>
      <h2 class="font-display mt-3 text-3xl text-primary md:text-4xl">De la tierra al expediente</h2>
    </div>
    <div class="grid grid-cols-1 overflow-hidden rounded-2xl border border-outline-variant md:grid-cols-3">
      {pasos.map((p, i) => (
        <div class={`bg-white/70 p-8 md:p-10 ${i < pasos.length - 1 ? "border-b border-outline-variant md:border-b-0 md:border-r" : ""}`}>
          <div class="font-display mb-5 text-4xl text-outline-variant">{p.numero}</div>
          <h3 class="font-display mb-3 text-xl text-primary">{p.titulo}</h3>
          <p class="text-on-surface-variant leading-relaxed">{p.descripcion}</p>
        </div>
      ))}
    </div>
  </div>
</section>
