---
import { FincaService } from '../services/finca.service.ts';
const fincas = await FincaService.getFincasLanding();
---

<section class="py-section-py-desktop max-w-container-max mx-auto px-6" id="inicio">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
    <div class="space-y-6">
      <span class="inline-block px-4 py-1 bg-secondary-container text-on-secondary-container text-label-sm font-label-sm rounded-full">
        Agrotech &amp; Blockchain
      </span>
      <h1 class="font-display text-display text-primary tracking-tighter">
        Huella de Altura: Trazabilidad Blockchain para la certificación global de su producción.
      </h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant max-w-xl">
        Lideramos la transformación del sector agroindustrial con soluciones tecnológicas que garantizan transparencia, origen y calidad superior en mercados internacionales.
      </p>
      <div class="flex flex-wrap gap-4 pt-4">
        <button class="bg-primary text-on-primary px-8 py-4 rounded-xl font-label-md text-label-md hover:bg-primary-container transition-all shadow-md">
          Digitalizar mi Producción
        </button>
        <button class="border border-outline text-primary px-8 py-4 rounded-xl font-label-md text-label-md hover:bg-surface-container-low transition-all">
          Explorar Certificaciones
        </button>
      </div>
    </div>
    <div class="relative group perspective-lg">
      <div class="absolute -inset-4 bg-primary/5 rounded-full blur-3xl opacity-50"></div>
      <div class="p-4 bg-surface-container-low rounded-xl border border-outline-variant/30 mb-6">
        <div class="flex items-center justify-between mb-2">
          <span class="text-primary font-bold">FINCAS</span>
          <span id="finca-counter" class="text-label-sm text-on-surface-variant"></span>
        </div>

        <div id="finca-card" class="transition-opacity duration-500">
          <p class="text-label-md font-label-md text-on-surface-variant uppercase">
            Finca: <span id="finca-nombre" class="font-bold text-primary"></span>
          </p>
          <div class="grid grid-cols-2 gap-2 mt-2 text-label-sm text-on-surface-variant">
            <p>Provincia: <span id="finca-provincia"></span></p>
            <p>Cantón: <span id="finca-canton"></span></p>
            <p>Área total: <span id="finca-area-total"></span> ha</p>
            <p>Área cultivada: <span id="finca-area-cultivada"></span> ha</p>
            <p>Tenencia: <span id="finca-tenencia"></span></p>
            <div id="finca-svg" class="mt-3"></div>
          </div>
        </div>
      </div>

      <script define:vars={{ fincas }}>
        const data = fincas;
        let index = 0;

        const elNombre = document.getElementById('finca-nombre');
        const elProvincia = document.getElementById('finca-provincia');
        const elCanton = document.getElementById('finca-canton');
        const elAreaTotal = document.getElementById('finca-area-total');
        const elAreaCultivada = document.getElementById('finca-area-cultivada');
        const elTenencia = document.getElementById('finca-tenencia');
        const elCounter = document.getElementById('finca-counter');
        const elCard = document.getElementById('finca-card');

        function poligonoToSvgPath(poligono, width = 200, height = 200, padding = 10) {
          if (!poligono || !poligono.coordinates || !poligono.coordinates[0]) {
            return null;
          }

          const coords = poligono.coordinates[0];
          const lngs = coords.map((c) => c[0]);
          const lats = coords.map((c) => c[1]);

          const minLng = Math.min(...lngs);
          const maxLng = Math.max(...lngs);
          const minLat = Math.min(...lats);
          const maxLat = Math.max(...lats);

          const rangeLng = maxLng - minLng || 1;
          const rangeLat = maxLat - minLat || 1;

          const scaleX = (width - padding * 2) / rangeLng;
          const scaleY = (height - padding * 2) / rangeLat;

          const points = coords.map(([lng, lat]) => {
            const x = padding + (lng - minLng) * scaleX;
            const y = height - padding - (lat - minLat) * scaleY;
            return `${x},${y}`;
          });

          return points.join(' ');
        }

        function renderPoligono(poligono) {
          const container = document.getElementById('finca-svg');
          if (!container) return;

          const points = poligonoToSvgPath(poligono);

          if (!points) {
            container.innerHTML = '<p class="text-label-sm text-on-surface-variant">Sin polígono disponible</p>';
            return;
          }

          const coordsArr = points.split(' ').map(p => p.split(',').map(Number));
          const centerX = coordsArr.reduce((sum, p) => sum + p[0], 0) / coordsArr.length;
          const centerY = coordsArr.reduce((sum, p) => sum + p[1], 0) / coordsArr.length;

          container.innerHTML = `
            <svg viewBox="0 0 200 200" class="w-full h-48 rounded-lg border border-outline-variant/30 overflow-hidden">
              <defs>
                <filter id="terreno" x="-20%" y="-20%" width="140%" height="140%">
                  <feTurbulence type="fractalNoise" baseFrequency="0.04 0.06" numOctaves="3" seed="7" result="noise"/>
                  <feColorMatrix in="noise" type="matrix"
                    values="0 0 0 0 0.18
                            0 0 0 0 0.42
                            0 0 0 0 0.16
                            0 0 0 0 1" result="verde"/>
                  <feComposite in="verde" in2="SourceGraphic" operator="over"/>
                </filter>

                <linearGradient id="terrenoFill" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#a8d98a" stop-opacity="0.45"/>
                  <stop offset="100%" stop-color="#2e7d32" stop-opacity="0.25"/>
                </linearGradient>

                <radialGradient id="vignette" cx="50%" cy="50%" r="75%">
                  <stop offset="60%" stop-color="#000" stop-opacity="0"/>
                  <stop offset="100%" stop-color="#000" stop-opacity="0.25"/>
                </radialGradient>
              </defs>

              <rect width="200" height="200" fill="#3a6b35"/>
              <rect width="200" height="200" filter="url(#terreno)" opacity="0.9"/>

              <ellipse cx="35" cy="40" rx="22" ry="16" fill="#5a8c3f" opacity="0.5"/>
              <ellipse cx="160" cy="150" rx="28" ry="20" fill="#2f5d2a" opacity="0.5"/>
              <ellipse cx="170" cy="35" rx="18" ry="14" fill="#4a7a35" opacity="0.4"/>
              <ellipse cx="50" cy="170" rx="20" ry="15" fill="#264d22" opacity="0.4"/>

              <rect x="2" y="2" width="196" height="196" fill="none" stroke="#fff" stroke-opacity="0.25" stroke-width="1" stroke-dasharray="4 3" rx="6"/>

              <polygon points="${points}" fill="url(#terrenoFill)" stroke="#ffe066" stroke-width="2" stroke-linejoin="round" stroke-dasharray="6 3"/>

              <circle cx="${centerX}" cy="${centerY}" r="4" fill="#ffe066" stroke="#7a5c00" stroke-width="1"/>
              <circle cx="${centerX}" cy="${centerY}" r="8" fill="none" stroke="#ffe066" stroke-width="1" stroke-opacity="0.6">
                <animate attributeName="r" values="8;14;8" dur="2s" repeatCount="indefinite"/>
                <animate attributeName="stroke-opacity" values="0.6;0;0.6" dur="2s" repeatCount="indefinite"/>
              </circle>

              <rect width="200" height="200" fill="url(#vignette)"/>

              <text x="8" y="194" font-size="7" fill="#fff" fill-opacity="0.8" font-family="monospace">N ↑</text>
            </svg>
          `;
        }

        function renderFinca(finca, i) {
          elNombre.textContent = finca.nombre ?? '—';
          elProvincia.textContent = finca.provincia ?? '—';
          elCanton.textContent = finca.canton ?? '—';
          elAreaTotal.textContent = finca.area_total_ha ?? '—';
          elAreaCultivada.textContent = finca.area_cultivada_ha ?? '—';
          elTenencia.textContent = finca.tenencia ?? '—';
          elCounter.textContent = `${i + 1} / ${data.length}`;

          renderPoligono(finca.poligono);
        }

        function showFinca(i) {
          elCard.style.opacity = '0';
          setTimeout(() => {
            renderFinca(data[i], i);
            elCard.style.opacity = '1';
          }, 250);
        }

        if (data.length > 0) {
          showFinca(index);

          setInterval(() => {
            index = (index + 1) % data.length;
            showFinca(index);
          }, 3000);
        }
      </script>
    </div>
  </div>
</section>