---
// Recuadro de configuración de red inválida (T02, RF-T02-09). Solo muestra el código: el
// detalle queda en el log del servidor.
import type { CodigoErrorCadena } from "../../lib/chain/config";

interface Props {
  codigo: CodigoErrorCadena;
}

const { codigo } = Astro.props;
---

<section role="alert" class="rounded-xl border border-outline-variant bg-white p-6" data-error-cadena={codigo}>
  <h2 class="flex items-center gap-2 text-lg font-semibold text-on-surface">
    <span class="material-symbols-outlined text-secondary" aria-hidden="true">warning</span>
    Verificación no disponible
  </h2>
  <p class="mt-1 text-on-surface-variant">El servicio de consulta no está configurado. Inténtalo más tarde.</p>
  <p class="mt-2 text-xs text-on-surface-variant">Código: <code>{codigo}</code></p>
</section>
