---
const beneficios = [
  {
    icon: "verified_user",
    titulo: "Garantía de origen",
    descripcion: "Elimine el fraude alimentario y asegure que su producto premium mantenga su identidad en toda la cadena.",
  },
  {
    icon: "language",
    titulo: "Acceso a mercados",
    descripcion: "Cumpla con las normativas de la UE sobre deforestación y sostenibilidad de forma digital y auditable.",
  },
  {
    icon: "monitoring",
    titulo: "Eficiencia operativa",
    descripcion: "Reduzca tiempos de auditoría y gestión de certificados con una infraestructura integrada.",
  },
];
---
<section class="ha-atmosphere py-16 md:py-24" id="beneficios">
  <div class="mx-auto mb-12 max-w-container-max px-6 text-center">
    <span class="text-xs font-semibold uppercase tracking-[0.18em] text-secondary">Desafíos del agro moderno</span>
    <h2 class="font-display mt-3 text-3xl text-primary md:text-4xl">Transparencia que genera valor real</h2>
  </div>
  <div class="mx-auto grid max-w-container-max grid-cols-1 gap-6 px-6 md:grid-cols-3">
    {beneficios.map((b) => (
      <article class="rounded-2xl border border-outline-variant/80 bg-white/80 p-8 shadow-[0_18px_40px_-28px_rgba(26,34,28,0.35)] backdrop-blur-sm hover-lift">
        <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-primary text-on-primary">
          <span class="material-symbols-outlined text-2xl">{b.icon}</span>
        </div>
        <h3 class="font-display text-xl text-primary mb-3">{b.titulo}</h3>
        <p class="leading-relaxed text-on-surface-variant">{b.descripcion}</p>
      </article>
    ))}
  </div>
</section>
