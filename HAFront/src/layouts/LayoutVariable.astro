---
import "../styles/global.css";
import { isAdminRole } from "../services/roles";
import { AuthService } from "../services/auth.service.ts";
import { FincaService } from "../services/finca.service.ts";
import { ExpedienteService } from "../services/expediente.service.ts";

const user = Astro.locals.user;
const userRole = user?.role?.name || Astro.props.userRole || "Usuario";
const isAdmin = isAdminRole(user?.role?.name);
const title = Astro.props.title || "Huella de Altura";

// Obtener token de las cookies
const token = Astro.cookies.get("token")?.value;
let userData = null;
let hasFinca = false;
let hasExpediente = false;
let fincaId = null; // <-- NUEVA VARIABLE para almacenar el ID de la finca

if (token) {
  try {
    userData = await AuthService.getMe(token);
    
    // Verificar si tiene finca
    if (userData?.id) {
      try {
        const finca = await FincaService.getByProductorId(userData.id, token);
        // Ahora verificamos si finca es un objeto válido
        hasFinca = finca !== null && typeof finca === 'object' && Object.keys(finca).length > 0;
        
        // GUARDAMOS EL ID DE LA FINCA
        if (hasFinca && finca.id) {
          fincaId = finca.id;
          console.log('✅ Finca encontrada con ID:', fincaId);
        }
        
        // Verificar si tiene expediente
        if (hasFinca) {
          try {
            const expedientes = await ExpedienteService.list(token, { productor_id: userData.id });
            hasExpediente = expedientes && expedientes.length > 0;
            if (hasExpediente) {
              console.log('✅ Expedientes encontrados:', expedientes.length);
            }
          } catch (e) {
            console.warn('⚠️ No se pudieron cargar expedientes:', e);
            hasExpediente = false;
          }
        } else {
          console.log('ℹ️ No se encontró finca para el usuario:', userData.id);
        }
      } catch (e) {
        console.error('❌ Error cargando finca:', e);
        hasFinca = false;
      }
    }
  } catch (e) {
    console.error("❌ Error cargando usuario en layout:", e);
  }
} else {
  console.warn('⚠️ No hay token de autenticación');
}

// Construir la URL de Información Agroambiental con el finca_id
const infoAgroUrl = fincaId ? `/infoAgro?finca_id=${fincaId}` : '/infoAgro';
const expedientesUrl = fincaId ? `/expedientes?finca_id=${fincaId}` : '/expedientes';
const satelitalUrl = fincaId ? `/satelital?finca_id=${fincaId}` : '/satelital';
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>

  <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined"
    rel="stylesheet"
  />

  <!-- Evita el "flash" del sidebar abierto antes de aplicar la preferencia guardada -->
  <script is:inline>
    (function () {
      try {
        var collapsed = localStorage.getItem("sidebarCollapsed") === "true";
        if (collapsed) {
          document.documentElement.classList.add("sidebar-collapsed");
        }
      } catch (e) {}
    })();
  </script>
</head>

<body class="bg-background text-on-surface overflow-hidden">

  <!-- TOP BAR -->
  <header
    class="fixed top-0 left-0 right-0 h-16 bg-surface border-b border-outline-variant flex items-center justify-between px-8 z-50"
  >
    <div class="flex items-center gap-4">
      <!-- BOTÓN VOLVER (solo visible en páginas específicas) -->
      <a
        id="btn-volver"
        href="/productorFinca"
        class="flex items-center gap-2 text-on-surface-variant hover:text-primary transition"
        title="Volver a Productor y Finca"
      >
        <span class="material-symbols-outlined">arrow_back</span>
        <span class="hidden md:inline text-sm">Volver</span>
      </a>

      <h1 class="text-primary font-bold text-xl">
        Huella de Altura
      </h1>
    </div>

    <div class="flex items-center gap-5">
      <button class="hover:text-primary">
        <span class="material-symbols-outlined">notifications</span>
      </button>

      <button class="hover:text-primary">
        <span class="material-symbols-outlined">help</span>
      </button>

      <div class="h-8 border-l border-outline-variant"></div>

      <div class="flex items-center gap-3">
        <div
          class="w-10 h-10 rounded-full bg-primary text-white flex items-center justify-center font-semibold"
        >
          {user?.email ? user.email.charAt(0).toUpperCase() : "U"}
        </div>

        <div class="hidden md:block">
          <p class="text-sm font-semibold">
            {user?.user_metadata?.full_name || user?.first_name ? `${user.first_name} ${user.last_name || ''}`.trim() || "Usuario" : "Usuario"}
          </p>
          <p class="text-xs text-on-surface-variant">
            {userRole}
          </p>
        </div>
      </div>
    </div>
  </header>

  <!-- WRAPPER -->
  <div class="flex pt-16 h-screen">

    <!-- SIDEBAR -->
    <aside
      id="main-sidebar"
      class="sidebar w-72 fixed top-16 bottom-0 bg-surface-container-low border-r border-outline-variant overflow-y-auto flex flex-col"
    >

      <!-- HEADER -->
      <div class="p-5 border-b border-outline-variant">
        <h2 class="font-semibold text-primary">
          Panel de Control
        </h2>

        <p class="text-xs text-on-surface-variant mt-1">
          {isAdmin ? "Administración del Sistema" : "Gestión General"}
        </p>
      </div>

      <!-- MENÚ -->
      <nav class="flex-1 p-3 space-y-1">

        {
          !isAdmin && (
            <>
              <!-- PRODUCTOR Y FINCA -->
              <a
                href="/productorFinca"
                id="link-productor"
                class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-surface-container transition enabled-link"
              >
                <span class="material-symbols-outlined">
                  agriculture
                </span>

                <span>Productor y Finca</span>
              </a>

              <!-- EXPEDIENTE -->
              <a
                href={expedientesUrl}
                id="link-expediente"
                class={`flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-surface-container transition ${hasFinca ? 'enabled-link' : 'disabled-link'}`}
              >
                <span class="material-symbols-outlined">
                  folder_open
                </span>

                <span>Expediente</span>

                {!hasFinca && (
                  <span id="badge-expediente" class="ml-auto text-xs bg-primary text-white px-2 py-0.5 rounded-full">
                    Completar Finca
                  </span>
                )}
              </a>

              <!-- INFORMACIÓN AGROAMBIENTAL -->
              <a
                href={infoAgroUrl}
                id="link-infoagro"
                class={`flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-surface-container transition ${hasExpediente ? 'enabled-link' : 'disabled-link'}`}
              >
                <span class="material-symbols-outlined">
                  eco
                </span>

                <span>Información Agroambiental</span>

                {!hasExpediente && (
                  <span id="badge-infoagro" class="ml-auto text-xs bg-primary text-white px-2 py-0.5 rounded-full">
                    {hasFinca ? 'Crear Expediente' : 'Completar Finca'}
                  </span>
                )}
              </a>

              <!-- SATELITAL -->
              <a
                href={satelitalUrl}
                id="link-satelital"
                class={`flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-surface-container transition ${hasExpediente ? 'enabled-link' : 'disabled-link'}`}
              >
                <span class="material-symbols-outlined">
                  satellite_alt
                </span>

                <span>Reporte Satelital</span>

                {!hasExpediente && (
                  <span id="badge-satelital" class="ml-auto text-xs bg-primary text-white px-2 py-0.5 rounded-full">
                    {hasFinca ? 'Crear Expediente' : 'Completar Finca'}
                  </span>
                )}
              </a>
            </>
          )
        }

        <!-- SOLO ADMINISTRADOR -->
        {
          isAdmin && (
            <>
              <p
                class="px-3 py-2 text-xs uppercase tracking-wider text-on-surface-variant"
              >
                Administración
              </p>

              <!-- GESTIÓN USUARIOS -->
              <a
                href="/user"
                class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-surface-container transition"
              >
                <span class="material-symbols-outlined">
                  group
                </span>

                <span>Gestión de Usuarios</span>
              </a>

              <!-- GESTIÓN ROLES -->
              <a
                href="/rol"
                class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-surface-container transition"
              >
                <span class="material-symbols-outlined">
                  admin_panel_settings
                </span>

                <span>Gestión de Roles</span>
              </a>

              <!-- VARIABLES DINÁMICAS -->
              <a
                href="/variableDynamic"
                class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-surface-container transition"
              >
                <span class="material-symbols-outlined">
                  tune
                </span>

                <span>Variables Dinámicas</span>
              </a>   
            </>
          )
        }

      </nav>

      <!-- FOOTER -->
      <div
        class="border-t border-outline-variant p-3 bg-surface-container-low"
      >
        <a
          href="/soporte"
          class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-surface-container transition"
        >
          <span class="material-symbols-outlined">
            support_agent
          </span>

          <span>Soporte</span>
        </a>

        <a
          href="/api/logout"
          class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-surface-container transition text-red-600"
        >
          <span class="material-symbols-outlined">
            logout
          </span>

          <span>Cerrar Sesión</span>
        </a>
      </div>

    </aside>

    <!-- CONTENIDO -->
    <main id="main-content" class="main-content ml-72 flex-1 overflow-y-auto p-8">
      <div class="max-w-7xl mx-auto">
        <slot />
      </div>
    </main>

  </div>

  <style>
    .disabled-link { 
      pointer-events: none; 
      opacity: 0.45; 
      cursor: not-allowed;
    }
    .enabled-link { 
      pointer-events: auto; 
      opacity: 1; 
    }
    #toast-container { 
      position: fixed; 
      right: 1rem; 
      bottom: 1rem; 
      display: flex; 
      flex-direction: column; 
      gap: 0.5rem;  
      z-index: 9999; 
    }
    .toast { 
      background: #111827; 
      color: #fff; 
      padding: 8px 12px; 
      border-radius: 8px; 
      box-shadow: 0 6px 18px rgba(0,0,0,0.2); 
      opacity: 0; 
      transform: translateY(10px); 
      transition: all 240ms ease; 
    }
    .toast.show { 
      opacity: 1; 
      transform: translateY(0); 
    }

    /* --- TOGGLE SIDEBAR --- */
    .sidebar {
      transition: transform 0.25s ease;
    }
    .main-content {
      transition: margin-left 0.25s ease;
    }

    /* Cuando el <html> tiene la clase sidebar-collapsed, ocultamos el aside
       y quitamos el margen del contenido principal */
    html.sidebar-collapsed .sidebar {
      transform: translateX(-100%);
    }
    html.sidebar-collapsed .main-content {
      margin-left: 0;
    }

    /* En móvil, el sidebar empieza oculto y se muestra como overlay */
    @media (max-width: 768px) {
      .sidebar {
        transform: translateX(-100%);
        z-index: 40;
      }
      .main-content {
        margin-left: 0;
      }
      html:not(.sidebar-collapsed) .sidebar {
        transform: translateX(0);
      }
    }
  </style>

  <div id="toast-container"></div>

  <script>
    // Cliente script sin importaciones de TypeScript
    document.addEventListener('DOMContentLoaded', () => {
      
      function getCookie(name) {
        const match = document.cookie.match(new RegExp(`(?:^|; )${name}=([^;]*)`));
        return match ? decodeURIComponent(match[1]) : "";
      }

      const token = getCookie('token');
      const linkProductor = document.getElementById('link-productor');
      const linkExpediente = document.getElementById('link-expediente');
      const linkInfoAgro = document.getElementById('link-infoagro');
      const linkSatelital = document.getElementById('link-satelital');
      const btnVolver = document.getElementById('btn-volver');

      function showToast(message, timeout = 3500) {
        const container = document.getElementById('toast-container');
        if (!container) return;
        const t = document.createElement('div');
        t.className = 'toast';
        t.textContent = message;
        container.appendChild(t);
        requestAnimationFrame(() => t.classList.add('show'));
        setTimeout(() => { 
          t.classList.remove('show'); 
          setTimeout(() => t.remove(), 260); 
        }, timeout);
      }

      // Ocultar botón volver si estamos en la página de productorFinca
      if (btnVolver) {
        const currentPath = window.location.pathname;
        if (currentPath === '/productorFinca') {
          btnVolver.style.display = 'none';
        }
      }

      // Recargar la página cuando se guarda algo
      window.addEventListener('fincaSaved', () => {
        showToast('✅ Finca guardada correctamente');
        setTimeout(() => location.reload(), 1000);
      });

      window.addEventListener('productorSaved', () => {
        showToast('✅ Productor guardado correctamente');
        setTimeout(() => location.reload(), 1000);
      });

      window.addEventListener('expedienteSaved', () => {
        showToast('✅ Expediente guardado correctamente');
        setTimeout(() => location.reload(), 1000);
      });

      // Manejar clics en enlaces deshabilitados
      if (linkExpediente) {
        linkExpediente.addEventListener('click', (ev) => {
          if (linkExpediente.classList.contains('disabled-link')) {
            ev.preventDefault();
            showToast('⚠️ Completa Productor y Finca primero');
          }
        });
      }

      if (linkInfoAgro) {
        linkInfoAgro.addEventListener('click', (ev) => {
          if (linkInfoAgro.classList.contains('disabled-link')) {
            ev.preventDefault();
            const badge = document.getElementById('badge-infoagro');
            const msg = badge && badge.textContent === 'Crear Expediente' 
              ? '⚠️ Crea un expediente primero' 
              : '⚠️ Completa Productor y Finca primero';
            showToast(msg);
          }
        });
      }

      if (linkSatelital) {
        linkSatelital.addEventListener('click', (ev) => {
          if (linkSatelital.classList.contains('disabled-link')) {
            ev.preventDefault();
            const badge = document.getElementById('badge-satelital');
            const msg = badge && badge.textContent === 'Crear Expediente' 
              ? '⚠️ Crea un expediente primero' 
              : '⚠️ Completa Productor y Finca primero';
            showToast(msg);
          }
        });
      }

      // --- TOGGLE SIDEBAR ---
      const sidebarToggle = document.getElementById('sidebar-toggle');
      const htmlEl = document.documentElement;

      function applyAriaExpanded() {
        if (!sidebarToggle) return;
        const isCollapsed = htmlEl.classList.contains('sidebar-collapsed');
        sidebarToggle.setAttribute('aria-expanded', String(!isCollapsed));
      }

      
      applyAriaExpanded();

      if (sidebarToggle) {
        sidebarToggle.addEventListener('click', () => {
          htmlEl.classList.toggle('sidebar-collapsed');
          const isCollapsed = htmlEl.classList.contains('sidebar-collapsed');
          try {
            localStorage.setItem('sidebarCollapsed', String(isCollapsed));
          } catch (e) {}
          applyAriaExpanded();
        });
      }
    });
  </script>

</body>
</html>