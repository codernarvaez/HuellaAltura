---
import "../styles/global.css";

import { isAdminRole } from "../lib/roles";

const user = Astro.locals.user;
const userRole = user?.role?.name || Astro.props.userRole || "Usuario";
const isAdmin = isAdminRole(user?.role?.name);
const title = Astro.props.title || "Huella de Altura";
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>

  <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined"
    rel="stylesheet"
  />
</head>

<body class="bg-background text-on-surface overflow-hidden">

  <!-- TOP BAR -->
  <header
    class="fixed top-0 left-0 right-0 h-16 bg-surface border-b border-outline-variant flex items-center justify-between px-8 z-50"
  >
    <div class="flex items-center gap-4">
      <h1 class="text-primary font-bold text-xl">
        Huella de Altura
      </h1>
    </div>

    <div class="flex items-center gap-5">
      <button class="hover:text-primary">
        <span class="material-symbols-outlined">notifications</span>
      </button>

      <button class="hover:text-primary">
        <span class="material-symbols-outlined">help</span>
      </button>

      <div class="h-8 border-l border-outline-variant"></div>

      <div class="flex items-center gap-3">
        <div
          class="w-10 h-10 rounded-full bg-primary text-white flex items-center justify-center font-semibold"
        >
          {user?.email ? user.email.charAt(0).toUpperCase() : "U"}
        </div>

        <div class="hidden md:block">
          <p class="text-sm font-semibold">{user?.user_metadata?.full_name || "Usuario"}</p>
          <p class="text-xs text-on-surface-variant">
            {userRole}
          </p>
        </div>
      </div>
    </div>
  </header>

  <!-- WRAPPER -->
  <div class="flex pt-16 h-screen">

    <!-- SIDEBAR -->
    <aside
      class="w-72 fixed top-16 bottom-0 bg-surface-container-low border-r border-outline-variant overflow-y-auto flex flex-col"
    >

      <!-- HEADER -->
      <div class="p-5 border-b border-outline-variant">
        <h2 class="font-semibold text-primary">
          Panel de Control
        </h2>

        <p class="text-xs text-on-surface-variant mt-1">
          {isAdmin ? "Administración del Sistema" : "Gestión General"}
        </p>
      </div>

      <!-- MENÚ -->
      <nav class="flex-1 p-3 space-y-1">

        {
          !isAdmin && (
            <>
              <!-- PRODUCTOR -->
              <a
                href="/productorFinca"
                class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-surface-container transition"
              >
                <span class="material-symbols-outlined">
                  agriculture
                </span>

                <span>Productor y Finca</span>
              </a>

              <!-- EXPEDIENTE -->
              <a
                href="/expedientes"
                class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-surface-container transition"
              >
                <span class="material-symbols-outlined">
                  folder_open
                </span>

                <span>Expediente</span>
              </a>

              <!-- INFORMACIÓN AGROAMBIENTAL -->
              <a
                href="/infoAgro"
                class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-surface-container transition"
              >
                <span class="material-symbols-outlined">
                  eco
                </span>

                <span>Información Agroambiental</span>
              </a>


              <!-- SATELITAL -->
              <a
                href="/satelital"
                class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-surface-container transition"
              >
                <span class="material-symbols-outlined">
                  satellite_alt
                </span>

                <span>Reporte Satelital</span>
              </a>
            </>
          )
        }

        <!-- SOLO ADMINISTRADOR -->
        {
          isAdmin && (
            <>
              <p
                class="px-3 py-2 text-xs uppercase tracking-wider text-on-surface-variant"
              >
                Administración
              </p>

              <!-- GESTIÓN USUARIOS -->
              <a
                href="/user"
                class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-surface-container transition"
              >
                <span class="material-symbols-outlined">
                  group
                </span>

                <span>Gestión de Usuarios</span>
              </a>

              <!-- GESTIÓN ROLES -->
              <a
                href="/rol"
                class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-surface-container transition"
              >
                <span class="material-symbols-outlined">
                  admin_panel_settings
                </span>

                <span>Gestión de Roles</span>
              </a>

              <!-- VARIABLES DINÁMICAS -->
              <a
                href="/variableDynamic"
                class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-surface-container transition"
              >
                <span class="material-symbols-outlined">
                  tune
                </span>

                <span>Variables Dinámicas</span>
              </a>   
            </>
          )
        }

      </nav>

      <!-- FOOTER -->
      <div
        class="border-t border-outline-variant p-3 bg-surface-container-low"
      >
        <a
          href="/soporte"
          class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-surface-container transition"
        >
          <span class="material-symbols-outlined">
            support_agent
          </span>

          <span>Soporte</span>
        </a>

        <a
          href="/api/logout"
          class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-surface-container transition text-red-600"
        >
          <span class="material-symbols-outlined">
            logout
          </span>

          <span>Cerrar Sesión</span>
        </a>
      </div>

    </aside>

    <!-- CONTENIDO -->
    <main class="ml-72 flex-1 overflow-y-auto p-8">
      <div class="max-w-7xl mx-auto">
        <slot />
      </div>
    </main>

  </div>

  <style>
    .disabled-link { pointer-events: none; opacity: 0.45; }
    .enabled-link { pointer-events: auto; opacity: 1; }
    .link-badge { margin-left: 8px; padding: 2px 8px; background: rgba(59,130,246,0.95); color: white; font-size: 11px; border-radius: 999px; }
    #toast-container { position: fixed; right: 1rem; bottom: 1rem; display:flex; flex-direction:column; gap:0.5rem; z-index:9999; }
    .toast { background: #111827; color: #fff; padding: 8px 12px; border-radius: 8px; box-shadow: 0 6px 18px rgba(0,0,0,0.2); opacity:0; transform: translateY(10px); transition: all 240ms ease; }
    .toast.show { opacity:1; transform: translateY(0); }
  </style>

  <div id="toast-container"></div>

  <script type="module">
    import { AuthService } from "../services/auth.service.ts";
    import { ProductorService } from "../services/productorServices.ts";
    import { FincaService } from "../services/finca.service.ts";
    import { ExpedienteService } from "../services/expediente.service.ts";

    function getCookie(name) {
      const match = document.cookie.match(new RegExp(`(?:^|; )${name}=([^;]*)`));
      return match ? decodeURIComponent(match[1]) : "";
    }

    const token = getCookie('token');
    const linkProductor = document.getElementById('link-productor');
    const linkExpediente = document.getElementById('link-expediente');
    const linkInfoAgro = document.getElementById('link-infoagro');
    const linkSatelital = document.getElementById('link-satelital');
    const badgeExpediente = document.getElementById('badge-expediente');
    const badgeInfoAgro = document.getElementById('badge-infoagro');
    const badgeSatelital = document.getElementById('badge-satelital');

    function showToast(message, timeout = 3500) {
      const container = document.getElementById('toast-container');
      if (!container) return;
      const t = document.createElement('div');
      t.className = 'toast';
      t.textContent = message;
      container.appendChild(t);
      // show
      requestAnimationFrame(() => t.classList.add('show'));
      setTimeout(() => { t.classList.remove('show'); setTimeout(()=> t.remove(), 260); }, timeout);
    }

    // handle clicks on disabled links to show reason
    function attachDisabledClick(linkEl, badgeEl, defaultMsg) {
      if (!linkEl) return;
      linkEl.addEventListener('click', (ev) => {
        if (linkEl.classList.contains('disabled-link')) {
          ev.preventDefault();
          const msg = badgeEl && badgeEl.textContent ? badgeEl.textContent : defaultMsg;
          showToast(msg);
        }
      });
    }

    attachDisabledClick(linkExpediente, badgeExpediente, 'Completa Productor y Finca antes de acceder a Expedientes');
    attachDisabledClick(linkInfoAgro, badgeInfoAgro, 'Crea un expediente antes de acceder a Información Agroambiental');

    async function initFlow() {
      // Default: only productor link active
      if (linkProductor) linkProductor.classList.add('enabled-link');
      if (linkExpediente) linkExpediente.classList.add('disabled-link');
      if (linkInfoAgro) linkInfoAgro.classList.add('disabled-link');
      if (badgeExpediente) badgeExpediente.classList.add('hidden');
      if (badgeInfoAgro) badgeInfoAgro.classList.add('hidden');

      if (!token) return; // can't progress without auth

      try {
        const user = await AuthService.getMe(token);

        // check productor
        let hasProductor = false;
        try {
          const productores = await ProductorService.list(token);
          hasProductor = productores.some(p => p.cedula_id === user.identifier || p.id === user.id);
        } catch (e) { /* ignore */ }

        // check finca
        let hasFinca = false;
        try {
          const fincas = await FincaService.list(token);
          // consider finca if linked to user id or productor id
          hasFinca = fincas.some(f => f.productor_id === user.id);
        } catch (e) { /* ignore */ }

        if (hasProductor && hasFinca) {
          // enable expediente link
          if (linkExpediente) { linkExpediente.classList.remove('disabled-link'); linkExpediente.classList.add('enabled-link'); }
        } else {
          // show hint badge on expediente
          if (badgeExpediente) { badgeExpediente.classList.remove('hidden'); badgeExpediente.textContent = hasProductor ? 'Completar Finca' : 'Completar Productor'; }
        }

        // check expedientes
        try {
          const expedientes = await ExpedienteService.list(token, { productor_id: user.id });
          if (expedientes && expedientes.length > 0) {
            if (linkInfoAgro) { linkInfoAgro.classList.remove('disabled-link'); linkInfoAgro.classList.add('enabled-link'); }
          } else {
            if (badgeInfoAgro) { badgeInfoAgro.classList.remove('hidden'); badgeInfoAgro.textContent = 'Crear Expediente'; }
          }
        } catch (e) { /* ignore */ }

      } catch (err) {
        console.warn('Flow init failed', err);
      }
    }

    // react to saves elsewhere in the app and re-evaluate flow
    window.addEventListener('productorSaved', () => initFlow());
    window.addEventListener('fincaSaved', () => initFlow());

    initFlow();
  </script>

</body>
</html>