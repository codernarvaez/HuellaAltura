---
import "../styles/global.css";
import { isAdminRole } from "../services/roles";
import { AuthService, type UserOut } from "../services/auth.service";
import { FincaService } from "../services/finca.service";
import {
  getProductorProgress,
  pasosPreviosCompletos,
  type ProductorProgress,
} from "../services/productorProgress";

interface Props {
  title?: string;
  userRole?: string;
}

const { title = "Huella de Altura", userRole: propRole } = Astro.props as Props;
const user = Astro.locals.user;
const userRole = user?.role?.name || propRole || "Usuario";
const isAdmin = isAdminRole(user?.role?.name);

// Obtener token de las cookies
const token = Astro.cookies.get("token")?.value;
let userData: UserOut | null = null;
let hasFinca = false;
let hasExpediente = false;
let fincaId: string | null = null;

// Determinar si el usuario es INVESTIGADOR
const esInvestigador = userRole === 'INVESTIGADOR' || userRole === 'AUDITOR_INTERNO';
// El resto de usuarios no-admin se consideran PRODUCTOR (misma regla que ya usaba el sidebar)
const esProductor = !isAdmin && !esInvestigador;

// 🔥 Progreso secuencial del productor (finca -> agroambiental -> satelital -> expediente)
let progress: ProductorProgress | null = null;

if (token) {
  try {
    userData = await AuthService.getMe(token);

    if (userData?.id && esProductor) {
      try {
        progress = await getProductorProgress(userData.id, token);
        hasFinca = progress.finca;
        hasExpediente = progress.expediente;
        fincaId = progress.fincaId;
      } catch (e: unknown) {
        console.error('❌ Error calculando progreso del productor:', e);
      }
    } else if (userData?.id) {
      // Investigador / Admin: solo necesitamos la finca para armar enlaces con finca_id
      try {
        const fincas = await FincaService.getByUsuarioId(userData.id, token);
        const finca = Array.isArray(fincas) ? fincas[0] : fincas;
        hasFinca = !!finca;
        if (finca?.id) fincaId = finca.id;
      } catch (e: unknown) {
        console.warn('⚠️ Error cargando finca:', e);
      }
    }
  } catch (e: unknown) {
    console.error("❌ Error cargando usuario en layout:", e);
  }
} else {
  console.warn('⚠️ No hay token de autenticación');
}

// Estado de bloqueo de cada paso del sidebar.
// Para roles distintos a PRODUCTOR (admin/investigador) todo queda desbloqueado,
// ya que el flujo secuencial solo aplica al productor.
const pasoAgroDesbloqueado = !esProductor || !progress || pasosPreviosCompletos('agroambiental', progress);
const pasoSatelitalDesbloqueado = !esProductor || !progress || pasosPreviosCompletos('satelital', progress);
const pasoExpedienteDesbloqueado = !esProductor || !progress || pasosPreviosCompletos('expediente', progress);

// Construir URLs con finca_id
const infoAgroUrl = fincaId ? `/infoAgro?finca_id=${fincaId}` : '/infoAgro';
const expedientesUrl = fincaId ? `/expedientes?finca_id=${fincaId}` : '/expedientes';
const satelitalUrl = fincaId ? `/satelital?finca_id=${fincaId}` : '/satelital';
const auditoriaSatelitalUrl = '/auditoriaSatelital';
const calendarioUrl = '/calendario';
const ledgerUrl = fincaId ? `/labores?finca_id=${fincaId}` : '/labores';

// ============================================================
// 🔥 URLS DEL MÓDULO DE ACOPIO
// ============================================================
const acopioMuestrasUrl = '/acopio/muestras';
const acopioLaboratorioUrl = '/acopio/laboratorio';
const acopioComprasUrl = '/acopio/compras';
const acopioBodegaUrl = '/acopio/bodega';
const acopioDespachosUrl = '/acopio/despachos';
const acopioCertificadosUrl = '/acopio/certificados';

// INVESTIGADOR siempre puede ver Info Agro
const puedeVerInfoAgro = esInvestigador || hasExpediente;

// Convertir booleans a strings para el cliente
const esInvestigadorStr = esInvestigador ? 'true' : 'false';
const puedeVerInfoAgroStr = puedeVerInfoAgro ? 'true' : 'false';
const isAdminStr = isAdmin ? 'true' : 'false';
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Outfit:wght@400;500;600;700&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap"
    rel="stylesheet"
  />
</head>

<body class="bg-background text-on-surface overflow-hidden antialiased">

  <!-- TOP BAR -->
  <header
    class="fixed top-0 left-0 right-0 z-50 flex h-16 items-center justify-between border-b border-outline-variant/80 bg-[#f7f4ef]/92 px-6 backdrop-blur-xl md:px-8"
  >
    <div class="flex items-center gap-4">
      <a
        id="btn-volver"
        href="/productorFinca"
        class="flex items-center gap-2 rounded-lg px-2 py-1.5 text-on-surface-variant transition hover:bg-surface-container hover:text-primary"
        title="Volver a Productor y Finca"
      >
        <span class="material-symbols-outlined text-[20px]">arrow_back</span>
        <span class="hidden text-sm md:inline">Volver</span>
      </a>

      <a href="/productorFinca" class="flex items-center gap-2 text-primary">
        <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">landscape</span>
        <span class="font-display text-lg tracking-tight md:text-xl">Huella de Altura</span>
      </a>
    </div>

    <div class="flex items-center gap-3 md:gap-5">
      <button type="button" class="rounded-lg p-2 text-on-surface-variant transition hover:bg-surface-container hover:text-primary" aria-label="Notificaciones">
        <span class="material-symbols-outlined">notifications</span>
      </button>

      <button type="button" class="rounded-lg p-2 text-on-surface-variant transition hover:bg-surface-container hover:text-primary" aria-label="Ayuda">
        <span class="material-symbols-outlined">help</span>
      </button>

      <div class="hidden h-8 border-l border-outline-variant sm:block"></div>

      <div class="flex items-center gap-3">
        <div
          class="flex h-10 w-10 items-center justify-center rounded-full bg-primary text-sm font-semibold text-white shadow-sm"
        >
          {user?.email ? user.email.charAt(0).toUpperCase() : "U"}
        </div>

        <div class="hidden md:block">
          <p class="text-sm font-semibold text-on-surface">
            {[user?.first_name, user?.last_name].filter(Boolean).join(" ") || "Usuario"}
          </p>
          <p class="text-xs uppercase tracking-wide text-on-surface-variant">
            {userRole}
          </p>
        </div>
      </div>
    </div>
  </header>

  <!-- WRAPPER -->
  <div class="flex pt-16 h-screen min-h-0 overflow-hidden">

    <!-- SIDEBAR -->
    <aside
      class="fixed top-16 bottom-0 flex w-72 flex-col overflow-y-auto border-r border-outline-variant/80 bg-surface-container-low"
    >

      <!-- HEADER -->
      <div class="border-b border-outline-variant/80 p-5">
        <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-secondary">
          {isAdmin ? "Administración" : (esInvestigador ? "Investigación" : "Productor")}
        </p>
        <h2 class="mt-1 font-display text-lg text-primary">
          Panel de control
        </h2>
      </div>

      <!-- MENÚ -->
      <nav class="flex-1 p-3 space-y-1">

        {
          !isAdmin && (
            <>
              {/* SI ES INVESTIGADOR - SOLO MUESTRA INFO AGROAMBIENTAL */}
              {esInvestigador ? (
                <>
                  <!-- INFORMACIÓN AGROAMBIENTAL (único enlace visible) -->
                  <a
                    href={infoAgroUrl}
                    id="link-infoagro"
                    class="ha-nav-link is-active border border-primary/15"
                  >
                    <span class="material-symbols-outlined text-primary">
                      eco
                    </span>

                    <span class="font-medium">Información Agroambiental</span>

                    <span class="ml-auto text-xs bg-green-500 text-white px-2 py-0.5 rounded-full">
                      Acceso
                    </span>
                  </a>

                  <div class="mt-4 p-3 bg-blue-50 border border-blue-200 rounded-lg text-xs text-blue-700">
                    <span class="material-symbols-outlined text-sm align-middle mr-1">info</span>
                    Como Investigador, tienes acceso a la información agroambiental de las fincas.
                  </div>
                </>
              ) : (
                /* USUARIO NORMAL (PRODUCTOR) - FLUJO SECUENCIAL */
                <>
                  <!-- 1. PRODUCTOR Y FINCA (siempre disponible) -->
                  <a
                    href="/productorFinca"
                    id="link-productor"
                    class="ha-nav-link"
                  >
                    <span class="material-symbols-outlined">
                      agriculture
                    </span>

                    <span>1. Productor y Finca</span>

                    {hasFinca && (
                      <span class="material-symbols-outlined text-green-600 ml-auto text-sm">check_circle</span>
                    )}
                  </a>

                  <!-- 2. INFORMACIÓN AGROAMBIENTAL -->
                  {pasoAgroDesbloqueado ? (
                    <a
                      href={infoAgroUrl}
                      id="link-infoagro"
                      class="ha-nav-link"
                    >
                      <span class="material-symbols-outlined">
                        eco
                      </span>

                      <span>2. Información Agroambiental</span>

                      {progress?.agroambiental && (
                        <span class="material-symbols-outlined text-green-600 ml-auto text-sm">check_circle</span>
                      )}
                    </a>
                  ) : (
                    <button
                      type="button"
                      id="link-infoagro-locked"
                      class="w-full text-left flex items-center gap-3 px-3 py-3 rounded-lg opacity-45 cursor-not-allowed"
                      data-locked-step="Productor y Finca"
                      title="Completa primero el paso 'Productor y Finca'"
                    >
                      <span class="material-symbols-outlined">
                        eco
                      </span>

                      <span>2. Información Agroambiental</span>

                      <span class="material-symbols-outlined ml-auto text-sm">lock</span>
                    </button>
                  )}

                  <!-- 3. SATELITAL -->
                  {pasoSatelitalDesbloqueado ? (
                    <a
                      href={satelitalUrl}
                      id="link-satelital"
                      class="ha-nav-link"
                    >
                      <span class="material-symbols-outlined">
                        satellite_alt
                      </span>

                      <span>3. Satelital</span>

                      {progress?.satelital && (
                        <span class="material-symbols-outlined text-green-600 ml-auto text-sm">check_circle</span>
                      )}
                    </a>
                  ) : (
                    <button
                      type="button"
                      id="link-satelital-locked"
                      class="w-full text-left flex items-center gap-3 px-3 py-3 rounded-lg opacity-45 cursor-not-allowed"
                      data-locked-step="Información Agroambiental"
                      title="Completa primero el paso 'Información Agroambiental'"
                    >
                      <span class="material-symbols-outlined">
                        satellite_alt
                      </span>

                      <span>3. Satelital</span>

                      <span class="material-symbols-outlined ml-auto text-sm">lock</span>
                    </button>
                  )}

                  <!-- 4. EXPEDIENTE -->
                  {pasoExpedienteDesbloqueado ? (
                    <a
                      href={expedientesUrl}
                      id="link-expediente"
                      class="ha-nav-link"
                    >
                      <span class="material-symbols-outlined">
                        folder_open
                      </span>

                      <span>4. Expediente</span>

                      {progress?.expediente && (
                        <span class="material-symbols-outlined text-green-600 ml-auto text-sm">check_circle</span>
                      )}
                    </a>
                  ) : (
                    <button
                      type="button"
                      id="link-expediente-locked"
                      class="w-full text-left flex items-center gap-3 px-3 py-3 rounded-lg opacity-45 cursor-not-allowed"
                      data-locked-step="Satelital"
                      title="Completa primero el paso 'Satelital'"
                    >
                      <span class="material-symbols-outlined">
                        folder_open
                      </span>

                      <span>4. Expediente</span>

                      <span class="material-symbols-outlined ml-auto text-sm">lock</span>
                    </button>
                  )}

                  <!-- 5. CALENDARIO -->
                  <a
                    href={calendarioUrl}
                    id="link-calendario"
                    class="ha-nav-link"
                  >
                    <span class="material-symbols-outlined">
                      calendar_month
                    </span>

                    <span>Calendario</span>
                  </a>

                  <!-- 6. LEDGER DE LABORES -->
                  <a
                    href={ledgerUrl}
                    id="link-ledger"
                    class="ha-nav-link"
                  >
                    <span class="material-symbols-outlined">
                      receipt_long
                    </span>

                    <span>Ledger de Labores</span>
                  </a>
                </>
              )}
            </>
          )
        }

        {/* 🔥 MÓDULO DE ACOPIO - SOLO ADMINISTRADOR */}
        {
          isAdmin && (
            <>
              <p
                class="px-3 py-2 text-xs uppercase tracking-wider text-on-surface-variant border-t border-outline-variant mt-4 pt-4"
              >
                Acopio y Trazabilidad
              </p>

              <!-- MUESTRAS -->
              <a
                href={acopioMuestrasUrl}
                id="link-acopio-muestras"
                class="ha-nav-link"
              >
                <span class="material-symbols-outlined">
                  science
                </span>
                <span>Muestras</span>
              </a>

              <!-- LABORATORIO -->
              <a
                href={acopioLaboratorioUrl}
                id="link-acopio-laboratorio"
                class="ha-nav-link"
              >
                <span class="material-symbols-outlined">
                  biotech
                </span>
                <span>Laboratorio</span>
              </a>

              <!-- ÓRDENES DE COMPRA -->
              <a
                href={acopioComprasUrl}
                id="link-acopio-compras"
                class="ha-nav-link"
              >
                <span class="material-symbols-outlined">
                  shopping_cart
                </span>
                <span>Órdenes de Compra</span>
              </a>

              <!-- BODEGA -->
              <a
                href={acopioBodegaUrl}
                id="link-acopio-bodega"
                class="ha-nav-link"
              >
                <span class="material-symbols-outlined">
                  warehouse
                </span>
                <span>Bodega</span>
              </a>

              <!-- DESPACHOS -->
              <a
                href={acopioDespachosUrl}
                id="link-acopio-despachos"
                class="ha-nav-link"
              >
                <span class="material-symbols-outlined">
                  local_shipping
                </span>
                <span>Despachos</span>
              </a>

              <!-- CERTIFICADOS -->
              <a
                href={acopioCertificadosUrl}
                id="link-acopio-certificados"
                class="ha-nav-link"
              >
                <span class="material-symbols-outlined">
                  verified
                </span>
                <span>Certificados</span>
              </a>

              <p
                class="px-3 py-2 text-xs uppercase tracking-wider text-on-surface-variant border-t border-outline-variant mt-4 pt-4"
              >
                Administración
              </p>

              <!-- GESTIÓN USUARIOS -->
              <a
                href="/user"
                class="ha-nav-link"
              >
                <span class="material-symbols-outlined">
                  group
                </span>

                <span>Gestión de Usuarios</span>
              </a>

              <!-- GESTIÓN ROLES -->
              <a
                href="/rol"
                class="ha-nav-link"
              >
                <span class="material-symbols-outlined">
                  admin_panel_settings
                </span>

                <span>Gestión de Roles</span>
              </a>

              <!-- VARIABLES DINÁMICAS -->
              <a
                href="/variableDynamic"
                class="ha-nav-link"
              >
                <span class="material-symbols-outlined">
                  tune
                </span>

                <span>Variables Dinámicas</span>
              </a>

              <!-- AUDITORÍA SATELITAL -->
              <a
                href={auditoriaSatelitalUrl}
                id="link-auditoria-satelital"
                class="ha-nav-link"
              >
                <span class="material-symbols-outlined">
                  satellite
                </span>

                <span>Auditoría Satelital</span>
              </a>

              <!-- CALENDARIO PARA ADMIN -->
              <a
                href={calendarioUrl}
                id="link-calendario-admin"
                class="ha-nav-link"
              >
                <span class="material-symbols-outlined">
                  calendar_month
                </span>

                <span>Calendario</span>
              </a>

              <!-- LEDGER DE LABORES PARA ADMIN -->
              <a
                href={ledgerUrl}
                id="link-ledger-admin"
                class="ha-nav-link"
              >
                <span class="material-symbols-outlined">
                  receipt_long
                </span>

                <span>Ledger de Labores</span>
              </a>
            </>
          )
        }

      </nav>

      <!-- FOOTER -->
      <div
        class="border-t border-outline-variant p-3 bg-surface-container-low"
      >
        <a
          href="/soporte"
          class="ha-nav-link"
        >
          <span class="material-symbols-outlined">
            support_agent
          </span>

          <span>Soporte</span>
        </a>

        <a
          href="/api/logout"
          class="ha-nav-link text-red-700 hover:!bg-red-50"
        >
          <span class="material-symbols-outlined">
            logout
          </span>

          <span>Cerrar Sesión</span>
        </a>
      </div>

    </aside>

    <!-- CONTENIDO -->
    <main class="ml-72 min-h-0 min-w-0 flex-1 overflow-y-auto bg-background p-6 md:p-8">
      <div class="mx-auto max-w-7xl">
        <slot />
      </div>
    </main>

  </div>

  <style>
    .disabled-link { 
      pointer-events: none; 
      opacity: 0.45; 
      cursor: not-allowed;
    }
    .enabled-link { 
      pointer-events: auto; 
      opacity: 1; 
    }
    #toast-container { 
      position: fixed; 
      right: 1rem; 
      bottom: 1rem; 
      display: flex; 
      flex-direction: column; 
      gap: 0.5rem; 
      z-index: 9999; 
    }
    .toast { 
      background: #0b3d2e; 
      color: #fff; 
      padding: 10px 14px; 
      border-radius: 12px; 
      box-shadow: 0 10px 28px rgba(11,61,46,0.28); 
      opacity: 0; 
      transform: translateY(10px); 
      transition: all 240ms ease; 
      font-size: 0.875rem;
    }
    .toast.show { 
      opacity: 1; 
      transform: translateY(0); 
    }
  </style>

  <div id="toast-container"></div>

  <script define:vars={{ esInvestigadorStr, puedeVerInfoAgroStr, isAdminStr }}>
  // Datos inyectados desde el servidor como variables
  const ES_INVESTIGADOR = esInvestigadorStr;
  const PUEDE_VER_INFO_AGRO = puedeVerInfoAgroStr;
  const IS_ADMIN = isAdminStr;

  document.addEventListener('DOMContentLoaded', () => {
      
      function getCookie(name) {
        const match = document.cookie.match(new RegExp(`(?:^|; )${name}=([^;]*)`));
        return match ? decodeURIComponent(match[1]) : "";
      }

      const linkProductor = document.getElementById('link-productor');
      const linkExpediente = document.getElementById('link-expediente');
      const linkInfoAgro = document.getElementById('link-infoagro');
      const linkSatelital = document.getElementById('link-satelital');
      const linkCalendario = document.getElementById('link-calendario');
      const linkCalendarioAdmin = document.getElementById('link-calendario-admin');
      const linkLedger = document.getElementById('link-ledger');
      const linkLedgerAdmin = document.getElementById('link-ledger-admin');
      const linkAuditoria = document.getElementById('link-auditoria-satelital');
      const btnVolver = document.getElementById('btn-volver');

      // 🔥 Enlaces del módulo de acopio
      const linkAcopioMuestras = document.getElementById('link-acopio-muestras');
      const linkAcopioLaboratorio = document.getElementById('link-acopio-laboratorio');
      const linkAcopioCompras = document.getElementById('link-acopio-compras');
      const linkAcopioBodega = document.getElementById('link-acopio-bodega');
      const linkAcopioDespachos = document.getElementById('link-acopio-despachos');
      const linkAcopioCertificados = document.getElementById('link-acopio-certificados');

      // Convertir strings a booleanos
      const esInvestigador = ES_INVESTIGADOR === 'true';
      const puedeVerInfoAgro = PUEDE_VER_INFO_AGRO === 'true';
      const isAdmin = IS_ADMIN === 'true';

      function showToast(message, timeout = 3500) {
        const container = document.getElementById('toast-container');
        if (!container) return;
        const t = document.createElement('div');
        t.className = 'toast';
        t.textContent = message;
        container.appendChild(t);
        requestAnimationFrame(() => t.classList.add('show'));
        setTimeout(() => { 
          t.classList.remove('show'); 
          setTimeout(() => t.remove(), 260); 
        }, timeout);
      }

      // Ocultar botón volver si estamos en la página de productorFinca
      if (btnVolver) {
        const currentPath = window.location.pathname;
        if (currentPath === '/productorFinca') {
          btnVolver.style.display = 'none';
        }
      }

      // 🔥 Botones de pasos bloqueados: al hacer click, avisamos qué falta
      document.querySelectorAll('[data-locked-step]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const pasoFaltante = btn.getAttribute('data-locked-step');
          showToast(`🔒 Debes completar primero: ${pasoFaltante}`);
        });
      });

      // 🔥 Si el middleware nos redirigió por intentar saltarse un paso,
      // avisamos con un toast al cargar la página.
      const params = new URLSearchParams(window.location.search);
      const bloqueado = params.get('bloqueado');
      if (bloqueado) {
        const NOMBRES_PASO = {
          finca: 'Productor y Finca',
          agroambiental: 'Información Agroambiental',
          satelital: 'Satelital',
          expediente: 'Expediente',
        };
        const nombre = NOMBRES_PASO[bloqueado] || bloqueado;
        showToast(`🔒 Debes completar los pasos anteriores antes de acceder a "${nombre}"`);

        // Limpiar el parámetro de la URL sin recargar la página
        params.delete('bloqueado');
        const nuevaUrl = window.location.pathname + (params.toString() ? `?${params.toString()}` : '');
        window.history.replaceState({}, '', nuevaUrl);
      }

      // Recargar la página cuando se guarda algo
      window.addEventListener('fincaSaved', () => {
        showToast('✅ Finca guardada correctamente');
        setTimeout(() => location.reload(), 1000);
      });

      window.addEventListener('productorSaved', () => {
        showToast('✅ Productor guardado correctamente');
        setTimeout(() => location.reload(), 1000);
      });

      window.addEventListener('expedienteSaved', () => {
        showToast('✅ Expediente guardado correctamente');
        setTimeout(() => location.reload(), 1000);
      });

      // Para administradores, mostrar mensaje de bienvenida
      if (isAdmin) {
        console.log('👑 Administrador: Todos los enlaces están disponibles');
      }
    });
  </script>

</body>
</html>