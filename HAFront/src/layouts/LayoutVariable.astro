---
import "../styles/global.css";
import { isAdminRole } from "../services/roles";
import { AuthService } from "../services/auth.service.ts";
import { FincaService } from "../services/finca.service.ts";
import { ExpedienteService } from "../services/expediente.service.ts";

const user = Astro.locals.user;
const userRole = user?.role?.name || Astro.props.userRole || "Usuario";
const isAdmin = isAdminRole(user?.role?.name);
const title = Astro.props.title || "Huella de Altura";

// Obtener token de las cookies
const token = Astro.cookies.get("token")?.value;
let userData = null;
let hasFinca = false;
let hasExpediente = false;
let fincaId = null;

// Determinar si el usuario es INVESTIGADOR
const esInvestigadorStr = userRole === 'INVESTIGADOR' || userRole === 'AUDITOR_INTERNO';

if (token) {
  try {
    userData = await AuthService.getMe(token);
    
    if (userData?.id) {
      try {
        const finca = await FincaService.getByProductorId(userData.id, token);
        hasFinca = finca !== null && typeof finca === 'object' && Object.keys(finca).length > 0;
        
        if (hasFinca && finca.id) {
          fincaId = finca.id;
          console.log('✅ Finca encontrada con ID:', fincaId);
        }
        
        if (hasFinca) {
          try {
            const expedientes = await ExpedienteService.list(token, { productor_id: userData.id });
            hasExpediente = expedientes && expedientes.length > 0;
            if (hasExpediente) {
              console.log('✅ Expedientes encontrados:', expedientes.length);
            }
          } catch (e) {
            console.warn('⚠️ No se pudieron cargar expedientes:', e);
            hasExpediente = false;
          }
        } else {
          console.log('ℹ️ No se encontró finca para el usuario:', userData.id);
        }
      } catch (e) {
        console.error('❌ Error cargando finca:', e);
        hasFinca = false;
      }
    }
  } catch (e) {
    console.error("❌ Error cargando usuario en layout:", e);
  }
} else {
  console.warn('⚠️ No hay token de autenticación');
}

// Construir URLs con finca_id
const infoAgroUrl = fincaId ? `/infoAgro?finca_id=${fincaId}` : '/infoAgro';
const expedientesUrl = fincaId ? `/expedientes?finca_id=${fincaId}` : '/expedientes';
const satelitalUrl = fincaId ? `/satelital?finca_id=${fincaId}` : '/satelital';
const auditoriaSatelitalUrl = '/auditoriaSatelital';
const calendarioUrl = '/calendario';
const ledgerUrl = fincaId ? `/labores?finca_id=${fincaId}` : '/labores';

// ============================================================
// 🔥 URLS DEL MÓDULO DE ACOPIO
// ============================================================
const acopioMuestrasUrl = '/acopio/muestras';
const acopioLaboratorioUrl = '/acopio/laboratorio';
const acopioComprasUrl = '/acopio/compras';
const acopioBodegaUrl = '/acopio/bodega';
const acopioDespachosUrl = '/acopio/despachos';
const acopioCertificadosUrl = '/acopio/certificados';

// INVESTIGADOR siempre puede ver Info Agro
const puedeVerInfoAgro = esInvestigador || hasExpediente;

// Convertir booleans a strings para el cliente
const esInvestigadorStr = esInvestigador ? 'true' : 'false';
const puedeVerInfoAgroStr = puedeVerInfoAgro ? 'true' : 'false';
const isAdminStr = isAdmin ? 'true' : 'false';
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>

  <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined"
    rel="stylesheet"
  />
</head>

<body class="bg-background text-on-surface overflow-hidden">

  <!-- TOP BAR -->
  <header
    class="fixed top-0 left-0 right-0 h-16 bg-surface border-b border-outline-variant flex items-center justify-between px-8 z-50"
  >
    <div class="flex items-center gap-4">
      <!-- BOTÓN VOLVER (solo visible en páginas específicas) -->
      <a
        id="btn-volver"
        href="/productorFinca"
        class="flex items-center gap-2 text-on-surface-variant hover:text-primary transition"
        title="Volver a Productor y Finca"
      >
        <span class="material-symbols-outlined">arrow_back</span>
        <span class="hidden md:inline text-sm">Volver</span>
      </a>

      <h1 class="text-primary font-bold text-xl">
        Huella de Altura
      </h1>
    </div>

    <div class="flex items-center gap-5">
      <button class="hover:text-primary">
        <span class="material-symbols-outlined">notifications</span>
      </button>

      <button class="hover:text-primary">
        <span class="material-symbols-outlined">help</span>
      </button>

      <div class="h-8 border-l border-outline-variant"></div>

      <div class="flex items-center gap-3">
        <div
          class="w-10 h-10 rounded-full bg-primary text-white flex items-center justify-center font-semibold"
        >
          {user?.email ? user.email.charAt(0).toUpperCase() : "U"}
        </div>

        <div class="hidden md:block">
          <p class="text-sm font-semibold">
            {user?.user_metadata?.full_name || user?.first_name ? `${user.first_name} ${user.last_name || ''}`.trim() || "Usuario" : "Usuario"}
          </p>
          <p class="text-xs text-on-surface-variant">
            {userRole}
          </p>
        </div>
      </div>
    </div>
  </header>

  <!-- WRAPPER -->
  <div class="flex pt-16 h-screen">

    <!-- SIDEBAR -->
    <aside
      class="w-72 fixed top-16 bottom-0 bg-surface-container-low border-r border-outline-variant overflow-y-auto flex flex-col"
    >

      <!-- HEADER -->
      <div class="p-5 border-b border-outline-variant">
        <h2 class="font-semibold text-primary">
          Panel de Control
        </h2>

        <p class="text-xs text-on-surface-variant mt-1">
          {isAdmin ? "Administración del Sistema" : (esInvestigador ? "Investigador" : "Gestión General")}
        </p>
      </div>

      <!-- MENÚ -->
      <nav class="flex-1 p-3 space-y-1">

        {
          !isAdmin && (
            <>
              {/* SI ES INVESTIGADOR - SOLO MUESTRA INFO AGROAMBIENTAL */}
              {esInvestigador ? (
                <>
                  <!-- INFORMACIÓN AGROAMBIENTAL (único enlace visible) -->
                  <a
                    href={infoAgroUrl}
                    id="link-infoagro"
                    class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-surface-container transition bg-primary/5 border border-primary/20"
                  >
                    <span class="material-symbols-outlined text-primary">
                      eco
                    </span>

                    <span class="font-medium">Información Agroambiental</span>

                    <span class="ml-auto text-xs bg-green-500 text-white px-2 py-0.5 rounded-full">
                      Acceso
                    </span>
                  </a>

                  <div class="mt-4 p-3 bg-blue-50 border border-blue-200 rounded-lg text-xs text-blue-700">
                    <span class="material-symbols-outlined text-sm align-middle mr-1">info</span>
                    Como Investigador, tienes acceso a la información agroambiental de las fincas.
                  </div>
                </>
              ) : (
                /* USUARIO NORMAL (PRODUCTOR) - NUEVO ORDEN */
                <>
                  <!-- 1. PRODUCTOR Y FINCA -->
                  <a
                    href="/productorFinca"
                    id="link-productor"
                    class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-surface-container transition"
                  >
                    <span class="material-symbols-outlined">
                      agriculture
                    </span>

                    <span>Productor y Finca</span>
                  </a>

                  <!-- 2. INFORMACIÓN AGROAMBIENTAL -->
                  <a
                    href={infoAgroUrl}
                    id="link-infoagro"
                    class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-surface-container transition"
                  >
                    <span class="material-symbols-outlined">
                      eco
                    </span>

                    <span>Información Agroambiental</span>
                  </a>

                  <!-- 3. SATELITAL -->
                  <a
                    href={satelitalUrl}
                    id="link-satelital"
                    class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-surface-container transition"
                  >
                    <span class="material-symbols-outlined">
                      satellite_alt
                    </span>

                    <span>Satelital</span>
                  </a>

                  <!-- 4. EXPEDIENTE -->
                  <a
                    href={expedientesUrl}
                    id="link-expediente"
                    class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-surface-container transition"
                  >
                    <span class="material-symbols-outlined">
                      folder_open
                    </span>

                    <span>Expediente</span>
                  </a>

                  <!-- 5. CALENDARIO -->
                  <a
                    href={calendarioUrl}
                    id="link-calendario"
                    class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-surface-container transition"
                  >
                    <span class="material-symbols-outlined">
                      calendar_month
                    </span>

                    <span>Calendario</span>
                  </a>

                  <!-- 6. LEDGER DE LABORES -->
                  <a
                    href={ledgerUrl}
                    id="link-ledger"
                    class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-surface-container transition"
                  >
                    <span class="material-symbols-outlined">
                      receipt_long
                    </span>

                    <span>Ledger de Labores</span>
                  </a>
                </>
              )}
            </>
          )
        }

        {/* 🔥 MÓDULO DE ACOPIO - SOLO ADMINISTRADOR */}
        {
          isAdmin && (
            <>
              <p
                class="px-3 py-2 text-xs uppercase tracking-wider text-on-surface-variant border-t border-outline-variant mt-4 pt-4"
              >
                Acopio y Trazabilidad
              </p>

              <!-- MUESTRAS -->
              <a
                href={acopioMuestrasUrl}
                id="link-acopio-muestras"
                class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-surface-container transition"
              >
                <span class="material-symbols-outlined">
                  science
                </span>
                <span>Muestras</span>
              </a>

              <!-- LABORATORIO -->
              <a
                href={acopioLaboratorioUrl}
                id="link-acopio-laboratorio"
                class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-surface-container transition"
              >
                <span class="material-symbols-outlined">
                  biotech
                </span>
                <span>Laboratorio</span>
              </a>

              <!-- ÓRDENES DE COMPRA -->
              <a
                href={acopioComprasUrl}
                id="link-acopio-compras"
                class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-surface-container transition"
              >
                <span class="material-symbols-outlined">
                  shopping_cart
                </span>
                <span>Órdenes de Compra</span>
              </a>

              <!-- BODEGA -->
              <a
                href={acopioBodegaUrl}
                id="link-acopio-bodega"
                class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-surface-container transition"
              >
                <span class="material-symbols-outlined">
                  warehouse
                </span>
                <span>Bodega</span>
              </a>

              <!-- DESPACHOS -->
              <a
                href={acopioDespachosUrl}
                id="link-acopio-despachos"
                class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-surface-container transition"
              >
                <span class="material-symbols-outlined">
                  local_shipping
                </span>
                <span>Despachos</span>
              </a>

              <!-- CERTIFICADOS -->
              <a
                href={acopioCertificadosUrl}
                id="link-acopio-certificados"
                class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-surface-container transition"
              >
                <span class="material-symbols-outlined">
                  verified
                </span>
                <span>Certificados</span>
              </a>

              <p
                class="px-3 py-2 text-xs uppercase tracking-wider text-on-surface-variant border-t border-outline-variant mt-4 pt-4"
              >
                Administración
              </p>

              <!-- GESTIÓN USUARIOS -->
              <a
                href="/user"
                class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-surface-container transition"
              >
                <span class="material-symbols-outlined">
                  group
                </span>

                <span>Gestión de Usuarios</span>
              </a>

              <!-- GESTIÓN ROLES -->
              <a
                href="/rol"
                class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-surface-container transition"
              >
                <span class="material-symbols-outlined">
                  admin_panel_settings
                </span>

                <span>Gestión de Roles</span>
              </a>

              <!-- VARIABLES DINÁMICAS -->
              <a
                href="/variableDynamic"
                class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-surface-container transition"
              >
                <span class="material-symbols-outlined">
                  tune
                </span>

                <span>Variables Dinámicas</span>
              </a>

              <!-- AUDITORÍA SATELITAL -->
              <a
                href={auditoriaSatelitalUrl}
                id="link-auditoria-satelital"
                class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-surface-container transition"
              >
                <span class="material-symbols-outlined">
                  satellite
                </span>

                <span>Auditoría Satelital</span>
              </a>

              <!-- CALENDARIO PARA ADMIN -->
              <a
                href={calendarioUrl}
                id="link-calendario-admin"
                class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-surface-container transition"
              >
                <span class="material-symbols-outlined">
                  calendar_month
                </span>

                <span>Calendario</span>
              </a>

              <!-- LEDGER DE LABORES PARA ADMIN -->
              <a
                href={ledgerUrl}
                id="link-ledger-admin"
                class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-surface-container transition"
              >
                <span class="material-symbols-outlined">
                  receipt_long
                </span>

                <span>Ledger de Labores</span>
              </a>
            </>
          )
        }

      </nav>

      <!-- FOOTER -->
      <div
        class="border-t border-outline-variant p-3 bg-surface-container-low"
      >
        <a
          href="/soporte"
          class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-surface-container transition"
        >
          <span class="material-symbols-outlined">
            support_agent
          </span>

          <span>Soporte</span>
        </a>

        <a
          href="/api/logout"
          class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-surface-container transition text-red-600"
        >
          <span class="material-symbols-outlined">
            logout
          </span>

          <span>Cerrar Sesión</span>
        </a>
      </div>

    </aside>

    <!-- CONTENIDO -->
    <main class="ml-72 flex-1 overflow-y-auto p-8">
      <div class="max-w-7xl mx-auto">
        <slot />
      </div>
    </main>

  </div>

  <style>
    .disabled-link { 
      pointer-events: none; 
      opacity: 0.45; 
      cursor: not-allowed;
    }
    .enabled-link { 
      pointer-events: auto; 
      opacity: 1; 
    }
    #toast-container { 
      position: fixed; 
      right: 1rem; 
      bottom: 1rem; 
      display: flex; 
      flex-direction: column; 
      gap: 0.5rem; 
      z-index: 9999; 
    }
    .toast { 
      background: #111827; 
      color: #fff; 
      padding: 8px 12px; 
      border-radius: 8px; 
      box-shadow: 0 6px 18px rgba(0,0,0,0.2); 
      opacity: 0; 
      transform: translateY(10px); 
      transition: all 240ms ease; 
    }
    .toast.show { 
      opacity: 1; 
      transform: translateY(0); 
    }
  </style>

  <div id="toast-container"></div>

  <script>
    // Datos inyectados desde el servidor como variables
    const ES_INVESTIGADOR = {esInvestigadorStr};
    const PUEDE_VER_INFO_AGRO = {puedeVerInfoAgroStr};
    const IS_ADMIN = {isAdminStr};

    document.addEventListener('DOMContentLoaded', () => {
      
      function getCookie(name) {
        const match = document.cookie.match(new RegExp(`(?:^|; )${name}=([^;]*)`));
        return match ? decodeURIComponent(match[1]) : "";
      }

      const linkProductor = document.getElementById('link-productor');
      const linkExpediente = document.getElementById('link-expediente');
      const linkInfoAgro = document.getElementById('link-infoagro');
      const linkSatelital = document.getElementById('link-satelital');
      const linkCalendario = document.getElementById('link-calendario');
      const linkCalendarioAdmin = document.getElementById('link-calendario-admin');
      const linkLedger = document.getElementById('link-ledger');
      const linkLedgerAdmin = document.getElementById('link-ledger-admin');
      const linkAuditoria = document.getElementById('link-auditoria-satelital');
      const btnVolver = document.getElementById('btn-volver');

      // 🔥 Enlaces del módulo de acopio
      const linkAcopioMuestras = document.getElementById('link-acopio-muestras');
      const linkAcopioLaboratorio = document.getElementById('link-acopio-laboratorio');
      const linkAcopioCompras = document.getElementById('link-acopio-compras');
      const linkAcopioBodega = document.getElementById('link-acopio-bodega');
      const linkAcopioDespachos = document.getElementById('link-acopio-despachos');
      const linkAcopioCertificados = document.getElementById('link-acopio-certificados');

      // Convertir strings a booleanos
      const esInvestigador = ES_INVESTIGADOR === 'true';
      const puedeVerInfoAgro = PUEDE_VER_INFO_AGRO === 'true';
      const isAdmin = IS_ADMIN === 'true';

      function showToast(message, timeout = 3500) {
        const container = document.getElementById('toast-container');
        if (!container) return;
        const t = document.createElement('div');
        t.className = 'toast';
        t.textContent = message;
        container.appendChild(t);
        requestAnimationFrame(() => t.classList.add('show'));
        setTimeout(() => { 
          t.classList.remove('show'); 
          setTimeout(() => t.remove(), 260); 
        }, timeout);
      }

      // Ocultar botón volver si estamos en la página de productorFinca
      if (btnVolver) {
        const currentPath = window.location.pathname;
        if (currentPath === '/productorFinca') {
          btnVolver.style.display = 'none';
        }
      }

      // Recargar la página cuando se guarda algo
      window.addEventListener('fincaSaved', () => {
        showToast('✅ Finca guardada correctamente');
        setTimeout(() => location.reload(), 1000);
      });

      window.addEventListener('productorSaved', () => {
        showToast('✅ Productor guardado correctamente');
        setTimeout(() => location.reload(), 1000);
      });

      window.addEventListener('expedienteSaved', () => {
        showToast('✅ Expediente guardado correctamente');
        setTimeout(() => location.reload(), 1000);
      });

      // Para administradores, mostrar mensaje de bienvenida
      if (isAdmin) {
        console.log('👑 Administrador: Todos los enlaces están disponibles');
      }
    });
  </script>

</body>
</html>