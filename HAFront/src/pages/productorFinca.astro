---
import DashboardLayout from "../layouts/LayoutVariable.astro";
import { AuthService } from "../services/auth.service.ts";
import { FincaService } from "../services/finca.service.ts";

// Obtener token de las cookies
const token = Astro.cookies.get("token")?.value;

let userData = null;
let fincaData = null;
let error = null;
let isLoading = true;

if (token) {
  try {
    userData = await AuthService.getMe(token);
    
    if (userData?.id) {
      try {
        const fincas = await FincaService.getByUsuarioId(userData.id, token);
        
        if (fincas && fincas.length > 0) {
          fincaData = fincas[0];
        }
      } catch (e) {
        fincaData = null;
      }
    }
    isLoading = false;
  } catch (e) {
    error = e.message;
    isLoading = false;
  }
} else {
  isLoading = false;
  error = "No hay sesión activa";
}

// Preparar datos para el cliente
const usuarioId = userData?.id || '';
const fincaId = fincaData?.id || '';

// Convertir a JSON seguro
const userDataStr = userData ? JSON.stringify(userData) : 'null';
const fincaDataStr = fincaData ? JSON.stringify(fincaData) : 'null';
const poligonoDataStr = fincaData?.poligono ? JSON.stringify(fincaData.poligono) : 'null';

// Escapar caracteres especiales
const userDataEscaped = userDataStr.replace(/</g, '\\u003c').replace(/>/g, '\\u003e');
const fincaDataEscaped = fincaDataStr.replace(/</g, '\\u003c').replace(/>/g, '\\u003e');
const poligonoDataEscaped = poligonoDataStr.replace(/</g, '\\u003c').replace(/>/g, '\\u003e');
---

<DashboardLayout title="Productor y Finca">
<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<style>
  #map {
    height: 400px;
    border-radius: 12px;
    border: 1px solid var(--outline-variant);
    background: #f8fafc;
    width: 100%;
  }
  .leaflet-control-zoom {
    border: none !important;
  }
  .leaflet-control-zoom a {
    background: white !important;
    color: #1a1a1a !important;
    border: 1px solid #e5e7eb !important;
    border-radius: 8px !important;
    margin: 2px !important;
    width: 32px !important;
    height: 32px !important;
    line-height: 32px !important;
    font-size: 16px !important;
  }
  .leaflet-control-zoom a:hover {
    background: #f3f4f6 !important;
  }
  .leaflet-popup-content-wrapper {
    border-radius: 12px !important;
  }
  .leaflet-popup-content {
    font-size: 14px !important;
    min-width: 200px;
  }
  
  .vertex-label {
    background: transparent !important;
    border: none !important;
  }
  
  .info-box {
    font-family: system-ui, -apple-system, sans-serif;
    line-height: 1.6;
    min-width: 180px;
  }
  .info-box strong {
    color: #1a1a1a;
  }
  
  .legend-box {
    font-family: system-ui, -apple-system, sans-serif;
    line-height: 1.8;
    background: white;
    padding: 10px 14px;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
    border: 1px solid #e5e7eb;
  }
  .legend-item {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
  }
  .legend-item:last-child {
    margin-bottom: 0;
  }
  .legend-line {
    display: inline-block;
    width: 24px;
    height: 3px;
    background: #2563eb;
  }
  .legend-point {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #ef4444;
  }

  .method-selector {
    display: flex;
    gap: 12px;
    margin-bottom: 20px;
  }
  .method-btn {
    flex: 1;
    padding: 12px 20px;
    border: 2px solid var(--outline-variant);
    border-radius: 12px;
    background: var(--surface);
    cursor: pointer;
    text-align: center;
    transition: all 0.3s ease;
    font-weight: 500;
  }
  .method-btn:hover {
    border-color: var(--primary);
    background: var(--surface-container-high);
  }
  .method-btn.active {
    border-color: var(--primary);
    background: var(--primary-container);
    color: var(--primary);
  }
  .method-btn .material-symbols-outlined {
    display: block;
    font-size: 28px;
    margin-bottom: 4px;
  }
  
  .method-content {
    display: none;
  }
  .method-content.active {
    display: block;
  }

  .drop-zone {
    border: 2px dashed var(--outline-variant);
    border-radius: 12px;
    padding: 30px 20px;
    text-align: center;
    cursor: pointer;
    transition: all 0.3s ease;
    background: var(--surface-container-low);
  }
  .drop-zone:hover {
    border-color: var(--primary);
    background: var(--primary-container);
  }
  .drop-zone.dragover {
    border-color: var(--primary);
    background: var(--primary-container);
    transform: scale(1.02);
  }
  .drop-zone .material-symbols-outlined {
    font-size: 40px;
    color: var(--primary);
  }
  .file-info {
    background: var(--surface-container-high);
    border-radius: 8px;
    padding: 12px 16px;
    margin-top: 12px;
  }
  
  .nombre-finca-input {
    margin-top: 12px;
  }
  .nombre-finca-input label {
    font-weight: 500;
  }
  
  .border-error {
    border-color: #ef4444 !important;
  }
  
  .coord-input {
    font-family: monospace;
  }

  .null-badge {
    background: #f3f4f6;
    color: #6b7280;
    font-size: 0.75rem;
    padding: 2px 10px;
    border-radius: 12px;
    font-weight: 400;
  }
</style>

<!-- INYECCIÓN DE DATOS CON define:vars -->
<script define:vars={{ usuarioId, fincaId, userDataEscaped, fincaDataEscaped, poligonoDataEscaped, error }}>
  window.USUARIO_ID = usuarioId;
  window.FINCA_ID = fincaId;
  window.USER_DATA = JSON.parse(userDataEscaped);
  window.FINCA_DATA = JSON.parse(fincaDataEscaped);
  window.POLIGONO_DATA = JSON.parse(poligonoDataEscaped);
  window.ERROR = error || null;

  console.log('📦 Datos inyectados:');
  console.log('  - USUARIO_ID:', window.USUARIO_ID);
  console.log('  - FINCA_ID:', window.FINCA_ID);
  console.log('  - USER_DATA:', window.USER_DATA);
  console.log('  - FINCA_DATA:', window.FINCA_DATA);
  console.log('  - POLIGONO_DATA:', window.POLIGONO_DATA);
  console.log('  - ERROR:', window.ERROR);
</script>

<div class="space-y-8">

  <!-- HEADER -->
  <div class="flex flex-col md:flex-row justify-between gap-6">
    <div>
      <h1 class="text-3xl font-bold text-on-surface">
        Módulo 1: Información de Productor y Finca
      </h1>
      <p class="mt-2 text-on-surface-variant max-w-3xl">
        Formulario dinámico de recopilación de datos de origen requeridos por el reglamento EUDR.
      </p>
    </div>
    <div class="flex items-center gap-2">
      <button
        id="editar-productor"
        class="flex items-center justify-center gap-2 px-4 h-12 bg-surface text-primary border border-outline rounded-xl hover:opacity-90 transition"
      >
        <span class="material-symbols-outlined">person</span>
        Editar Productor
      </button>

      <!-- Botón Editar Finca: solo si ya existe -->
      {fincaData && (
        <button
          id="editar-finca"
          class="flex items-center justify-center gap-2 px-4 h-12 bg-surface text-primary border border-outline rounded-xl hover:opacity-90 transition"
        >
          <span class="material-symbols-outlined">agriculture</span>
          Editar Finca
        </button>
      )}
    </div>
  </div>

  <!-- PRODUCTOR AUTHENTICADO -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-2 items-end">
    <div class="md:col-span-2">
      <label class="block mb-2 text-sm font-medium text-on-surface-variant">
        Productor autenticado
      </label>
      <div class="flex items-center gap-4">
        <div class="flex-1 h-14 px-4 bg-surface-container-low border border-outline-variant rounded-xl flex items-center">
          <span class="material-symbols-outlined text-primary mr-2">person</span>
          <span id="productor-auth-name-display" class="font-medium">
            {isLoading ? 'Cargando...' : (error ? 'Error' : (userData ? `${userData.first_name || ''} ${userData.last_name || ''}`.trim() || userData.email || 'Sin nombre' : 'No hay sesión'))}
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- PRODUCTOR -->
  <section class="bg-surface-container-low border border-outline-variant rounded-xl p-8 hover-lift">
    <div class="flex items-center gap-3 border-b border-outline-variant pb-4 mb-6">
      <span class="material-symbols-outlined text-primary">person</span>
      <h2 class="text-xl font-semibold">Información del Productor</h2>
      <div class="ml-auto flex gap-2">
        <button id="guardar-productor" class="hidden px-3 py-1 bg-primary text-white rounded">Guardar</button>
        <button id="cancelar-productor" class="hidden px-3 py-1 bg-surface text-primary border rounded">Cancelar</button>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label class="block mb-2 text-sm font-medium text-on-surface-variant">Nombre Completo *</label>
        <input
          id="productor-nombre"
          type="text"
          readonly
          value={userData ? `${userData.first_name || ''} ${userData.last_name || ''}`.trim() : ''}
          placeholder="Nombre del productor"
          class="w-full h-14 px-4 bg-surface border border-outline-variant rounded-xl"
        />
      </div>

      <div>
        <label class="block mb-2 text-sm font-medium text-on-surface-variant">Cédula de Identidad / ID *</label>
        <input
          id="productor-cedula"
          type="text"
          readonly
          value={userData?.identifier || ''}
          placeholder="Número de identificación"
          class="w-full h-14 px-4 bg-surface border border-outline-variant rounded-xl"
        />
      </div>

      <div>
        <label class="block mb-2 text-sm font-medium text-on-surface-variant">Organización / Asociación</label>
        <input
          id="productor-organizacion"
          type="text"
          readonly
          value={userData?.organizacion || ''}
          placeholder="Nombre de la organización"
          class="w-full h-14 px-4 bg-surface border border-outline-variant rounded-xl"
        />
      </div>

      <div>
        <label class="block mb-2 text-sm font-medium text-on-surface-variant">Celular de Contacto</label>
        <input
          id="productor-celular"
          type="text"
          readonly
          value={userData?.phone_number || ''}
          placeholder="Número de celular"
          class="w-full h-14 px-4 bg-surface border border-outline-variant rounded-xl"
        />
      </div>

      <div>
        <label class="block mb-2 text-sm font-medium text-on-surface-variant">Género</label>
        <select
          id="productor-genero"
          disabled
          class="w-full h-14 px-4 bg-surface border border-outline-variant rounded-xl"
        >
          <option value="">Seleccionar género</option>
          <option value="MASCULINO" selected={userData?.genero === 'MASCULINO'}>Masculino</option>
          <option value="FEMENINO" selected={userData?.genero === 'FEMENINO'}>Femenino</option>
        </select>
      </div>

      <div>
        <label class="block mb-2 text-sm font-medium text-on-surface-variant">Edad</label>
        <input
          id="productor-edad"
          type="number"
          readonly
          value={userData?.edad || ''}
          placeholder="Edad del productor"
          class="w-full h-14 px-4 bg-surface border border-outline-variant rounded-xl"
        />
      </div>

      <div>
        <label class="block mb-2 text-sm font-medium text-on-surface-variant">Nivel Educativo</label>
        <select
          id="productor-nivel"
          disabled
          class="w-full h-14 px-4 bg-surface border border-outline-variant rounded-xl"
        >
          <option value="">Seleccionar nivel</option>
          <option value="NINGUNO" selected={userData?.nivel_educativo === 'NINGUNO'}>Ninguno</option>
          <option value="PRIMARIA" selected={userData?.nivel_educativo === 'PRIMARIA'}>Primaria</option>
          <option value="SECUNDARIA" selected={userData?.nivel_educativo === 'SECUNDARIA'}>Secundaria</option>
          <option value="SUPERIOR" selected={userData?.nivel_educativo === 'SUPERIOR'}>Superior</option>
          <option value="POSGRADO" selected={userData?.nivel_educativo === 'POSGRADO'}>Posgrado</option>
        </select>
      </div>
    </div>
  </section>

  <!-- FINCA -->
  <section class="bg-surface-container-low border border-outline-variant rounded-xl p-8 hover-lift">
    <div class="flex items-center gap-3 border-b border-outline-variant pb-4 mb-6">
      <span class="material-symbols-outlined text-primary">agriculture</span>
      <h2 class="text-xl font-semibold">Información de la Finca</h2>
      <div class="ml-auto flex gap-2">
        <button id="guardar-finca" class="hidden px-3 py-1 bg-primary text-white rounded">Guardar</button>
        <button id="cancelar-finca" class="hidden px-3 py-1 bg-surface text-primary border rounded">Cancelar</button>
      </div>
    </div>

    <!-- SELECTOR DE MÉTODO -->
    <div class="method-selector">
      <button id="metodo-manual" class="method-btn active">
        <span class="material-symbols-outlined">edit_note</span>
        Ingreso Manual
      </button>
      <button id="metodo-archivo" class="method-btn">
        <span class="material-symbols-outlined">upload_file</span>
        Cargar Archivo
      </button>
    </div>

    <!-- FORMULARIO DE FINCA -->
    <div id="finca-form">
      <!-- Ingreso Manual -->
      <div id="manual-content" class="method-content active">
        <p class="text-sm text-on-surface-variant mb-4">Ingresa los datos de la finca manualmente.</p>
      </div>

      <!-- Carga de Archivo -->
      <div id="archivo-content" class="method-content">
        <p class="text-sm text-on-surface-variant mb-4">
          Sube un archivo GPX, KML o GeoJSON para cargar automáticamente los datos.
        </p>
        
        <div class="nombre-finca-input mb-4">
          <label class="block mb-2 text-sm font-medium text-on-surface-variant">
            Nombre de la Finca <span class="text-error">*</span>
          </label>
          <input
            id="finca-nombre-archivo"
            type="text"
            placeholder="Ingresa el nombre de la finca"
            class="w-full h-14 px-4 bg-white border border-outline-variant rounded-xl focus:ring-2 focus:ring-primary focus:outline-none"
          />
          <p class="text-xs text-on-surface-variant mt-1">
            Este nombre se usará para la finca que se cree desde el archivo.
          </p>
        </div>

        <div id="drop-zone" class="drop-zone">
          <span class="material-symbols-outlined">cloud_upload</span>
          <p class="mt-2 font-medium">Arrastra y suelta tu archivo aquí</p>
          <p class="text-sm text-on-surface-variant">o haz clic para seleccionar un archivo</p>
          <p class="text-xs text-on-surface-variant mt-2">Formatos: .gpx, .kml, .geojson, .json</p>
          <input id="file-input" type="file" accept=".gpx,.kml,.geojson,.json" class="hidden" />
        </div>
        <div id="file-info" class="file-info hidden">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-primary">description</span>
              <div>
                <p id="file-name" class="font-medium text-sm">archivo.gpx</p>
                <p id="file-size" class="text-xs text-on-surface-variant">0 KB</p>
              </div>
            </div>
            <div class="flex gap-2">
              <button id="procesar-archivo" class="px-4 py-2 bg-primary text-white rounded-xl text-sm hover:opacity-90 transition flex items-center gap-2">
                <span class="material-symbols-outlined text-sm">play_arrow</span>
                Procesar
              </button>
              <button id="eliminar-archivo" class="px-4 py-2 bg-surface text-on-surface-variant border border-outline-variant rounded-xl text-sm hover:bg-surface-container-high transition">
                <span class="material-symbols-outlined text-sm">close</span>
              </button>
            </div>
          </div>
        </div>
        <div id="carga-progreso" class="mt-4 hidden">
          <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-primary animate-spin">progress_activity</span>
            <span class="text-sm text-on-surface-variant">Procesando archivo...</span>
          </div>
        </div>
        <div id="resultado-carga" class="mt-4 hidden"></div>
      </div>

      <!-- CAMPOS DE LA FINCA -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6 pt-6 border-t border-outline-variant">
        <!-- Nombre: editable si es nueva finca, readonly si ya existe -->
        <div>
          <label class="block mb-2 text-sm font-medium text-on-surface-variant">Nombre de la Finca *</label>
          <input
            id="finca-nombre"
            type="text"
            readonly={!!fincaData}
            value={fincaData?.nombre || ''}
            placeholder="Nombre de la finca"
            class="w-full h-14 px-4 bg-surface border border-outline-variant rounded-xl"
          />
        </div>

        <!-- Código EUDR (siempre readonly) -->
        <div>
          <label class="block mb-2 text-sm font-medium text-on-surface-variant">Código Único de Finca</label>
          <input
            id="finca-eudr"
            type="text"
            readonly
            value={fincaData?.eudr_id || ''}
            placeholder="Código EUDR"
            class="w-full h-14 px-4 bg-surface-container border border-outline-variant rounded-xl"
          />
        </div>

        <!-- Provincia (readonly siempre, viene del archivo) -->
        <div>
          <label class="block mb-2 text-sm font-medium text-on-surface-variant">Provincia</label>
          <input
            id="finca-provincia"
            type="text"
            readonly
            value={fincaData?.provincia || ''}
            placeholder="Provincia"
            class="w-full h-14 px-4 bg-surface border border-outline-variant rounded-xl"
          />
        </div>

        <!-- Cantón (readonly siempre) -->
        <div>
          <label class="block mb-2 text-sm font-medium text-on-surface-variant">Cantón</label>
          <input
            id="finca-canton"
            type="text"
            readonly
            value={fincaData?.canton || ''}
            placeholder="Cantón"
            class="w-full h-14 px-4 bg-surface border border-outline-variant rounded-xl"
          />
        </div>

        <!-- Parroquia (readonly siempre) -->
        <div>
          <label class="block mb-2 text-sm font-medium text-on-surface-variant">Parroquia</label>
          <input
            id="finca-parroquia"
            type="text"
            readonly
            value={fincaData?.parroquia || ''}
            placeholder="Parroquia"
            class="w-full h-14 px-4 bg-surface border border-outline-variant rounded-xl"
          />
        </div>

        <!-- Barrio / Sector: editable si es nueva finca, readonly si existe -->
        <div>
          <label class="block mb-2 text-sm font-medium text-on-surface-variant">Barrio / Sector</label>
          <input
            id="finca-barrio"
            type="text"
            readonly={!!fincaData}
            value={fincaData?.sector || ''}
            placeholder="Barrio o sector"
            class="w-full h-14 px-4 bg-surface border border-outline-variant rounded-xl"
          />
        </div>

        <!-- Área Total (readonly siempre, viene del archivo) -->
        <div>
          <label class="block mb-2 text-sm font-medium text-on-surface-variant">Área Total (ha) *</label>
          <input
            id="finca-area-total"
            type="number"
            step="0.01"
            readonly
            value={fincaData?.area_total_ha || ''}
            placeholder="Área total en hectáreas"
            class="w-full h-14 px-4 bg-surface border border-outline-variant rounded-xl"
          />
        </div>

        <!-- Área Cultivada: editable siempre (nueva o existente) -->
        <div>
          <label class="block mb-2 text-sm font-medium text-on-surface-variant">Área Cultivada (ha)</label>
          <input
            id="finca-area-cultivada"
            type="number"
            step="0.01"
            readonly={!!fincaData}
            value={fincaData?.area_cultivada_ha || ''}
            placeholder="Área cultivada en hectáreas"
            class="w-full h-14 px-4 bg-surface border border-outline-variant rounded-xl"
          />
        </div>

        <!-- Latitud (readonly siempre) -->
        <div>
          <label class="block mb-2 text-sm font-medium text-on-surface-variant">Latitud</label>
          <input
            id="finca-latitud"
            type="number"
            step="0.000001"
            readonly
            value={fincaData?.latitud || ''}
            placeholder="-4.262500"
            class="w-full h-14 px-4 bg-surface border border-outline-variant rounded-xl coord-input"
          />
        </div>

        <!-- Longitud (readonly siempre) -->
        <div>
          <label class="block mb-2 text-sm font-medium text-on-surface-variant">Longitud</label>
          <input
            id="finca-longitud"
            type="number"
            step="0.000001"
            readonly
            value={fincaData?.longitud || ''}
            placeholder="-79.223100"
            class="w-full h-14 px-4 bg-surface border border-outline-variant rounded-xl coord-input"
          />
        </div>

        <!-- Tenencia: editable si es nueva finca, disabled si existe -->
        <div class="md:col-span-2">
          <label class="block mb-2 text-sm font-medium text-on-surface-variant">Tenencia de Tierra</label>
          <select
            id="finca-tenencia"
            disabled={!!fincaData}
            class="w-full h-14 px-4 bg-surface border border-outline-variant rounded-xl"
          >
            <option value="">Seleccionar tenencia</option>
            <option value="PROPIA" selected={fincaData?.tenencia === 'PROPIA'}>Propia</option>
            <option value="ARRENDAMIENTO" selected={fincaData?.tenencia === 'ARRENDAMIENTO'}>Arrendamiento</option>
            <option value="POSESION" selected={fincaData?.tenencia === 'POSESION'}>Posesión</option>
          </select>
        </div>

        <!-- Variedad de Café: editable si es nueva finca, readonly si existe -->
        <div>
          <label class="block mb-2 text-sm font-medium text-on-surface-variant">Variedad de Café</label>
          <input
            id="finca-variedad"
            type="text"
            readonly={!!fincaData}
            value={fincaData?.variedad_cafe || ''}
            placeholder="Ej: Caturra, Typica, etc."
            class="w-full h-14 px-4 bg-surface border border-outline-variant rounded-xl"
          />
          {!fincaData?.variedad_cafe && <span class="null-badge text-xs">No registrado</span>}
        </div>

        <!-- Densidad de Siembra: editable si es nueva finca, readonly si existe -->
        <div>
          <label class="block mb-2 text-sm font-medium text-on-surface-variant">Densidad de Siembra (plantas/ha)</label>
          <input
            id="finca-densidad"
            type="number"
            step="100"
            readonly={!!fincaData}
            value={fincaData?.densidad_siembra || ''}
            placeholder="Ej: 5000"
            class="w-full h-14 px-4 bg-surface border border-outline-variant rounded-xl"
          />
          {!fincaData?.densidad_siembra && <span class="null-badge text-xs">No registrado</span>}
        </div>

        <!-- Origen de Semilla: editable si es nueva finca, readonly si existe -->
        <div>
          <label class="block mb-2 text-sm font-medium text-on-surface-variant">Origen de Semilla</label>
          <input
            id="finca-origen-semilla"
            type="text"
            readonly={!!fincaData}
            value={fincaData?.origen_semilla || ''}
            placeholder="Ej: Vivero local"
            class="w-full h-14 px-4 bg-surface border border-outline-variant rounded-xl"
          />
          {!fincaData?.origen_semilla && <span class="null-badge text-xs">No registrado</span>}
        </div>

        <!-- Año de Establecimiento: editable si es nueva finca, readonly si existe -->
        <div>
          <label class="block mb-2 text-sm font-medium text-on-surface-variant">Año de Establecimiento</label>
          <input
            id="finca-anio"
            type="number"
            step="1"
            readonly={!!fincaData}
