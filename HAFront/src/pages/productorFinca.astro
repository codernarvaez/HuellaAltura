<!-- SCRIPT 2: Edición y guardado (SIN TOASTIFY)                  -->
<!-- ============================================================ -->
<script type="module">
  import { FincaService } from "../services/finca.service.ts";

  document.addEventListener('DOMContentLoaded', () => {
    function notify(message, type = 'info') {
      console.log(`[${type.toUpperCase()}] ${message}`);
      if (type === 'error') {
        alert('❌ ' + message);
      }
    }

    // ===== Referencias =====
    const editarProductorBtn = document.getElementById('editar-productor');
    const editarFincaBtn = document.getElementById('editar-finca');
    const guardarProductorBtn = document.getElementById('guardar-productor');
    const cancelarProductorBtn = document.getElementById('cancelar-productor');
    const guardarFincaBtn = document.getElementById('guardar-finca');
    const cancelarFincaBtn = document.getElementById('cancelar-finca');
    const guardarFincaSubmit = document.getElementById('guardar-finca-submit');

    // ===== Datos =====
    let usuarioId = window.USUARIO_ID || '';
    let userData = window.USER_DATA || null;
    let fincaData = window.FINCA_DATA || null;

    console.log('📦 Datos del productor:', userData);
    console.log('🏡 Datos de finca:', fincaData);

    function updateAuthNameDisplay() {
      const authNameDisplay = document.getElementById('productor-auth-name-display');
      if (!authNameDisplay) return;
      if (userData) {
        const fullName = `${userData.first_name || ''} ${userData.last_name || ''}`.trim();
        authNameDisplay.textContent = fullName || userData.email || 'Sin nombre';
      } else {
        authNameDisplay.textContent = 'No hay sesión';
      }
    }

    function getCookie(name) {
      const match = document.cookie.match(new RegExp(`(?:^|; )${name}=([^;]*)`));
      return match ? decodeURIComponent(match[1]) : '';
    }

    // ===== Estado inicial =====
    if (userData) {
      if (fincaData && fincaData.id) {
        notify('✅ Información cargada correctamente', 'success');
      } else {
        notify('ℹ️ Completa los datos de la finca', 'info');
      }
      updateAuthNameDisplay();
    } else {
      const errorMsg = window.ERROR || '';
      if (errorMsg) {
        notify('❌ Error: ' + errorMsg, 'error');
      } else {
        notify('⚠️ No hay sesión activa o el token es inválido', 'error');
      }
      document.getElementById('productor-auth-name-display').textContent = 'No hay sesión';
    }

    // ===== Editar Productor =====
    if (editarProductorBtn) {
      editarProductorBtn.addEventListener('click', () => {
        document.querySelectorAll('#productor-nombre, #productor-cedula, #productor-organizacion, #productor-celular, #productor-edad').forEach(el => {
          el.removeAttribute('readonly');
          el.classList.remove('bg-surface');
          el.classList.add('bg-white');
        });
        document.getElementById('productor-genero')?.removeAttribute('disabled');
        document.getElementById('productor-nivel')?.removeAttribute('disabled');
        editarProductorBtn.classList.add('hidden');
        guardarProductorBtn?.classList.remove('hidden');
        cancelarProductorBtn?.classList.remove('hidden');
        notify('✏️ Modo edición activado', 'warning');
      });
    }

    if (cancelarProductorBtn) {
      cancelarProductorBtn.addEventListener('click', () => location.reload());
    }

    // ===== Guardar Productor =====
    if (guardarProductorBtn) {
      guardarProductorBtn.addEventListener('click', async () => {
        const nombreCompleto = document.getElementById('productor-nombre')?.value || '';
        const partes = nombreCompleto.trim().split(' ');
        const firstName = partes[0] || '';
        const lastName = partes.slice(1).join(' ') || '';
        
        const payload = {
          first_name: firstName,
          last_name: lastName,
          identifier: document.getElementById('productor-cedula')?.value || '',
          organizacion: document.getElementById('productor-organizacion')?.value || '',
          phone_number: document.getElementById('productor-celular')?.value || '',
          genero: document.getElementById('productor-genero')?.value || '',
          edad: parseInt(document.getElementById('productor-edad')?.value) || null,
          nivel_educativo: document.getElementById('productor-nivel')?.value || ''
        };

        console.log('📤 Payload (guardar productor):', payload);

        try {
          notify('⏳ Guardando cambios...', 'warning');
          const token = getCookie('token');
          
          const response = await fetch('/api/usuarios/update', {
            method: 'PUT',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify(payload)
          });

          if (response.ok) {
            const updated = await response.json();
            userData = updated;
            updateAuthNameDisplay();
            notify('✅ Productor actualizado correctamente', 'success');
            setTimeout(() => location.reload(), 1500);
          } else {
            const errorData = await response.json();
            notify('❌ Error: ' + (errorData.message || 'Error al actualizar'), 'error');
          }
        } catch (error) {
          notify('❌ Error al guardar los cambios', 'error');
        }
      });
    }

    // ===== Editar Finca (solo si existe) =====
    if (editarFincaBtn) {
      editarFincaBtn.addEventListener('click', () => {
        // Habilitar todos los campos de finca que estaban readonly/disabled
        const camposEditar = [
          'finca-nombre', 'finca-barrio', 'finca-area-cultivada',
          'finca-variedad', 'finca-densidad', 'finca-origen-semilla', 'finca-anio'
        ];
        camposEditar.forEach(id => {
          const el = document.getElementById(id);
          if (el) {
            el.removeAttribute('readonly');
            el.classList.remove('bg-surface');
            el.classList.add('bg-white');
          }
        });
        document.getElementById('finca-tenencia')?.removeAttribute('disabled');
        
        editarFincaBtn.classList.add('hidden');
        guardarFincaBtn?.classList.remove('hidden');
        cancelarFincaBtn?.classList.remove('hidden');
        notify('✏️ Modo edición de finca activado', 'warning');
      });
    }

    if (cancelarFincaBtn) {
      cancelarFincaBtn.addEventListener('click', () => location.reload());
    }

    // ===== Guardar Finca (FUNCIÓN EXPUESTA GLOBALMENTE) =====
    async function guardarFinca() {
      const nombre = document.getElementById('finca-nombre')?.value || '';
      const provincia = document.getElementById('finca-provincia')?.value || '';
      const canton = document.getElementById('finca-canton')?.value || '';
      const parroquia = document.getElementById('finca-parroquia')?.value || '';
      const sector = document.getElementById('finca-barrio')?.value || '';
      const areaTotal = parseFloat(document.getElementById('finca-area-total')?.value) || 0;
      const areaCultivada = parseFloat(document.getElementById('finca-area-cultivada')?.value) || 0;
      const tenencia = document.getElementById('finca-tenencia')?.value || 'PROPIA';
      const latitud = parseFloat(document.getElementById('finca-latitud')?.value) || null;
      const longitud = parseFloat(document.getElementById('finca-longitud')?.value) || null;
      
      const variedad_cafe = document.getElementById('finca-variedad')?.value || null;
      const densidad_siembra = document.getElementById('finca-densidad')?.value ? parseInt(document.getElementById('finca-densidad').value) : null;
      const origen_semilla = document.getElementById('finca-origen-semilla')?.value || null;
      const anio_establecimiento = document.getElementById('finca-anio')?.value ? parseInt(document.getElementById('finca-anio').value) : null;

      let poligono = null;
      if (window.POLIGONO_CARGADO) {
        poligono = window.POLIGONO_CARGADO;
      } else if (fincaData?.poligono) {
        poligono = fincaData.poligono;
      }

      const payload = {
        nombre,
        provincia,
        canton,
        parroquia: parroquia || undefined,
        sector: sector || undefined,
        area_total_ha: areaTotal,
        area_cultivada_ha: areaCultivada,
        tenencia,
        latitud,
        longitud,
        poligono,
        variedad_cafe,
        densidad_siembra,
        origen_semilla,
        anio_establecimiento
      };

      console.log('📤 Payload (guardar finca):', JSON.stringify(payload, null, 2));

      const fincaId = fincaData?.id;
      const token = getCookie('token');

      if (!usuarioId && !fincaId) {
        notify('❌ Error: ID de usuario no encontrado', 'error');
        return;
      }

      try {
        notify('⏳ Guardando finca...', 'warning');
        
        let result;
        if (fincaId) {
          result = await FincaService.update(fincaId, payload, token);
          notify('✅ Finca actualizada correctamente', 'success');
        } else {
          if (!usuarioId) throw new Error('No se encontró el ID del usuario.');
          payload.usuario_id = usuarioId;
          result = await FincaService.create(payload, token);
          notify('✅ Finca creada correctamente', 'success');
        }
        
        const newFincaId = result.id;
        if (newFincaId) {
          const irLink = document.getElementById('ir-info-agro');
          if (irLink) {
            irLink.href = `/infoAgro?finca_id=${newFincaId}`;
            irLink.classList.remove('cursor-not-allowed', 'opacity-60', 'bg-gray-300', 'text-gray-500');
            irLink.classList.add('bg-primary', 'text-white', 'shadow-sm');
            irLink.onclick = null;
          }
          fincaData = result;
        }
        setTimeout(() => location.reload(), 1500);
      } catch (error) {
        notify('❌ Error: ' + (error.message || 'Error al guardar finca'), 'error');
      }
    }

    // Exponer la función guardarFinca globalmente
    window.guardarFinca = guardarFinca;

    // Asignar eventos a los botones de guardar
    if (guardarFincaSubmit) {
      guardarFincaSubmit.addEventListener('click', guardarFinca);
    }
    if (guardarFincaBtn) {
      guardarFincaBtn.addEventListener('click', guardarFinca);
    }

    console.log('🔍 window.guardarFinca disponible:', typeof window.guardarFinca);
  });
</script>

