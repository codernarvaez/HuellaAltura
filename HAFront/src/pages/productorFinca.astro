---
import DashboardLayout from "../layouts/LayoutVariable.astro";
---

<DashboardLayout title="Productor y Finca">

<div class="space-y-8">

  <!-- HEADER -->
  <div class="flex flex-col md:flex-row justify-between gap-6">

    <div>
      <h1 class="text-3xl font-bold text-on-surface">
        Módulo 1: Información de Productor y Finca
      </h1>

      <p class="mt-2 text-on-surface-variant max-w-3xl">
        Formulario dinámico de recopilación de datos de origen requeridos por el reglamento EUDR.
      </p>
    </div>

    <button
      id="guardar-registro"
      class="flex items-center justify-center gap-2 px-6 h-12 bg-primary text-white rounded-xl shadow-sm hover:opacity-90 transition"
    >
      <span class="material-symbols-outlined">
        save
      </span>

      Guardar Registro
    </button>

  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-6 items-end">
    <div class="md:col-span-2">
      <label class="block mb-2 text-sm font-medium text-on-surface-variant">
        Seleccionar productor existente
      </label>
      <select id="productor-select" class="w-full h-14 px-4 rounded-xl border border-outline-variant bg-surface focus:outline-none focus:ring-2 focus:ring-primary">
        <option value="">Cargando productores...</option>
      </select>
    </div>

    <div class="text-right">
      <p id="productor-message" class="text-sm text-on-surface-variant"></p>
    </div>
  </div>

  <!-- PRODUCTOR -->
  <section
    class="bg-surface-container-low border border-outline-variant rounded-xl p-8 hover-lift"
  >

    <div class="flex items-center gap-3 border-b border-outline-variant pb-4 mb-6">

      <span class="material-symbols-outlined text-primary">
        person
      </span>

      <h2 class="text-xl font-semibold">
        Información del Productor
      </h2>

    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

      <div>
        <label class="block mb-2 text-sm font-medium text-on-surface-variant">
          Nombre Completo *
        </label>

        <input
          id="productor-nombre"
          type="text"
          value="José Miguel Mosquera"
          class="w-full h-14 px-4 bg-surface border border-outline-variant rounded-xl"
        />
      </div>

      <div>
        <label class="block mb-2 text-sm font-medium text-on-surface-variant">
          Cédula de Identidad / ID *
        </label>

        <input
          id="productor-cedula"
          type="text"
          value="1100433455"
          class="w-full h-14 px-4 bg-surface border border-outline-variant rounded-xl"
        />
      </div>

      <div>
        <label class="block mb-2 text-sm font-medium text-on-surface-variant">
          Organización / Asociación
        </label>

        <input
          id="productor-organizacion"
          type="text"
          value="Asociación Agroartesanal de Productores"
          class="w-full h-14 px-4 bg-surface border border-outline-variant rounded-xl"
        />
      </div>

      <div>
        <label class="block mb-2 text-sm font-medium text-on-surface-variant">
          Celular de Contacto
        </label>

        <input
          id="productor-celular"
          type="text"
          value="+5939532692"
          class="w-full h-14 px-4 bg-surface border border-outline-variant rounded-xl"
        />
      </div>

      <div>
        <label class="block mb-2 text-sm font-medium text-on-surface-variant">
          Género
        </label>

        <select
          id="productor-genero"
          class="w-full h-14 px-4 bg-surface border border-outline-variant rounded-xl"
        >
          <option value="Masculino">Masculino</option>
          <option value="Femenino">Femenino</option>
        </select>
      </div>

      <div>
        <label class="block mb-2 text-sm font-medium text-on-surface-variant">
          Edad
        </label>

        <input
          id="productor-edad"
          type="number"
          value="56"
          class="w-full h-14 px-4 bg-surface border border-outline-variant rounded-xl"
        />
      </div>

    </div>

  </section>

  <!-- FINCA -->
  <section
    class="bg-surface-container-low border border-outline-variant rounded-xl p-8 hover-lift"
  >

    <div class="flex items-center gap-3 border-b border-outline-variant pb-4 mb-6">

      <span class="material-symbols-outlined text-primary">
        agriculture
      </span>

      <h2 class="text-xl font-semibold">
        Información de la Finca Cafetalera / Agrícola
      </h2>

    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

      <div>
        <label class="block mb-2 text-sm font-medium text-on-surface-variant">
          Nombre de la Finca *
        </label>

        <input
          type="text"
          value="El Ahuacate"
          class="w-full h-14 px-4 bg-surface border border-outline-variant rounded-xl"
        />
      </div>

      <div>
        <label class="block mb-2 text-sm font-medium text-on-surface-variant">
          Código Único de Finca
        </label>

        <input
          type="text"
          readonly
          value="uuidv4-90234-89304"
          class="w-full h-14 px-4 bg-surface-container border border-outline-variant rounded-xl"
        />
      </div>

      <div>
        <label class="block mb-2 text-sm font-medium text-on-surface-variant">
          Provincia
        </label>

        <input
          type="text"
          value="Loja"
          class="w-full h-14 px-4 bg-surface border border-outline-variant rounded-xl"
        />
      </div>

      <div>
        <label class="block mb-2 text-sm font-medium text-on-surface-variant">
          Cantón
        </label>

        <input
          type="text"
          value="Loja"
          class="w-full h-14 px-4 bg-surface border border-outline-variant rounded-xl"
        />
      </div>

      <div>
        <label class="block mb-2 text-sm font-medium text-on-surface-variant">
          Parroquia
        </label>

        <input
          type="text"
          value="Vilcabamba"
          class="w-full h-14 px-4 bg-surface border border-outline-variant rounded-xl"
        />
      </div>

      <div>
        <label class="block mb-2 text-sm font-medium text-on-surface-variant">
          Barrio / Sector
        </label>

        <input
          type="text"
          value="Ullaguanga"
          class="w-full h-14 px-4 bg-surface border border-outline-variant rounded-xl"
        />
      </div>

      <div>
        <label class="block mb-2 text-sm font-medium text-on-surface-variant">
          Área Total (ha) *
        </label>

        <input
          type="number"
          value="3"
          class="w-full h-14 px-4 bg-surface border border-outline-variant rounded-xl"
        />
      </div>

      <div>
        <label class="block mb-2 text-sm font-medium text-on-surface-variant">
          Área Cultivada (ha)
        </label>

        <input
          type="number"
          value="3"
          class="w-full h-14 px-4 bg-surface border border-outline-variant rounded-xl"
        />
      </div>

      <div class="md:col-span-2">
        <label class="block mb-2 text-sm font-medium text-on-surface-variant">
          Tenencia de Tierra
        </label>

        <select
          class="w-full h-14 px-4 bg-surface border border-outline-variant rounded-xl"
        >
          <option>Propia con escritura</option>
          <option>Arrendada</option>
          <option>Posesión</option>
        </select>
      </div>

    </div>

    <!-- ALERTA -->
    <div
      class="mt-8 p-5 rounded-xl border border-primary bg-primary-container/10"
    >

      <div class="flex gap-3">

        <span class="material-symbols-outlined text-primary">
          info
        </span>

        <p class="text-sm text-on-surface">
          El área es de 3 ha (menor a 4 ha). El reglamento EUDR permite
          registrar únicamente un punto central de coordenadas geográficas
          para cumplir con el estándar.
        </p>

      </div>

    </div>

  </section>

  <!-- SIGUIENTE PASO -->
  <section
    class="bg-surface-container-low border border-outline-variant rounded-xl p-6"
  >

    <p class="text-xs uppercase tracking-wider text-on-surface-variant mb-2">
      Próximo Paso
    </p>

    <p class="text-on-surface mb-4">
      Cargar el mapa de la finca para completar el registro.
    </p>

    <button
      class="flex items-center gap-2 text-primary font-semibold hover:underline"
    >
      Ir al mapeo de campos dinámicos

      <span class="material-symbols-outlined">
        arrow_forward
      </span>
    </button>

  </section>

</div>

</DashboardLayout>

<script type="module">
import { ProductorService } from "/src/services/productorServices.ts";

  const selectProductor = document.getElementById("productor-select");
  const message = document.getElementById("productor-message");
  const buttonGuardar = document.getElementById("guardar-registro");

  const inputNombre = document.getElementById("productor-nombre");
  const inputCedula = document.getElementById("productor-cedula");
  const inputOrganizacion = document.getElementById("productor-organizacion");
  const inputCelular = document.getElementById("productor-celular");
  const selectGenero = document.getElementById("productor-genero");
  const inputEdad = document.getElementById("productor-edad");

  function getCookie(name) {
    const match = document.cookie.match(new RegExp(`(?:^|; )${name}=([^;]*)`));
    return match ? decodeURIComponent(match[1]) : "";
  }

  const token = getCookie("token");

  function showMessage(text, isError = false) {
    if (!message) return;
    message.textContent = text;
    message.classList.remove("text-error", "text-success");
    message.classList.add(isError ? "text-error" : "text-success");
  }

  async function cargarProductores() {
    if (!selectProductor) return;
    selectProductor.innerHTML = `<option value="">Cargando productores...</option>`;
    try {
      const productores = await ProductorService.list(token);
      if (productores.length === 0) {
        selectProductor.innerHTML = `<option value="">No hay productores registrados</option>`;
        return;
      }
      selectProductor.innerHTML = `
        <option value="">Selecciona un productor</option>
        ${productores
          .map(
            (productor) => `
              <option value="${productor.id}">${productor.nombre_completo} — ${productor.cedula_id}</option>
            `
          )
          .join("")}
      `;
      showMessage("Productores cargados correctamente.");
    } catch (error) {
      selectProductor.innerHTML = `<option value="">Error al cargar productores</option>`;
      showMessage(error instanceof Error ? error.message : "Error al cargar productores.", true);
    }
  }

  async function cargarProductor(productorId) {
    if (!productorId) return;
    try {
      const productor = await ProductorService.getById(productorId, token);
      if (inputNombre) inputNombre.value = productor.nombre_completo || "";
      if (inputCedula) inputCedula.value = productor.cedula_id || "";
      if (inputOrganizacion) inputOrganizacion.value = productor.organizacion || "";
      if (inputCelular) inputCelular.value = productor.celular || "";
      if (selectGenero) selectGenero.value = productor.genero || "Masculino";
      if (inputEdad) inputEdad.value = productor.edad?.toString() || "";
      showMessage("Productor cargado correctamente.");
    } catch (error) {
      showMessage(error instanceof Error ? error.message : "Error al obtener productor.", true);
    }
  }

  async function guardarProductor() {
    if (!inputNombre || !inputCedula) {
      showMessage("Nombre y cédula son obligatorios.", true);
      return;
    }

    const payload = {
      nombre_completo: inputNombre.value.trim(),
      cedula_id: inputCedula.value.trim(),
      organizacion: inputOrganizacion?.value.trim() || "",
      celular: inputCelular?.value.trim() || "",
      genero: selectGenero?.value || "",
      edad: inputEdad?.value ? Number(inputEdad.value) : undefined,
    };

    try {
      await ProductorService.create(payload, token);
      showMessage("Productor guardado correctamente.");
      cargarProductores();
    } catch (error) {
      showMessage(error instanceof Error ? error.message : "Error al guardar productor.", true);
    }
  }

  if (selectProductor) {
    selectProductor.addEventListener("change", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLSelectElement)) return;
      if (target.value) {
        cargarProductor(target.value);
      }
    });
  }

  if (buttonGuardar) {
    buttonGuardar.addEventListener("click", guardarProductor);
  }

  cargarProductores();
</script>