            placeholder="Ej: 2020"
            class="w-full h-14 px-4 bg-surface border border-outline-variant rounded-xl"
          />
          {!fincaData?.anio_establecimiento && <span class="null-badge text-xs">No registrado</span>}
        </div>

        <!-- Botón Guardar Finca (SIEMPRE VISIBLE) -->
        <div class="md:col-span-2 flex justify-end gap-3 pt-4 border-t border-outline-variant">
          <button
            id="guardar-finca-submit"
            class="px-6 py-3 bg-primary text-white rounded-xl font-medium hover:opacity-90 transition flex items-center gap-2"
          >
            <span class="material-symbols-outlined text-sm">save</span>
            Guardar Finca
          </button>
        </div>
      </div>
    </div>

    <!-- MAPA DE LA FINCA -->
    <div class="mt-8">
      <div class="flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-primary">map</span>
        <h3 class="text-lg font-semibold text-on-surface">Ubicación de la Finca</h3>
        {fincaData?.poligono && (
          <span class="ml-auto text-sm">
            <span class="inline-flex items-center gap-1 bg-primary/10 text-primary px-3 py-1 rounded-full text-xs">
              <span class="material-symbols-outlined text-sm">check_circle</span>
              Polígono cargado
            </span>
          </span>
        )}
      </div>
      <div id="map"></div>
      <p class="text-xs text-on-surface-variant mt-2">
        {fincaData?.poligono 
          ? '✅ El polígono de la finca se muestra en el mapa.'
          : 'ℹ️ No hay un polígono registrado. Carga un archivo GPX/KML/GeoJSON para agregarlo.'}
      </p>
    </div>
  </section>

  <!-- SIGUIENTE PASO -->
  <section class="bg-surface-container-low border border-outline-variant rounded-xl p-6">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
      <div>
        <p class="text-xs uppercase tracking-wider text-on-surface-variant mb-1">Siguiente Paso</p>
        <p class="text-on-surface font-medium">
          {fincaId 
            ? 'Continúa con la información agroambiental de la finca.' 
            : 'Guarda la información de la finca para continuar.'}
        </p>
        {!fincaId && (
          <p class="text-sm text-warning mt-1">⚠️ Guarda la finca primero para continuar.</p>
        )}
      </div>
      
      <a 
        id="ir-info-agro"
        href={fincaId ? `/infoAgro?finca_id=${fincaId}` : '#'}
        class={fincaId 
          ? 'flex items-center gap-2 px-6 py-3 bg-primary text-white rounded-xl font-semibold hover:opacity-90 transition shadow-sm' 
          : 'flex items-center gap-2 px-6 py-3 bg-gray-300 text-gray-500 rounded-xl font-semibold cursor-not-allowed opacity-60'}
        onclick={!fincaId ? "event.preventDefault(); alert('⚠️ Primero debes guardar la información de la finca.');" : ''}
