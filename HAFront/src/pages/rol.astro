---
import DashboardLayout from "../layouts/LayoutVariable.astro";
---

<DashboardLayout title="Gestión de Roles">

  <div class="space-y-8">

    <!-- HEADER -->
    <section class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">

      <div>
        <h1 class="text-3xl font-bold text-primary">
          Gestión de Roles
        </h1>

        <p class="text-on-surface-variant mt-2 max-w-3xl">
          Define y administra los niveles de acceso para el personal de
          Huella de Altura.
        </p>
      </div>

      <button
        id="new-role-button"
        class="bg-primary text-white px-5 py-3 rounded-xl flex items-center gap-2 hover:opacity-90 transition"
        type="button"
      >
        <span class="material-symbols-outlined">
          add
        </span>

        Crear Nuevo Rol
      </button>

      <!-- Panel Crear Rol -->
      <div id="new-role-overlay" class="fixed inset-0 z-40 hidden bg-black/40"></div>
      <div id="new-role-panel" class="fixed inset-y-0 right-0 z-50 hidden w-full max-w-md overflow-auto border-l border-outline-variant bg-surface p-6 shadow-2xl transition-transform duration-300 transform translate-x-full">
        <div class="flex items-center justify-between gap-4 mb-6">
          <div>
            <h2 id="role-panel-title" class="text-2xl font-semibold text-on-surface">Crear nuevo rol</h2>
            <p id="role-panel-subtitle" class="text-on-surface-variant mt-1 text-sm">Agrega un nivel de acceso nuevo para el sistema.</p>
          </div>
          <button id="close-role-panel" type="button" class="text-on-surface-variant hover:text-on-surface">
            <span class="material-symbols-outlined">close</span>
          </button>
        </div>

        <form id="role-form" class="grid gap-4">
          <input type="hidden" id="role-id" value="" />
          
          <label class="block">
            <span class="text-sm text-on-surface-variant">Nombre del rol *</span>
            <input id="role-name" type="text" required class="mt-2 w-full rounded-xl border border-outline-variant bg-surface px-4 py-3 focus:outline-none focus:ring-2 focus:ring-primary" />
          </label>

          <label class="block">
            <span class="text-sm text-on-surface-variant">Descripción</span>
            <textarea id="role-description" rows="4" class="mt-2 w-full rounded-xl border border-outline-variant bg-surface px-4 py-3 focus:outline-none focus:ring-2 focus:ring-primary"></textarea>
          </label>

          <p id="role-form-message" class="text-sm hidden"></p>

          <div class="flex flex-col gap-3 pt-3 border-t border-outline-variant md:flex-row md:justify-between">
            <button id="cancel-role-button" type="button" class="w-full md:w-auto px-6 py-3 rounded-xl border border-outline-variant hover:bg-surface-container-high transition">Cancelar</button>
            <button id="submit-role-button" type="submit" class="w-full md:w-auto bg-primary text-white px-6 py-3 rounded-xl font-medium hover:opacity-90 transition">Guardar rol</button>
          </div>
        </form>
      </div>

      <!-- Panel Confirmar Eliminación -->
      <div id="delete-role-overlay" class="fixed inset-0 z-50 hidden bg-black/50"></div>
      <div id="delete-role-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4">
        <div class="bg-surface rounded-2xl max-w-md w-full p-6 shadow-2xl">
          <div class="flex items-center gap-3 text-error mb-4">
            <span class="material-symbols-outlined text-3xl">warning</span>
            <h3 class="text-xl font-semibold">Eliminar Rol</h3>
          </div>
          <p class="text-on-surface-variant mb-2">
            ¿Estás seguro de que deseas eliminar el rol <strong id="delete-role-name"></strong>?
          </p>
          <p class="text-sm text-on-surface-variant mb-6">
            Esta acción no se puede deshacer. Los usuarios con este rol perderán sus permisos.
          </p>
          <input type="hidden" id="delete-role-id" value="" />
          <div class="flex flex-col md:flex-row gap-3 md:justify-end">
            <button id="cancel-delete-button" type="button" class="px-6 py-3 rounded-xl border border-outline-variant hover:bg-surface-container-high transition">Cancelar</button>
            <button id="confirm-delete-button" type="button" class="px-6 py-3 rounded-xl bg-error text-white font-medium hover:bg-error/90 transition">Eliminar</button>
          </div>
        </div>
      </div>

    </section>

    <!-- ESTADISTICAS -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-6">

      <div class="lg:col-span-8 bg-white border border-outline-variant rounded-xl p-6 shadow-sm relative overflow-hidden">
        <div class="relative z-10">
          <p class="text-xs uppercase tracking-wider text-on-surface-variant">Total de Roles Activos</p>
          <h2 id="total-roles-count" class="text-5xl font-bold text-primary mt-2">0</h2>
          <div class="flex items-center gap-2 mt-3 text-secondary">
            <span class="material-symbols-outlined text-base">trending_up</span>
            <span class="text-sm">Roles disponibles en el sistema</span>
          </div>
        </div>
        <span class="material-symbols-outlined absolute -right-8 -bottom-8 text-[180px] opacity-5 text-primary">verified_user</span>
      </div>

      <div class="lg:col-span-4 bg-primary text-white rounded-xl p-6 shadow-sm">
        <p class="text-xs uppercase tracking-wider opacity-80">Información</p>
        <h3 class="text-xl font-semibold mt-2">Gestión de Roles</h3>
        <p class="mt-3 text-sm opacity-90">
          Cada rol define los permisos y accesos de los usuarios en la plataforma.
        </p>
      </div>

    </section>

    <!-- LISTA DE ROLES DINÁMICA -->
    <section class="bg-surface-container-low border border-outline-variant rounded-xl overflow-hidden">
      <div class="p-6 border-b border-outline-variant flex flex-col lg:flex-row gap-4 lg:items-center lg:justify-between">
        <div>
          <p class="text-xs uppercase tracking-wider text-on-surface-variant">Roles registrados</p>
          <h2 class="text-2xl font-semibold">Lista de roles</h2>
        </div>

        <div class="flex flex-col sm:flex-row items-center gap-3">
          <div class="relative w-full sm:w-[320px]">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant">search</span>
            <input
              id="roles-search"
              type="text"
              placeholder="Buscar rol o descripción..."
              class="w-full pl-10 pr-4 h-12 rounded-xl border border-outline-variant bg-white focus:ring-2 focus:ring-primary focus:outline-none"
            />
          </div>
          <button id="refresh-roles-button" type="button" class="h-12 w-12 rounded-xl border border-outline-variant hover:bg-surface-container-high transition">
            <span class="material-symbols-outlined">refresh</span>
          </button>
        </div>
      </div>

      <div id="roles-card-grid" class="p-6 grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
        <div class="col-span-full p-6 text-center text-on-surface-variant" id="roles-loading">
          Cargando roles...
        </div>
      </div>

      <div class="p-4 border-t border-outline-variant flex items-center justify-between">
        <p id="roles-total-text" class="text-sm text-on-surface-variant">Mostrando 0 roles</p>
        <p id="roles-filtered-text" class="text-sm text-on-surface-variant hidden"></p>
      </div>
    </section>

  </div>

</DashboardLayout>

<script type="module">
  import { RoleService } from "/src/services/rol.service.ts";

  // ============================================================
  // DOM ELEMENTS
  // ============================================================
  
  const newRoleButton = document.getElementById("new-role-button");
  const newRoleOverlay = document.getElementById("new-role-overlay");
  const newRolePanel = document.getElementById("new-role-panel");
  const closeRolePanel = document.getElementById("close-role-panel");
  const cancelRoleButton = document.getElementById("cancel-role-button");
  const roleForm = document.getElementById("role-form");
  const roleIdInput = document.getElementById("role-id");
  const roleNameInput = document.getElementById("role-name");
  const roleDescriptionInput = document.getElementById("role-description");
  const roleFormMessage = document.getElementById("role-form-message");
  const rolePanelTitle = document.getElementById("role-panel-title");
  const rolePanelSubtitle = document.getElementById("role-panel-subtitle");
  const submitRoleButton = document.getElementById("submit-role-button");
  
  const rolesCardGrid = document.getElementById("roles-card-grid");
  const rolesTotalText = document.getElementById("roles-total-text");
  const rolesFilteredText = document.getElementById("roles-filtered-text");
  const rolesSearchInput = document.getElementById("roles-search");
  const refreshRolesButton = document.getElementById("refresh-roles-button");
  const totalRolesCount = document.getElementById("total-roles-count");

  // Delete modal
  const deleteOverlay = document.getElementById("delete-role-overlay");
  const deleteModal = document.getElementById("delete-role-modal");
  const deleteRoleId = document.getElementById("delete-role-id");
  const deleteRoleName = document.getElementById("delete-role-name");
  const cancelDeleteButton = document.getElementById("cancel-delete-button");
  const confirmDeleteButton = document.getElementById("confirm-delete-button");

  // ============================================================
  // UTILITIES
  // ============================================================

  function getCookie(name) {
    const match = document.cookie.match(new RegExp(`(?:^|; )${name}=([^;]*)`));
    return match ? decodeURIComponent(match[1]) : "";
  }

  const token = getCookie("token");
  let cachedRoles = [];
  let editingRoleId = null;

  function showFormMessage(text, isError = false) {
    if (!roleFormMessage) return;
    roleFormMessage.textContent = text;
    roleFormMessage.classList.remove("hidden", "text-error", "text-success");
    roleFormMessage.classList.add(isError ? "text-error" : "text-success");
  }

  function hideFormMessage() {
    if (roleFormMessage) {
      roleFormMessage.textContent = "";
      roleFormMessage.classList.add("hidden");
    }
  }

  // ============================================================
  // PANEL OPEN/CLOSE
  // ============================================================

  function openNewRolePanel() {
    editingRoleId = null;
    roleIdInput.value = "";
    roleNameInput.value = "";
    roleDescriptionInput.value = "";
    rolePanelTitle.textContent = "Crear nuevo rol";
    rolePanelSubtitle.textContent = "Agrega un nivel de acceso nuevo para el sistema.";
    submitRoleButton.textContent = "Guardar rol";
    hideFormMessage();
    
    if (newRoleOverlay) newRoleOverlay.classList.remove("hidden");
    if (newRolePanel) {
      newRolePanel.classList.remove("hidden", "translate-x-full");
      newRolePanel.classList.add("translate-x-0");
    }
  }

  function openEditRolePanel(role) {
    editingRoleId = role.id;
    roleIdInput.value = role.id;
    roleNameInput.value = role.name;
    roleDescriptionInput.value = role.description || "";
    rolePanelTitle.textContent = "Editar rol";
    rolePanelSubtitle.textContent = "Modifica los datos del rol seleccionado.";
    submitRoleButton.textContent = "Actualizar rol";
    hideFormMessage();
    
    if (newRoleOverlay) newRoleOverlay.classList.remove("hidden");
    if (newRolePanel) {
      newRolePanel.classList.remove("hidden", "translate-x-full");
      newRolePanel.classList.add("translate-x-0");
    }
  }

  function closeNewRolePanel() {
    if (newRolePanel) {
      newRolePanel.classList.add("translate-x-full");
      newRolePanel.classList.remove("translate-x-0");
      setTimeout(() => {
        newRolePanel.classList.add("hidden");
      }, 300);
    }
    if (newRoleOverlay) newRoleOverlay.classList.add("hidden");
    if (roleForm) roleForm.reset();
    hideFormMessage();
    editingRoleId = null;
  }

  // ============================================================
  // DELETE MODAL
  // ============================================================

  function openDeleteModal(role) {
    deleteRoleId.value = role.id;
    deleteRoleName.textContent = role.name;
    if (deleteOverlay) deleteOverlay.classList.remove("hidden");
    if (deleteModal) deleteModal.classList.remove("hidden");
  }

  function closeDeleteModal() {
    if (deleteOverlay) deleteOverlay.classList.add("hidden");
    if (deleteModal) deleteModal.classList.add("hidden");
    deleteRoleId.value = "";
    deleteRoleName.textContent = "";
  }

  // ============================================================
  // RENDER ROLES
  // ============================================================

  function renderRoles(roles) {
    if (!rolesCardGrid || !rolesTotalText) return;

    if (!roles.length) {
      rolesCardGrid.innerHTML = `
        <div class="col-span-full p-6 text-center text-on-surface-variant">
          No se encontraron roles.
        </div>
      `;
      rolesTotalText.textContent = `Mostrando 0 roles`;
      if (rolesFilteredText) rolesFilteredText.classList.add("hidden");
      if (totalRolesCount) totalRolesCount.textContent = "0";
      return;
    }

    const totalRoles = cachedRoles.length;
    if (totalRolesCount) totalRolesCount.textContent = totalRoles.toString();

    rolesCardGrid.innerHTML = roles
      .map((role) => `
        <div class="bg-white border border-outline-variant rounded-3xl p-6 shadow-sm hover:shadow-md transition">
          <div class="flex items-start justify-between gap-4 mb-4">
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-primary/10 text-primary text-2xl font-semibold">
              ${role.name.charAt(0).toUpperCase()}
            </div>
            <div class="flex gap-2">
              <button class="h-10 w-10 rounded-lg border border-outline-variant hover:bg-primary/10 text-primary transition" type="button" data-role-id="${role.id}" data-action="edit">
                <span class="material-symbols-outlined text-base">edit</span>
              </button>
              <button class="h-10 w-10 rounded-lg border border-outline-variant hover:bg-error/10 text-error transition" type="button" data-role-id="${role.id}" data-action="delete">
                <span class="material-symbols-outlined text-base">delete</span>
              </button>
            </div>
          </div>
          <h3 class="text-xl font-semibold mb-2 text-on-surface">${role.name}</h3>
          <p class="text-sm text-on-surface-variant mb-5">${role.description || "Sin descripción"}</p>
          <div class="flex flex-wrap items-center gap-2">
            <span class="rounded-full bg-surface-container px-3 py-1 text-xs uppercase tracking-[0.08em] text-on-surface-variant">ID</span>
            <span class="font-mono text-xs text-on-surface-variant break-all">${role.id}</span>
          </div>
        </div>
      `)
      .join("");

    rolesTotalText.textContent = `Mostrando ${roles.length} roles`;
    
    if (rolesFilteredText) {
      if (roles.length < cachedRoles.length) {
        rolesFilteredText.classList.remove("hidden");
        rolesFilteredText.textContent = `(Filtrados de ${cachedRoles.length} totales)`;
      } else {
        rolesFilteredText.classList.add("hidden");
      }
    }
  }

  function filterRoles(roles) {
    const query = rolesSearchInput?.value.toLowerCase().trim() || "";
    if (!query) return roles;

    return roles.filter((role) => {
      return (
        role.name.toLowerCase().includes(query) ||
        (role.description || "").toLowerCase().includes(query) ||
        role.id.toLowerCase().includes(query)
      );
    });
  }

  // ============================================================
  // LOAD ROLES
  // ============================================================

  async function loadRoles() {
    if (rolesCardGrid) {
      rolesCardGrid.innerHTML = `
        <div class="col-span-full p-6 text-center text-on-surface-variant">Cargando roles...</div>
      `;
    }

    try {
      cachedRoles = await RoleService.list(token);
      renderRoles(filterRoles(cachedRoles));
      return cachedRoles;
    } catch (error) {
      if (rolesCardGrid) {
        rolesCardGrid.innerHTML = `
          <div class="col-span-full p-6 text-center text-error">${error instanceof Error ? error.message : "Error al cargar roles."}</div>
        `;
      }
      return [];
    }
  }

  // ============================================================
  // EVENT LISTENERS - PANEL
  // ============================================================

  if (newRoleButton) newRoleButton.addEventListener("click", openNewRolePanel);
  if (newRoleOverlay) newRoleOverlay.addEventListener("click", closeNewRolePanel);
  if (closeRolePanel) closeRolePanel.addEventListener("click", closeNewRolePanel);
  if (cancelRoleButton) cancelRoleButton.addEventListener("click", closeNewRolePanel);

  // ============================================================
  // EVENT LISTENERS - DELETE MODAL
  // ============================================================

  if (cancelDeleteButton) cancelDeleteButton.addEventListener("click", closeDeleteModal);
  if (deleteOverlay) deleteOverlay.addEventListener("click", closeDeleteModal);

  if (confirmDeleteButton) {
    confirmDeleteButton.addEventListener("click", async () => {
      const roleId = deleteRoleId.value;
      if (!roleId) return;

      try {
        confirmDeleteButton.disabled = true;
        confirmDeleteButton.textContent = "Eliminando...";
        
        await RoleService.delete(roleId, token);
        await loadRoles();
        closeDeleteModal();
        showFormMessage("Rol eliminado correctamente.");
        setTimeout(hideFormMessage, 3000);
      } catch (error) {
        showFormMessage(error instanceof Error ? error.message : "Error al eliminar rol.", true);
      } finally {
        confirmDeleteButton.disabled = false;
        confirmDeleteButton.textContent = "Eliminar";
      }
    });
  }

  // ============================================================
  // EVENT LISTENERS - FORM SUBMIT
  // ============================================================

  if (roleForm) {
    roleForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      
      const name = roleNameInput?.value.trim();
      const description = roleDescriptionInput?.value.trim();

      if (!name) {
        showFormMessage("El nombre del rol es obligatorio.", true);
        return;
      }

      try {
        submitRoleButton.disabled = true;
        submitRoleButton.textContent = "Guardando...";
        hideFormMessage();

        if (editingRoleId) {
          // UPDATE
          await RoleService.update(editingRoleId, { name, description: description || undefined }, token);
          showFormMessage("Rol actualizado correctamente.");
        } else {
          // CREATE
          await RoleService.create({ name, description: description || undefined }, token);
          showFormMessage("Rol creado correctamente.");
        }

        await loadRoles();
        setTimeout(() => {
          closeNewRolePanel();
          submitRoleButton.disabled = false;
          submitRoleButton.textContent = editingRoleId ? "Actualizar rol" : "Guardar rol";
        }, 1200);
        
      } catch (error) {
        showFormMessage(error instanceof Error ? error.message : "Error al guardar rol.", true);
        submitRoleButton.disabled = false;
        submitRoleButton.textContent = editingRoleId ? "Actualizar rol" : "Guardar rol";
      }
    });
  }

  // ============================================================
  // EVENT LISTENERS - SEARCH & REFRESH
  // ============================================================

  if (rolesSearchInput) {
    rolesSearchInput.addEventListener("input", () => {
      renderRoles(filterRoles(cachedRoles));
    });
  }

  if (refreshRolesButton) {
    refreshRolesButton.addEventListener("click", async () => {
      await loadRoles();
    });
  }

  // ============================================================
  // EVENT LISTENERS - ACTION BUTTONS (Edit/Delete)
  // ============================================================

  document.addEventListener("click", async (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;
    const button = target.closest("button[data-action]");
    if (!button) return;

    const roleId = button.getAttribute("data-role-id");
    const action = button.getAttribute("data-action");
    if (!roleId || !action) return;

    const role = cachedRoles.find(r => r.id === roleId);
    if (!role) return;

    if (action === "edit") {
      openEditRolePanel(role);
    }

    if (action === "delete") {
      openDeleteModal(role);
    }
  });

  // ============================================================
  // KEYBOARD SHORTCUTS
  // ============================================================

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      if (!deleteModal?.classList.contains("hidden")) {
        closeDeleteModal();
      }
      if (!newRolePanel?.classList.contains("hidden")) {
        closeNewRolePanel();
      }
    }
  });

  // ============================================================
  // INIT
  // ============================================================

  loadRoles();
</script>