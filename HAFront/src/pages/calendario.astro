<script is:inline src="https://unpkg.com/lucide@latest"></script>

<!-- 🔥 SCRIPTS CON DATOS -->
<script define:vars={{ 
    fincaId: fincaIdStr, 
    meses, 
    tiposProceso, 
    actividadesPorMes,
    calendarioData: calendarioDataStr,
    userData: userDataStr,
    userRole: userRoleStr,
    puedeValidar: puedeValidarStr,
    puedeAprobar: puedeAprobarStr,
    fincasDisponibles: fincasDisponiblesStr,
    esAdmin: esAdminStr,
    API_URL: 'https://geoguard-exped.onrender.com'
}}>
    console.log("🏠 Finca ID:", fincaId);
    console.log("📋 Calendario Data:", calendarioData);
    console.log("🎭 User Role:", userRole);
    console.log("👑 Es Admin:", esAdmin);
    console.log("✅ Puede Validar:", puedeValidar);
    console.log("✅ Puede Aprobar:", puedeAprobar);
    console.log("📋 Fincas Disponibles:", fincasDisponibles);

    // ============================================================
    // DATOS QUEMADOS DEL EXCEL (solo para el combobox)
    // ============================================================
    const actividadesData = actividadesPorMes;

    function getActividadesByMes(mes) {
        return actividadesData[mes] || [];
    }

    function getEtapaByActividad(mes, actividad) {
        const actividades = getActividadesByMes(mes);
        const found = actividades.find(a => a.actividad === actividad);
        return found ? found.etapa : '';
    }

    // ============================================================
    // FUNCIONES GENERALES
    // ============================================================

    function getCookie(name) {
        const match = document.cookie.match(new RegExp(`(?:^|; )${name}=([^;]*)`));
        return match ? decodeURIComponent(match[1]) : "";
    }

    // ============================================================
    // MODAL CREAR LABOR
    // ============================================================

    function toggleModalCrear(show) {
        const modal = document.getElementById('modal-nueva-labor');
        if (show) {
            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
            document.getElementById('form-nueva-labor').reset();
            document.getElementById('labor-error').classList.add('hidden');
            document.getElementById('actividad-descripcion').classList.add('hidden');
            actualizarActividades();
        } else {
            modal.classList.add('hidden');
            document.body.style.overflow = '';
        }
    }

    function actualizarActividades() {
        const mesSelect = document.getElementById('labor-mes');
        const actividadSelect = document.getElementById('labor-nombre');
        const tipoSelect = document.getElementById('labor-tipo');
        const descripcionDiv = document.getElementById('actividad-descripcion');
        const descripcionTexto = document.getElementById('actividad-descripcion-texto');

        const mesSeleccionado = mesSelect.value;
        
        actividadSelect.innerHTML = '<option value="">Selecciona una actividad</option>';
        tipoSelect.value = '';
        descripcionDiv.classList.add('hidden');

        if (!mesSeleccionado) return;

        const actividades = getActividadesByMes(mesSeleccionado);
        
        if (actividades.length === 0) {
            actividadSelect.innerHTML = '<option value="">No hay actividades para este mes</option>';
            return;
        }

        actividades.forEach((item) => {
            const option = document.createElement('option');
            option.value = item.actividad;
            option.textContent = item.actividad;
            option.dataset.etapa = item.etapa;
            actividadSelect.appendChild(option);
        });
    }

    function actualizarEtapa() {
        const mesSelect = document.getElementById('labor-mes');
        const actividadSelect = document.getElementById('labor-nombre');
        const tipoSelect = document.getElementById('labor-tipo');
        const descripcionDiv = document.getElementById('actividad-descripcion');
        const descripcionTexto = document.getElementById('actividad-descripcion-texto');

        const mes = mesSelect.value;
        const actividad = actividadSelect.value;

        if (!mes || !actividad) {
            tipoSelect.value = '';
            descripcionDiv.classList.add('hidden');
            return;
        }

        const etapa = getEtapaByActividad(mes, actividad);
        if (etapa) {
            tipoSelect.value = etapa;
            descripcionTexto.textContent = `Etapa: ${etapa}`;
            descripcionDiv.classList.remove('hidden');
        } else {
            tipoSelect.value = '';
            descripcionDiv.classList.add('hidden');
        }

        if (window.lucide) window.lucide.createIcons();
    }

    // ============================================================
    // MODAL EJECUTAR LABOR
    // ============================================================

    let laborSeleccionada = null;

    function toggleModalEjecutar(show, laborData = null) {
        const modal = document.getElementById('modal-ejecutar-labor');
        if (show) {
            if (laborData) {
                laborSeleccionada = laborData;
                document.getElementById('ejecucion-labor-id').value = laborData.labor_id;
                document.getElementById('ejecucion-labor-nombre').value = laborData.nombre || '';
                document.getElementById('ejecucion-labor-mes').value = laborData.mes || '';
                document.getElementById('ejecucion-labor-mes-hidden').value = laborData.mes || '';
                
                // Resetear campos
                document.getElementById('ejecucion-detalle').value = '';
                document.getElementById('ejecucion-persona').value = '';
                document.getElementById('ejecucion-jornalero').value = '';
                document.getElementById('ejecucion-salario').value = '';
                
                // Resetear insumos y herramientas
                document.getElementById('insumos-container').innerHTML = `
                    <div class="flex gap-2">
                        <input type="text" placeholder="Nombre del insumo" class="insumo-nombre flex-1 h-10 px-3 border border-slate-200 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:outline-none transition text-sm" />
                        <input type="number" step="0.01" placeholder="Cantidad" class="insumo-cantidad w-24 h-10 px-3 border border-slate-200 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:outline-none transition text-sm" />
                        <input type="text" placeholder="Unidad" class="insumo-unidad w-20 h-10 px-3 border border-slate-200 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:outline-none transition text-sm" />
                        <button type="button" class="btn-eliminar-insumo text-red-500 hover:text-red-700 px-2">
                            <i data-lucide="x" class="w-4 h-4"></i>
                        </button>
                    </div>
                `;
                document.getElementById('herramientas-container').innerHTML = `
                    <div class="flex gap-2">
                        <input type="text" placeholder="Nombre de la herramienta" class="herramienta-nombre flex-1 h-10 px-3 border border-slate-200 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:outline-none transition text-sm" />
                        <button type="button" class="btn-eliminar-herramienta text-red-500 hover:text-red-700 px-2">
                            <i data-lucide="x" class="w-4 h-4"></i>
                        </button>
                    </div>
                `;
                document.getElementById('foto-preview').classList.add('hidden');
                document.getElementById('ejecucion-foto').value = '';
            }
            
            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
            
            if (window.lucide) window.lucide.createIcons();
            
            agregarEventListenersInsumos();
            agregarEventListenersHerramientas();
        } else {
            modal.classList.add('hidden');
            document.body.style.overflow = '';
        }
    }

    // ============================================================
    // INSUMOS Y HERRAMIENTAS DINÁMICOS
    // ============================================================

    function agregarEventListenersInsumos() {
        document.querySelectorAll('.btn-eliminar-insumo').forEach(btn => {
            btn.removeEventListener('click', eliminarInsumo);
            btn.addEventListener('click', eliminarInsumo);
        });
    }

    function eliminarInsumo(e) {
        const container = document.getElementById('insumos-container');
        if (container.children.length > 1) {
            e.target.closest('.flex').remove();
        }
    }

    function agregarEventListenersHerramientas() {
        document.querySelectorAll('.btn-eliminar-herramienta').forEach(btn => {
            btn.removeEventListener('click', eliminarHerramienta);
            btn.addEventListener('click', eliminarHerramienta);
        });
    }

    function eliminarHerramienta(e) {
        const container = document.getElementById('herramientas-container');
        if (container.children.length > 1) {
            e.target.closest('.flex').remove();
        }
    }

    // ============================================================
    // 🔥 RENDERIZAR MATRIZ ANUAL CON BOTONES DE VALIDACIÓN
    // ============================================================

    function renderMatrizAnual() {
        const nombresMeses = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];

        let calendario = null;
        try {
            if (calendarioData && calendarioData !== 'null') {
                calendario = typeof calendarioData === 'string' ? JSON.parse(calendarioData) : calendarioData;
            }
        } catch (e) {
            console.warn("⚠️ Error parseando calendarioData:", e);
        }

        const laboresPorMes = {};
        if (calendario && calendario.calendario) {
            calendario.calendario.forEach(mesData => {
                laboresPorMes[mesData.mes] = mesData.labores || [];
            });
        }

        for (let m = 0; m < 12; m++) {
            const nombreMes = nombresMeses[m];
            const contenedorMes = document.querySelector(`[data-mes="${nombreMes}"]`);
            if (!contenedorMes) continue;

            contenedorMes.innerHTML = '';

            const labores = laboresPorMes[nombreMes] || [];

            if (labores.length === 0) {
                contenedorMes.innerHTML = `
                    <div class="border border-dashed border-slate-200 rounded-xl h-full flex flex-col items-center justify-center bg-white/40 p-4 text-center">
                        <div class="text-slate-300 mb-1">
                            <i data-lucide="calendar-x" class="w-5 h-5"></i>
                        </div>
                        <p class="text-[11px] font-bold text-slate-700">Sin labores programadas</p>
                        <p class="text-[10px] text-slate-400 mt-0.5 max-w-[150px] leading-tight">No hay labores registradas para este mes.</p>
                    </div>
                `;
                continue;
            }

            labores.forEach((labor) => {
                const cardBox = document.createElement('div');
                
                // 🔥 Colores según estado
                let estadoColor = "bg-slate-100 text-slate-700";
                let estadoIcon = "📋";
                
                if (labor.estado === "PLANIFICADO") {
                    estadoColor = "bg-blue-100 text-blue-700";
                    estadoIcon = "📋";
                } else if (labor.estado === "EJECUTADO") {
                    estadoColor = "bg-green-100 text-green-700";
                    estadoIcon = "✅";
                } else if (labor.estado === "PRE_VALIDADO") {
                    estadoColor = "bg-yellow-100 text-yellow-700";
                    estadoIcon = "🔍";
