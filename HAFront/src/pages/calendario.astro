            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    const preview = document.getElementById('foto-preview');
                    const img = document.getElementById('foto-preview-img');
                    img.src = event.target.result;
                    preview.classList.remove('hidden');
                };
                reader.readAsDataURL(file);
            }
        });

        document.getElementById('btn-eliminar-foto')?.addEventListener('click', () => {
            document.getElementById('foto-preview').classList.add('hidden');
            document.getElementById('ejecucion-foto').value = '';
        });
    });

    document.addEventListener('astro:after-swap', () => {
        renderMatrizAnual();
    });
</script>