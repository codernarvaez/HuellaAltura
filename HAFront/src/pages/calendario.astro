        <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-5">
            <div class="flex items-center gap-3">
                <div class="bg-emerald-500/10 p-2 rounded-xl text-emerald-600">
                    <i data-lucide="plus-circle" class="w-5 h-5"></i>
                </div>
                <h2 class="text-xl font-bold text-slate-900">Programar Nueva Labor</h2>
            </div>
            <button id="btn-cerrar-modal" class="text-slate-400 hover:text-slate-600 transition">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <!-- Formulario -->
        <form id="form-nueva-labor" class="space-y-4">
            <!-- Nombre de la Labor (Actividad) -->
            <div>
                <label for="labor-nombre" class="block text-sm font-medium text-slate-700 mb-1.5">
                    Actividad <span class="text-red-500">*</span>
                </label>
                <select
                    id="labor-nombre"
