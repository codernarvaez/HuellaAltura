    // ============================================================
    // 🔥 FUNCIONES DE VALIDACIÓN NORMATIVA
    // ============================================================

    async function validarNormativa(laborId) {
        if (!confirm('¿Validar esta labor contra la normativa?')) return;
        
        try {
            const token = getCookie('token');
            if (!token) {
                alert('No hay sesión activa');
                return;
            }

            const btn = document.querySelector(`.btn-validar-normativa[data-labor-id="${laborId}"]`);
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<i data-lucide="loader-circle" class="w-3 h-3 animate-spin"></i> Validando...';
            }

            const response = await fetch(`${API_URL}/api/v1/labores/${laborId}/validar-norma`, {
                method: 'POST',
                headers: { 
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json'
                }
            });
            
            const data = await response.json();
            
            if (!response.ok) {
                throw new Error(data.detail || 'Error al validar normativa');
            }
            
            if (data.estado_validacion === "PRE_VALIDADO") {
                alert('✅ Labor pre-validada correctamente.');
            } else if (data.estado_validacion === "RECHAZADO") {
                alert('❌ La labor NO cumple con la normativa.');
            } else {
                alert('⚠️ Resultado: ' + data.estado_validacion);
            }
            
            location.reload();
        } catch (error) {
            console.error('❌ Error al validar normativa:', error);
            alert('Error al validar normativa: ' + error.message);
            
            const btn = document.querySelector(`.btn-validar-normativa[data-labor-id="${laborId}"]`);
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = '<i data-lucide="check-circle" class="w-3 h-3"></i> Validar Normativa';
            }
        }
    }

    async function aprobarLabor(laborId) {
        if (!confirm('¿Aprobar esta labor como auditor?')) return;
        
        try {
