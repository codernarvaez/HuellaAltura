    async function rechazarLabor(laborId) {
        if (!confirm('¿Rechazar esta labor?')) return;
        
        try {
            const token = getCookie('token');
            if (!token) {
                alert('No hay sesión activa');
                return;
            }

            const btn = document.querySelector(`.btn-rechazar-labor[data-labor-id="${laborId}"]`);
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<i data-lucide="loader-circle" class="w-3 h-3 animate-spin"></i> Rechazando...';
            }

            const response = await fetch(`${API_URL}/api/v1/labores/${laborId}`, {
                method: 'PATCH',
                headers: { 
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ estado: "RECHAZADO" })
            });
            
            const data = await response.json();
            
            if (!response.ok) {
                throw new Error(data.detail || 'Error al rechazar labor');
            }
            
            alert('❌ Labor rechazada.');
            location.reload();
        } catch (error) {
            console.error('❌ Error al rechazar labor:', error);
            alert('Error al rechazar labor: ' + error.message);
            
            const btn = document.querySelector(`.btn-rechazar-labor[data-labor-id="${laborId}"]`);
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = '<i data-lucide="x-circle" class="w-3 h-3"></i> Rechazar';
            }
        }
    }

    // ============================================================
    // CREAR LABOR
    // ============================================================

    async function crearLabor(event) {
        event.preventDefault();

        const nombre = document.getElementById('labor-nombre').value;
        const tipo = document.getElementById('labor-tipo').value;
        const mesSelect = document.getElementById('labor-mes');
        const mes = mesSelect.value;
        const cantidad = document.getElementById('labor-cantidad').value.trim();

        if (!nombre || !tipo || !mes || !cantidad) {
            const errorDiv = document.getElementById('labor-error');
            errorDiv.classList.remove('hidden');
            errorDiv.classList.add('text-red-500');
            document.getElementById('labor-error-text').textContent = 'Todos los campos son obligatorios';
            return;
        }

        if (!fincaId || fincaId === 'null' || fincaId === '') {
            const errorDiv = document.getElementById('labor-error');
            errorDiv.classList.remove('hidden');
            errorDiv.classList.add('text-red-500');
            document.getElementById('labor-error-text').textContent = 'No se encontró una finca asociada al usuario.';
            return;
        }

        const payload = {
            nombre: nombre,
            tipo_proceso: tipo,
            mes: mes,
            cantidad_proyectada: cantidad,
            finca_id: String(fincaId).trim()
        };

        console.log('📦 Payload crear labor:', JSON.stringify(payload, null, 2));

        try {
            const token = getCookie('token');
            if (!token) {
                const errorDiv = document.getElementById('labor-error');
                errorDiv.classList.remove('hidden');
                errorDiv.classList.add('text-red-500');
                document.getElementById('labor-error-text').textContent = 'No hay sesión activa';
                return;
            }

            const btnGuardar = document.getElementById('btn-guardar-labor');
            btnGuardar.disabled = true;
            btnGuardar.innerHTML = '<i data-lucide="loader-circle" class="w-4 h-4 animate-spin"></i> Guardando...';

            const { LaboresService } = await import('/src/services/labores.service.ts');
            const resultado = await LaboresService.agendarLabor(payload, token);
            console.log('✅ Labor creada:', resultado);

            const errorDiv = document.getElementById('labor-error');
            errorDiv.classList.remove('hidden', 'text-red-500');
            errorDiv.classList.add('text-emerald-500');
            document.getElementById('labor-error-text').textContent = '✅ Labor creada correctamente';

            setTimeout(() => {
                toggleModalCrear(false);
                window.location.reload();
            }, 1500);

        } catch (error) {
            console.error('❌ Error al crear labor:', error);
            const errorDiv = document.getElementById('labor-error');
            errorDiv.classList.remove('hidden');
            errorDiv.classList.add('text-red-500');
            document.getElementById('labor-error-text').textContent = error.message || 'Error al crear la labor';
            
            const btnGuardar = document.getElementById('btn-guardar-labor');
            btnGuardar.disabled = false;
            btnGuardar.innerHTML = '<i data-lucide="save" class="w-4 h-4"></i> Guardar Labor';
            if (window.lucide) window.lucide.createIcons();
        }
    }

    // ============================================================
    // EJECUTAR LABOR CON SUBIDA DE FOTO
    // ============================================================

    async function ejecutarLabor(event) {
        event.preventDefault();

        const laborId = document.getElementById('ejecucion-labor-id').value;
        const detalle = document.getElementById('ejecucion-detalle').value.trim();
        const persona = document.getElementById('ejecucion-persona').value.trim();
        const jornalero = document.getElementById('ejecucion-jornalero').value.trim() || null;
        const salario = parseFloat(document.getElementById('ejecucion-salario').value) || null;

        const fotoInput = document.getElementById('ejecucion-foto');
        const fotoFile = fotoInput.files && fotoInput.files.length > 0 ? fotoInput.files[0] : null;

        const insumoElements = document.querySelectorAll('.insumo-nombre');
        const insumos = [];
        insumoElements.forEach((el, index) => {
            const nombre = el.value.trim();
            const cantidad = parseFloat(document.querySelectorAll('.insumo-cantidad')[index]?.value) || 0;
            const unidad = document.querySelectorAll('.insumo-unidad')[index]?.value.trim() || '';
            if (nombre) {
                insumos.push({ nombre, cantidad, unidad });
            }
        });

        const herramientaElements = document.querySelectorAll('.herramienta-nombre');
        const herramientas = [];
        herramientaElements.forEach(el => {
            const nombre = el.value.trim();
            if (nombre) {
                herramientas.push(nombre);
            }
        });

        if (!detalle || !persona) {
            alert('Detalle de Aplicación y Persona Desarrollo son obligatorios');
            return;
        }

        try {
            const token = getCookie('token');
            if (!token) {
                alert('No hay sesión activa');
                return;
            }

            const btnGuardar = document.getElementById('btn-guardar-ejecucion');
            btnGuardar.disabled = true;
            btnGuardar.innerHTML = '<i data-lucide="loader-circle" class="w-4 h-4 animate-spin"></i> Subiendo evidencia...';

            let fotoUrl = null;
            let fotoHash = null;

            if (fotoFile) {
                try {
                    console.log('📤 Subiendo foto a Cloudinary...');
                    const { LaboresService } = await import('/src/services/labores.service.ts');
                    const resultado = await LaboresService.subirEvidencia(fotoFile, token);
                    fotoUrl = resultado.foto_url;
                    fotoHash = resultado.foto_hash;
                    console.log('✅ Foto subida:', fotoUrl);
                } catch (error) {
                    console.error('❌ Error al subir foto:', error);
                    alert('Error al subir la foto: ' + (error.message || 'Error desconocido'));
                    btnGuardar.disabled = false;
                    btnGuardar.innerHTML = '<i data-lucide="check" class="w-4 h-4"></i> Verificar e Incorporar al Ledger';
                    if (window.lucide) window.lucide.createIcons();
                    return;
                }
            }

            const payload = {
                persona_desarrollo: persona,
                detalle_aplicacion: detalle,
                insumos: insumos.length > 0 ? insumos : [],
                herramientas: herramientas.length > 0 ? herramientas : []
            };

            if (jornalero) payload.nombre_jornalero = jornalero;
            if (salario !== null && !isNaN(salario)) payload.salario = salario;
            if (fotoUrl) payload.foto_url = fotoUrl;
            if (fotoHash) payload.foto_hash = fotoHash;

            console.log('📦 Payload ejecución:', JSON.stringify(payload, null, 2));

            btnGuardar.innerHTML = '<i data-lucide="loader-circle" class="w-4 h-4 animate-spin"></i> Guardando...';

            const { LaboresService } = await import('/src/services/labores.service.ts');
            const resultado = await LaboresService.ejecutarLabor(laborId, payload, token);
            console.log('✅ Ejecución registrada:', resultado);

            alert('✅ Ejecución registrada correctamente.');

            setTimeout(() => {
                toggleModalEjecutar(false);
                window.location.reload();
            }, 1500);

        } catch (error) {
            console.error('❌ Error al ejecutar labor:', error);
            alert('Error al registrar ejecución: ' + (error.message || 'Error desconocido'));
            
            const btnGuardar = document.getElementById('btn-guardar-ejecucion');
            btnGuardar.disabled = false;
            btnGuardar.innerHTML = '<i data-lucide="check" class="w-4 h-4"></i> Verificar e Incorporar al Ledger';
            if (window.lucide) window.lucide.createIcons();
        }
    }

