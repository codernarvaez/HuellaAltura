</div>

<!-- ============================================================ -->
<!-- MODAL PARA CREAR LABOR                                      -->
<!-- ============================================================ -->
<div id="modal-nueva-labor" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm hidden">
    <div class="bg-white rounded-2xl w-full max-w-lg mx-4 p-6 shadow-2xl animate-modal-in">
