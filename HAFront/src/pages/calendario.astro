---
// src/pages/calendario.astro
import DashboardLayout from "../layouts/LayoutVariable.astro";
import { AuthService } from "../services/auth.service.ts";
import { FincaService } from "../services/finca.service.ts";
import { LaboresService } from "../services/labores.service.ts";

// Obtener token de las cookies
const token = Astro.cookies.get("token")?.value;

let userData = null;
let fincaId = null;
let error = null;
let isLoading = true;
let calendarioData = null;
let userRole = null;
let fincasDisponibles = [];

if (token) {
  try {
    userData = await AuthService.getMe(token);
    userRole = userData?.role?.name || '';
    console.log("👤 Usuario:", userData?.first_name, userData?.last_name);
    console.log("🎭 Rol del usuario:", userRole);
    
    // 🔥 Verificar si el usuario es ADMINISTRADOR
    const esAdmin = userRole === 'SUPER_ADMIN' || userRole === 'TENANT_ADMIN' || userRole === 'ADMIN';
    
    // 🔥 OBTENER EL finca_id DE LA URL (si viene)
    const urlParams = Astro.url.searchParams;
    const fincaIdFromUrl = urlParams.get("finca_id");
    
    if (userData?.id) {
      // 🔥 OBTENER FINCAS SEGÚN EL ROL
      try {
        if (esAdmin) {
          // ADMIN: Obtener todas las fincas disponibles
          const fincas = await FincaService.list(token);
          fincasDisponibles = fincas || [];
          console.log("📋 Fincas disponibles para admin:", fincasDisponibles.length);
        } else {
          // PRODUCTOR/TECNICO: Obtener su finca asociada
          const fincaUsuario = await FincaService.getByUsuarioId(userData.id, token);
          if (fincaUsuario && fincaUsuario.length > 0) {
            fincasDisponibles = fincaUsuario;
            console.log("📋 Finca del usuario:", fincasDisponibles.length);
          } else {
            console.warn("⚠️ El usuario no tiene finca asociada");
          }
        }
        
        // 🔥 SELECCIONAR LA FINCA
        if (fincaIdFromUrl && fincasDisponibles.some(f => f.id === fincaIdFromUrl)) {
          // Si hay finca_id en la URL y existe en las disponibles, usarla
          fincaId = fincaIdFromUrl;
          console.log("✅ Finca seleccionada desde URL:", fincaId);
        } else if (fincasDisponibles.length > 0) {
          // Si no, usar la primera finca disponible
          fincaId = fincasDisponibles[0].id;
          console.log("✅ Finca seleccionada por defecto:", fincasDisponibles[0].nombre);
        }
      } catch (e) {
        console.warn("⚠️ Error obteniendo fincas:", e.message);
      }
      
      // 🔥 Cargar calendario si hay fincaId
      if (fincaId) {
        try {
          const response = await LaboresService.obtenerCalendario(fincaId, token);
          calendarioData = response;
          console.log("📋 Calendario cargado para finca:", fincaId);
        } catch (e) {
          console.warn("⚠️ Error obteniendo calendario:", e.message);
          calendarioData = null;
        }
      }
    }
    
    isLoading = false;
  } catch (e) {
    error = e.message;
    console.error("❌ Error:", e);
    isLoading = false;
  }
} else {
  isLoading = false;
  error = "No hay sesión activa";
}

// Lista de meses en español
const meses = [
  { value: "1", label: "Enero" },
  { value: "2", label: "Febrero" },
  { value: "3", label: "Marzo" },
  { value: "4", label: "Abril" },
  { value: "5", label: "Mayo" },
  { value: "6", label: "Junio" },
  { value: "7", label: "Julio" },
  { value: "8", label: "Agosto" },
  { value: "9", label: "Septiembre" },
  { value: "10", label: "Octubre" },
  { value: "11", label: "Noviembre" },
  { value: "12", label: "Diciembre" }
];

// Tipos de Proceso disponibles (Etapas)
const tiposProceso = [
  { value: "Producción", label: "🌱 Producción" },
  { value: "Cosecha", label: "🌾 Cosecha" },
  { value: "Pos-cosecha", label: "📦 Pos-cosecha" }
];

// Actividades del Excel (solo para el combobox del modal)
const actividadesPorMes = {
  "Enero": [
    { actividad: "Elaboración Plan de Producción Certificada (PPC)", etapa: "Producción" },
    { actividad: "Monitoreo fitosanitario (broca, roya, ojo de gallo)", etapa: "Producción" },
    { actividad: "Fertilización orgánica sólida (refuerzo llenado de grano)", etapa: "Producción" }
  ],
  "Febrero": [
    { actividad: "Continuación PPC y diagnóstico agrícola-social-económico", etapa: "Producción" },
    { actividad: "Manejo de malezas (limpia manual selectiva)", etapa: "Producción" },
    { actividad: "Preparación de semillero / vivero (si hay renovación)", etapa: "Producción" }
  ],
  "Marzo": [
    { actividad: "Trasplante a vivero / funda (chapolas)", etapa: "Producción" },
    { actividad: "Fertilización orgánica líquida (biol) — llenado de grano", etapa: "Producción" },
    { actividad: "Control de malezas y manejo de coberturas", etapa: "Producción" }
  ],
  "Abril": [
    { actividad: "Manejo de sombra (raleo/regulación previo a época seca)", etapa: "Producción" },
    { actividad: "Preparación de infraestructura de beneficio (pre-cosecha)", etapa: "Producción" },
    { actividad: "Monitoreo de maduración y trampeo de broca", etapa: "Producción" }
  ],
  "Mayo": [
    { actividad: "Mantenimiento de trampas y control biológico de broca", etapa: "Producción" },
    { actividad: "Inicio de maduración de frutos (control visual)", etapa: "Producción" },
    { actividad: "Preparación logística de cosecha", etapa: "Cosecha" }
  ],
  "Junio": [
    { actividad: "Recolección selectiva (inicio de cosecha)", etapa: "Cosecha" },
    { actividad: "Pasadas de recolección (repaso de cafetal)", etapa: "Cosecha" },
    { actividad: "Boyado (clasificación por flotación)", etapa: "Pos-cosecha" },
    { actividad: "Despulpado (mismo día de cosecha)", etapa: "Pos-cosecha" },
    { actividad: "Fermentación", etapa: "Pos-cosecha" },
    { actividad: "Lavado", etapa: "Pos-cosecha" },
    { actividad: "Secado", etapa: "Pos-cosecha" },
    { actividad: "Almacenamiento en finca", etapa: "Pos-cosecha" }
  ],
  "Julio": [
    { actividad: "Cosecha pico (recolección diaria)", etapa: "Cosecha" },
    { actividad: "Primera entrega de café pergamino a PROCAFEQ", etapa: "Pos-cosecha" }
  ],
  "Agosto": [
    { actividad: "Cosecha pico / continuación", etapa: "Cosecha" },
    { actividad: "Segunda entrega de café pergamino a PROCAFEQ", etapa: "Pos-cosecha" }
  ],
  "Septiembre": [
    { actividad: "Podas fitosanitarias y de formación (post-cosecha inmediata)", etapa: "Producción" },
    { actividad: "Repela / recolección de frutos remanentes", etapa: "Producción" },
    { actividad: "Cierre de cosecha principal", etapa: "Cosecha" },
    { actividad: "Entrega final de café pergamino a PROCAFEQ", etapa: "Pos-cosecha" },
    { actividad: "Transporte a planta de procesamiento (FAPECAFES)", etapa: "Pos-cosecha" }
  ],
  "Octubre": [
    { actividad: "Poda de recepa (renovación, cafetales >20 años)", etapa: "Producción" },
    { actividad: "Regulación de sombra en época seca", etapa: "Producción" },
    { actividad: "Elaboración de compost / biol para próxima campaña", etapa: "Producción" }
  ],
  "Noviembre": [
    { actividad: "Fertilización orgánica principal (antes de lluvias)", etapa: "Producción" },
    { actividad: "Inspección interna anual de finca (SIC PROCAFEQ)", etapa: "Producción" },
    { actividad: "Manejo de malezas (post-fertilización)", etapa: "Producción" }
  ],
  "Diciembre": [
    { actividad: "Floración (monitoreo, sin intervención directa)", etapa: "Producción" },
    { actividad: "Resiembra de fallas", etapa: "Producción" },
    { actividad: "Cierre de registros anuales", etapa: "Producción" }
  ]
};

// 🔥 NUEVA LÓGICA DE ROLES
const esAdmin = userRole === 'SUPER_ADMIN' || userRole === 'TENANT_ADMIN' || userRole === 'ADMIN';
const puedeValidar = userRole === 'PRODUCTOR' || 
                     userRole === 'TECNICO_CAMPO' || 
                     userRole === 'INVESTIGADOR' ||
                     esAdmin;

const puedeAprobar = userRole === 'AUDITOR_INTERNO' || 
                     userRole === 'SUPER_ADMIN' || 
                     userRole === 'TENANT_ADMIN' ||
                     userRole === 'ADMIN';

// 🔥 Asegurar que fincaId se pase correctamente al cliente
const fincaIdStr = fincaId ? String(fincaId) : '';
const calendarioDataStr = calendarioData ? JSON.stringify(calendarioData) : 'null';
const userDataStr = userData ? JSON.stringify(userData) : 'null';
const userRoleStr = userRole || '';
const puedeValidarStr = puedeValidar ? 'true' : 'false';
const puedeAprobarStr = puedeAprobar ? 'true' : 'false';
const fincasDisponiblesStr = fincasDisponibles ? JSON.stringify(fincasDisponibles) : '[]';
const esAdminStr = esAdmin ? 'true' : 'false';
---

<DashboardLayout title="Calendario Anual">

<div class="space-y-8">

    <!-- HEADER -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
            <h1 class="text-3xl font-bold text-slate-950">
                Calendario & Planificador Anual (Módulo 2)
            </h1>
            <p class="mt-2 text-slate-500 max-w-2xl">
                Planificación de labores agrícolas basada en el calendario cafetalero.
            </p>
            <!-- 🔥 Mostrar rol actual y permisos -->
            <div class="mt-2 flex flex-wrap items-center gap-2">
                <span class="text-xs font-medium text-slate-500">Tu rol:</span>
                <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-primary/10 text-primary">
                    {userRole || 'No definido'}
                </span>
                {puedeValidar && (
                    <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-green-100 text-green-700">
                        ✅ Puede validar
                    </span>
                )}
                {puedeAprobar && (
                    <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-purple-100 text-purple-700">
                        ✅ Puede aprobar
                    </span>
                )}
            </div>
        </div>
        {/* 🔥 Botón "Programar Nueva Labor" - solo visible para quienes pueden validar */}
        {puedeValidar && (
            <button id="btn-nueva-labor-global" class="flex items-center gap-2 bg-emerald-600 text-white px-5 h-12 rounded-xl hover:bg-emerald-500 transition shadow-sm font-medium text-sm whitespace-nowrap">
                <i data-lucide="plus-circle" class="w-5 h-5"></i>
                Programar Nueva Labor
            </button>
        )}
    </div>

    <!-- 🔥 SELECTOR DE FINCAS (SOLO PARA ADMINISTRADORES) -->
    {esAdmin && fincasDisponibles.length > 1 && (
        <div class="bg-white border border-slate-200 rounded-xl p-4 flex flex-col sm:flex-row sm:items-center gap-4 shadow-sm">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-slate-400">agriculture</span>
                <span class="text-sm font-medium text-slate-700">Seleccionar Finca:</span>
            </div>
            <select
                id="selector-finca"
                class="flex-1 h-10 px-3 border border-slate-200 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:outline-none transition bg-white text-sm"
            >
                {fincasDisponibles.map((finca) => (
                    <option key={finca.id} value={finca.id} selected={finca.id === fincaId}>
                        {finca.nombre} {finca.provincia ? `- ${finca.provincia}` : ''}
                    </option>
                ))}
            </select>
            <button
                id="btn-cambiar-finca"
                class="px-4 py-2 bg-emerald-600 text-white rounded-lg text-sm font-medium hover:bg-emerald-500 transition"
            >
                Cargar Calendario
            </button>
        </div>
    )}

    {/* 🔥 INDICADOR DE FINCA ACTUAL PARA PRODUCTOR (solo si hay una finca) */}
    {!esAdmin && fincasDisponibles.length > 0 && (
        <div class="bg-blue-50 border border-blue-200 rounded-xl p-3 flex items-center gap-2">
            <span class="material-symbols-outlined text-blue-500 text-sm">info</span>
            <span class="text-sm text-blue-700">
                Mostrando calendario de tu finca: <strong>{fincasDisponibles[0]?.nombre || 'Seleccionada'}</strong>
            </span>
        </div>
    )}

    {/* 🔥 MENSAJE SI NO HAY FINCAS */}
    {fincasDisponibles.length === 0 && !isLoading && (
        <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-6 text-center">
            <span class="material-symbols-outlined text-yellow-500 text-4xl">info</span>
            <p class="mt-2 font-semibold text-yellow-700">No hay fincas disponibles</p>
            <p class="text-sm text-yellow-600 mt-1">
                {esAdmin 
                    ? 'No hay fincas registradas en el sistema. Crea una finca primero.'
                    : 'No tienes una finca asociada. Contacta a un administrador.'}
            </p>
        </div>
    )}

    <!-- MATRIZ DEL CALENDARIO ANUAL -->
    <div class="bg-white rounded-2xl border border-slate-200 p-6 md:p-8 shadow-sm space-y-6">
        
        <div class="flex items-center space-x-3 pb-6 border-b border-slate-100">
