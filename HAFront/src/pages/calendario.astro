            }

            const response = await fetch(`${API_URL}/api/v1/labores/${laborId}/aprobar`, {
                method: 'POST',
                headers: { 
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json'
                }
            });
            
            const data = await response.json();
            
            if (!response.ok) {
                throw new Error(data.detail || 'Error al aprobar labor');
            }
            
            alert('✅ Labor auditada y aprobada correctamente.');
            location.reload();
        } catch (error) {
            console.error('❌ Error al aprobar labor:', error);
            alert('Error al aprobar labor: ' + error.message);
            
            const btn = document.querySelector(`.btn-aprobar-labor[data-labor-id="${laborId}"]`);
            if (btn) {
