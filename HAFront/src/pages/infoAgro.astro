---
import DashboardLayout from "../layouts/LayoutVariable.astro";
---

<DashboardLayout title="Información Agroambiental">

  <div class="space-y-6">

    <!-- HEADER -->
    <section>
      <h1 class="text-3xl font-bold text-primary">
        Información Agroambiental
      </h1>
      <p class="text-on-surface-variant mt-2 max-w-3xl">
        Registro de variables ambientales complementarias asociadas a la finca
        y configuración dinámica definida por el administrador.
      </p>
    </section>

    <!-- INFORMACIÓN AGROAMBIENTAL -->
    <section
      class="bg-white border border-outline-variant rounded-xl shadow-sm overflow-hidden"
    >
      <div
        class="px-6 py-4 border-b border-outline-variant flex items-center gap-3"
      >
        <span class="material-symbols-outlined text-primary">
          eco
        </span>
        <h2 class="text-xl font-semibold text-primary">
          Información Agroambiental y Campos Dinámicos
        </h2>
      </div>

      <div class="p-6">
        <p class="text-on-surface-variant mb-6">
          Los campos a continuación corresponden a variables ambientales
          complementarias configuradas por el administrador.
        </p>

        <div id="infoagro-loading" class="text-sm text-on-surface-variant">
          Cargando variables dinámicas...
        </div>

        <div id="infoagro-fields" class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-4"></div>
      </div>
    </section>

    <!-- PUNTO GEOGRÁFICO -->
    <section
      class="bg-white border border-outline-variant rounded-xl shadow-sm overflow-hidden"
    >
      <div
        class="px-6 py-4 border-b border-outline-variant flex items-center gap-3"
      >
        <span class="material-symbols-outlined text-primary">
          location_on
        </span>
        <h2 class="text-xl font-semibold text-primary">
          Linderos / Punto Geográfico
        </h2>
      </div>

      <div class="p-6">
        <div
          class="h-[450px] rounded-xl overflow-hidden border border-outline-variant mb-6"
        >
          <img
            src="/images/mapa-demo.jpg"
            alt="Mapa de finca"
            class="w-full h-full object-cover"
          />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="infoagro-static-coordinates">
          <div>
            <label
              class="block mb-2 text-sm font-medium text-on-surface-variant"
            >
              Latitud (WGS84)
            </label>
            <input
              type="text"
              value="-0.512021"
              readonly
              class="w-full h-14 px-4 rounded-xl border border-outline-variant bg-surface-container-low"
            />
          </div>
          <div>
            <label
              class="block mb-2 text-sm font-medium text-on-surface-variant"
            >
              Longitud (WGS84)
            </label>
            <input
              type="text"
              value="-78.376812"
              readonly
              class="w-full h-14 px-4 rounded-xl border border-outline-variant bg-surface-container-low"
            />
          </div>
        </div>
      </div>
    </section>
  </div>
</DashboardLayout>

<script type="module">
  import { AgroambientalService } from "/src/services/InfoAgroambiental.ts";

  const infoAgroFields = document.getElementById("infoagro-fields");
  const infoAgroLoading = document.getElementById("infoagro-loading");

  function getCookie(name) {
    const match = document.cookie.match(new RegExp(`(?:^|; )${name}=([^;]*)`));
    return match ? decodeURIComponent(match[1]) : "";
  }

  const token = getCookie("token");
  const urlParams = new URLSearchParams(window.location.search);
  const expedienteId = urlParams.get("expediente_id");

  function renderField(variable) {
    return `
      <div>
        <label class="block mb-2 text-sm font-medium text-on-surface-variant">
          ${variable.nombre}
        </label>
        <input
          type="text"
          id="variable-${variable.id}"
          name="variable-${variable.id}"
          value="${variable.valor ?? ""}"
          readonly
          class="w-full h-14 px-4 rounded-xl border border-outline-variant bg-surface-container-low text-on-surface"
        />
      </div>
    `;
  }

  async function loadInfoAgro() {
    if (!infoAgroFields || !infoAgroLoading) return;

    if (!token || !expedienteId) {
      infoAgroLoading.textContent = "";
      infoAgroFields.innerHTML = `<div class="col-span-full p-6 text-center text-error">No se encontró token o expediente_id.</div>`;
      return;
    }

    try {
      const datos = await AgroambientalService.getByExpediente(expedienteId, token);
      const fields = datos.flatMap((dato) => dato.variables || []);
      infoAgroLoading.textContent = "";

      if (!fields.length) {
        infoAgroFields.innerHTML = `<div class="col-span-full p-6 text-center text-on-surface-variant">No se encontraron variables dinámicas para este expediente.</div>`;
        return;
      }

      infoAgroFields.innerHTML = fields
        .map((variable) => renderField(variable))
        .join("");
    } catch (error) {
      infoAgroLoading.textContent = "";
      infoAgroFields.innerHTML = `<div class="col-span-full p-6 text-center text-error">${error instanceof Error ? error.message : "Error al cargar variables dinámicas."}</div>`;
    }
  }

  loadInfoAgro();
</script>
