---
import DashboardLayout from "../layouts/LayoutVariable.astro";
import { AuthService } from "../services/auth.service.ts";

// Obtener token de las cookies
const token = Astro.cookies.get("token")?.value;

let userData = null;
let userRole = null;
let error = null;
let isLoading = true;

if (token) {
  try {
    userData = await AuthService.getMe(token);
    userRole = userData?.role?.name || '';
    console.log("✅ Usuario cargado:", userData);
    console.log("🎭 Rol del usuario:", userRole);
    isLoading = false;
  } catch (e) {
    error = e.message;
    console.error("❌ Error cargando datos del usuario:", e);
    isLoading = false;
  }
} else {
  isLoading = false;
  error = "No hay sesión activa";
}

// Determinar si el usuario es INVESTIGADOR (puede editar)
const esInvestigador = userRole === 'INVESTIGADOR' || userRole === 'TENANT_ADMIN' || userRole === 'SUPER_ADMIN';
const esProductor = userRole === 'PRODUCTOR';

console.log("🔍 esInvestigador:", esInvestigador);
console.log("🔍 esProductor:", esProductor);
---

<DashboardLayout title="Información Agroambiental">

  <div class="space-y-6">

    <!-- HEADER -->
    <section>
      <h1 class="text-3xl font-bold text-primary">
        Información Agroambiental
      </h1>
      <p class="text-on-surface-variant mt-2 max-w-3xl">
        Registro de variables ambientales complementarias asociadas a la finca.
      </p>
      {esProductor && (
        <div class="mt-4 p-4 bg-blue-50 border border-blue-200 rounded-xl text-sm text-blue-700">
          <span class="material-symbols-outlined text-sm align-middle mr-1">info</span>
          <strong>Modo solo lectura:</strong> Como PRODUCTOR, solo puedes visualizar la información agroambiental. 
          Para registrar o modificar datos, contacta a un INVESTIGADOR.
        </div>
      )}
      {esInvestigador && (
        <div class="mt-4 p-4 bg-green-50 border border-green-200 rounded-xl text-sm text-green-700">
          <span class="material-symbols-outlined text-sm align-middle mr-1">edit</span>
          <strong>Modo edición:</strong> Como INVESTIGADOR, puedes registrar y modificar la información agroambiental.
        </div>
      )}
    </section>

    <!-- FORMULARIO AGROAMBIENTAL -->
    <section
      class="bg-white border border-outline-variant rounded-xl shadow-sm overflow-hidden"
    >
      <div
        class="px-6 py-4 border-b border-outline-variant flex items-center justify-between gap-3 flex-wrap"
      >
        <div class="flex items-center gap-3">
          <span class="material-symbols-outlined text-primary">
            eco
          </span>
          <h2 class="text-xl font-semibold text-primary">
            Información Agroambiental
          </h2>
        </div>
        <div class="flex gap-2 flex-wrap">
          <!-- BOTÓN VOLVER -->
          <button
            id="volver-btn"
            class="px-4 py-2 bg-surface text-on-surface-variant border border-outline-variant rounded-xl hover:bg-surface-container-high transition flex items-center gap-2"
          >
            <span class="material-symbols-outlined text-sm">arrow_back</span>
            Volver
          </button>
          
          <!-- BOTÓN GUARDAR - SOLO PARA INVESTIGADOR -->
          {esInvestigador && (
            <button
              id="guardar-infoagro"
              class="px-4 py-2 bg-primary text-white rounded-xl hover:opacity-90 transition flex items-center gap-2"
            >
              <span class="material-symbols-outlined text-sm">save</span>
              Guardar
            </button>
          )}
          
          <!-- BOTÓN LIMPIAR - SOLO PARA INVESTIGADOR -->
          {esInvestigador && (
            <button
              id="limpiar-infoagro"
              class="px-4 py-2 bg-surface text-on-surface-variant border border-outline-variant rounded-xl hover:bg-surface-container-high transition flex items-center gap-2"
            >
              <span class="material-symbols-outlined text-sm">clear</span>
              Limpiar
            </button>
          )}
        </div>
      </div>

      <div class="p-6">
        <p class="text-on-surface-variant mb-6">
          Complete la información agroambiental de la finca. Los campos marcados con <span class="text-error">*</span> son obligatorios.
          {esProductor && " (Solo lectura)"}
        </p>

        <form id="infoagro-form">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Índice Shannon -->
            <div>
              <label class="block mb-2 text-sm font-medium text-on-surface-variant">
                Índice de Shannon
              </label>
              <input
                id="indice_shannon"
                type="number"
                step="0.01"
                placeholder="0.00"
                readonly={esProductor}
                class="w-full h-14 px-4 rounded-xl border border-outline-variant bg-white text-on-surface focus:ring-2 focus:ring-primary focus:outline-none"
              />
            </div>

            <!-- Índice Simpson -->
            <div>
              <label class="block mb-2 text-sm font-medium text-on-surface-variant">
                Índice de Simpson
              </label>
              <input
                id="indice_simpson"
                type="number"
                step="0.01"
                placeholder="0.00"
                readonly={esProductor}
                class="w-full h-14 px-4 rounded-xl border border-outline-variant bg-white text-on-surface focus:ring-2 focus:ring-primary focus:outline-none"
              />
            </div>

            <!-- Uso de Suelo -->
            <div>
              <label class="block mb-2 text-sm font-medium text-on-surface-variant">
                Uso de Suelo <span class="text-error">*</span>
              </label>
              {esProductor ? (
                <input
                  id="uso_suelo_text"
                  type="text"
                  readonly
                  placeholder="No especificado"
                  class="w-full h-14 px-4 rounded-xl border border-outline-variant bg-surface-container-low text-on-surface"
                />
              ) : (
                <select
                  id="uso_suelo"
                  class="w-full h-14 px-4 rounded-xl border border-outline-variant bg-white text-on-surface focus:ring-2 focus:ring-primary focus:outline-none"
                >
                  <option value="">Seleccionar uso de suelo</option>
                  <option value="AGRICOLA">Agrícola</option>
                  <option value="FORESTAL">Forestal</option>
                  <option value="PASTOREO">Pastoreo</option>
                  <option value="MIXTO">Mixto</option>
                  <option value="CONSERVACION">Conservación</option>
                  <option value="OTRO">Otro</option>
                </select>
              )}
            </div>

            <!-- Cobertura Forestal -->
            <div>
              <label class="block mb-2 text-sm font-medium text-on-surface-variant">
                Cobertura Forestal <span class="text-error">*</span>
              </label>
              {esProductor ? (
                <input
                  id="cobertura_forestal_text"
                  type="text"
                  readonly
                  placeholder="No especificado"
                  class="w-full h-14 px-4 rounded-xl border border-outline-variant bg-surface-container-low text-on-surface"
                />
              ) : (
                <select
                  id="cobertura_forestal"
                  class="w-full h-14 px-4 rounded-xl border border-outline-variant bg-white text-on-surface focus:ring-2 focus:ring-primary focus:outline-none"
                >
                  <option value="">Seleccionar cobertura forestal</option>
                  <option value="BOSQUE_NATIVO">Bosque Nativo</option>
                  <option value="BOSQUE_PLANTADO">Bosque Plantado</option>
                  <option value="PASTIZAL">Pastizal</option>
                  <option value="CULTIVOS">Cultivos</option>
                  <option value="VEGETACION_SECUNDARIA">Vegetación Secundaria</option>
                  <option value="OTRO">Otro</option>
                </select>
              )}
            </div>

            <!-- Sistema de Producción -->
            <div>
              <label class="block mb-2 text-sm font-medium text-on-surface-variant">
                Sistema de Producción <span class="text-error">*</span>
              </label>
              {esProductor ? (
                <input
                  id="sistema_produccion_text"
                  type="text"
                  readonly
                  placeholder="No especificado"
                  class="w-full h-14 px-4 rounded-xl border border-outline-variant bg-surface-container-low text-on-surface"
                />
              ) : (
                <select
                  id="sistema_produccion"
                  class="w-full h-14 px-4 rounded-xl border border-outline-variant bg-white text-on-surface focus:ring-2 focus:ring-primary focus:outline-none"
                >
                  <option value="">Seleccionar sistema de producción</option>
                  <option value="ORGANICO">Orgánico</option>
                  <option value="CONVENCIONAL">Convencional</option>
                  <option value="AGROFORESTAL">Agroforestal</option>
                  <option value="SILVOPASTORIL">Silvopastoril</option>
                  <option value="TRADICIONAL">Tradicional</option>
                  <option value="OTRO">Otro</option>
                </select>
              )}
            </div>

            <!-- Biomasa Árboles -->
            <div>
              <label class="block mb-2 text-sm font-medium text-on-surface-variant">
                Biomasa de Árboles (ton/ha)
              </label>
              <input
                id="biomasa_arboles"
                type="number"
                step="0.01"
                placeholder="0.00"
                readonly={esProductor}
                class="w-full h-14 px-4 rounded-xl border border-outline-variant bg-white text-on-surface focus:ring-2 focus:ring-primary focus:outline-none"
              />
            </div>

            <!-- Biomasa Café -->
            <div>
              <label class="block mb-2 text-sm font-medium text-on-surface-variant">
                Biomasa de Café (ton/ha)
              </label>
              <input
                id="biomasa_cafe"
                type="number"
                step="0.01"
                placeholder="0.00"
                readonly={esProductor}
                class="w-full h-14 px-4 rounded-xl border border-outline-variant bg-white text-on-surface focus:ring-2 focus:ring-primary focus:outline-none"
              />
            </div>

            <!-- Hojarasca/Mantillo -->
            <div>
              <label class="block mb-2 text-sm font-medium text-on-surface-variant">
                Hojarasca y Mantillo (ton/ha)
              </label>
              <input
                id="hojarasca_mantillo"
                type="number"
                step="0.01"
                placeholder="0.00"
                readonly={esProductor}
                class="w-full h-14 px-4 rounded-xl border border-outline-variant bg-white text-on-surface focus:ring-2 focus:ring-primary focus:outline-none"
              />
            </div>

            <!-- Carbono Orgánico Suelo -->
            <div>
              <label class="block mb-2 text-sm font-medium text-on-surface-variant">
                Carbono Orgánico del Suelo (ton/ha)
              </label>
              <input
                id="carbono_organico_suelo"
                type="number"
                step="0.01"
                placeholder="0.00"
                readonly={esProductor}
                class="w-full h-14 px-4 rounded-xl border border-outline-variant bg-white text-on-surface focus:ring-2 focus:ring-primary focus:outline-none"
              />
            </div>

            <!-- Total Stock Carbono -->
            <div class="md:col-span-2">
              <label class="block mb-2 text-sm font-medium text-primary">
                Total Stock de Carbono (ton/ha)
              </label>
              <input
                id="total_stock_carbono"
                type="number"
                step="0.01"
                readonly
                placeholder="0.00"
                class="w-full h-14 px-4 rounded-xl border border-primary bg-primary-container/5 text-primary font-semibold"
              />
              <p class="text-xs text-on-surface-variant mt-1">
                * Este valor se calcula automáticamente como la suma de: biomasa de árboles + biomasa de café + hojarasca y mantillo + carbono orgánico del suelo.
              </p>
            </div>
          </div>

          <!-- Variables Dinámicas (Opcional) -->
          <div id="dynamic-variables-container" class="mt-8 pt-6 border-t border-outline-variant hidden">
            <h3 class="text-lg font-semibold text-on-surface mb-4 flex items-center gap-2">
              <span class="material-symbols-outlined text-primary">tune</span>
              Variables Dinámicas
            </h3>
            <p class="text-sm text-on-surface-variant mb-4">
              Variables adicionales asociadas a la finca.
            </p>
            <div id="dynamic-variables" class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <!-- Las variables dinámicas se cargarán aquí si existen -->
            </div>
          </div>

          <!-- Mensaje de estado -->
          <div id="infoagro-message" class="mt-6 hidden text-sm"></div>

          <!-- BOTÓN SIGUIENTE - IR A SATELITAL -->
          <div id="siguiente-container" class="mt-6 pt-4 border-t border-outline-variant hidden">
            <div class="flex items-center justify-between">
              <div class="text-sm text-on-surface-variant">
                <span class="material-symbols-outlined text-sm align-middle mr-1">check_circle</span>
                Datos agroambientales cargados correctamente
              </div>
              <a
                id="ir-satelital"
                href="#"
                class="px-6 py-3 bg-primary text-white rounded-xl font-medium hover:opacity-90 transition flex items-center gap-2"
              >
                <span class="material-symbols-outlined text-sm">satellite_alt</span>
                Ir a Reporte Satelital
                <span class="material-symbols-outlined text-sm">arrow_forward</span>
              </a>
            </div>
          </div>

        </form>
      </div>
    </section>

    <!-- PUNTO GEOGRÁFICO - ELIMINADO -->
    <!-- La sección de mapa y coordenadas ha sido removida -->

  </div>
</DashboardLayout>

<script type="module">
  import { FincaService } from "/src/services/finca.service.ts";
  import { AgroambientalService } from "/src/services/InfoAgroambiental.ts";

  // DOM Elements
  const form = document.getElementById("infoagro-form");
  const messageEl = document.getElementById("infoagro-message");
  const dynamicVariablesContainer = document.getElementById("dynamic-variables-container");
  const dynamicVariablesEl = document.getElementById("dynamic-variables");
  const guardarBtn = document.getElementById("guardar-infoagro");
  const limpiarBtn = document.getElementById("limpiar-infoagro");
  const volverBtn = document.getElementById("volver-btn");
  const siguienteContainer = document.getElementById("siguiente-container");
  const irSatelital = document.getElementById("ir-satelital");

  // Form fields
  const fields = {
    indice_shannon: document.getElementById("indice_shannon"),
    indice_simpson: document.getElementById("indice_simpson"),
    uso_suelo: document.getElementById("uso_suelo"),
    uso_suelo_text: document.getElementById("uso_suelo_text"),
    cobertura_forestal: document.getElementById("cobertura_forestal"),
    cobertura_forestal_text: document.getElementById("cobertura_forestal_text"),
    sistema_produccion: document.getElementById("sistema_produccion"),
    sistema_produccion_text: document.getElementById("sistema_produccion_text"),
    biomasa_arboles: document.getElementById("biomasa_arboles"),
    biomasa_cafe: document.getElementById("biomasa_cafe"),
    hojarasca_mantillo: document.getElementById("hojarasca_mantillo"),
    carbono_organico_suelo: document.getElementById("carbono_organico_suelo"),
    total_stock_carbono: document.getElementById("total_stock_carbono"),
  };

  function getCookie(name) {
    const match = document.cookie.match(new RegExp(`(?:^|; )${name}=([^;]*)`));
    return match ? decodeURIComponent(match[1]) : "";
  }

  const token = getCookie("token");
  const urlParams = new URLSearchParams(window.location.search);
  const fincaId = urlParams.get("finca_id");

  // Determinar si el usuario es PRODUCTOR (solo lectura)
  const esProductor = window.ES_PRODUCTOR === true || false;
  const esInvestigador = !esProductor;

  // Variable para almacenar el dato_id si existe
  let datoId = null;
  let datosCargados = false;

  // Mapeo de valores para mostrar en modo solo lectura
  const mapUsoSuelo = {
    'AGRICOLA': 'Agrícola',
    'FORESTAL': 'Forestal',
    'PASTOREO': 'Pastoreo',
    'MIXTO': 'Mixto',
    'CONSERVACION': 'Conservación',
    'OTRO': 'Otro'
  };

  const mapCoberturaForestal = {
    'BOSQUE_NATIVO': 'Bosque Nativo',
    'BOSQUE_PLANTADO': 'Bosque Plantado',
    'PASTIZAL': 'Pastizal',
    'CULTIVOS': 'Cultivos',
    'VEGETACION_SECUNDARIA': 'Vegetación Secundaria',
    'OTRO': 'Otro'
  };

  const mapSistemaProduccion = {
    'ORGANICO': 'Orgánico',
    'CONVENCIONAL': 'Convencional',
    'AGROFORESTAL': 'Agroforestal',
    'SILVOPASTORIL': 'Silvopastoril',
    'TRADICIONAL': 'Tradicional',
    'OTRO': 'Otro'
  };

  // Función para mostrar el botón "Siguiente" con el dato_id
  function mostrarBotonSiguiente(mostrar, idAgroambiental = null) {
    if (siguienteContainer) {
      if (mostrar && fincaId) {
        siguienteContainer.classList.remove('hidden');
        // Construir URL con finca_id y dato_id
        let url = `/satelital?finca_id=${fincaId}`;
        if (idAgroambiental) {
          url += `&dato_id=${idAgroambiental}`;
        }
        if (irSatelital) {
          irSatelital.href = url;
          console.log('🔗 URL Satelital:', url);
        }
      } else {
        siguienteContainer.classList.add('hidden');
      }
    }
  }

  // Calcular Total Stock de Carbono
  function calcularTotalStock() {
    const biomasaArboles = parseFloat(fields.biomasa_arboles?.value) || 0;
    const biomasaCafe = parseFloat(fields.biomasa_cafe?.value) || 0;
    const hojarasca = parseFloat(fields.hojarasca_mantillo?.value) || 0;
    const carbonoOrganico = parseFloat(fields.carbono_organico_suelo?.value) || 0;
    
    const total = biomasaArboles + biomasaCafe + hojarasca + carbonoOrganico;
    
    if (fields.total_stock_carbono) {
      fields.total_stock_carbono.value = total.toFixed(2);
    }
    return total;
  }

  // Mostrar mensaje
  function showMessage(text, isError = false) {
    if (!messageEl) return;
    messageEl.textContent = text;
    messageEl.classList.remove('hidden', 'text-error', 'text-success');
    messageEl.classList.add(isError ? 'text-error' : 'text-success');
  }

  function hideMessage() {
    if (messageEl) {
      messageEl.textContent = '';
      messageEl.classList.add('hidden');
    }
  }

  // Limpiar formulario (solo para INVESTIGADOR)
  function limpiarFormulario() {
    Object.values(fields).forEach(field => {
      if (field && field.tagName === 'INPUT' && !field.readOnly) {
        field.value = '';
      } else if (field && field.tagName === 'SELECT') {
        field.value = '';
      }
    });
    
    const dynamicInputs = dynamicVariablesEl?.querySelectorAll('input');
    if (dynamicInputs) {
      dynamicInputs.forEach(input => input.value = '');
    }
    
    hideMessage();
  }

  // Obtener variables dinámicas del formulario
  function getDynamicVariables() {
    const inputs = dynamicVariablesEl?.querySelectorAll('input');
    if (!inputs || inputs.length === 0) return [];
    
    return Array.from(inputs).map(input => ({
      nombre: input.placeholder || input.id.replace('variable-', ''),
      valor: input.value,
      tipo_dato: 'text'
    }));
  }

  // Cargar variables dinámicas y datos existentes
  async function loadExistingData() {
    if (!fincaId || !token) {
      return;
    }

    try {
      const datos = await AgroambientalService.getByFinca(fincaId, token);
      
      if (datos && datos.length > 0) {
        const dato = datos[0];
        datoId = dato.id;
        datosCargados = true;
        
        // Llenar campos con datos existentes
        if (fields.indice_shannon) fields.indice_shannon.value = dato.indice_shannon ?? '';
        if (fields.indice_simpson) fields.indice_simpson.value = dato.indice_simpson ?? '';
        if (fields.biomasa_arboles) fields.biomasa_arboles.value = dato.biomasa_arboles ?? '';
        if (fields.biomasa_cafe) fields.biomasa_cafe.value = dato.biomasa_cafe ?? '';
        if (fields.hojarasca_mantillo) fields.hojarasca_mantillo.value = dato.hojarasca_mantillo ?? '';
        if (fields.carbono_organico_suelo) fields.carbono_organico_suelo.value = dato.carbono_organico_suelo ?? '';
        
        // Si es PRODUCTOR (solo lectura), mostrar los valores en texto
        if (esProductor) {
          if (fields.uso_suelo_text) {
            fields.uso_suelo_text.value = mapUsoSuelo[dato.uso_suelo] || dato.uso_suelo || 'No especificado';
          }
          if (fields.cobertura_forestal_text) {
            fields.cobertura_forestal_text.value = mapCoberturaForestal[dato.cobertura_forestal] || dato.cobertura_forestal || 'No especificado';
          }
          if (fields.sistema_produccion_text) {
            fields.sistema_produccion_text.value = mapSistemaProduccion[dato.sistema_produccion] || dato.sistema_produccion || 'No especificado';
          }
        } else {
          // Si es INVESTIGADOR, seleccionar los valores en los selects
          if (fields.uso_suelo) fields.uso_suelo.value = dato.uso_suelo ?? '';
          if (fields.cobertura_forestal) fields.cobertura_forestal.value = dato.cobertura_forestal ?? '';
          if (fields.sistema_produccion) fields.sistema_produccion.value = dato.sistema_produccion ?? '';
        }
        
        calcularTotalStock();

        if (dato.variables && dato.variables.length > 0) {
          dynamicVariablesContainer.classList.remove('hidden');
          dynamicVariablesEl.innerHTML = dato.variables
            .map((v) => `
              <div>
                <label class="block mb-2 text-sm font-medium text-on-surface-variant">
                  ${v.nombre || 'Variable'}
                </label>
                <input
                  type="text"
                  id="variable-${v.id}"
                  name="variables[${v.nombre}]"
                  value="${v.valor || ''}"
                  placeholder="${v.nombre}"
                  ${esProductor ? 'readonly' : ''}
                  class="w-full h-14 px-4 rounded-xl border border-outline-variant ${esProductor ? 'bg-surface-container-low' : 'bg-white'} text-on-surface focus:ring-2 focus:ring-primary focus:outline-none"
                />
              </div>
            `)
            .join('');
        } else {
          dynamicVariablesContainer.classList.add('hidden');
          dynamicVariablesEl.innerHTML = '';
        }
        
        // Mostrar el botón "Siguiente" con el dato_id
        mostrarBotonSiguiente(true, datoId);
        
        if (!esProductor) {
          showMessage('✅ Datos cargados correctamente. Puedes modificarlos y guardar.', false);
          setTimeout(hideMessage, 3000);
        }
      } else {
        datosCargados = false;
        dynamicVariablesContainer.classList.add('hidden');
        dynamicVariablesEl.innerHTML = '';
        if (esProductor) {
          if (fields.uso_suelo_text) fields.uso_suelo_text.value = 'No especificado';
          if (fields.cobertura_forestal_text) fields.cobertura_forestal_text.value = 'No especificado';
          if (fields.sistema_produccion_text) fields.sistema_produccion_text.value = 'No especificado';
        }
        // Ocultar el botón "Siguiente" si no hay datos
        mostrarBotonSiguiente(false);
      }
    } catch (error) {
      console.error('❌ Error cargando datos:', error);
      datosCargados = false;
      dynamicVariablesContainer.classList.add('hidden');
      dynamicVariablesEl.innerHTML = '';
      if (esProductor) {
        if (fields.uso_suelo_text) fields.uso_suelo_text.value = 'Error al cargar';
        if (fields.cobertura_forestal_text) fields.cobertura_forestal_text.value = 'Error al cargar';
        if (fields.sistema_produccion_text) fields.sistema_produccion_text.value = 'Error al cargar';
      }
      // Ocultar el botón "Siguiente" en caso de error
      mostrarBotonSiguiente(false);
    }
  }

  // Cargar datos de la finca (solo coordenadas - ELIMINADO)
  // Ya no se cargan coordenadas porque se eliminó la sección

  // Guardar datos agroambientales (solo para INVESTIGADOR)
  async function guardarInfoAgro() {
    if (esProductor) {
      showMessage('❌ No tienes permisos para modificar esta información.', true);
      return;
    }

    if (!token) {
      showMessage('❌ No se encontró token de autenticación.', true);
      return;
    }

    if (!fincaId) {
      showMessage('❌ No se encontró ID de finca.', true);
      return;
    }

    // Validar campos obligatorios
    const usoSuelo = fields.uso_suelo?.value;
    const coberturaForestal = fields.cobertura_forestal?.value;
    const sistemaProduccion = fields.sistema_produccion?.value;

    if (!usoSuelo || !coberturaForestal || !sistemaProduccion) {
      showMessage('❌ Los campos Uso de Suelo, Cobertura Forestal y Sistema de Producción son obligatorios.', true);
      return;
    }

    // Recopilar datos del formulario
    const payload = {
      indice_shannon: parseFloat(fields.indice_shannon?.value) || 0,
      indice_simpson: parseFloat(fields.indice_simpson?.value) || 0,
      uso_suelo: usoSuelo,
      cobertura_forestal: coberturaForestal,
      sistema_produccion: sistemaProduccion,
      biomasa_arboles: parseFloat(fields.biomasa_arboles?.value) || 0,
      biomasa_cafe: parseFloat(fields.biomasa_cafe?.value) || 0,
      hojarasca_mantillo: parseFloat(fields.hojarasca_mantillo?.value) || 0,
      carbono_organico_suelo: parseFloat(fields.carbono_organico_suelo?.value) || 0,
      finca_id: fincaId,
      variables: getDynamicVariables()
    };

    console.log('📤 [INFOAGRO] Guardando payload:', payload);

    try {
      showMessage('💾 Guardando información agroambiental...', false);
      
      let result;
      if (datoId) {
        const updatePayload = { ...payload };
        delete updatePayload.finca_id;
        delete updatePayload.variables;
        
        result = await AgroambientalService.update(datoId, updatePayload, token);
        console.log('✅ [INFOAGRO] Actualizado:', result);
        showMessage('✅ Información agroambiental actualizada correctamente.', false);
      } else {
        result = await AgroambientalService.create(payload, token);
        datoId = result.id;
        console.log('✅ [INFOAGRO] Creado:', result);
        showMessage('✅ Información agroambiental creada correctamente.', false);
      }
      
      // Mostrar el botón "Siguiente" después de guardar con el datoId
      mostrarBotonSiguiente(true, datoId);
      
      setTimeout(hideMessage, 3000);

    } catch (error) {
      console.error('❌ [INFOAGRO] Error guardando:', error);
      showMessage(`❌ Error: ${error instanceof Error ? error.message : 'Error al guardar'}`, true);
    }
  }

  // --- EVENTO VOLVER ---
  if (volverBtn) {
    volverBtn.addEventListener('click', () => {
      window.location.href = '/productorFinca';
    });
  }

  // --- EVENTO GUARDAR (solo para INVESTIGADOR) ---
  if (guardarBtn && !esProductor) {
    guardarBtn.addEventListener('click', (e) => {
      e.preventDefault();
      guardarInfoAgro();
    });
  }

  // --- EVENTO LIMPIAR (solo para INVESTIGADOR) ---
  if (limpiarBtn && !esProductor) {
    limpiarBtn.addEventListener('click', () => {
      if (confirm('¿Estás seguro de que quieres limpiar todos los campos?')) {
        limpiarFormulario();
        showMessage('🧹 Formulario limpiado', false);
        setTimeout(hideMessage, 2000);
      }
    });
  }

  // Recalcular total stock al cambiar campos relevantes (solo para INVESTIGADOR)
  if (!esProductor) {
    const camposStock = ['biomasa_arboles', 'biomasa_cafe', 'hojarasca_mantillo', 'carbono_organico_suelo'];
    camposStock.forEach(id => {
      const el = document.getElementById(id);
      if (el) {
        el.addEventListener('input', calcularTotalStock);
        el.addEventListener('change', calcularTotalStock);
      }
    });
  }

  // Inicializar
  console.log('🚀 [INFOAGRO] Inicializando página...');
  loadExistingData();
</script>