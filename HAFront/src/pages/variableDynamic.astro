---
import DashboardLayout from "../layouts/LayoutVariable.astro";
---

<DashboardLayout title="Management Dashboard">

  <div class="space-y-6">

    <!-- HEADER -->
    <section>
      <h1 class="text-3xl font-bold text-primary">
        Dynamic Asset Management
      </h1>

      <p class="text-on-surface-variant mt-2 max-w-2xl">
        Configure your schema and manage environmental records with precision and compliance tracking.
      </p>
    </section>

    <!-- GRID PRINCIPAL -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

      <!-- FORMULARIO -->
      <div
        class="lg:col-span-4 bg-surface-container-low border border-outline-variant rounded-xl p-6 shadow-sm"
      >

        <div class="flex items-center gap-2 mb-5">
          <span class="material-symbols-outlined text-primary">
            add_circle
          </span>

          <h2 class="font-semibold text-lg">
            Crear Nueva Variable
          </h2>
        </div>

        <form id="variable-form" class="space-y-5">

          <!-- Nombre -->
          <div>
            <label class="block text-sm font-medium mb-2">
              Nombre / Etiqueta de la Variable
            </label>

            <input
              id="variable-name"
              type="text"
              placeholder="Ej. pH del Suelo"
              class="w-full h-12 px-4 rounded-xl border border-outline-variant bg-surface focus:outline-none focus:ring-2 focus:ring-primary"
              required
            />
          </div>

          <!-- Sección -->
          <div>
            <label class="block text-sm font-medium mb-2">
              Sección de Destino
            </label>

            <select
              id="variable-module"
              class="w-full h-12 px-4 rounded-xl border border-outline-variant bg-surface focus:outline-none focus:ring-2 focus:ring-primary"
            >
              <option value="Biodiversidad">Módulo de Biodiversidad</option>
              <option value="Carbono">Módulo de Carbono</option>
              <option value="Recursos Hídricos">Módulo de Recursos Hídricos</option>
              <option value="Suelos">Módulo de Suelos</option>
            </select>
          </div>

          <!-- Tipo -->
          <div>
            <label class="block text-sm font-medium mb-2">
              Tipo de Dato
            </label>

            <select
              id="variable-type"
              class="w-full h-12 px-4 rounded-xl border border-outline-variant bg-surface focus:outline-none focus:ring-2 focus:ring-primary"
            >
              <option value="FLOAT">Numérico (Decimal/Entero)</option>
              <option value="STRING">Texto</option>
              <option value="BOOLEAN">Booleano (Sí / No)</option>
              <option value="DATE">Fecha</option>
              <option value="FLOAT">Porcentaje (%)</option>
            </select>
          </div>

          <!-- Valor por defecto -->
          <div>
            <label class="block text-sm font-medium mb-2">
              Valor por Defecto
            </label>

            <input
              id="variable-default"
              type="text"
              placeholder="Opcional"
              class="w-full h-12 px-4 rounded-xl border border-outline-variant bg-surface focus:outline-none focus:ring-2 focus:ring-primary"
            />
          </div>

          <button
            type="submit"
            class="w-full h-12 bg-primary text-white rounded-xl font-medium hover:opacity-90 transition"
          >
            Crear Variable
          </button>

          <p id="variable-message" class="text-sm text-error mt-2 hidden"></p>

        </form>

      </div>

      <!-- TABLA DE VARIABLES -->
      <div
        class="lg:col-span-8 bg-surface-container-lowest border border-outline-variant rounded-xl overflow-hidden shadow-sm"
      >

        <!-- HEADER TABLA -->
        <div class="p-5 border-b border-outline-variant flex justify-between items-center bg-surface-container">

          <h2 class="font-semibold text-lg">
            Variables Activas
          </h2>

          <span
            id="variable-count"
            class="text-xs px-3 py-1 rounded-full bg-secondary-container text-secondary font-medium"
          >
            0 Variables
          </span>

        </div>

        <!-- TABLA -->
        <div class="overflow-x-auto">

          <table class="w-full">

            <thead
              class="bg-surface-container text-on-surface-variant uppercase tracking-wider text-xs"
            >
              <tr>

                <th class="px-5 py-4 text-left font-semibold">
                  Variable
                </th>

                <th class="px-5 py-4 text-left font-semibold">
                  Tipo
                </th>

                <th class="px-5 py-4 text-left font-semibold">
                  Valor
                </th>

                <th class="px-5 py-4 text-right font-semibold">
                  Acciones
                </th>

              </tr>
            </thead>

            <tbody id="variables-table-body" class="divide-y divide-outline-variant text-sm">
              <tr>
                <td colspan="4" class="p-6 text-center text-on-surface-variant">
                  Cargando variables...
                </td>
              </tr>
            </tbody>

          </table>

        </div>

      </div>

    </div>

  </div>

</DashboardLayout>

<script type="module">
  import { VariableService } from "../services/variableservices.ts";

  const tableBody = document.getElementById("variables-table-body");
  const countBadge = document.getElementById("variable-count");
  const messageBox = document.getElementById("variable-message");
  const form = document.getElementById("variable-form");

  const queryParams = new URLSearchParams(window.location.search);
  const datoId = queryParams.get("dato_id") || "REEMPLAZAR_POR_DATO_ID";

  function getCookie(name) {
    const match = document.cookie.match(new RegExp(`(?:^|; )${name}=([^;]*)`));
    return match ? decodeURIComponent(match[1]) : "";
  }

  const token = getCookie("token");

  function showMessage(text, isError = false) {
    if (!messageBox) return;
    messageBox.textContent = text;
    messageBox.classList.remove("hidden");
    messageBox.classList.toggle("text-error", isError);
    messageBox.classList.toggle("text-success", !isError);
    setTimeout(() => {
      messageBox.classList.add("hidden");
    }, 4000);
  }

  async function loadVariables() {
    if (!tableBody || !countBadge) return;
    tableBody.innerHTML = `<tr><td colspan="4" class="p-6 text-center text-on-surface-variant">Cargando variables...</td></tr>`;
    try {
      const variables = await VariableService.list(datoId, token);
      if (variables.length === 0) {
        tableBody.innerHTML = `<tr><td colspan="4" class="p-6 text-center text-on-surface-variant">No hay variables registradas.</td></tr>`;
      } else {
        tableBody.innerHTML = variables
          .map(
            (variable) => `
              <tr class="bg-white hover:bg-surface-container-low transition-colors">
                <td class="px-5 py-5 font-medium text-on-surface">${variable.nombre}</td>
                <td class="px-5 py-5 text-on-surface">${variable.tipo_dato}</td>
                <td class="px-5 py-5 text-on-surface">${variable.valor}</td>
                <td class="px-5 py-5 text-right">
                  <button data-id="${variable.id}" class="delete-variable text-error font-medium hover:underline">Eliminar</button>
                </td>
              </tr>
            `
          )
          .join("");
      }
      countBadge.textContent = `${variables.length} Variables`;
    } catch (error) {
      tableBody.innerHTML = `<tr><td colspan="4" class="p-6 text-center text-error">${error instanceof Error ? error.message : "Error al cargar variables."}</td></tr>`;
      countBadge.textContent = `0 Variables`;
    }
  }

  async function createVariable(event) {
    event.preventDefault();
    const nombre = document.getElementById("variable-name").value.trim();
    const tipo_dato = document.getElementById("variable-type").value;
    const valor = document.getElementById("variable-default").value.trim();

    if (!nombre) {
      showMessage("El nombre de la variable es obligatorio.", true);
      return;
    }

    try {
      await VariableService.create(datoId, {
        nombre,
        valor: valor || "",
        tipo_dato,
      }, token);
      showMessage("Variable creada correctamente.");
      form.reset();
      loadVariables();
    } catch (error) {
      showMessage(error instanceof Error ? error.message : "No se pudo crear la variable.", true);
    }
  }

  async function deleteVariable(id) {
    try {
      await VariableService.delete(datoId, Number(id), token);
      showMessage("Variable eliminada correctamente.");
      loadVariables();
    } catch (error) {
      showMessage(error instanceof Error ? error.message : "No se pudo eliminar la variable.", true);
    }
  }

  if (form) {
    form.addEventListener("submit", createVariable);
  }

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;
    const id = target.dataset.id;
    if (!id) return;

    if (target.classList.contains("delete-variable")) {
      if (!confirm("¿Eliminar esta variable?")) return;
      deleteVariable(id);
    }
  });

  if (!token) {
    showMessage("Token no encontrado. Inicia sesión para usar este módulo.", true);
    if (tableBody) {
      tableBody.innerHTML = `<tr><td colspan="4" class="p-6 text-center text-error">Inicia sesión para ver las variables.</td></tr>`;
    }
  } else {
    loadVariables();
  }
</script>
