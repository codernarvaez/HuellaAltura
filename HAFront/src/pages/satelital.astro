---
import Layout from "../layouts/LayoutVariable.astro";
import { GeoespacialService } from "/src/services/geoespacial.service.ts";
import { FincaService } from "../services/finca.service.ts";
import { AuthService } from "../services/auth.service.ts";
import { ExpedienteService } from "../services/expediente.service.ts";

// Obtener parámetros de la URL
const urlParams = Astro.url.searchParams;
const fincaId = urlParams.get("finca_id");
const datoId = urlParams.get("dato_id");

// Obtener token de las cookies
const token = Astro.cookies.get("token")?.value;

let fincaData = null;
let validacionEudr = null;
let error = null;
let isLoading = true;
let userRole = null;
let expedienteExistente = null;
let expedienteId = null;

// Solo intentar cargar si hay token y fincaId
if (token && fincaId) {
  try {
    // Obtener datos del usuario
    const userData = await AuthService.getMe(token);
    userRole = userData?.role?.name || '';
    console.log("🎭 Rol del usuario:", userRole);
    
    // Cargar datos de la finca
    try {
      fincaData = await FincaService.getById(fincaId, token);
      console.log("✅ Finca cargada:", fincaData);
      console.log("📊 Estado EUDR de la finca:", fincaData?.estado_eudr);
    } catch (e) {
      console.error("❌ Error cargando finca:", e);
      error = "No se pudo cargar la información de la finca.";
      isLoading = false;
    }
    
    // Verificar expediente solo si se cargó la finca
    if (fincaData) {
      try {
        const expedientes = await ExpedienteService.list(token, { finca_id: fincaId });
        if (expedientes && expedientes.length > 0) {
          expedienteExistente = expedientes[0];
          expedienteId = expedienteExistente.id;
          console.log("✅ Expediente existente:", expedienteExistente);
          console.log("📊 Estado del expediente:", expedienteExistente.estado);
        }
      } catch (e) {
        console.warn("⚠️ Error verificando expediente:", e);
      }
      
      // Intentar validar EUDR
      try {
        validacionEudr = await GeoespacialService.validarEudr(fincaId, token);
        console.log("✅ Validación EUDR:", validacionEudr);
      } catch (e) {
        console.warn("⚠️ Error en validación EUDR:", e);
        validacionEudr = null;
      }
    }
    
    isLoading = false;
  } catch (e) {
    error = e.message;
    console.error("❌ Error cargando datos:", e);
    isLoading = false;
  }
} else {
  isLoading = false;
  if (!token) {
    error = "No hay sesión activa. Por favor, inicia sesión.";
  } else if (!fincaId) {
    error = "No se encontró ID de finca en la URL";
  }
}

// Determinar si es PRODUCTOR
const esProductor = userRole === 'PRODUCTOR';

// Determinar estado de validación - USAMOS fincaData.estado_eudr
let estadoEudr = fincaData?.estado_eudr || "PENDIENTE";

// Si el expediente existe y está APROBADO, forzamos estadoEudr a APROBADO
if (expedienteExistente) {
  const estadoExp = expedienteExistente.estado || 'PENDIENTE';
  if (estadoExp === "APROBADO" || estadoExp === "VALIDADO") {
    estadoEudr = "APROBADO";
    console.log("🔥 Forzando estadoEudr a APROBADO por expediente");
  }
}

console.log("📊 Estado EUDR final:", estadoEudr);

let deforestacionDetectada = false;
let porcentajeDeforestacion = 0;
let fechaAnalisis = new Date().toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' });
let fuente = "Google Earth Engine - Sentinel-2";

// Si hay validación EUDR, usamos esos datos para enriquecer
if (validacionEudr) {
  // Solo actualizamos si la finca no tiene estado o está pendiente
  if (estadoEudr === "PENDIENTE" || !estadoEudr) {
    estadoEudr = validacionEudr?.resultado?.estado_eudr || 
                 validacionEudr?.estado_eudr || 
                 estadoEudr;
  }
  
  deforestacionDetectada = validacionEudr?.resultado?.deforestacion_detectada !== undefined 
    ? validacionEudr.resultado.deforestacion_detectada 
    : (validacionEudr?.deforestacion_detectada || false);
    
  porcentajeDeforestacion = validacionEudr?.resultado?.porcentaje !== undefined
    ? validacionEudr.resultado.porcentaje
    : (validacionEudr?.porcentaje || 0);
    
  fechaAnalisis = validacionEudr?.resultado?.fecha_analisis || 
                  validacionEudr?.fecha_analisis || 
                  new Date().toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' });
                  
  fuente = validacionEudr?.resultado?.fuente || 
           validacionEudr?.fuente || 
           "Google Earth Engine - Sentinel-2";
}

// Determinar badge de estado
let estadoBadge = "Pendiente";
let estadoColor = "text-blue-700";
let estadoFondo = "bg-blue-50 border-blue-200";

if (estadoEudr === "APROBADO" || estadoEudr === "VALIDADO") {
  estadoBadge = "Aprobado";
  estadoColor = "text-green-700";
  estadoFondo = "bg-green-50 border-green-200";
} else if (estadoEudr === "PRE_VALIDADO" || estadoEudr === "PREVALIDADO") {
  estadoBadge = "Pre-validado";
  estadoColor = "text-yellow-700";
  estadoFondo = "bg-yellow-50 border-yellow-200";
} else if (estadoEudr === "ALERTA" || estadoEudr === "DEFORESTACION") {
  estadoBadge = "¡Alerta!";
  estadoColor = "text-red-700";
  estadoFondo = "bg-red-50 border-red-200";
} else if (estadoEudr === "RECHAZADO") {
  estadoBadge = "Rechazado";
  estadoColor = "text-red-700";
  estadoFondo = "bg-red-50 border-red-200";
}

// Determinar si la validación ha sido realizada por un admin
const validacionRealizada = estadoEudr !== "PENDIENTE";

// Roles permitidos para ejecutar auditoría
const rolesPermitidos = ['SUPER_ADMIN', 'TENANT_ADMIN', 'TECNICO_CAMPO', 'AUDITOR_INTERNO'];
const tienePermisoAuditoria = rolesPermitidos.includes(userRole);

// El productor solo puede ver el resultado si ya fue validado por un admin
const puedeVerResultado = !esProductor || (esProductor && validacionRealizada);

// Determinar si el botón de expediente está habilitado
const expedienteHabilitado = (estadoEudr === "APROBADO" || estadoEudr === "VALIDADO" || 
                             (expedienteExistente && (expedienteExistente.estado === "APROBADO" || expedienteExistente.estado === "VALIDADO")));

console.log("🔍 expedienteHabilitado:", expedienteHabilitado);
console.log("📊 estadoEudr:", estadoEudr);
console.log("📊 expedienteExistente:", expedienteExistente?.estado);

// Convertir variables para el cliente
const esProductorStr = JSON.stringify(esProductor);
const puedeVerResultadoStr = JSON.stringify(puedeVerResultado);
const validacionRealizadaStr = JSON.stringify(validacionRealizada);
const expedienteHabilitadoStr = JSON.stringify(expedienteHabilitado);
const tienePermisoAuditoriaStr = JSON.stringify(tienePermisoAuditoria);
const fincaIdStr = fincaId || '';
const expedienteIdStr = expedienteId || '';
const estadoEudrStr = estadoEudr;
const existeExpedienteStr = JSON.stringify(!!expedienteExistente);
const expedienteEstadoStr = expedienteExistente?.estado || 'PENDIENTE';
const fincaNombre = fincaData?.nombre || 'Finca sin nombre';
---

<Layout title="Huella de Altura | Auditoría Satelital">

<!-- Datos inyectados para el cliente -->
<script>
  window.ES_PRODUCTOR = {esProductorStr};
  window.PUEDE_VER_RESULTADO = {puedeVerResultadoStr};
  window.VALIDACION_REALIZADA = {validacionRealizadaStr};
  window.EXPEDIENTE_HABILITADO = {expedienteHabilitadoStr};
  window.TIENE_PERMISO_AUDITORIA = {tienePermisoAuditoriaStr};
  window.FINCA_ID = "{fincaIdStr}";
  window.EXPEDIENTE_ID = "{expedienteIdStr}";
  window.ESTADO_EUDR = "{estadoEudrStr}";
  window.EXISTE_EXPEDIENTE = {existeExpedienteStr};
  window.EXPEDIENTE_ESTADO = "{expedienteEstadoStr}";
  
  console.log('📋 Datos inyectados en cliente:', {
    ES_PRODUCTOR: window.ES_PRODUCTOR,
    FINCA_ID: window.FINCA_ID,
    ESTADO_EUDR: window.ESTADO_EUDR,
    EXPEDIENTE_HABILITADO: window.EXPEDIENTE_HABILITADO,
    EXISTE_EXPEDIENTE: window.EXISTE_EXPEDIENTE,
    EXPEDIENTE_ESTADO: window.EXPEDIENTE_ESTADO
  });
</script>

<section class="flex overflow-hidden -m-8" style="height: calc(100vh - 4rem);">

  <div class="flex-grow relative bg-surface-dim overflow-hidden">

    <!-- Imagen de fondo del mapa -->
    <div class="absolute inset-0 z-0">
      <img
        alt="Mapa Satelital"
        class="w-full h-full object-cover grayscale-[0.2] contrast-[1.1]"
        src="https://lh3.googleusercontent.com/aida-public/AB6AXuCDjAtsFX3vINrNQMtsTCQyAm5BcIy-r1CDh39eHkSCO-lPkbrpW3lKJXRxrSlzw1Aie7kt1beOXOiRSgmcd2lCRNeNNrO2c9HRB5sShshVsCfKPBWwHQnW-QGU_5ot0cv51KkIfCHH1qUOOc53PO8wApcFvki8fKTibBgusGFdLG_Y7O6IO9LH_yOKFjUIsP8rTIi9KfUNRqli0AgHXOnplAi_wvT39b3gvY9I1AhP7jMudm3Oxa_Dchg4wHq7Y0wHNeXC9kwAoi9M"
      />
      <div class="absolute inset-0 map-gradient-overlay"></div>
    </div>

    <!-- Línea de escaneo -->
    <div class="scanning-line"></div>

    <!-- Panel superior izquierdo -->
    <div class="absolute top-4 left-4 z-30 flex flex-col gap-3">

      <div class="glass-panel border border-outline-variant rounded-xl p-4 shadow-sm w-64">
        <div class="flex justify-between items-start mb-1">
          <span class="text-xs text-on-surface-variant uppercase tracking-wider font-semibold">Índice Satelital</span>
          <span class="px-2 py-0.5 bg-primary-container text-on-primary-container rounded text-[10px] font-bold">EN VIVO</span>
        </div>
        <div class="text-xl font-semibold text-primary mt-1">Sentinel-2B</div>
        <div class="mt-2 flex flex-col gap-1">
          <div class="flex justify-between text-xs">
            <span class="text-on-surface-variant">Banda Espectral</span>
            <span class="font-mono">B8A (Borde Rojo)</span>
          </div>
          <div class="flex justify-between text-xs">
            <span class="text-on-surface-variant">Cobertura Nubosa</span>
            <span class="font-mono text-green-600">0.4%</span>
          </div>
        </div>
      </div>

      <div class="glass-panel border border-outline-variant rounded-xl p-4 shadow-sm w-64">
        <span class="text-xs text-on-surface-variant uppercase tracking-wider font-semibold">Finca</span>
        <div class="mt-2 space-y-2">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-sm text-secondary">agriculture</span>
            <span class="text-sm font-semibold">{fincaData?.nombre || 'No cargada'}</span>
          </div>
          {fincaData?.provincia && (
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-sm text-secondary">location_on</span>
              <span class="text-sm font-mono">{fincaData.provincia}, {fincaData.canton || ''}</span>
            </div>
          )}
          {fincaData?.area_total_ha && (
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-sm text-secondary">square_foot</span>
              <span class="text-sm font-mono">{fincaData.area_total_ha} ha</span>
            </div>
          )}
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-sm text-secondary">badge</span>
            <span class="text-sm font-mono text-xs font-bold" style="color: {estadoColor.replace('text-', '')}">
              Estado: {estadoBadge}
            </span>
          </div>
          {esProductor && (
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-sm text-secondary">badge</span>
              <span class="text-sm font-mono text-xs text-blue-600">🔒 Rol: Productor (Solo lectura)</span>
            </div>
          )}
          {expedienteExistente && (
            <div class="flex items-center gap-2 mt-1 p-1.5 bg-emerald-50/50 rounded-md border border-emerald-200/50">
              <span class="material-symbols-outlined text-xs text-emerald-500">folder</span>
              <span class="text-[10px] text-emerald-600">Expediente: {expedienteExistente.id?.substring(0, 8)}</span>
            </div>
          )}
        </div>
      </div>
      
      {datoId && (
        <div class="glass-panel border border-outline-variant rounded-xl p-4 shadow-sm w-64">
          <span class="text-xs text-on-surface-variant uppercase tracking-wider font-semibold">Dato Agroambiental</span>
          <div class="mt-2">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-sm text-secondary">eco</span>
              <span class="text-sm font-mono">ID: {datoId.substring(0, 8)}...</span>
            </div>
          </div>
        </div>
      )}
    </div>

    <!-- Controles de zoom -->
    <div class="absolute bottom-4 right-4 z-30 flex flex-col gap-2">
      <button class="w-10 h-10 glass-panel border border-outline-variant rounded-lg flex items-center justify-center hover:bg-surface-container-high transition-colors">
        <span class="material-symbols-outlined text-primary">add</span>
      </button>
      <button class="w-10 h-10 glass-panel border border-outline-variant rounded-lg flex items-center justify-center hover:bg-surface-container-high transition-colors">
        <span class="material-symbols-outlined text-primary">remove</span>
      </button>
      <button class="w-10 h-10 glass-panel border border-outline-variant rounded-lg flex items-center justify-center hover:bg-surface-container-high transition-colors mt-4">
        <span class="material-symbols-outlined text-primary">layers</span>
      </button>
    </div>
  </div>

  <!-- Panel lateral derecho - Resultados de Auditoría -->
  <aside class="w-[380px] bg-surface-container-lowest border-l border-outline-variant flex flex-col p-6 overflow-y-auto shrink-0">

    <div class="mb-6">
      <h2 class="text-xl font-semibold text-primary mb-1">Resultados de la Auditoría</h2>
      <p class="text-on-surface-variant text-sm">
        {esProductor 
          ? 'Visualización de los resultados de la auditoría satelital realizada por el administrador.' 
          : 'Análisis en tiempo real del área poligonal seleccionada para el cumplimiento del EUDR.'}
      </p>
    </div>

    <!-- Estado de Validación EUDR -->
    <div class={`border rounded-xl p-4 mb-4 ${error ? 'bg-red-50 border-red-200' : estadoFondo}`}>
      <div class="flex items-center justify-between mb-4">
        <span class="text-sm font-bold text-on-surface">Estado de Validación EUDR</span>
        {!error && (
          <div class="flex items-center gap-2 px-3 py-1 bg-secondary/10 border border-secondary/20 rounded-full">
            <span class="w-2 h-2 rounded-full bg-secondary"></span>
            <span class="text-[10px] font-bold text-secondary uppercase tracking-tighter">{estadoBadge}</span>
          </div>
        )}
      </div>
      
      {isLoading ? (
        <div class="flex items-center justify-center py-8">
          <span class="material-symbols-outlined animate-spin text-primary">progress_activity</span>
          <span class="ml-2 text-on-surface-variant">Cargando validación...</span>
        </div>
      ) : error ? (
        <div class="text-red-600 text-sm">
          <span class="material-symbols-outlined text-sm align-middle">error</span>
          {error}
        </div>
      ) : !puedeVerResultado && esProductor ? (
        <!-- PRODUCTOR: Auditoría pendiente -->
        <div class="flex flex-col gap-3">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-full bg-blue-100 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-blue-500">hourglass_empty</span>
            </div>
            <div>
              <div class="font-bold text-on-surface text-sm">⏳ Auditoría en Proceso</div>
              <div class="text-xs text-on-surface-variant">
                La validación satelital está siendo realizada por el administrador.
              </div>
            </div>
          </div>
          <div class="border-t border-outline-variant pt-3">
            <p class="text-xs text-on-surface-variant">
              <span class="material-symbols-outlined text-sm align-middle text-blue-500">info</span>
              Una vez que el administrador complete la auditoría, podrás visualizar los resultados aquí.
            </p>
          </div>
        </div>
      ) : (
        <!-- Resultados de la auditoría -->
        <div class="flex flex-col gap-3">
          <div class="flex items-center gap-3">
            <div class={`w-12 h-12 rounded-full flex items-center justify-center shrink-0 ${
              estadoEudr === "APROBADO" || estadoEudr === "VALIDADO" 
                ? 'bg-green-100' 
                : estadoEudr === "ALERTA" || estadoEudr === "RECHAZADO"
                  ? 'bg-red-100' 
                  : 'bg-yellow-100'
            }`}>
              <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">
                {estadoEudr === "APROBADO" || estadoEudr === "VALIDADO" 
                  ? 'verified_user' 
                  : estadoEudr === "ALERTA" || estadoEudr === "RECHAZADO"
                    ? 'warning' 
                    : 'pending'}
              </span>
            </div>
            <div>
              <div class="font-bold text-on-surface text-sm">
                {estadoEudr === "APROBADO" || estadoEudr === "VALIDADO"
                  ? '✅ Auditoría Aprobada'
                  : estadoEudr === "RECHAZADO"
                    ? '❌ Auditoría Rechazada'
                    : estadoEudr === "ALERTA"
                      ? '⚠️ Alerta de Deforestación'
                      : '⏳ Pendiente de Validación'}
              </div>
              <div class="text-xs text-on-surface-variant">
                Comparación de línea base: 31-12-2020
              </div>
              {esProductor && validacionRealizada && (
                <div class="text-[10px] text-blue-600 mt-1">
                  ✅ Validación realizada por administrador
                </div>
              )}
              {expedienteExistente && (estadoEudr === "APROBADO" || estadoEudr === "VALIDADO") && (
                <div class="text-[10px] text-emerald-600 mt-1">
                  ✅ Expediente vinculado y aprobado
                </div>
              )}
            </div>
          </div>
          
          {porcentajeDeforestacion > 0 && (
            <div class="border-t border-outline-variant pt-3 flex flex-col gap-2">
              <div class="flex justify-between text-sm">
                <span class="text-on-surface-variant">Porcentaje de Deforestación</span>
                <span class="font-bold">{porcentajeDeforestacion}%</span>
              </div>
              <div class="w-full bg-outline-variant rounded-full h-1.5 overflow-hidden">
                <div class={`h-full ${porcentajeDeforestacion > 10 ? 'bg-red-500' : 'bg-green-500'}`} style="width: {Math.min(porcentajeDeforestacion, 100)}%"></div>
              </div>
            </div>
          )}

          <div class="border-t border-outline-variant pt-3 flex flex-col gap-1">
            <div class="flex justify-between text-xs">
              <span class="text-on-surface-variant">Fecha de Análisis</span>
              <span class="font-mono">{fechaAnalisis}</span>
            </div>
            <div class="flex justify-between text-xs">
              <span class="text-on-surface-variant">Fuente</span>
              <span class="font-mono text-xs">{fuente}</span>
            </div>
            {fincaData?.eudr_id && (
              <div class="flex justify-between text-xs">
                <span class="text-on-surface-variant">EUDR ID</span>
                <span class="font-mono text-xs">{fincaData.eudr_id}</span>
              </div>
            )}
            {expedienteExistente && (
              <div class="flex justify-between text-xs">
                <span class="text-on-surface-variant">Expediente</span>
                <span class="font-mono text-xs text-emerald-600">{expedienteExistente.id?.substring(0, 8)}...</span>
              </div>
            )}
          </div>
        </div>
      )}
    </div>

    <!-- Información de la finca -->
    {fincaData && (
      <div class="bg-surface-container-low border border-outline-variant rounded-xl p-4 mb-4">
        <span class="text-xs text-on-surface-variant uppercase tracking-wider font-semibold">Datos de la Finca</span>
        <div class="mt-2 space-y-1">
          <div class="flex justify-between text-sm">
            <span class="text-on-surface-variant">Nombre</span>
            <span class="font-semibold">{fincaData.nombre}</span>
          </div>
          <div class="flex justify-between text-sm">
            <span class="text-on-surface-variant">Provincia</span>
            <span>{fincaData.provincia || 'N/A'}</span>
          </div>
          <div class="flex justify-between text-sm">
            <span class="text-on-surface-variant">Cantón</span>
            <span>{fincaData.canton || 'N/A'}</span>
          </div>
          <div class="flex justify-between text-sm">
            <span class="text-on-surface-variant">Área Total</span>
            <span>{fincaData.area_total_ha || 0} ha</span>
          </div>
          <div class="flex justify-between text-sm">
            <span class="text-on-surface-variant">Estado EUDR</span>
            <span class={`font-semibold ${estadoColor}`}>{estadoBadge}</span>
          </div>
          {expedienteExistente && (
            <div class="flex justify-between text-sm">
              <span class="text-on-surface-variant">Expediente</span>
              <span class="font-mono text-xs text-emerald-600">{expedienteExistente.id?.substring(0, 8)}...</span>
            </div>
          )}
        </div>
      </div>
    )}

    <div class="flex items-start gap-3 p-3 rounded-lg bg-surface-container mb-6">
      <span class="material-symbols-outlined text-primary-container shrink-0">info</span>
      <p class="text-xs leading-relaxed text-on-surface-variant">
        {esProductor 
          ? 'Los resultados mostrados corresponden a la auditoría realizada por el administrador.'
          : 'Auditoría basada en datos del Copernicus Open Access Hub. Precisión geométrica: +/- 5m.'}
      </p>
    </div>

    <!-- Botones de acción según rol -->
    <div class="mt-auto space-y-3">
      {!esProductor && !error && (
        <!-- Admin: Botón Ejecutar Auditoría -->
        <button
          id="btn-audit"
          class={`w-full py-3 rounded-xl font-bold transition-all flex items-center justify-center gap-2 shadow-sm group ${
            tienePermisoAuditoria && !error
              ? 'bg-primary text-white hover:opacity-90 active:scale-[0.98]' 
              : 'bg-gray-300 text-gray-500 cursor-not-allowed'
          }`}
          data-finca-id={fincaId}
          {!(tienePermisoAuditoria && !error) && 'disabled'}
        >
          <span class="material-symbols-outlined transition-transform group-hover:rotate-180">
            {tienePermisoAuditoria && !error ? 'refresh' : 'lock'}
          </span>
          {tienePermisoAuditoria && !error ? 'Ejecutar Auditoría GEE' : 'Sin Permisos'}
        </button>
      )}

      <!-- Botón Generar/Ver Expediente - 🔥 CORREGIDO: Sin comillas dobles en los atributos data -->
      <a
        id="btn-generar-expediente"
        href="#"
        class={`w-full py-3 rounded-xl font-bold transition-all flex items-center justify-center gap-2 shadow-sm ${
          expedienteExistente 
            ? 'bg-emerald-500 hover:bg-emerald-600 text-white' 
            : expedienteHabilitado && !error
              ? 'bg-amber-500 hover:bg-amber-600 text-white'
              : 'bg-gray-300 text-gray-500 cursor-not-allowed'
        }`}
        data-finca-id={fincaId}
        data-expediente-id={expedienteId}
        data-existe={!!expedienteExistente}
        data-estado-eudr={estadoEudr}
        data-expediente-estado={expedienteExistente?.estado || 'PENDIENTE'}
      >
        <span class="material-symbols-outlined">
          {expedienteExistente ? 'folder_open' : 'description'}
        </span>
        {expedienteExistente ? 'Ver Expediente' : 'Generar Expediente'}
      </a>

      {esProductor && !validacionRealizada && !error && (
        <div class="text-center text-xs text-on-surface-variant bg-blue-50 p-3 rounded-xl border border-blue-200">
          <span class="material-symbols-outlined text-sm align-middle text-blue-500">schedule</span>
          Esperando validación del administrador...
        </div>
      )}
    </div>

  </aside>
</section>

</Layout>

<style>
  .scanning-line {
    position: absolute;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, transparent, #0d5c3a, transparent);
    box-shadow: 0 0 15px #8ed6aa;
    animation: scan 4s linear infinite;
    z-index: 20;
  }
  @keyframes scan {
    0%   { top: 0%;   opacity: 0; }
    10%  { opacity: 1; }
    90%  { opacity: 1; }
    100% { top: 100%; opacity: 0; }
  }
  .glass-panel {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .map-gradient-overlay {
    background: radial-gradient(circle at center, transparent 30%, rgba(0, 67, 40, 0.1) 100%);
  }
</style>

<script>
  import { GeoespacialService } from "/src/services/geoespacial.service.ts"
  import { ExpedienteService } from "/src/services/expediente.service.ts";

  document.addEventListener('DOMContentLoaded', () => {
    const btnAudit = document.getElementById("btn-audit");
    const btnExpediente = document.getElementById("btn-generar-expediente");
    const scanningLine = document.querySelector(".scanning-line");
    
    // Obtener datos del enlace - 🔥 AHORA CON VALORES REALES
    const fincaId = btnExpediente?.getAttribute('data-finca-id') || '';
    const expedienteId = btnExpediente?.getAttribute('data-expediente-id') || '';
    const existeExpediente = btnExpediente?.getAttribute('data-existe') === 'true';
    const estadoEudrAttr = btnExpediente?.getAttribute('data-estado-eudr') || 'PENDIENTE';
    const expedienteEstadoAttr = btnExpediente?.getAttribute('data-expediente-estado') || 'PENDIENTE';
    
    // Obtener valores de window
    const esProductor = window.ES_PRODUCTOR === true;
    const tienePermisoAuditoria = window.TIENE_PERMISO_AUDITORIA === true;
    const fincaIdWindow = window.FINCA_ID || fincaId;
    const estadoEudr = window.ESTADO_EUDR || estadoEudrAttr || 'PENDIENTE';
    const expedienteHabilitado = window.EXPEDIENTE_HABILITADO === true;
    const expedienteEstado = window.EXPEDIENTE_ESTADO || expedienteEstadoAttr || 'PENDIENTE';

    console.log('📋 Configuración en cliente:', { 
      fincaId: fincaIdWindow, 
      existeExpediente, 
      estadoEudr,
      expedienteHabilitado,
      expedienteEstado,
      estadoEudrAttr,
      expedienteEstadoAttr
    });

    function getCookie(name) {
      const match = document.cookie.match(new RegExp(`(?:^|; )${name}=([^;]*)`));
      return match ? decodeURIComponent(match[1]) : "";
    }

    const token = getCookie('token');
    let validacionActual = null;

    // Función para actualizar estado de validación
    function actualizarEstadoValidacion(data) {
      if (!data) return;
      
      const resultado = data.resultado || data;
      const estado = resultado.estado_eudr || data.estado_eudr || "PENDIENTE";
      const deforestacion = resultado.deforestacion_detectada || data.deforestacion_detectada || false;
      const porcentaje = resultado.porcentaje || data.porcentaje || 0;
      const fecha = resultado.fecha_analisis || data.fecha_analisis || new Date().toLocaleDateString('es-ES');
      const fuente = resultado.fuente || data.fuente || "Google Earth Engine - Sentinel-2";

      validacionActual = data;

      // Actualizar badge
      const estadoBadge = document.querySelector('.bg-secondary\\/10 .text-secondary');
      if (estadoBadge) {
        if (estado === "APROBADO" || estado === "VALIDADO") {
          estadoBadge.textContent = "Aprobado";
        } else if (estado === "PRE_VALIDADO") {
          estadoBadge.textContent = "Pre-validado";
        } else if (estado === "ALERTA") {
          estadoBadge.textContent = "¡Alerta!";
        } else if (estado === "RECHAZADO") {
          estadoBadge.textContent = "Rechazado";
        } else {
          estadoBadge.textContent = "Pendiente";
        }
      }

      // Actualizar mensaje de deforestación
      const deforestacionText = document.querySelector('.font-bold.text-sm');
      if (deforestacionText) {
        deforestacionText.textContent = deforestacion 
          ? '⚠️ Deforestación Detectada' 
          : '✅ Sin Deforestación Detectada';
      }

      // Actualizar porcentaje
      const porcentajeText = document.querySelector('.flex.justify-between.text-sm .font-bold');
      if (porcentajeText) {
        porcentajeText.textContent = porcentaje + '%';
      }

      // Actualizar barra
      const barra = document.querySelector('.bg-outline-variant .h-full');
      if (barra) {
        barra.style.width = Math.min(porcentaje, 100) + '%';
        barra.className = `h-full ${porcentaje > 10 ? 'bg-red-500' : 'bg-green-500'}`;
      }

      // Actualizar fecha y fuente
      const items = document.querySelectorAll('.flex.justify-between.text-xs');
      if (items.length >= 2) {
        const fechaElement = items[0]?.querySelector('.font-mono');
        if (fechaElement) fechaElement.textContent = fecha;
        const fuenteElement = items[1]?.querySelector('.font-mono');
        if (fuenteElement) fuenteElement.textContent = fuente;
      }

      // Actualizar icono y panel
      const iconContainer = document.querySelector('.w-12.h-12.rounded-full');
      const icon = iconContainer?.querySelector('.material-symbols-outlined');
      if (icon) {
        if (estado === "APROBADO" || estado === "VALIDADO") {
          icon.textContent = 'verified_user';
          iconContainer.className = 'w-12 h-12 rounded-full flex items-center justify-center shrink-0 bg-green-100';
        } else if (estado === "ALERTA" || estado === "RECHAZADO") {
          icon.textContent = 'warning';
          iconContainer.className = 'w-12 h-12 rounded-full flex items-center justify-center shrink-0 bg-red-100';
        } else {
          icon.textContent = 'pending';
          iconContainer.className = 'w-12 h-12 rounded-full flex items-center justify-center shrink-0 bg-yellow-100';
        }
      }

      const panel = document.querySelector('.border.rounded-xl.p-4.mb-4');
      if (panel) {
        if (estado === "APROBADO" || estado === "VALIDADO") {
          panel.className = 'border rounded-xl p-4 mb-4 bg-green-50 border-green-200';
        } else if (estado === "ALERTA" || estado === "RECHAZADO") {
          panel.className = 'border rounded-xl p-4 mb-4 bg-red-50 border-red-200';
        } else if (estado === "PRE_VALIDADO") {
          panel.className = 'border rounded-xl p-4 mb-4 bg-yellow-50 border-yellow-200';
        } else {
          panel.className = 'border rounded-xl p-4 mb-4 bg-blue-50 border-blue-200';
        }
      }

      // Si es productor, recargar para ver cambios
      if (esProductor) {
        setTimeout(() => location.reload(), 2000);
      }
    }

    // Función para generar expediente
    async function generarExpediente(e) {
      e.preventDefault();
      
      if (!fincaIdWindow) {
        alert('No se encontró ID de finca');
        return;
      }

      // Si ya existe, redirigir
      if (existeExpediente) {
        console.log('🔍 Redirigiendo a expedientes con finca_id:', fincaIdWindow);
        window.location.href = `/expedientes?finca_id=${fincaIdWindow}`;
        return;
      }

      // Verificar si el expediente está habilitado
      const estaAprobado = estadoEudr === "APROBADO" || estadoEudr === "VALIDADO" || 
                          expedienteEstado === "APROBADO" || expedienteEstado === "VALIDADO";
      
      console.log('🔍 Verificando aprobación:', { estadoEudr, expedienteEstado, estaAprobado });
      
      if (!estaAprobado) {
        alert('El expediente solo puede generarse cuando la auditoría está aprobada.');
        return;
      }

      try {
        btnExpediente.disabled = true;
        btnExpediente.innerHTML = '<span class="material-symbols-outlined animate-spin">progress_activity</span> Generando...';
        btnExpediente.className = 'w-full py-3 rounded-xl font-bold transition-all flex items-center justify-center gap-2 shadow-sm bg-gray-400 text-white cursor-wait';

        const payload = {
          finca_id: fincaIdWindow,
          organizacion_inquilino: 'Asociación APECAEL',
          estado: 'APROBADO'
        };

        const expediente = await ExpedienteService.create(payload, token);

        // Notificación
        const notification = document.createElement("div");
        notification.className = "fixed bottom-6 right-6 bg-emerald-600 text-white px-6 py-3 rounded-lg shadow-xl z-50 text-sm font-semibold";
        notification.innerText = "✅ Expediente EUDR generado correctamente";
        document.body.appendChild(notification);
        setTimeout(() => notification.remove(), 4000);

        // Actualizar botón a "Ver Expediente"
        btnExpediente.innerHTML = '<span class="material-symbols-outlined">folder_open</span> Ver Expediente';
        btnExpediente.className = 'w-full py-3 bg-emerald-500 hover:bg-emerald-600 text-white rounded-xl font-bold transition-all flex items-center justify-center gap-2 shadow-sm';
        btnExpediente.setAttribute('data-existe', 'true');
        btnExpediente.disabled = false;

        // Después de generar, redirigir a expedientes
        setTimeout(() => {
          window.location.href = `/expedientes?finca_id=${fincaIdWindow}`;
        }, 1500);

      } catch (error) {
        console.error('❌ Error generando expediente:', error);
        alert('Error al generar expediente: ' + (error.message || 'Error desconocido'));
        btnExpediente.disabled = false;
        btnExpediente.innerHTML = existeExpediente 
          ? '<span class="material-symbols-outlined">folder_open</span> Ver Expediente'
          : '<span class="material-symbols-outlined">description</span> Generar Expediente';
        btnExpediente.className = existeExpediente
          ? 'w-full py-3 bg-emerald-500 hover:bg-emerald-600 text-white rounded-xl font-bold transition-all flex items-center justify-center gap-2 shadow-sm'
          : 'w-full py-3 bg-amber-500 hover:bg-amber-600 text-white rounded-xl font-bold transition-all flex items-center justify-center gap-2 shadow-sm';
      }
    }

    // Evento: Ejecutar Auditoría
    if (btnAudit && !esProductor && window.TIENE_PERMISO_AUDITORIA) {
      btnAudit.addEventListener("click", async () => {
        if (!fincaIdWindow) {
          alert('No se encontró ID de finca');
          return;
        }

        btnAudit.disabled = true;
        btnAudit.innerHTML = '<span class="material-symbols-outlined animate-spin">sync</span> Ejecutando Análisis...';
        
        if (scanningLine) {
          scanningLine.style.animationDuration = "1.5s";
        }

        try {
          const resultado = await GeoespacialService.validarEudr(fincaIdWindow, token);
          validacionActual = resultado;
          actualizarEstadoValidacion(resultado);

          const notification = document.createElement("div");
          notification.className = "fixed bottom-6 right-6 bg-primary text-white px-6 py-3 rounded-lg shadow-xl z-50 text-sm font-semibold";
          notification.innerText = "Auditoría Satelital Completada con Éxito";
          document.body.appendChild(notification);
          setTimeout(() => notification.remove(), 3000);

        } catch (error) {
          console.error('❌ Error en auditoría:', error);
          alert('Error al ejecutar la auditoría: ' + (error.message || 'Error desconocido'));
        }

        btnAudit.disabled = false;
        btnAudit.innerHTML = '<span class="material-symbols-outlined">refresh</span> Ejecutar Auditoría GEE';
        
        if (scanningLine) {
          scanningLine.style.animationDuration = "4s";
        }
      });
    }

    // Evento: Generar/Ver Expediente
    if (btnExpediente) {
      btnExpediente.addEventListener('click', generarExpediente);
    }
  });
</script>