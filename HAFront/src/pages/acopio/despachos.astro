---
// src/pages/acopio/despachos.astro
import DashboardLayout from "../../layouts/LayoutVariable.astro";
import { AuthService } from "../../services/auth.service.ts";
import { AcopioService } from "../../services/acopio.service.ts";

// Obtener token y datos del usuario
const token = Astro.cookies.get("token")?.value;

let userData = null;
let userRole = '';
let inventario = [];
let despachos = [];
let error = null;
let isLoading = true;

if (token) {
  try {
    userData = await AuthService.getMe(token);
    userRole = userData?.role?.name || '';
    console.log("👤 Usuario:", userData?.first_name, userData?.last_name);
    console.log("🎭 Rol del usuario:", userRole);
    
    // Obtener inventario (solo café en bodega o en trilla)
    try {
      const allInventario = await AcopioService.getInventarioAll(token);
      // Filtrar solo los que están en bodega o en trilla (no despachados)
      inventario = allInventario.filter(i => i.estado === 'EN_BODEGA' || i.estado === 'EN_TRILLA');
      console.log("📦 Inventario disponible:", inventario.length);
    } catch (e) {
      console.warn("⚠️ Error obteniendo inventario:", e.message);
      inventario = [];
    }
    
    // Obtener despachos existentes
    try {
      despachos = await AcopioService.getDespachos(token);
      console.log("📋 Despachos existentes:", despachos.length);
    } catch (e) {
      console.warn("⚠️ Error obteniendo despachos:", e.message);
      despachos = [];
    }
    
    isLoading = false;
  } catch (e) {
    error = e.message;
    console.error("❌ Error:", e);
    isLoading = false;
  }
} else {
  isLoading = false;
  error = "No hay sesión activa";
}

const puedeDespachar = userRole === 'SUPER_ADMIN' || 
                       userRole === 'TENANT_ADMIN' || 
                       userRole === 'ADMIN' || 
                       userRole === 'JEFE_CALIDAD' ||
                       userRole === 'BODEGUERO';

const inventarioStr = JSON.stringify(inventario);
const despachosStr = JSON.stringify(despachos);
const userRoleStr = userRole;
const puedeDespacharStr = puedeDespachar ? 'true' : 'false';
const API_URL = "https://geoguard-exped.onrender.com";
---

<DashboardLayout title="Despachos - Acopio">

<div class="space-y-6 max-w-[1400px] mx-auto">

    <!-- HEADER -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">
                🚢 Despachos y Exportación
            </h1>
            <p class="mt-1 text-sm text-slate-500 max-w-3xl">
                Registro de despacho de café, gestión de exportaciones y generación de certificados de trazabilidad.
            </p>
            <div class="mt-2 flex flex-wrap items-center gap-2">
                <span class="text-xs font-medium text-slate-500">Tu rol:</span>
                <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-primary/10 text-primary">
                    {userRole || 'No definido'}
                </span>
                {puedeDespachar && (
                    <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-700">
                        ✅ Puede gestionar despachos
                    </span>
                )}
            </div>
        </div>
        <div class="flex items-center gap-2">
            <button
                id="btn-recargar"
                class="flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700 px-4 h-10 rounded-xl transition font-medium text-sm"
            >
                <i data-lucide="refresh-cw" class="w-4 h-4"></i>
                Recargar
            </button>
            <a
                href="/acopio/bodega"
                class="flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700 px-4 h-10 rounded-xl transition font-medium text-sm"
            >
                <i data-lucide="arrow-left" class="w-4 h-4"></i>
                Volver a Bodega
            </a>
            <a
                href="/acopio/certificados"
                class="flex items-center gap-2 bg-purple-500 hover:bg-purple-400 text-white px-4 h-10 rounded-xl transition font-medium text-sm"
            >
                <i data-lucide="file-text" class="w-4 h-4"></i>
                Certificados
            </a>
        </div>
    </div>

    <!-- INDICADOR DE CARGA -->
    {isLoading && (
        <div class="text-center py-12">
            <span class="material-symbols-outlined animate-spin text-primary text-4xl">progress_activity</span>
            <p class="mt-2 text-slate-500">Cargando datos...</p>
        </div>
    )}

    <!-- MENSAJE DE ERROR -->
    {error && (
        <div class="bg-red-50 border border-red-200 rounded-xl p-6 text-center">
            <span class="material-symbols-outlined text-red-500 text-4xl">error</span>
            <p class="mt-2 text-red-600">{error}</p>
        </div>
    )}

    <!-- ============================================================ -->
    <!-- TAB: DESPACHOS / CERTIFICADOS                               -->
    <!-- ============================================================ -->
    {!isLoading && !error && (
        <div>
            <!-- Tabs -->
            <div class="border-b border-slate-200 mb-6">
                <nav class="flex gap-6">
                    <button 
                        class="tab-btn py-3 px-1 text-sm font-medium border-b-2 border-emerald-600 text-emerald-600 transition"
                        data-tab="despacho"
                    >
                        🚢 Registrar Despacho
                    </button>
                    <button 
                        class="tab-btn py-3 px-1 text-sm font-medium border-b-2 border-transparent text-slate-500 hover:text-slate-700 transition"
                        data-tab="historial"
                    >
                        📋 Historial de Despachos
                    </button>
                </nav>
            </div>

            <!-- ============================================================ -->
            <!-- TAB 1: REGISTRAR DESPACHO                                  -->
            <!-- ============================================================ -->
            <div id="tab-despacho" class="tab-content space-y-6">
                <div class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm">
                    <h2 class="text-lg font-semibold text-slate-900 mb-4">
                        🚢 Registrar Despacho
                    </h2>
                    <p class="text-sm text-slate-500 mb-4">
                        Selecciona café disponible en bodega para registrar su salida/exportación.
                    </p>

                    {inventario.length === 0 ? (
                        <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-6 text-center">
                            <span class="material-symbols-outlined text-yellow-500 text-4xl">info</span>
                            <p class="mt-2 font-semibold text-yellow-700">No hay café disponible para despachar</p>
                            <p class="text-sm text-yellow-600 mt-1">
                                Primero debes procesar el café en bodega (ingreso y trilla).
                            </p>
                            <a
                                href="/acopio/bodega"
                                class="mt-4 inline-block px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-medium hover:bg-blue-500 transition"
                            >
                                Ir a Bodega
                            </a>
                        </div>
                    ) : (
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                            {inventario.map((item) => {
                                const saldo = item.pesoIngresoKg - (item.pesoSalidaKg || 0);
                                return (
                                    <div 
                                        key={item.id} 
                                        class="border border-slate-200 rounded-xl p-4 hover:shadow-md transition-shadow"
                                    >
                                        <div class="flex justify-between items-start">
                                            <h4 class="font-semibold text-slate-900 text-sm">
                                                Lote #{item.id.substring(0, 8)}
                                            </h4>
                                            <span class={`
                                                px-2 py-0.5 rounded-full text-xs font-medium
                                                ${item.estado === 'EN_BODEGA' ? 'bg-blue-100 text-blue-700' : ''}
                                                ${item.estado === 'EN_TRILLA' ? 'bg-yellow-100 text-yellow-700' : ''}
                                            `}>
                                                {item.estado.replace('_', ' ')}
                                            </span>
                                        </div>
                                        <div class="mt-3 space-y-1 text-sm">
                                            <div class="flex justify-between">
                                                <span class="text-slate-500">Código QR:</span>
                                                <span class="font-mono text-xs text-slate-700">{item.codigoQR || 'N/A'}</span>
                                            </div>
                                            <div class="flex justify-between">
                                                <span class="text-slate-500">Ingreso:</span>
                                                <span class="font-medium text-slate-700">{item.pesoIngresoKg} kg</span>
                                            </div>
                                            <div class="flex justify-between">
                                                <span class="text-slate-500">Salida:</span>
                                                <span class="font-medium text-slate-700">{item.pesoSalidaKg || 0} kg</span>
                                            </div>
                                            <div class="flex justify-between border-t border-slate-100 pt-1">
                                                <span class="text-slate-500 font-medium">Disponible:</span>
                                                <span class="font-bold text-emerald-600">{saldo.toFixed(2)} kg</span>
                                            </div>
                                        </div>
                                        {saldo > 0 ? (
                                            <button 
                                                class="btn-despachar mt-4 w-full text-sm bg-emerald-600 hover:bg-emerald-500 text-white px-4 py-2 rounded-lg transition font-medium flex items-center justify-center gap-2"
                                                data-inventario-id={item.id}
                                                data-saldo={saldo}
                                            >
                                                <i data-lucide="truck" class="w-4 h-4"></i>
                                                Despachar
                                            </button>
                                        ) : (
                                            <div class="mt-4 w-full text-center text-xs text-slate-400 py-2 bg-slate-50 rounded-lg">
                                                ✅ Todo despachado
                                            </div>
                                        )}
                                    </div>
                                );
                            })}
                        </div>
                    )}
                </div>
            </div>

            <!-- ============================================================ -->
            <!-- TAB 2: HISTORIAL DE DESPACHOS                              -->
            <!-- ============================================================ -->
            <div id="tab-historial" class="tab-content hidden space-y-6">
                <div class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm">
                    <h2 class="text-lg font-semibold text-slate-900 mb-4">
                        📋 Historial de Despachos
                    </h2>
                    <p class="text-sm text-slate-500 mb-4">
                        Registro de todos los despachos realizados.
                    </p>

                    {despachos.length === 0 ? (
                        <div class="bg-slate-50 border border-slate-200 rounded-xl p-8 text-center">
                            <span class="material-symbols-outlined text-slate-400 text-4xl">inbox</span>
                            <p class="mt-2 font-semibold text-slate-700">No hay despachos registrados</p>
                            <p class="text-sm text-slate-500 mt-1">
                                Los despachos aparecerán aquí cuando se registren.
                            </p>
                        </div>
                    ) : (
                        <div class="overflow-x-auto">
                            <table class="w-full text-sm">
                                <thead>
                                    <tr class="border-b border-slate-200">
                                        <th class="text-left py-3 px-4 font-semibold text-slate-600">ID</th>
                                        <th class="text-left py-3 px-4 font-semibold text-slate-600">Inventario</th>
                                        <th class="text-right py-3 px-4 font-semibold text-slate-600">Peso (kg)</th>
                                        <th class="text-left py-3 px-4 font-semibold text-slate-600">Destino</th>
                                        <th class="text-left py-3 px-4 font-semibold text-slate-600">Fecha</th>
                                        <th class="text-center py-3 px-4 font-semibold text-slate-600">Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {despachos.map((despacho) => (
                                        <tr key={despacho.id} class="border-b border-slate-100 hover:bg-slate-50/50 transition">
                                            <td class="py-3 px-4 font-mono text-xs text-slate-600">{despacho.id}</td>
                                            <td class="py-3 px-4 font-mono text-xs text-slate-600">{despacho.inventarioId?.substring(0, 8) || 'N/A'}</td>
                                            <td class="py-3 px-4 text-right font-medium text-slate-700">{despacho.peso_salida_kg || despacho.pesoSalidaKg || 0}</td>
                                            <td class="py-3 px-4 text-slate-700">{despacho.destino || 'N/A'}</td>
                                            <td class="py-3 px-4 text-slate-600">{despacho.creadoEn ? new Date(despacho.creadoEn).toLocaleDateString('es-ES') : 'N/A'}</td>
                                            <td class="py-3 px-4 text-center">
                                                <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-700">
                                                    ✅ Completado
                                                </span>
                                            </td>
                                        </tr>
                                    ))}
                                </tbody>
                            </table>
                        </div>
                    )}
                </div>
            </div>
        </div>
    )}

</div>

<!-- ============================================================ -->
<!-- MODAL: REGISTRAR DESPACHO                                  -->
<!-- ============================================================ -->
<div id="modal-despacho" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm hidden">
    <div class="bg-white rounded-2xl w-full max-w-lg mx-4 p-6 shadow-2xl animate-modal-in max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-5">
            <div class="flex items-center gap-3">
                <div class="bg-emerald-500/10 p-2 rounded-xl text-emerald-600">
                    <i data-lucide="truck" class="w-5 h-5"></i>
                </div>
                <h2 class="text-xl font-bold text-slate-900">Registrar Despacho</h2>
            </div>
            <button id="btn-cerrar-despacho" class="text-slate-400 hover:text-slate-600 transition">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <form id="form-despacho" class="space-y-4">
            <input type="hidden" id="despacho-inventario-id" />

            <div class="bg-slate-50 rounded-xl p-4 space-y-2">
                <div class="flex justify-between text-sm">
                    <span class="text-slate-500">Lote:</span>
                    <span id="despacho-inventario" class="font-medium text-slate-700">-</span>
                </div>
                <div class="flex justify-between text-sm">
                    <span class="text-slate-500">Disponible:</span>
                    <span id="despacho-disponible" class="font-medium text-slate-700">-</span>
                </div>
            </div>

            <div>
                <label for="despacho-peso" class="block text-sm font-medium text-slate-700 mb-1.5">
                    Peso a despachar (kg) <span class="text-red-500">*</span>
                </label>
                <input
                    id="despacho-peso"
                    type="number"
                    step="0.01"
                    min="0.01"
                    placeholder="0.00"
                    class="w-full h-12 px-4 border border-slate-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none transition"
                    required
                />
                <p class="text-xs text-slate-400 mt-1">Máximo: <span id="despacho-peso-max">0</span> kg</p>
            </div>

            <div>
                <label for="despacho-destino" class="block text-sm font-medium text-slate-700 mb-1.5">
                    Destino <span class="text-red-500">*</span>
                </label>
                <input
                    id="despacho-destino"
                    type="text"
                    placeholder="Ej: Puerto de Guayaquil, Comprador XYZ"
                    class="w-full h-12 px-4 border border-slate-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none transition"
                    required
                />
            </div>

            <div id="despacho-error" class="hidden text-red-500 text-sm flex items-center gap-2">
                <i data-lucide="alert-circle" class="w-4 h-4"></i>
                <span id="despacho-error-text">Error al registrar despacho</span>
            </div>

            <div class="flex gap-3 pt-4 border-t border-slate-100">
                <button
                    type="button"
                    id="btn-cancelar-despacho"
                    class="flex-1 h-12 bg-slate-100 text-slate-700 rounded-xl font-medium hover:bg-slate-200 transition"
                >
                    Cancelar
                </button>
                <button
                    type="submit"
                    id="btn-guardar-despacho"
                    class="flex-1 h-12 bg-emerald-600 text-white rounded-xl font-medium hover:bg-emerald-500 transition flex items-center justify-center gap-2"
                >
                    <i data-lucide="check" class="w-4 h-4"></i>
                    Registrar Despacho
                </button>
            </div>
        </form>
    </div>
</div>

</DashboardLayout>

<!-- Estilos CSS Inyectados -->
<style is:global>
    @keyframes modalIn {
        from {
            opacity: 0;
            transform: scale(0.95) translateY(10px);
        }
        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }
    .animate-modal-in {
        animation: modalIn 0.2s ease-out;
    }
</style>

<script is:inline src="https://unpkg.com/lucide@latest"></script>

<script>
    import { AuthService } from "/src/services/auth.service.ts";
    import { AcopioService } from "/src/services/acopio.service.ts";

    console.log("🚢 Página de Despachos cargada");

    const API_URL = "https://geoguard-exped.onrender.com";

    function getCookie(name) {
        const match = document.cookie.match(new RegExp(`(?:^|; )${name}=([^;]*)`));
        return match ? decodeURIComponent(match[1]) : "";
    }

    function getToken() {
        return getCookie('token');
    }

    // ============================================================
    // TABS
    // ============================================================

    function initTabs() {
        const tabs = document.querySelectorAll('.tab-btn');
        const contents = {
            despacho: document.getElementById('tab-despacho'),
            historial: document.getElementById('tab-historial')
        };

        tabs.forEach(tab => {
            tab.addEventListener('click', function() {
                tabs.forEach(t => {
                    t.classList.remove('border-emerald-600', 'text-emerald-600');
                    t.classList.add('border-transparent', 'text-slate-500');
                });
                
                this.classList.remove('border-transparent', 'text-slate-500');
                this.classList.add('border-emerald-600', 'text-emerald-600');
                
                Object.values(contents).forEach(c => c?.classList.add('hidden'));
                
                const tabName = this.dataset.tab;
                if (contents[tabName]) {
                    contents[tabName].classList.remove('hidden');
                }
            });
        });
    }

    // ============================================================
    // MODAL: DESPACHO - CORREGIDO CON UUID
    // ============================================================

    function toggleModalDespacho(show, inventarioId = null, saldo = null) {
        const modal = document.getElementById('modal-despacho');
        const errorDiv = document.getElementById('despacho-error');
        errorDiv.classList.add('hidden');

        if (show && inventarioId) {
            document.getElementById('despacho-inventario-id').value = inventarioId;
            document.getElementById('despacho-inventario').textContent = inventarioId.substring(0, 8) + '...';
            document.getElementById('despacho-disponible').textContent = `${saldo} kg`;
            document.getElementById('despacho-peso-max').textContent = saldo;
            document.getElementById('despacho-peso').value = '';
            document.getElementById('despacho-peso').max = saldo;
            document.getElementById('despacho-destino').value = '';
            document.getElementById('despacho-error').classList.add('hidden');
            
            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
            if (window.lucide) window.lucide.createIcons();
        } else {
            modal.classList.add('hidden');
            document.body.style.overflow = '';
        }
    }

    // ============================================================
    // REGISTRAR DESPACHO - CORREGIDO CON UUID
    // ============================================================

    async function registrarDespacho(event) {
        event.preventDefault();

        // 🔥 CORREGIDO: Usar el ID como string (UUID), no parseInt
        const inventarioId = document.getElementById('despacho-inventario-id').value;
        const pesoSalida = parseFloat(document.getElementById('despacho-peso').value);
        const destino = document.getElementById('despacho-destino').value.trim();

        console.log('🔍 Registrando despacho:', { inventarioId, pesoSalida, destino });

        // Validaciones
        if (!inventarioId || inventarioId === 'undefined' || inventarioId === 'null') {
            const errorDiv = document.getElementById('despacho-error');
            errorDiv.classList.remove('hidden');
            errorDiv.classList.add('text-red-500');
            document.getElementById('despacho-error-text').textContent = 'ID de inventario inválido';
            return;
        }

        if (isNaN(pesoSalida) || pesoSalida <= 0) {
            const errorDiv = document.getElementById('despacho-error');
            errorDiv.classList.remove('hidden');
            errorDiv.classList.add('text-red-500');
            document.getElementById('despacho-error-text').textContent = 'El peso debe ser mayor a 0';
            return;
        }

        if (!destino || destino.length < 3) {
            const errorDiv = document.getElementById('despacho-error');
            errorDiv.classList.remove('hidden');
            errorDiv.classList.add('text-red-500');
            document.getElementById('despacho-error-text').textContent = 'El destino es obligatorio (mínimo 3 caracteres)';
            return;
        }

        // 🔥 CORREGIDO: Payload con inventarioId como string
        const payload = {
            inventarioId: inventarioId,
            peso_salida_kg: pesoSalida,
            destino: destino
        };

        console.log('📦 Payload despacho:', JSON.stringify(payload, null, 2));

        try {
            const token = getToken();
            if (!token) {
                const errorDiv = document.getElementById('despacho-error');
                errorDiv.classList.remove('hidden');
                errorDiv.classList.add('text-red-500');
                document.getElementById('despacho-error-text').textContent = 'No hay sesión activa';
                return;
            }

            const btnGuardar = document.getElementById('btn-guardar-despacho');
            btnGuardar.disabled = true;
            btnGuardar.innerHTML = '<i data-lucide="loader-circle" class="w-4 h-4 animate-spin"></i> Registrando...';

            const resultado = await AcopioService.registrarDespacho(payload, token);
            console.log('✅ Despacho registrado:', resultado);

            const errorDiv = document.getElementById('despacho-error');
            errorDiv.classList.remove('hidden');
            errorDiv.classList.add('text-emerald-500');
            document.getElementById('despacho-error-text').textContent = `✅ Despacho registrado - ${resultado.peso_total_despachado} kg a ${resultado.destino}`;

            setTimeout(() => {
                toggleModalDespacho(false);
                window.location.reload();
            }, 2000);

        } catch (error) {
            console.error('❌ Error al registrar despacho:', error);
            const errorDiv = document.getElementById('despacho-error');
            errorDiv.classList.remove('hidden');
            errorDiv.classList.add('text-red-500');
            document.getElementById('despacho-error-text').textContent = error.message || 'Error al registrar despacho';
            
            const btnGuardar = document.getElementById('btn-guardar-despacho');
            btnGuardar.disabled = false;
            btnGuardar.innerHTML = '<i data-lucide="check" class="w-4 h-4"></i> Registrar Despacho';
            if (window.lucide) window.lucide.createIcons();
        }
    }

    // ============================================================
    // EVENTOS
    // ============================================================

    document.addEventListener('DOMContentLoaded', () => {
        console.log('🔧 Inicializando eventos...');

        // Tabs
        initTabs();

        // Botón Recargar
        document.getElementById('btn-recargar')?.addEventListener('click', () => {
            window.location.reload();
        });

        // ---- Botones Despachar ----
        document.querySelectorAll('.btn-despachar').forEach(btn => {
            btn.addEventListener('click', function() {
                const inventarioId = this.dataset.inventarioId;
                const saldo = parseFloat(this.dataset.saldo);
                console.log('🔘 Despachar - Inventario ID:', inventarioId, 'Saldo:', saldo);
                toggleModalDespacho(true, inventarioId, saldo);
            });
        });

        // ---- Cerrar Modal Despacho ----
        document.getElementById('btn-cerrar-despacho')?.addEventListener('click', () => toggleModalDespacho(false));
        document.getElementById('btn-cancelar-despacho')?.addEventListener('click', () => toggleModalDespacho(false));
        document.getElementById('modal-despacho')?.addEventListener('click', (e) => {
            if (e.target === e.currentTarget) toggleModalDespacho(false);
        });

        // ---- Formulario Despacho ----
        document.getElementById('form-despacho')?.addEventListener('submit', registrarDespacho);

        // ---- Recrear íconos Lucide ----
        if (window.lucide) {
            window.lucide.createIcons();
        }

        console.log('✅ Eventos inicializados correctamente');
    });

    document.addEventListener('astro:after-swap', () => {
        if (window.lucide) {
            window.lucide.createIcons();
        }
    });
</script>