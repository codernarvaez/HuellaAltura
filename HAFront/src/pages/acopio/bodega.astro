<!-- Estilos CSS Inyectados -->
<style is:global>
    @keyframes modalIn {
        from {
            opacity: 0;
            transform: scale(0.95) translateY(10px);
        }
        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }
    .animate-modal-in {
        animation: modalIn 0.2s ease-out;
    }
    .btn-accion-success:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.15);
    }
</style>

<script is:inline src="https://unpkg.com/lucide@latest"></script>

<script>
    // Importar el servicio para uso en cliente
    import { AcopioService } from "../../services/acopio.service.ts";

    console.log("📦 Página de Bodega cargada");

    function getCookie(name) {
        const match = document.cookie.match(new RegExp(`(?:^|; )${name}=([^;]*)`));
        return match ? decodeURIComponent(match[1]) : "";
    }

    function getToken() {
        return getCookie('token');
    }

    // ============================================================
    // TABS
    // ============================================================

    function initTabs() {
        const tabs = document.querySelectorAll('.tab-btn');
        const contents = {
            ingreso: document.getElementById('tab-ingreso'),
            inventario: document.getElementById('tab-inventario'),
            trilla: document.getElementById('tab-trilla')
        };

        tabs.forEach(tab => {
            tab.addEventListener('click', function() {
                tabs.forEach(t => {
                    t.classList.remove('border-emerald-600', 'text-emerald-600');
                    t.classList.add('border-transparent', 'text-slate-500');
                });
                
                this.classList.remove('border-transparent', 'text-slate-500');
                this.classList.add('border-emerald-600', 'text-emerald-600');
                
                Object.values(contents).forEach(c => c.classList.add('hidden'));
                
                const tabName = this.dataset.tab;
                if (contents[tabName]) {
                    contents[tabName].classList.remove('hidden');
                }
            });
        });
    }

    // ============================================================
    // CARGAR DATOS DE MUESTRA AL MODAL (usando getMuestraByUuid)
    // ============================================================

    async function cargarDatosMuestraEnModal(muestraId) {
        console.log('🔍 Cargando datos de la muestra por UUID:', muestraId);
        
        const loadingEl = document.getElementById('muestra-loading');
        if (loadingEl) loadingEl.classList.remove('hidden');
        
        document.getElementById('qr-cargado-info')?.classList.add('hidden');
        document.getElementById('peso-sugerido-info')?.classList.add('hidden');
        document.getElementById('proceso-cargado-info')?.classList.add('hidden');
        
        try {
            const token = getToken();
            if (!token) {
                console.warn('⚠️ No hay token para cargar la muestra');
                if (loadingEl) loadingEl.classList.add('hidden');
                return;
            }

            const muestra = await AcopioService.getMuestraByUuid(muestraId, token);
            
            if (muestra) {
                console.log('✅ Datos de muestra cargados por UUID:', muestra);
                
                const qrInput = document.getElementById('ingreso-codigo-qr');
                if (muestra.codigoQR) {
                    qrInput.value = muestra.codigoQR;
                    qrInput.disabled = true;
                    qrInput.classList.add('bg-slate-100', 'cursor-not-allowed');
                    console.log('📝 QR cargado:', muestra.codigoQR);
                    
                    const qrInfo = document.getElementById('qr-cargado-info');
                    if (qrInfo) qrInfo.classList.remove('hidden');
                }
                
                const procesoSelect = document.getElementById('ingreso-tipo-proceso');
                if (muestra.tipoProceso) {
                    const optionExists = Array.from(procesoSelect.options).some(
                        option => option.value === muestra.tipoProceso
                    );
                    if (optionExists) {
                        procesoSelect.value = muestra.tipoProceso;
                        procesoSelect.disabled = true;
                        procesoSelect.classList.add('bg-slate-100', 'cursor-not-allowed');
                        console.log('📝 Proceso cargado:', muestra.tipoProceso);
                        
                        const procesoInfo = document.getElementById('proceso-cargado-info');
                        if (procesoInfo) procesoInfo.classList.remove('hidden');
                    } else {
                        console.warn(`⚠️ Tipo de proceso "${muestra.tipoProceso}" no es una opción válida.`);
                    }
                }

                const pesoInput = document.getElementById('ingreso-peso');
                const pesoInfo = document.getElementById('peso-sugerido-info');
                const pesoValor = document.getElementById('peso-sugerido-valor');
                
                if (muestra.pesoKg) {
                    const peso_lb = (muestra.pesoKg * 2.20462).toFixed(2);
                    pesoInput.placeholder = `Sugerido: ${peso_lb} lb (${muestra.pesoKg} kg)`;
                    pesoInput.title = `Peso de muestra: ${muestra.pesoKg} kg`;
                    
                    if (pesoInfo && pesoValor) {
                        pesoValor.textContent = `${peso_lb} lb (${muestra.pesoKg} kg)`;
                        pesoInfo.classList.remove('hidden');
                    }
                }

                const infoDiv = document.createElement('div');
                infoDiv.id = 'info-muestra-cargada';
                infoDiv.className = 'text-xs text-emerald-600 bg-emerald-50 p-2 rounded-lg flex items-center gap-2 -mt-2';
                infoDiv.innerHTML = `
                    <i data-lucide="check-circle" class="w-4 h-4"></i>
                    Datos de la muestra cargados automáticamente desde el UUID: ${muestraId.substring(0, 8)}...
                `;
                
                const procesoField = document.getElementById('ingreso-tipo-proceso').closest('div');
                const existingInfo = document.getElementById('info-muestra-cargada');
                if (existingInfo) existingInfo.remove();
                procesoField.after(infoDiv);
                
                if (window.lucide) window.lucide.createIcons();
                
            } else {
                console.warn('⚠️ No se pudieron cargar los datos de la muestra por UUID.');
                habilitarCamposManuales();
            }
        } catch (error) {
            console.error('❌ Error al cargar datos de la muestra por UUID:', error);
            habilitarCamposManuales();
        } finally {
            const loadingEl = document.getElementById('muestra-loading');
            if (loadingEl) loadingEl.classList.add('hidden');
        }
    }

    function habilitarCamposManuales() {
        document.getElementById('ingreso-codigo-qr').disabled = false;
        document.getElementById('ingreso-tipo-proceso').disabled = false;
        document.getElementById('ingreso-codigo-qr').classList.remove('bg-slate-100', 'cursor-not-allowed');
        document.getElementById('ingreso-tipo-proceso').classList.remove('bg-slate-100', 'cursor-not-allowed');
        document.getElementById('ingreso-codigo-qr').value = '';
        document.getElementById('ingreso-tipo-proceso').value = '';
        
        document.getElementById('qr-cargado-info')?.classList.add('hidden');
        document.getElementById('peso-sugerido-info')?.classList.add('hidden');
        document.getElementById('proceso-cargado-info')?.classList.add('hidden');
        
        const existingInfo = document.getElementById('info-muestra-cargada');
        if (existingInfo) existingInfo.remove();
    }

    // ============================================================
    // MODAL: INGRESO A BODEGA
    // ============================================================

    function toggleModalIngreso(show, ordenId = null, volumen = null, muestraId = null) {
        const modal = document.getElementById('modal-ingreso-bodega');
        const errorDiv = document.getElementById('ingreso-error');
        errorDiv.classList.add('hidden');

        if (show && ordenId) {
            document.getElementById('ingreso-orden-id').value = ordenId;
            document.getElementById('ingreso-muestra-id').value = muestraId || '';
            document.getElementById('ingreso-orden').textContent = `Orden #${ordenId}`;
            document.getElementById('ingreso-volumen-autorizado').textContent = `${volumen} kg`;
            
            document.getElementById('ingreso-codigo-qr').value = '';
            document.getElementById('ingreso-peso').value = '';
            document.getElementById('ingreso-tipo-proceso').value = '';
            
            habilitarCamposManuales();
            
            const existingInfo = document.getElementById('info-muestra-cargada');
            if (existingInfo) existingInfo.remove();

            if (muestraId) {
                cargarDatosMuestraEnModal(muestraId);
            }
            
            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
            if (window.lucide) window.lucide.createIcons();
        } else {
            modal.classList.add('hidden');
            document.body.style.overflow = '';
            habilitarCamposManuales();
            const infoDiv = document.getElementById('info-muestra-cargada');
            if (infoDiv) infoDiv.remove();
        }
    }

    // ============================================================
    // REGISTRAR INGRESO
    // ============================================================

    async function registrarIngresoBodega(event) {
        event.preventDefault();

        const ordenCompraId = document.getElementById('ingreso-orden-id').value;
        const codigoQR = document.getElementById('ingreso-codigo-qr').value.trim();
        const pesoIngresado_lb = parseFloat(document.getElementById('ingreso-peso').value);
        const tipoProceso = document.getElementById('ingreso-tipo-proceso').value;

        if (!ordenCompraId || !codigoQR || isNaN(pesoIngresado_lb) || !tipoProceso) {
            const errorDiv = document.getElementById('ingreso-error');
            errorDiv.classList.remove('hidden');
            errorDiv.className = 'text-sm flex items-center gap-2 p-3 rounded-xl bg-red-50 border border-red-200 text-red-600';
            document.getElementById('ingreso-error-text').textContent = 'Todos los campos son obligatorios';
            return;
        }

        const payload = {
            ordenCompraId,
            codigoQR,
            pesoIngresado_lb,
            tipoProceso
        };

        console.log('📦 Payload ingreso bodega:', JSON.stringify(payload, null, 2));

        try {
            const token = getToken();
            if (!token) {
                const errorDiv = document.getElementById('ingreso-error');
                errorDiv.classList.remove('hidden');
                errorDiv.className = 'text-sm flex items-center gap-2 p-3 rounded-xl bg-red-50 border border-red-200 text-red-600';
                document.getElementById('ingreso-error-text').textContent = 'No hay sesión activa';
                return;
            }

            const btnGuardar = document.getElementById('btn-guardar-ingreso');
            btnGuardar.disabled = true;
            btnGuardar.innerHTML = '<i data-lucide="loader-circle" class="w-4 h-4 animate-spin"></i> Registrando...';

            const resultado = await AcopioService.registrarIngresoBodega(payload, token);
            console.log('✅ Ingreso registrado:', resultado);

            const errorDiv = document.getElementById('ingreso-error');
            errorDiv.classList.remove('hidden');
            errorDiv.className = 'text-sm flex items-center gap-2 p-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700';
            document.getElementById('ingreso-error-text').textContent = `✅ Ingreso registrado - Inventario #${resultado.inventario_id} | ${resultado.peso_ingreso_kg} kg`;

            setTimeout(() => {
                toggleModalIngreso(false);
                window.location.reload();
            }, 2000);

        } catch (error) {
            console.error('❌ Error al registrar ingreso:', error);
            const errorDiv = document.getElementById('ingreso-error');
            errorDiv.classList.remove('hidden');
            errorDiv.className = 'text-sm flex items-center gap-2 p-3 rounded-xl bg-red-50 border border-red-200 text-red-600';
            document.getElementById('ingreso-error-text').textContent = error.message || 'Error al registrar ingreso';
            
            const btnGuardar = document.getElementById('btn-guardar-ingreso');
            btnGuardar.disabled = false;
            btnGuardar.innerHTML = '<i data-lucide="save" class="w-4 h-4"></i> Registrar Ingreso';
            if (window.lucide) window.lucide.createIcons();
        }
    }

    // ============================================================
    // PROCESAR TRILLA - CORREGIDO CON UUID
    // ============================================================

    function toggleModalTrilla(show, resultado = null) {
        const modal = document.getElementById('modal-resultado-trilla');
        if (show && resultado) {
            const resultadosDiv = document.getElementById('trilla-resultado-content');
            resultadosDiv.classList.remove('opacity-0', 'translate-y-4');
            resultadosDiv.classList.add('opacity-100', 'translate-y-0');
            
            document.getElementById('trilla-peso-entrada').textContent = `${resultado.peso_entrada_kg} kg`;
            document.getElementById('trilla-factor').textContent = `${(resultado.factor_aplicado * 100).toFixed(0)}%`;
            document.getElementById('trilla-cafe-oro').textContent = `${resultado.kg_cafe_oro_esperados} kg`;
            document.getElementById('trilla-merma').textContent = `${resultado.merma_esperada_kg} kg`;
            
            document.getElementById('trilla-resumen').innerHTML = `
                <div class="mt-3 p-3 bg-slate-50 rounded-lg border border-slate-200">
                    <p class="text-xs text-slate-500">Resumen:</p>
                    <p class="text-sm text-slate-700">
                        De <strong>${resultado.peso_entrada_kg} kg</strong> de café pergamino,
                        se obtienen <strong class="text-emerald-600">${resultado.kg_cafe_oro_esperados} kg</strong> de café oro
                        con una merma de <strong class="text-orange-600">${resultado.merma_esperada_kg} kg</strong>
                        (${(resultado.factor_aplicado * 100).toFixed(0)}% de rendimiento).
                    </p>
                </div>
            `;
            
            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
            if (window.lucide) window.lucide.createIcons();
        } else {
            modal.classList.add('hidden');
            document.body.style.overflow = '';
            const resultadosDiv = document.getElementById('trilla-resultado-content');
            resultadosDiv.classList.add('opacity-0', 'translate-y-4');
            resultadosDiv.classList.remove('opacity-100', 'translate-y-0');
        }
    }

    async function procesarTrilla(inventarioId, pesoIngreso) {
        console.log('🔍 Iniciando trilla para inventario (UUID):', inventarioId);
        console.log('🔍 Peso de ingreso:', pesoIngreso);
        
        // 🔥 Buscar el input específico por data-inventario-id (UUID)
        const input = document.querySelector(`input.factor-trilla-input[data-inventario-id="${inventarioId}"]`);
        
        console.log('🔍 Input encontrado:', input);
        
        if (!input) {
            console.error('❌ No se encontró el input para inventario:', inventarioId);
            alert('Error: No se encontró el campo de factor de rendimiento. Por favor recarga la página.');
            return;
        }

        const factorRendimiento = parseFloat(input.value);
        console.log('🔍 Factor de rendimiento:', factorRendimiento);
        
        if (isNaN(factorRendimiento) || factorRendimiento <= 0 || factorRendimiento > 1) {
            alert('Por favor ingresa un factor de rendimiento válido (0.01 - 1.00)');
            input.focus();
            input.select();
            return;
        }

        if (!confirm(`¿Procesar trilla para el lote ${inventarioId.substring(0, 8)}... con factor ${factorRendimiento}?`)) {
            console.log('ℹ️ Trilla cancelada por el usuario');
            return;
        }

        // 🔥 CORREGIDO: Payload con inventarioId como string (UUID)
        const payload = {
            inventarioId: inventarioId,
            factorRendimiento: factorRendimiento
        };

        console.log('📦 Payload trilla:', JSON.stringify(payload, null, 2));

        try {
            const token = getToken();
            if (!token) {
                alert('No hay sesión activa');
                return;
            }

            const btn = document.querySelector(`.btn-procesar-trilla[data-inventario-id="${inventarioId}"]`);
            const originalText = btn?.innerHTML || '⚙️ Procesar Trilla';
            
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<i data-lucide="loader-circle" class="w-4 h-4 animate-spin"></i> Procesando...';
                if (window.lucide) window.lucide.createIcons();
            }

            // ✅ Usar el servicio para procesar trilla
            const resultado = await AcopioService.procesarTrilla(payload, token);
            console.log('✅ Trilla procesada:', resultado);

            toggleModalTrilla(true, resultado.resultados);

            setTimeout(() => {
                window.location.reload();
            }, 4000);

        } catch (error) {
            console.error('❌ Error al procesar trilla:', error);
            alert('Error al procesar trilla: ' + (error.message || 'Error desconocido'));
            
            const btn = document.querySelector(`.btn-procesar-trilla[data-inventario-id="${inventarioId}"]`);
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = originalText;
                if (window.lucide) window.lucide.createIcons();
            }
        }
    }

    // ============================================================
    // EVENTOS - CORREGIDO CON UUID
    // ============================================================

    document.addEventListener('DOMContentLoaded', () => {
        console.log('🔧 Inicializando eventos...');

        initTabs();

        document.getElementById('btn-recargar')?.addEventListener('click', () => {
            window.location.reload();
        });

        // ---- Botones Ingreso a Bodega ----
        document.querySelectorAll('.btn-ingresar-bodega').forEach(btn => {
            btn.addEventListener('click', function() {
                const ordenId = this.dataset.ordenId;
                const volumen = this.dataset.volumen;
                const muestraId = this.dataset.muestraId;
                toggleModalIngreso(true, ordenId, volumen, muestraId);
            });
        });

        // ---- Cerrar Modal Ingreso ----
        document.getElementById('btn-cerrar-ingreso')?.addEventListener('click', () => toggleModalIngreso(false));
        document.getElementById('btn-cancelar-ingreso')?.addEventListener('click', () => toggleModalIngreso(false));
        document.getElementById('modal-ingreso-bodega')?.addEventListener('click', (e) => {
            if (e.target === e.currentTarget) toggleModalIngreso(false);
        });

        document.getElementById('form-ingreso-bodega')?.addEventListener('submit', registrarIngresoBodega);

        // ---- 🔥 Botones Procesar Trilla - CORREGIDO CON UUID ----
        document.querySelectorAll('.btn-procesar-trilla').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                
                // Obtener el contenedor del botón
                const container = this.closest('.border') || this.closest('.flex');
                
                // Buscar el input dentro del mismo contenedor
                const input = container?.querySelector('.factor-trilla-input');
                
                console.log('🔍 Contenedor encontrado:', container);
                console.log('🔍 Input encontrado:', input);
                
                if (!input) {
                    console.error('❌ No se encontró el input asociado');
                    alert('Error: No se encontró el campo de factor de rendimiento. Por favor recarga la página.');
                    return;
                }
                
                // 🔥 CORREGIDO: Usar el ID como string (UUID), no parseInt
                const inventarioId = input.dataset.inventarioId;
                const peso = parseFloat(this.dataset.peso);
                
                console.log('🔘 Botón clickeado - Inventario ID (UUID):', inventarioId);
                console.log('🔘 Peso:', peso);
                
                // 🔥 Validar que el ID sea un string válido
                if (!inventarioId || inventarioId === 'undefined' || inventarioId === 'null') {
                    console.error('❌ Inventario ID inválido:', { inventarioId });
                    alert('Error: ID de inventario inválido. Por favor recarga la página.');
                    return;
                }
                
                if (isNaN(peso) || peso <= 0) {
                    console.error('❌ Peso inválido:', { peso });
                    alert('Error: Peso inválido. Por favor recarga la página.');
                    return;
                }
                
                // 🔥 Llamar a la función con el ID como string
                procesarTrilla(inventarioId, peso);
            });
        });

        // ---- Botones "Ir a Trillar" desde inventario ----
        document.querySelectorAll('.btn-ir-trillar').forEach(btn => {
            btn.addEventListener('click', function() {
                const tabTrilla = document.querySelector('.tab-btn[data-tab="trilla"]');
                if (tabTrilla) {
                    tabTrilla.click();
                    const trillaSection = document.getElementById('tab-trilla');
                    if (trillaSection) {
                        trillaSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }
                }
            });
        });

        // ---- Cerrar Modal Trilla ----
        document.getElementById('btn-cerrar-trilla')?.addEventListener('click', () => toggleModalTrilla(false));
        document.getElementById('btn-cerrar-trilla-btn')?.addEventListener('click', () => toggleModalTrilla(false));
        document.getElementById('modal-resultado-trilla')?.addEventListener('click', (e) => {
            if (e.target === e.currentTarget) toggleModalTrilla(false);
        });

        // ---- Ver Inventario desde modal de trilla ----
        document.getElementById('btn-ver-inventario')?.addEventListener('click', () => {
            toggleModalTrilla(false);
            const tabInventario = document.querySelector('.tab-btn[data-tab="inventario"]');
            if (tabInventario) {
                tabInventario.click();
            }
        });

        if (window.lucide) {
            window.lucide.createIcons();
        }

        console.log('✅ Eventos inicializados correctamente');
    });

    document.addEventListener('astro:after-swap', () => {
        if (window.lucide) {
            window.lucide.createIcons();
        }
    });
</script>