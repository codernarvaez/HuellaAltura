---
// src/pages/acopio/bodega.astro
import DashboardLayout from "../../layouts/LayoutVariable.astro";
import { AuthService } from "../../services/auth.service.ts";
import { AcopioService } from "../../services/acopio.service.ts";

// Obtener token y datos del usuario
const token = Astro.cookies.get("token")?.value;

let userData = null;
let userRole = '';
let ordenes = [];
let inventario = [];
let error = null;
let isLoading = true;

if (token) {
  try {
    userData = await AuthService.getMe(token);
    userRole = userData?.role?.name || '';
    console.log("👤 Usuario:", userData?.first_name, userData?.last_name);
    console.log("🎭 Rol del usuario:", userRole);
    
    // ============================================================
    // ✅ USAR EL SERVICIO PARA OBTENER ÓRDENES
    // ============================================================
    
    try {
      // Obtener todas las órdenes usando el servicio
      const todasOrdenes = await AcopioService.getOrdenesCompra(token);
      console.log("📋 Todas las órdenes obtenidas:", todasOrdenes.length);
      
      // Filtrar solo las órdenes aprobadas
      const ordenesAprobadas = todasOrdenes.filter(orden => orden.estado === 'APROBADA');
      console.log("📋 Órdenes aprobadas:", ordenesAprobadas.length);
      
      // ============================================================
      // 📊 USAR EL SERVICIO PARA OBTENER INVENTARIO
      // ============================================================
      
      // Obtener todo el inventario usando el servicio
      const inventarioCompleto = await AcopioService.getInventarioAll(token);
      console.log("📦 Inventario total:", inventarioCompleto.length);
      
      // Crear un Set con las órdenes que ya tienen inventario
      const ordenesConInventario = new Set(
        inventarioCompleto.map(item => item.ordenCompraId)
      );
      
      // Filtrar órdenes que NO tienen inventario (para mostrar en Ingreso)
      ordenes = ordenesAprobadas.filter(orden => !ordenesConInventario.has(orden.id));
      
      // Asignar el inventario completo
      inventario = inventarioCompleto;
      
      console.log("📋 Órdenes disponibles para ingreso:", ordenes.length);
      console.log("📦 Inventario en bodega:", inventario.filter(i => i.estado === 'EN_BODEGA').length);
      
    } catch (e) {
      console.warn("⚠️ Error obteniendo datos:", e.message);
      ordenes = [];
      inventario = [];
    }
    
    isLoading = false;
  } catch (e) {
    error = e.message;
    console.error("❌ Error:", e);
    isLoading = false;
  }
} else {
  isLoading = false;
  error = "No hay sesión activa";
}

const puedeGestionarBodega = userRole === 'SUPER_ADMIN' || 
                             userRole === 'TENANT_ADMIN' || 
                             userRole === 'ADMIN' || 
                             userRole === 'JEFE_CALIDAD' ||
                             userRole === 'BODEGUERO';

const ordenesStr = JSON.stringify(ordenes);
const inventarioStr = JSON.stringify(inventario);
const userRoleStr = userRole;
const puedeGestionarBodegaStr = puedeGestionarBodega ? 'true' : 'false';
---

<DashboardLayout title="Bodega - Acopio">

<div class="space-y-6 max-w-[1400px] mx-auto">

    <!-- HEADER -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">
                📦 Bodega de Café
            </h1>
            <p class="mt-1 text-sm text-slate-500 max-w-3xl">
                Registro de ingreso físico de café, gestión de inventario y proceso de trilla (balance de masa).
            </p>
            <div class="mt-2 flex flex-wrap items-center gap-2">
                <span class="text-xs font-medium text-slate-500">Tu rol:</span>
                <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-primary/10 text-primary">
                    {userRole || 'No definido'}
                </span>
                {puedeGestionarBodega && (
                    <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-blue-100 text-blue-700">
                        ✅ Puede gestionar bodega
                    </span>
                )}
            </div>
        </div>
        <div class="flex items-center gap-2">
            <button
                id="btn-recargar"
                class="flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700 px-4 h-10 rounded-xl transition font-medium text-sm"
            >
                <i data-lucide="refresh-cw" class="w-4 h-4"></i>
                Recargar
            </button>
            <a
                href="/acopio/compras"
                class="flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700 px-4 h-10 rounded-xl transition font-medium text-sm"
            >
                <i data-lucide="arrow-left" class="w-4 h-4"></i>
                Volver a Compras
            </a>
            <!-- 🔥 BOTÓN PARA IR A DESPACHOS -->
            <a
                href="/acopio/despachos"
                class="flex items-center gap-2 bg-emerald-500 hover:bg-emerald-400 text-white px-4 h-10 rounded-xl transition font-medium text-sm shadow-md hover:shadow-lg"
            >
                <i data-lucide="truck" class="w-4 h-4"></i>
                Ir a Despachos
            </a>
        </div>
    </div>

    <!-- INDICADOR DE CARGA -->
    {isLoading && (
        <div class="text-center py-12">
            <span class="material-symbols-outlined animate-spin text-primary text-4xl">progress_activity</span>
            <p class="mt-2 text-slate-500">Cargando datos...</p>
        </div>
    )}

    <!-- MENSAJE DE ERROR -->
    {error && (
        <div class="bg-red-50 border border-red-200 rounded-xl p-6 text-center">
            <span class="material-symbols-outlined text-red-500 text-4xl">error</span>
            <p class="mt-2 text-red-600">{error}</p>
        </div>
    )}

    <!-- ============================================================ -->
    <!-- TAB: INGRESO / INVENTARIO / TRILLA                          -->
    <!-- ============================================================ -->
    {!isLoading && !error && (
        <div>
            <!-- Tabs -->
            <div class="border-b border-slate-200 mb-6">
                <nav class="flex gap-6">
                    <button 
                        class="tab-btn py-3 px-1 text-sm font-medium border-b-2 border-emerald-600 text-emerald-600 transition"
                        data-tab="ingreso"
                    >
                        📥 Ingreso a Bodega
                    </button>
                    <button 
                        class="tab-btn py-3 px-1 text-sm font-medium border-b-2 border-transparent text-slate-500 hover:text-slate-700 transition"
                        data-tab="inventario"
                    >
                        📊 Inventario
                    </button>
                    <button 
                        class="tab-btn py-3 px-1 text-sm font-medium border-b-2 border-transparent text-slate-500 hover:text-slate-700 transition"
                        data-tab="trilla"
                    >
                        ⚙️ Trilla
                    </button>
                </nav>
            </div>

            <!-- ============================================================ -->
            <!-- TAB 1: INGRESO A BODEGA                                     -->
            <!-- ============================================================ -->
            <div id="tab-ingreso" class="tab-content space-y-6">
                <div class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm">
                    <h2 class="text-lg font-semibold text-slate-900 mb-4">
                        📥 Registrar Ingreso Físico
                    </h2>
                    <p class="text-sm text-slate-500 mb-4">
                        Selecciona una orden de compra aprobada para registrar el ingreso físico del café a bodega.
                    </p>

                    {ordenes.length === 0 ? (
                        <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-6 text-center">
                            <span class="material-symbols-outlined text-yellow-500 text-4xl">info</span>
                            <p class="mt-2 font-semibold text-yellow-700">No hay órdenes de compra pendientes de ingreso</p>
                            <p class="text-sm text-yellow-600 mt-1">
                                Todas las órdenes aprobadas ya han sido ingresadas a bodega o no hay órdenes aprobadas.
                            </p>
                            <a
                                href="/acopio/compras"
                                class="mt-4 inline-block px-4 py-2 bg-emerald-600 text-white rounded-lg text-sm font-medium hover:bg-emerald-500 transition"
                            >
                                Ir a Compras
                            </a>
                        </div>
                    ) : (
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            {ordenes.map((orden) => (
                                <div 
                                    key={orden.id} 
                                    class="border border-slate-200 rounded-xl p-4 hover:shadow-md transition-shadow orden-item"
                                    data-orden-id={orden.id}
                                >
                                    <div class="flex justify-between items-start">
                                        <div>
                                            <h4 class="font-semibold text-slate-900 text-sm">
                                                Orden #{orden.id}
                                            </h4>
                                            <p class="text-xs text-slate-500 mt-1">
                                                Muestra: {orden.muestraId?.substring(0, 8) || 'N/A'}...
                                            </p>
                                            <p class="text-xs text-slate-500">
                                                Finca: {orden.fincaNombre || 'N/A'}
                                            </p>
                                        </div>
                                        <span class="text-xs bg-emerald-100 text-emerald-700 px-2 py-0.5 rounded-full font-medium">
                                            ✅ Aprobada
                                        </span>
                                    </div>
                                    <div class="mt-3 grid grid-cols-2 gap-2 text-sm">
                                        <div class="flex justify-between">
                                            <span class="text-slate-500">Volumen:</span>
                                            <span class="font-medium text-slate-700">{orden.volumenKg} kg</span>
                                        </div>
                                        <div class="flex justify-between">
                                            <span class="text-slate-500">Precio:</span>
                                            <span class="font-medium text-slate-700">${orden.precioAcordado}/kg</span>
                                        </div>
                                        {orden.primas && (
                                            <div class="flex justify-between col-span-2">
                                                <span class="text-slate-500">Primas:</span>
                                                <span class="font-medium text-slate-700">${orden.primas}</span>
                                            </div>
                                        )}
                                    </div>
                                    {orden.aprobadoEUDR && (
                                        <div class="mt-2 flex items-center gap-1 text-xs text-emerald-600">
                                            <i data-lucide="check-circle" class="w-3 h-3"></i>
                                            ✅ EUDR Validado
                                        </div>
                                    )}
                                    <button 
                                        class="btn-ingresar-bodega mt-4 w-full text-sm bg-blue-600 hover:bg-blue-500 text-white px-4 py-2 rounded-lg transition font-medium flex items-center justify-center gap-2"
                                        data-orden-id={orden.id}
                                        data-volumen={orden.volumenKg}
                                        data-muestra-id={orden.muestraId}
                                    >
                                        <i data-lucide="arrow-down-circle" class="w-4 h-4"></i>
                                        Registrar Ingreso
                                    </button>
                                </div>
                            ))}
                        </div>
                    )}
                </div>
            </div>

            <!-- ============================================================ -->
            <!-- TAB 2: INVENTARIO                                           -->
            <!-- ============================================================ -->
            <div id="tab-inventario" class="tab-content hidden space-y-6">
                <div class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm">
                    <div class="flex justify-between items-center mb-4">
                        <h2 class="text-lg font-semibold text-slate-900">
                            📊 Inventario Actual
                        </h2>
                        <div class="flex gap-2 text-xs">
                            <span class="px-2 py-1 bg-blue-100 text-blue-700 rounded-full">
                                En Bodega: {inventario.filter(i => i.estado === 'EN_BODEGA').length}
                            </span>
                            <span class="px-2 py-1 bg-yellow-100 text-yellow-700 rounded-full">
                                En Trilla: {inventario.filter(i => i.estado === 'EN_TRILLA').length}
                            </span>
                            <span class="px-2 py-1 bg-emerald-100 text-emerald-700 rounded-full">
                                Despachado: {inventario.filter(i => i.estado === 'DESPACHADO').length}
                            </span>
                        </div>
                    </div>

                    {inventario.length === 0 ? (
                        <div class="bg-slate-50 border border-slate-200 rounded-xl p-8 text-center">
                            <span class="material-symbols-outlined text-slate-400 text-4xl">inbox</span>
                            <p class="mt-2 font-semibold text-slate-700">No hay inventario registrado</p>
                            <p class="text-sm text-slate-500 mt-1">
                                Registra ingresos desde la pestaña "Ingreso a Bodega".
                            </p>
                        </div>
                    ) : (
                        <div class="overflow-x-auto">
                            <table class="w-full text-sm">
                                <thead>
                                    <tr class="border-b border-slate-200">
                                        <th class="text-left py-3 px-4 font-semibold text-slate-600">ID</th>
                                        <th class="text-left py-3 px-4 font-semibold text-slate-600">Orden</th>
                                        <th class="text-left py-3 px-4 font-semibold text-slate-600">Código QR</th>
                                        <th class="text-right py-3 px-4 font-semibold text-slate-600">Ingreso (kg)</th>
                                        <th class="text-right py-3 px-4 font-semibold text-slate-600">Salida (kg)</th>
                                        <th class="text-center py-3 px-4 font-semibold text-slate-600">Estado</th>
                                        <th class="text-center py-3 px-4 font-semibold text-slate-600">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {inventario.map((item) => (
                                        <tr key={item.id} class="border-b border-slate-100 hover:bg-slate-50/50 transition">
                                            <td class="py-3 px-4 font-mono text-xs text-slate-600">{item.id}</td>
                                            <td class="py-3 px-4 font-mono text-xs text-slate-600">{item.ordenCompraId?.substring(0, 8) || 'N/A'}</td>
                                            <td class="py-3 px-4 font-mono text-xs text-slate-600">{item.codigoQR || 'N/A'}</td>
                                            <td class="py-3 px-4 text-right font-medium text-slate-700">{item.pesoIngresoKg}</td>
                                            <td class="py-3 px-4 text-right text-slate-600">{item.pesoSalidaKg || 0}</td>
                                            <td class="py-3 px-4 text-center">
                                                <span class={`
                                                    px-2 py-0.5 rounded-full text-xs font-medium
                                                    ${item.estado === 'EN_BODEGA' ? 'bg-blue-100 text-blue-700' : ''}
                                                    ${item.estado === 'EN_TRILLA' ? 'bg-yellow-100 text-yellow-700' : ''}
                                                    ${item.estado === 'DESPACHADO' ? 'bg-emerald-100 text-emerald-700' : ''}
                                                `}>
                                                    {item.estado?.replace('_', ' ') || 'N/A'}
                                                </span>
                                            </td>
                                            <td class="py-3 px-4 text-center">
                                                {item.estado === 'EN_BODEGA' && (
                                                    <button 
                                                        class="btn-ir-trillar text-xs bg-purple-100 hover:bg-purple-200 text-purple-700 px-3 py-1 rounded transition font-medium"
                                                        data-inventario-id={item.id}
                                                    >
                                                        ⚙️ Trillar
                                                    </button>
                                                )}
                                                {item.estado === 'EN_TRILLA' && (
                                                    <span class="text-xs text-yellow-600">⏳ En proceso</span>
                                                )}
                                                {item.estado === 'DESPACHADO' && (
                                                    <span class="text-xs text-emerald-600">✅ Completado</span>
                                                )}
                                            </td>
                                        </tr>
                                    ))}
                                </tbody>
                            </table>
                        </div>
                    )}
                </div>
            </div>

            <!-- ============================================================ -->
            <!-- TAB 3: TRILLA - CORREGIDA CON UUID                         -->
            <!-- ============================================================ -->
            <div id="tab-trilla" class="tab-content hidden space-y-6">
                <div class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm">
                    <h2 class="text-lg font-semibold text-slate-900 mb-4">
                        ⚙️ Procesar Trilla (Balance de Masa)
                    </h2>
                    <p class="text-sm text-slate-500 mb-4">
                        Procesa el café pergamino a café oro, calculando el rendimiento y la merma.
                    </p>

                    {inventario.filter(i => i.estado === 'EN_BODEGA').length === 0 ? (
                        <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-6 text-center">
                            <span class="material-symbols-outlined text-yellow-500 text-4xl">info</span>
                            <p class="mt-2 font-semibold text-yellow-700">No hay café en bodega para trillar</p>
                            <p class="text-sm text-yellow-600 mt-1">
                                Primero registra ingresos a bodega desde la pestaña "Ingreso a Bodega".
                            </p>
                        </div>
                    ) : (
                        <div class="space-y-4">
                            {inventario.filter(i => i.estado === 'EN_BODEGA').map((item) => {
                                const inputId = `factor-${item.id}`;
                                return (
                                    <div key={item.id} class="border border-slate-200 rounded-xl p-4 flex flex-col md:flex-row md:items-center justify-between gap-4 hover:shadow-md transition-shadow">
                                        <div class="flex-1">
                                            <div class="flex items-center gap-3">
                                                <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center text-purple-600">
                                                    <i data-lucide="package" class="w-5 h-5"></i>
                                                </div>
                                                <div>
                                                    <p class="font-semibold text-slate-900 text-sm">
                                                        Lote #{item.id.substring(0, 8)}
                                                    </p>
                                                    <p class="text-xs text-slate-500">
                                                        Código QR: <span class="font-mono">{item.codigoQR || 'N/A'}</span>
                                                    </p>
                                                    <p class="text-xs text-slate-500">
                                                        Peso ingresado: <span class="font-medium text-slate-700">{item.pesoIngresoKg} kg</span>
                                                    </p>
                                                    <p class="text-xs text-slate-500">
                                                        Orden: <span class="font-mono">{item.ordenCompraId?.substring(0, 8) || 'N/A'}</span>
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="flex flex-wrap items-center gap-3">
                                            <div>
                                                <label class="text-xs text-slate-500 block mb-1">Factor de rendimiento</label>
                                                <input
                                                    id={inputId}
                                                    type="number"
                                                    step="0.01"
                                                    min="0.01"
                                                    max="1.00"
                                                    placeholder="0.78"
                                                    class="factor-trilla-input w-32 h-10 px-3 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-purple-500 focus:outline-none transition"
                                                    data-inventario-id={item.id}
                                                    value="0.78"
                                                />
                                            </div>
                                            <button 
                                                class="btn-procesar-trilla text-sm bg-purple-600 hover:bg-purple-500 text-white px-5 py-2.5 rounded-lg transition font-medium shadow-sm hover:shadow-md flex items-center gap-2 mt-5"
                                                data-inventario-id={item.id}
                                                data-peso={item.pesoIngresoKg}
                                            >
                                                <i data-lucide="flask" class="w-4 h-4"></i>
                                                Procesar Trilla
                                            </button>
                                        </div>
                                    </div>
                                );
                            })}
                        </div>
                    )}
                </div>
            </div>
        </div>
    )}

</div>

<!-- ============================================================ -->
<!-- MODAL: INGRESO A BODEGA                                    -->
<!-- ============================================================ -->
<div id="modal-ingreso-bodega" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm hidden">
    <div class="bg-white rounded-2xl w-full max-w-lg mx-4 p-6 shadow-2xl animate-modal-in max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-5">
            <div class="flex items-center gap-3">
                <div class="bg-blue-500/10 p-2 rounded-xl text-blue-600">
                    <i data-lucide="arrow-down-circle" class="w-5 h-5"></i>
                </div>
                <h2 class="text-xl font-bold text-slate-900">Registrar Ingreso a Bodega</h2>
            </div>
            <button id="btn-cerrar-ingreso" class="text-slate-400 hover:text-slate-600 transition">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <form id="form-ingreso-bodega" class="space-y-4">
            <input type="hidden" id="ingreso-orden-id" />
            <input type="hidden" id="ingreso-muestra-id" />

            <div class="bg-slate-50 rounded-xl p-4 space-y-2">
                <div class="flex justify-between text-sm">
                    <span class="text-slate-500">Orden de Compra:</span>
                    <span id="ingreso-orden" class="font-medium text-slate-700">-</span>
                </div>
                <div class="flex justify-between text-sm">
                    <span class="text-slate-500">Volumen autorizado:</span>
                    <span id="ingreso-volumen-autorizado" class="font-medium text-slate-700">-</span>
                </div>
            </div>

            <div>
                <label for="ingreso-codigo-qr" class="block text-sm font-medium text-slate-700 mb-1.5">
                    Código QR de la muestra <span class="text-red-500">*</span>
                </label>
                <input
                    id="ingreso-codigo-qr"
                    type="text"
                    placeholder="QR-XXXXXX"
                    class="w-full h-12 px-4 border border-slate-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none transition"
                    required
                />
                <p class="text-xs text-slate-400 mt-1">Se cargará automáticamente desde la muestra</p>
                <div id="qr-cargado-info" class="hidden text-xs text-emerald-600 mt-1 flex items-center gap-1">
                    <i data-lucide="check-circle" class="w-3 h-3"></i>
                    <span>QR cargado desde la muestra</span>
                </div>
            </div>

            <div>
                <label for="ingreso-peso" class="block text-sm font-medium text-slate-700 mb-1.5">
                    Peso ingresado (lb) <span class="text-red-500">*</span>
                </label>
                <input
                    id="ingreso-peso"
                    type="number"
                    step="0.01"
                    placeholder="0.00"
                    class="w-full h-12 px-4 border border-slate-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none transition"
                    required
                />
                <p class="text-xs text-slate-400 mt-1">Se convertirá automáticamente a kilogramos</p>
                <div id="peso-sugerido-info" class="hidden text-xs text-slate-500 mt-1">
                    <i data-lucide="info" class="w-3 h-3 inline"></i>
                    Peso sugerido: <span id="peso-sugerido-valor">0</span> lb
                </div>
            </div>

            <div>
                <label for="ingreso-tipo-proceso" class="block text-sm font-medium text-slate-700 mb-1.5">
                    Tipo de Proceso <span class="text-red-500">*</span>
                </label>
                <select
                    id="ingreso-tipo-proceso"
                    class="w-full h-12 px-4 border border-slate-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none transition bg-white"
                    required
                >
                    <option value="">Selecciona un tipo</option>
                    <option value="Lavado">Lavado</option>
                    <option value="Natural">Natural</option>
                    <option value="Honey">Honey</option>
                </select>
                <p class="text-xs text-slate-400 mt-1">Se cargará automáticamente desde la muestra</p>
                <div id="proceso-cargado-info" class="hidden text-xs text-emerald-600 mt-1 flex items-center gap-1">
                    <i data-lucide="check-circle" class="w-3 h-3"></i>
                    <span>Proceso cargado desde la muestra</span>
                </div>
            </div>

            <div id="muestra-loading" class="hidden text-sm text-slate-500 flex items-center gap-2 p-2 bg-slate-50 rounded-lg">
                <i data-lucide="loader-circle" class="w-4 h-4 animate-spin"></i>
                <span>Cargando datos de la muestra...</span>
