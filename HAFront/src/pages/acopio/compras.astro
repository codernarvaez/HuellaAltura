---
// src/pages/acopio/compras.astro
import DashboardLayout from "../../layouts/LayoutVariable.astro";
import { AuthService } from "../../services/auth.service.ts";
import { AcopioService } from "../../services/acopio.service.ts";
import { FincaService } from "../../services/finca.service.ts";

// Obtener token y datos del usuario
const token = Astro.cookies.get("token")?.value;

let userData = null;
let userRole = '';
let muestras = [];
let fincas = [];
let error = null;
let isLoading = true;

if (token) {
  try {
    userData = await AuthService.getMe(token);
    userRole = userData?.role?.name || '';
    console.log("👤 Usuario:", userData?.first_name, userData?.last_name);
    console.log("🎭 Rol del usuario:", userRole);
    
    // Obtener fincas del usuario
    const esAdmin = userRole === 'SUPER_ADMIN' || userRole === 'TENANT_ADMIN' || userRole === 'ADMIN';
    
    if (esAdmin) {
      fincas = await FincaService.list(token);
    } else {
      fincas = await FincaService.getByUsuarioId(userData.id, token) || [];
    }
    console.log("📋 Fincas obtenidas:", fincas.length);
    
    // Obtener todas las muestras de todas las fincas
    let todasLasMuestras = [];
    for (const finca of fincas) {
      try {
        const muestrasFinca = await AcopioService.getMuestrasByFinca(finca.id, token);
        // Agregar nombre de finca a cada muestra
        const muestrasConFinca = muestrasFinca.map(m => ({
          ...m,
          fincaNombre: finca.nombre
        }));
        todasLasMuestras = [...todasLasMuestras, ...muestrasConFinca];
      } catch (e) {
        console.warn(`⚠️ Error obteniendo muestras de finca ${finca.id}:`, e.message);
      }
    }
    
    // 🔥 Filtrar solo muestras que tengan análisis completos
    // Por ahora, mostramos todas las muestras que tienen análisis físico y sensorial
    // En el frontend se cargarán los análisis para cada muestra
    muestras = todasLasMuestras;
    console.log("📋 Total muestras:", muestras.length);
    
    isLoading = false;
  } catch (e) {
    error = e.message;
    console.error("❌ Error:", e);
    isLoading = false;
  }
} else {
  isLoading = false;
  error = "No hay sesión activa";
}

const puedeAprobarCompras = userRole === 'SUPER_ADMIN' || 
                            userRole === 'TENANT_ADMIN' || 
                            userRole === 'ADMIN' || 
                            userRole === 'JEFE_CALIDAD';

const fincasStr = JSON.stringify(fincas);
const muestrasStr = JSON.stringify(muestras);
const userRoleStr = userRole;
const puedeAprobarComprasStr = puedeAprobarCompras ? 'true' : 'false';
const API_URL = "https://geoguard-exped.onrender.com";
---

<DashboardLayout title="Órdenes de Compra - Acopio">

<div class="space-y-6 max-w-[1400px] mx-auto">

    <!-- HEADER -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">
                🛒 Órdenes de Compra
            </h1>
            <p class="mt-1 text-sm text-slate-500 max-w-3xl">
                Selecciona muestras analizadas para generar órdenes de compra con validación EUDR.
            </p>
            <div class="mt-2 flex flex-wrap items-center gap-2">
                <span class="text-xs font-medium text-slate-500">Tu rol:</span>
                <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-primary/10 text-primary">
                    {userRole || 'No definido'}
                </span>
                {puedeAprobarCompras && (
                    <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-green-100 text-green-700">
                        ✅ Puede aprobar compras
                    </span>
                )}
            </div>
        </div>
        <div class="flex items-center gap-2">
            <a
                href="/acopio/muestras"
                class="flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700 px-4 h-10 rounded-xl transition font-medium text-sm"
            >
                <i data-lucide="arrow-left" class="w-4 h-4"></i>
                Volver a Muestras
            </a>
        </div>
    </div>

    <!-- INDICADOR DE CARGA -->
    {isLoading && (
        <div class="text-center py-12">
            <span class="material-symbols-outlined animate-spin text-primary text-4xl">progress_activity</span>
            <p class="mt-2 text-slate-500">Cargando muestras...</p>
        </div>
    )}

    <!-- MENSAJE DE ERROR -->
    {error && (
        <div class="bg-red-50 border border-red-200 rounded-xl p-6 text-center">
            <span class="material-symbols-outlined text-red-500 text-4xl">error</span>
            <p class="mt-2 text-red-600">{error}</p>
        </div>
    )}

    <!-- MENSAJE SIN MUESTRAS -->
    {!isLoading && !error && muestras.length === 0 && (
        <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-6 text-center">
            <span class="material-symbols-outlined text-yellow-500 text-4xl">info</span>
            <p class="mt-2 font-semibold text-yellow-700">No hay muestras disponibles</p>
            <p class="text-sm text-yellow-600 mt-1">
                {fincas.length === 0 
                    ? 'No tienes fincas asociadas. Contacta a un administrador.'
                    : 'Las muestras aparecerán aquí cuando tengan análisis físico y sensorial completos.'}
            </p>
            <a
                href="/acopio/laboratorio"
                class="mt-4 inline-block px-4 py-2 bg-purple-600 text-white rounded-lg text-sm font-medium hover:bg-purple-500 transition"
            >
                Ir a Laboratorio
            </a>
        </div>
    )}

    <!-- FILTRO Y LISTADO DE MUESTRAS -->
    {!isLoading && !error && muestras.length > 0 && (
        <div class="space-y-4">
            <!-- Filtro por finca -->
            <div class="bg-white border border-slate-200 rounded-xl p-4 flex flex-col sm:flex-row sm:items-center gap-4 shadow-sm">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-slate-400">filter_list</span>
                    <span class="text-sm font-medium text-slate-700">Filtrar por:</span>
                </div>
                <select
                    id="filtro-finca"
                    class="flex-1 h-10 px-3 border border-slate-200 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:outline-none transition bg-white text-sm"
                >
                    <option value="todas">Todas las fincas</option>
                    {fincas.map((finca) => (
                        <option key={finca.id} value={finca.id}>
                            {finca.nombre}
                        </option>
                    ))}
                </select>
                <select
                    id="filtro-estado"
                    class="flex-1 h-10 px-3 border border-slate-200 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:outline-none transition bg-white text-sm"
                >
                    <option value="todas">Todos los estados</option>
                    <option value="pendiente">Pendiente</option>
                    <option value="analizada">Con análisis completo</option>
                </select>
                <button
                    id="btn-filtrar"
                    class="px-4 py-2 bg-emerald-600 text-white rounded-lg text-sm font-medium hover:bg-emerald-500 transition"
                >
                    Filtrar
                </button>
            </div>

            <!-- Grid de muestras -->
            <div id="muestras-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {muestras.map((muestra) => (
                    <div 
                        key={muestra.id} 
                        class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow muestra-item"
                        data-muestra-id={muestra.id}
                        data-muestra-data={JSON.stringify(muestra)}
                    >
                        <div class="p-4">
                            <div class="flex justify-between items-start">
                                <div>
                                    <h3 class="font-semibold text-slate-900 text-sm">
                                        {muestra.fincaNombre || 'Finca no asignada'}
                                    </h3>
                                    <div class="flex items-center gap-2 mt-1 text-xs text-slate-500">
                                        <span>📅 {new Date(muestra.creadoEn).toLocaleDateString('es-ES')}</span>
                                        <span>•</span>
                                        <span>⚖️ {muestra.pesoKg} kg</span>
                                    </div>
                                </div>
                                <span class="text-xs bg-blue-100 text-blue-700 px-2 py-0.5 rounded-full font-medium">
                                    {muestra.tipoProceso || 'N/A'}
                                </span>
                            </div>
                            
                            <div class="mt-3 flex items-center gap-2">
                                <span class="text-xs text-slate-400">Código:</span>
                                <span class="text-xs font-mono text-slate-600">{muestra.codigoQR || 'N/A'}</span>
                            </div>

                            <!-- Estado de análisis -->
                            <div class="mt-3 border-t border-slate-100 pt-3">
                                <div class="flex items-center gap-2 text-xs">
                                    <span class="text-slate-500">🔬 Físico:</span>
                                    <span class="estado-fisico font-medium text-yellow-600" data-muestra-id={muestra.id}>
                                        <i data-lucide="loader-circle" class="w-3 h-3 inline animate-spin"></i>
                                        Cargando...
                                    </span>
                                </div>
                                <div class="flex items-center gap-2 text-xs mt-1">
                                    <span class="text-slate-500">☕ Sensorial:</span>
                                    <span class="estado-sensorial font-medium text-yellow-600" data-muestra-id={muestra.id}>
                                        <i data-lucide="loader-circle" class="w-3 h-3 inline animate-spin"></i>
                                        Cargando...
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="border-t border-slate-100 px-4 py-3 bg-slate-50/50 flex justify-end">
                            <button 
                                class="btn-seleccionar-muestra text-sm bg-emerald-600 hover:bg-emerald-500 text-white px-4 py-2 rounded-lg transition font-medium flex items-center gap-1 disabled:opacity-50 disabled:cursor-not-allowed"
                                data-muestra-id={muestra.id}
                                disabled
                            >
                                <i data-lucide="shopping-cart" class="w-4 h-4"></i>
                                Seleccionar
                            </button>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    )}

    <!-- CONTADOR DE MUESTRAS -->
    {!isLoading && !error && muestras.length > 0 && (
        <div class="text-xs text-slate-500 text-right">
            Total: <span class="font-semibold">{muestras.length}</span> muestras
        </div>
    )}

</div>

<!-- ============================================================ -->
<!-- MODAL PARA CREAR ORDEN DE COMPRA                           -->
<!-- ============================================================ -->
<div id="modal-orden-compra" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm hidden">
    <div class="bg-white rounded-2xl w-full max-w-lg mx-4 p-6 shadow-2xl animate-modal-in max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-5">
            <div class="flex items-center gap-3">
                <div class="bg-emerald-500/10 p-2 rounded-xl text-emerald-600">
                    <i data-lucide="shopping-cart" class="w-5 h-5"></i>
                </div>
                <h2 class="text-xl font-bold text-slate-900">Crear Orden de Compra</h2>
            </div>
            <button id="btn-cerrar-modal" class="text-slate-400 hover:text-slate-600 transition">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <form id="form-orden-compra" class="space-y-4">
            <input type="hidden" id="orden-muestra-id" />

            <!-- Información de la muestra -->
            <div class="bg-slate-50 rounded-xl p-4 space-y-2">
                <div class="flex justify-between text-sm">
                    <span class="text-slate-500">Finca:</span>
                    <span id="orden-finca" class="font-medium text-slate-700">-</span>
                </div>
                <div class="flex justify-between text-sm">
                    <span class="text-slate-500">Código QR:</span>
                    <span id="orden-qr" class="font-mono text-sm text-slate-700">-</span>
                </div>
                <div class="flex justify-between text-sm">
                    <span class="text-slate-500">Peso disponible:</span>
                    <span id="orden-peso" class="font-medium text-slate-700">-</span>
                </div>
                <div class="flex justify-between text-sm">
                    <span class="text-slate-500">Puntaje SCA:</span>
                    <span id="orden-puntaje" class="font-medium text-slate-700">-</span>
                </div>
            </div>

            <!-- Datos de la orden -->
            <div>
                <label for="orden-volumen" class="block text-sm font-medium text-slate-700 mb-1.5">
                    Volumen (kg) <span class="text-red-500">*</span>
                </label>
                <input
                    id="orden-volumen"
                    type="number"
                    step="0.01"
                    placeholder="0.00"
                    class="w-full h-12 px-4 border border-slate-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none transition"
                    required
                />
                <p class="text-xs text-slate-400 mt-1">Máximo: <span id="orden-volumen-max">0</span> kg</p>
            </div>

            <div>
                <label for="orden-precio" class="block text-sm font-medium text-slate-700 mb-1.5">
                    Precio Acordado ($/kg) <span class="text-red-500">*</span>
                </label>
                <input
                    id="orden-precio"
                    type="number"
                    step="0.01"
                    placeholder="0.00"
                    class="w-full h-12 px-4 border border-slate-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none transition"
                    required
                />
            </div>

            <div>
                <label for="orden-primas" class="block text-sm font-medium text-slate-700 mb-1.5">
                    Primas ($)
                </label>
                <input
                    id="orden-primas"
                    type="number"
                    step="0.01"
                    placeholder="0.00"
                    class="w-full h-12 px-4 border border-slate-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none transition"
                />
                <p class="text-xs text-slate-400 mt-1">Opcional - primas por calidad o certificación</p>
            </div>

            <!-- Validación EUDR -->
            <div class="bg-blue-50 border border-blue-200 rounded-xl p-4">
                <div class="flex items-start gap-3">
                    <div class="mt-0.5">
                        <i data-lucide="check-circle" class="w-5 h-5 text-blue-600"></i>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-blue-700">Validación EUDR</p>
                        <p class="text-xs text-blue-600 mt-1">
                            La orden de compra será validada automáticamente contra los requisitos EUDR 
                            (Cero deforestación, trazabilidad, etc.)
                        </p>
                    </div>
                </div>
            </div>

            <!-- Mensaje de error -->
            <div id="orden-error" class="hidden text-red-500 text-sm flex items-center gap-2">
                <i data-lucide="alert-circle" class="w-4 h-4"></i>
                <span id="orden-error-text">Error al crear la orden</span>
            </div>

            <!-- Botones -->
            <div class="flex gap-3 pt-4 border-t border-slate-100">
                <button
                    type="button"
                    id="btn-cancelar-orden"
                    class="flex-1 h-12 bg-slate-100 text-slate-700 rounded-xl font-medium hover:bg-slate-200 transition"
                >
                    Cancelar
                </button>
                <button
                    type="submit"
                    id="btn-guardar-orden"
                    class="flex-1 h-12 bg-emerald-600 text-white rounded-xl font-medium hover:bg-emerald-500 transition flex items-center justify-center gap-2"
                >
                    <i data-lucide="check" class="w-4 h-4"></i>
                    Aprobar Orden
                </button>
            </div>
        </form>
    </div>
</div>

</DashboardLayout>

<!-- Estilos CSS Inyectados -->
<style is:global>
    @keyframes modalIn {
        from {
            opacity: 0;
            transform: scale(0.95) translateY(10px);
        }
        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }
    .animate-modal-in {
        animation: modalIn 0.2s ease-out;
    }
</style>

<script is:inline src="https://unpkg.com/lucide@latest"></script>

<script>
    import { AuthService } from "/src/services/auth.service.ts";
    import { AcopioService } from "/src/services/acopio.service.ts";
    import { FincaService } from "../services/finca.service.ts";

    console.log("🛒 Página de Órdenes de Compra cargada");

    const API_URL = "https://geoguard-exped.onrender.com";
    let muestrasData = [];
    let muestraSeleccionada = null;

    function getCookie(name) {
        const match = document.cookie.match(new RegExp(`(?:^|; )${name}=([^;]*)`));
        return match ? decodeURIComponent(match[1]) : "";
    }

    function getToken() {
        return getCookie('token');
    }

    // ============================================================
    // CARGAR ANÁLISIS DE CADA MUESTRA
    // ============================================================

    async function cargarAnalisisMuestra(muestraId) {
        try {
            const token = getToken();
            if (!token) return null;

            const [fisico, sensorial] = await Promise.all([
                AcopioService.getAnalisisFisico(muestraId, token),
                AcopioService.getAnalisisSensorial(muestraId, token)
            ]);

            return { fisico, sensorial };
        } catch (error) {
            console.warn(`⚠️ Error cargando análisis para muestra ${muestraId}:`, error);
            return null;
        }
    }

    async function cargarTodosLosAnalisis() {
        const items = document.querySelectorAll('.muestra-item');
        for (const item of items) {
            const muestraId = item.dataset.muestraId;
            const estadoFisico = item.querySelector('.estado-fisico');
            const estadoSensorial = item.querySelector('.estado-sensorial');
            const btnSeleccionar = item.querySelector('.btn-seleccionar-muestra');

            const analisis = await cargarAnalisisMuestra(muestraId);
            
            if (analisis && analisis.fisico && analisis.sensorial) {
                // ✅ Tiene ambos análisis
                estadoFisico.textContent = '✅ Completado';
                estadoFisico.className = 'estado-fisico font-medium text-emerald-600';
                estadoSensorial.textContent = `✅ ${analisis.sensorial.puntajeTotal} pts`;
                estadoSensorial.className = 'estado-sensorial font-medium text-emerald-600';
                btnSeleccionar.disabled = false;
                btnSeleccionar.title = 'Seleccionar muestra para orden de compra';
            } else if (analisis && analisis.fisico) {
                // ⚠️ Solo físico
                estadoFisico.textContent = '✅ Completado';
                estadoFisico.className = 'estado-fisico font-medium text-emerald-600';
                estadoSensorial.textContent = '⏳ Pendiente';
                estadoSensorial.className = 'estado-sensorial font-medium text-yellow-600';
                btnSeleccionar.disabled = true;
                btnSeleccionar.title = 'Falta análisis sensorial';
            } else if (analisis && analisis.sensorial) {
                // ⚠️ Solo sensorial
                estadoFisico.textContent = '⏳ Pendiente';
                estadoFisico.className = 'estado-fisico font-medium text-yellow-600';
                estadoSensorial.textContent = `✅ ${analisis.sensorial.puntajeTotal} pts`;
                estadoSensorial.className = 'estado-sensorial font-medium text-emerald-600';
                btnSeleccionar.disabled = true;
                btnSeleccionar.title = 'Falta análisis físico';
            } else {
                // ❌ Sin análisis
                estadoFisico.textContent = '❌ No realizado';
                estadoFisico.className = 'estado-fisico font-medium text-red-500';
                estadoSensorial.textContent = '❌ No realizado';
                estadoSensorial.className = 'estado-sensorial font-medium text-red-500';
                btnSeleccionar.disabled = true;
                btnSeleccionar.title = 'Faltan análisis completos';
            }

            // Guardar datos de análisis en el elemento
            if (analisis) {
                item.dataset.analisisFisico = JSON.stringify(analisis.fisico);
                item.dataset.analisisSensorial = JSON.stringify(analisis.sensorial);
            }
        }

        // Recrear íconos
        if (window.lucide) window.lucide.createIcons();
    }

    // ============================================================
    // MODAL DE ORDEN DE COMPRA
    // ============================================================

    function toggleModalOrden(show, muestraData = null, analisis = null) {
        const modal = document.getElementById('modal-orden-compra');
        if (show && muestraData && analisis) {
            muestraSeleccionada = muestraData;
            
            // Llenar información de la muestra
            document.getElementById('orden-muestra-id').value = muestraData.id;
            document.getElementById('orden-finca').textContent = muestraData.fincaNombre || 'N/A';
            document.getElementById('orden-qr').textContent = muestraData.codigoQR || 'N/A';
            document.getElementById('orden-peso').textContent = `${muestraData.pesoKg} kg`;
            
            const puntaje = analisis.sensorial?.puntajeTotal || 'N/A';
            document.getElementById('orden-puntaje').textContent = puntaje;
            
            // Volumen máximo disponible
            document.getElementById('orden-volumen-max').textContent = muestraData.pesoKg;
            document.getElementById('orden-volumen').max = muestraData.pesoKg;
            document.getElementById('orden-volumen').value = '';
            document.getElementById('orden-precio').value = '';
            document.getElementById('orden-primas').value = '';
            
            // Ocultar errores
            document.getElementById('orden-error').classList.add('hidden');
            
            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
            if (window.lucide) window.lucide.createIcons();
        } else {
            modal.classList.add('hidden');
            document.body.style.overflow = '';
            muestraSeleccionada = null;
        }
    }

    // ============================================================
    // CREAR ORDEN DE COMPRA
    // ============================================================

    async function crearOrdenCompra(event) {
        event.preventDefault();

        const muestraId = document.getElementById('orden-muestra-id').value;
        const volumenKg = parseFloat(document.getElementById('orden-volumen').value);
        const precioAcordado = parseFloat(document.getElementById('orden-precio').value);
        const primas = parseFloat(document.getElementById('orden-primas').value) || 0;

        if (!muestraId || isNaN(volumenKg) || isNaN(precioAcordado) || volumenKg <= 0 || precioAcordado <= 0) {
            const errorDiv = document.getElementById('orden-error');
            errorDiv.classList.remove('hidden');
            errorDiv.classList.add('text-red-500');
            document.getElementById('orden-error-text').textContent = 'Volumen y precio son obligatorios y deben ser mayores a 0';
            return;
        }

        const payload = {
            muestraId,
            volumenKg,
            precioAcordado,
            primas
        };

        console.log('📦 Payload orden de compra:', JSON.stringify(payload, null, 2));

        try {
            const token = getToken();
            if (!token) {
                const errorDiv = document.getElementById('orden-error');
                errorDiv.classList.remove('hidden');
                errorDiv.classList.add('text-red-500');
                document.getElementById('orden-error-text').textContent = 'No hay sesión activa';
                return;
            }

            const btnGuardar = document.getElementById('btn-guardar-orden');
            btnGuardar.disabled = true;
            btnGuardar.innerHTML = '<i data-lucide="loader-circle" class="w-4 h-4 animate-spin"></i> Validando EUDR...';

            const resultado = await AcopioService.aprobarOrdenCompra(payload, token);
            console.log('✅ Orden de compra creada:', resultado);

            const errorDiv = document.getElementById('orden-error');
            errorDiv.classList.remove('hidden', 'text-red-500');
            errorDiv.classList.add('text-emerald-500');
            document.getElementById('orden-error-text').textContent = `✅ Orden #${resultado.orden_id} aprobada - EUDR: ✅ Validada`;

            setTimeout(() => {
                toggleModalOrden(false);
                window.location.reload();
            }, 2000);

        } catch (error) {
            console.error('❌ Error al crear orden de compra:', error);
            const errorDiv = document.getElementById('orden-error');
            errorDiv.classList.remove('hidden');
            errorDiv.classList.add('text-red-500');
            
            // Mensajes específicos para EUDR
            let mensaje = error.message || 'Error al crear la orden';
            if (mensaje.includes('EUDR') || mensaje.includes('deforestación')) {
                mensaje = '❌ Validación EUDR fallida: ' + mensaje;
            }
            document.getElementById('orden-error-text').textContent = mensaje;
            
            const btnGuardar = document.getElementById('btn-guardar-orden');
            btnGuardar.disabled = false;
            btnGuardar.innerHTML = '<i data-lucide="check" class="w-4 h-4"></i> Aprobar Orden';
            if (window.lucide) window.lucide.createIcons();
        }
    }

    // ============================================================
    // FILTRAR MUESTRAS
    // ============================================================

    function filtrarMuestras() {
        const fincaFilter = document.getElementById('filtro-finca').value;
        const estadoFilter = document.getElementById('filtro-estado').value;
        const items = document.querySelectorAll('.muestra-item');

        items.forEach(item => {
            const data = JSON.parse(item.dataset.muestraData);
            let mostrar = true;

            // Filtro por finca
            if (fincaFilter !== 'todas' && data.fincaId !== fincaFilter) {
                mostrar = false;
            }

            // Filtro por estado de análisis
            if (estadoFilter !== 'todas') {
                const btn = item.querySelector('.btn-seleccionar-muestra');
                const tieneAnalisis = !btn.disabled;
                if (estadoFilter === 'analizada' && !tieneAnalisis) {
                    mostrar = false;
                }
                if (estadoFilter === 'pendiente' && tieneAnalisis) {
                    mostrar = false;
                }
            }

            item.style.display = mostrar ? '' : 'none';
        });
    }

    // ============================================================
    // EVENTOS
    // ============================================================

    document.addEventListener('DOMContentLoaded', () => {
        console.log('🔧 Inicializando eventos...');

        // Cargar análisis para todas las muestras
        cargarTodosLosAnalisis();

        // ---- Botones Seleccionar Muestra ----
        document.querySelectorAll('.btn-seleccionar-muestra').forEach(btn => {
            btn.addEventListener('click', function() {
                const muestraId = this.dataset.muestraId;
                const item = this.closest('.muestra-item');
                const data = JSON.parse(item.dataset.muestraData);
                const analisis = {
                    fisico: JSON.parse(item.dataset.analisisFisico || 'null'),
                    sensorial: JSON.parse(item.dataset.analisisSensorial || 'null')
                };
                
                if (!analisis.fisico || !analisis.sensorial) {
                    alert('Esta muestra no tiene análisis completos');
                    return;
                }
                
                toggleModalOrden(true, data, analisis);
            });
        });

        // ---- Cerrar Modal ----
        document.getElementById('btn-cerrar-modal')?.addEventListener('click', () => toggleModalOrden(false));
        document.getElementById('btn-cancelar-orden')?.addEventListener('click', () => toggleModalOrden(false));
        document.getElementById('modal-orden-compra')?.addEventListener('click', (e) => {
            if (e.target === e.currentTarget) toggleModalOrden(false);
        });

        // ---- Formulario ----
        document.getElementById('form-orden-compra')?.addEventListener('submit', crearOrdenCompra);

        // ---- Filtros ----
        document.getElementById('btn-filtrar')?.addEventListener('click', filtrarMuestras);
        document.getElementById('filtro-finca')?.addEventListener('change', filtrarMuestras);
        document.getElementById('filtro-estado')?.addEventListener('change', filtrarMuestras);

        // ---- Recrear íconos Lucide ----
        if (window.lucide) {
            window.lucide.createIcons();
        }

        console.log('✅ Eventos inicializados correctamente');
    });

    document.addEventListener('astro:after-swap', () => {
        if (window.lucide) {
            window.lucide.createIcons();
        }
    });
</script>