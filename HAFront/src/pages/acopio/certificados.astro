---
// src/pages/acopio/certificados.astro
import DashboardLayout from "../../layouts/LayoutVariable.astro";
import { AuthService } from "../../services/auth.service.ts";
import { AcopioService } from "../../services/acopio.service.ts";

// Obtener token y datos del usuario
const token = Astro.cookies.get("token")?.value;

let userData = null;
let userRole = '';
let lotesDespachados = [];
let error = null;
let isLoading = true;
let certificadoGenerado = null;

if (token) {
  try {
    userData = await AuthService.getMe(token);
    userRole = userData?.role?.name || '';
    console.log("👤 Usuario:", userData?.first_name, userData?.last_name);
    console.log("🎭 Rol del usuario:", userRole);
    
    // Obtener inventario despachado
    try {
      const allInventario = await AcopioService.getInventarioAll(token);
      // Filtrar solo los que están despachados
      lotesDespachados = allInventario.filter(i => i.estado === 'DESPACHADO');
      console.log("📦 Lotes despachados:", lotesDespachados.length);
    } catch (e) {
      console.warn("⚠️ Error obteniendo lotes despachados:", e.message);
      lotesDespachados = [];
    }
    
    isLoading = false;
  } catch (e) {
    error = e.message;
    console.error("❌ Error:", e);
    isLoading = false;
  }
} else {
  isLoading = false;
  error = "No hay sesión activa";
}

const puedeVerCertificados = userRole === 'SUPER_ADMIN' || 
                             userRole === 'TENANT_ADMIN' || 
                             userRole === 'ADMIN' || 
                             userRole === 'JEFE_CALIDAD' ||
                             userRole === 'BODEGUERO';

const lotesDespachadosStr = JSON.stringify(lotesDespachados);
const userRoleStr = userRole;
const puedeVerCertificadosStr = puedeVerCertificados ? 'true' : 'false';
const API_URL = "https://geoguard-exped.onrender.com";
---

<DashboardLayout title="Certificados - Acopio">

<div class="space-y-6 max-w-[1400px] mx-auto">

    <!-- HEADER -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">
                📄 Certificados de Trazabilidad
            </h1>
            <p class="mt-1 text-sm text-slate-500 max-w-3xl">
                Generación y descarga de certificados de trazabilidad para lotes de café despachados.
            </p>
            <div class="mt-2 flex flex-wrap items-center gap-2">
                <span class="text-xs font-medium text-slate-500">Tu rol:</span>
                <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-primary/10 text-primary">
                    {userRole || 'No definido'}
                </span>
                {puedeVerCertificados && (
                    <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-purple-100 text-purple-700">
                        ✅ Puede generar certificados
                    </span>
                )}
            </div>
        </div>
        <div class="flex items-center gap-2">
            <a
                href="/acopio/despachos"
                class="flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700 px-4 h-10 rounded-xl transition font-medium text-sm"
            >
                <i data-lucide="arrow-left" class="w-4 h-4"></i>
                Volver a Despachos
            </a>
        </div>
    </div>

    <!-- INDICADOR DE CARGA -->
    {isLoading && (
        <div class="text-center py-12">
            <span class="material-symbols-outlined animate-spin text-primary text-4xl">progress_activity</span>
            <p class="mt-2 text-slate-500">Cargando datos...</p>
        </div>
    )}

    <!-- MENSAJE DE ERROR -->
    {error && (
        <div class="bg-red-50 border border-red-200 rounded-xl p-6 text-center">
            <span class="material-symbols-outlined text-red-500 text-4xl">error</span>
            <p class="mt-2 text-red-600">{error}</p>
        </div>
    )}

    <!-- ============================================================ -->
    <!-- CONTENIDO PRINCIPAL                                         -->
    <!-- ============================================================ -->
    {!isLoading && !error && (
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            
            <!-- ============================================================ -->
            <!-- COLUMNA IZQUIERDA: Lista de lotes                            -->
            <!-- ============================================================ -->
            <div class="lg:col-span-1">
                <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-sm">
                    <h2 class="text-sm font-semibold text-slate-900 mb-3 flex items-center gap-2">
                        <i data-lucide="package" class="w-4 h-4"></i>
                        Lotes Despachados
                        <span class="ml-auto text-xs bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full">
                            {lotesDespachados.length}
                        </span>
                    </h2>

                    {lotesDespachados.length === 0 ? (
                        <div class="text-center py-6">
                            <span class="material-symbols-outlined text-slate-300 text-3xl">inbox</span>
                            <p class="mt-2 text-sm text-slate-500">No hay lotes despachados</p>
                            <p class="text-xs text-slate-400 mt-1">
                                Primero registra despachos desde la página de Despachos.
                            </p>
                            <a
                                href="/acopio/despachos"
                                class="mt-3 inline-block px-3 py-1.5 bg-emerald-600 text-white rounded-lg text-xs font-medium hover:bg-emerald-500 transition"
                            >
                                Ir a Despachos
                            </a>
                        </div>
                    ) : (
                        <div class="space-y-2 max-h-[600px] overflow-y-auto pr-1">
                            {lotesDespachados.map((lote) => (
                                <div 
                                    key={lote.id}
                                    class="lote-item border border-slate-200 rounded-lg p-3 hover:bg-slate-50 transition cursor-pointer"
                                    data-inventario-id={lote.id}
                                    data-orden-id={lote.ordenCompraId}
                                    onclick="seleccionarLote(this)"
                                >
                                    <div class="flex justify-between items-start">
                                        <div>
                                            <p class="font-medium text-sm text-slate-900">
                                                Lote #{lote.id}
                                            </p>
                                            <p class="text-xs text-slate-500 mt-0.5">
                                                Orden: {lote.ordenCompraId?.substring(0, 8) || 'N/A'}...
                                            </p>
                                        </div>
                                        <span class="text-xs bg-emerald-100 text-emerald-700 px-2 py-0.5 rounded-full font-medium">
                                            DESPACHADO
                                        </span>
                                    </div>
                                    <div class="mt-2 flex justify-between text-xs">
                                        <span class="text-slate-500">Peso:</span>
                                        <span class="font-medium text-slate-700">{lote.pesoIngresoKg} kg</span>
                                    </div>
                                    <div class="flex justify-between text-xs">
                                        <span class="text-slate-500">Despachado:</span>
                                        <span class="font-medium text-slate-700">{lote.pesoSalidaKg || 0} kg</span>
                                    </div>
                                    <div class="mt-2">
                                        <button 
                                            class="btn-generar-certificado w-full text-xs bg-purple-600 hover:bg-purple-500 text-white px-3 py-1.5 rounded-lg transition font-medium"
                                            data-inventario-id={lote.id}
                                        >
                                            <i data-lucide="file-text" class="w-3 h-3 inline mr-1"></i>
                                            Generar Certificado
                                        </button>
                                    </div>
                                </div>
                            ))}
                        </div>
                    )}
                </div>
            </div>

            <!-- ============================================================ -->
            <!-- COLUMNA DERECHA: Vista del certificado                      -->
            <!-- ============================================================ -->
            <div class="lg:col-span-2">
                <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
                    <!-- Encabezado del certificado -->
                    <div class="bg-gradient-to-r from-purple-600 to-purple-800 px-6 py-4">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="bg-white/20 p-2 rounded-lg">
                                    <i data-lucide="award" class="w-6 h-6 text-white"></i>
                                </div>
                                <div>
                                    <h2 class="text-lg font-bold text-white">Certificado de Trazabilidad</h2>
                                    <p class="text-xs text-purple-200">Café de Altura - Trazabilidad EUDR</p>
                                </div>
                            </div>
                            <div class="text-right">
                                <p class="text-xs text-purple-200">Versión</p>
                                <p class="text-sm font-bold text-white">1.0</p>
                            </div>
                        </div>
                    </div>

                    <!-- Cuerpo del certificado -->
                    <div id="certificado-body" class="p-6">
                        <!-- Estado: Sin selección -->
                        <div id="certificado-vacio" class="text-center py-12">
                            <span class="material-symbols-outlined text-slate-300 text-5xl">description</span>
                            <p class="mt-3 text-slate-500 font-medium">Selecciona un lote para generar su certificado</p>
                            <p class="text-sm text-slate-400 mt-1">
                                Haz clic en "Generar Certificado" en cualquier lote de la lista.
                            </p>
                        </div>

                        <!-- Estado: Cargando -->
                        <div id="certificado-cargando" class="hidden text-center py-12">
                            <span class="material-symbols-outlined animate-spin text-purple-600 text-4xl">progress_activity</span>
                            <p class="mt-3 text-slate-500">Generando certificado...</p>
                        </div>

                        <!-- Estado: Certificado generado -->
                        <div id="certificado-generado" class="hidden space-y-4">
                            <!-- Identificador -->
                            <div class="bg-slate-50 rounded-lg p-4 border border-slate-200">
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="text-xs text-slate-500">Identificador de Trazabilidad</p>
                                        <p id="cert-id" class="text-sm font-mono font-bold text-slate-900 mt-1">-</p>
                                    </div>
                                    <span id="cert-status" class="px-2 py-1 text-xs font-medium rounded-full bg-emerald-100 text-emerald-700">
                                        ✅ Válido
                                    </span>
                                </div>
                            </div>

                            <!-- Grid de información -->
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <!-- Origen -->
                                <div class="bg-slate-50 rounded-lg p-4 border border-slate-200">
                                    <p class="text-xs text-slate-500 flex items-center gap-1">
                                        <i data-lucide="map-pin" class="w-3 h-3"></i>
                                        Origen
                                    </p>
                                    <p id="cert-origen-finca" class="text-sm font-medium text-slate-900 mt-1">-</p>
                                    <p id="cert-origen-productor" class="text-xs text-slate-600 mt-0.5">-</p>
                                </div>

                                <!-- Fecha -->
                                <div class="bg-slate-50 rounded-lg p-4 border border-slate-200">
                                    <p class="text-xs text-slate-500 flex items-center gap-1">
                                        <i data-lucide="calendar" class="w-3 h-3"></i>
                                        Fecha de Emisión
                                    </p>
                                    <p id="cert-fecha" class="text-sm font-medium text-slate-900 mt-1">-</p>
                                </div>

                                <!-- Cumplimiento EUDR -->
                                <div class="bg-slate-50 rounded-lg p-4 border border-slate-200">
                                    <p class="text-xs text-slate-500 flex items-center gap-1">
                                        <i data-lucide="check-circle" class="w-3 h-3"></i>
                                        Cumplimiento EUDR
                                    </p>
                                    <div class="flex items-center gap-2 mt-1">
                                        <span id="cert-eudr-icon" class="text-emerald-600">
                                            <i data-lucide="check-circle" class="w-5 h-5"></i>
                                        </span>
                                        <span id="cert-eudr-text" class="text-sm font-medium text-emerald-700">Aprobado</span>
                                    </div>
                                    <p id="cert-eudr-fecha" class="text-xs text-slate-500 mt-0.5">-</p>
                                </div>

                                <!-- Perfil de Calidad -->
                                <div class="bg-slate-50 rounded-lg p-4 border border-slate-200">
                                    <p class="text-xs text-slate-500 flex items-center gap-1">
                                        <i data-lucide="coffee" class="w-3 h-3"></i>
                                        Perfil de Calidad
                                    </p>
                                    <div class="flex items-center justify-between mt-1">
                                        <span id="cert-clasificacion" class="text-sm font-medium text-slate-900">-</span>
                                        <span id="cert-puntaje" class="text-sm font-bold text-purple-600">-</span>
                                    </div>
                                    <p id="cert-humedad" class="text-xs text-slate-500 mt-0.5">-</p>
                                </div>
                            </div>

                            <!-- Rendimiento Industrial -->
                            <div class="bg-slate-50 rounded-lg p-4 border border-slate-200">
                                <p class="text-xs text-slate-500 flex items-center gap-1 mb-2">
                                    <i data-lucide="flask" class="w-3 h-3"></i>
                                    Rendimiento Industrial
                                </p>
                                <div class="grid grid-cols-3 gap-4">
                                    <div>
                                        <p class="text-xs text-slate-400">Peso Ingreso</p>
                                        <p id="cert-rendimiento-ingreso" class="text-sm font-medium text-slate-900">-</p>
                                    </div>
                                    <div>
                                        <p class="text-xs text-slate-400">Factor Trilla</p>
                                        <p id="cert-rendimiento-factor" class="text-sm font-medium text-slate-900">-</p>
                                    </div>
                                    <div>
                                        <p class="text-xs text-slate-400">Café Oro</p>
                                        <p id="cert-rendimiento-oro" class="text-sm font-bold text-emerald-600">-</p>
                                    </div>
                                </div>
                            </div>

                            <!-- Despacho -->
                            <div class="bg-slate-50 rounded-lg p-4 border border-slate-200">
                                <p class="text-xs text-slate-500 flex items-center gap-1 mb-2">
                                    <i data-lucide="truck" class="w-3 h-3"></i>
                                    Estado de Despacho
                                </p>
                                <div class="grid grid-cols-2 gap-4">
                                    <div>
                                        <p class="text-xs text-slate-400">Peso Autorizado</p>
                                        <p id="cert-despacho-peso" class="text-sm font-medium text-slate-900">-</p>
                                    </div>
                                    <div>
                                        <p class="text-xs text-slate-400">Estado</p>
                                        <p id="cert-despacho-estado" class="text-sm font-medium text-emerald-600">DESPACHADO</p>
                                    </div>
                                </div>
                            </div>

                            <!-- Botón de descarga -->
                            <div class="flex justify-end pt-2">
                                <button
                                    id="btn-descargar-pdf"
                                    class="px-6 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-sm font-medium transition flex items-center gap-2"
                                >
                                    <i data-lucide="download" class="w-4 h-4"></i>
                                    Descargar Certificado (PDF)
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    )}

</div>

</DashboardLayout>

<!-- Estilos CSS Inyectados -->
<style is:global>
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .certificado-animate {
        animation: fadeIn 0.3s ease-out;
    }
    .lote-item.selected {
        border-color: #7c3aed;
        background-color: #f5f3ff;
    }
</style>

<script is:inline src="https://unpkg.com/lucide@latest"></script>

<script>
    import { AuthService } from "/src/services/auth.service.ts";
    import { AcopioService } from "/src/services/acopio.service.ts";

    console.log("📄 Página de Certificados cargada");

    const API_URL = "https://geoguard-exped.onrender.com";
    let inventarioIdSeleccionado = null;
    let certificadoData = null;

    function getCookie(name) {
        const match = document.cookie.match(new RegExp(`(?:^|; )${name}=([^;]*)`));
        return match ? decodeURIComponent(match[1]) : "";
    }

    function getToken() {
        return getCookie('token');
    }

    // ============================================================
    // SELECCIONAR LOTE
    // ============================================================

    window.seleccionarLote = function(element) {
        // Remover selección anterior
        document.querySelectorAll('.lote-item').forEach(el => {
            el.classList.remove('selected');
        });
        
        // Seleccionar este
        element.classList.add('selected');
        
        // Obtener ID
        const inventarioId = element.dataset.inventarioId;
        if (inventarioId) {
            // Generar certificado automáticamente
            generarCertificado(parseInt(inventarioId));
        }
    };

    // ============================================================
    // GENERAR CERTIFICADO
    // ============================================================

    async function generarCertificado(inventarioId) {
        console.log('📄 Generando certificado para inventario:', inventarioId);
        
        // Mostrar loading
        document.getElementById('certificado-vacio').classList.add('hidden');
        document.getElementById('certificado-generado').classList.add('hidden');
        document.getElementById('certificado-cargando').classList.remove('hidden');

        try {
            const token = getToken();
            if (!token) {
                throw new Error('No hay sesión activa');
            }

            const certificado = await AcopioService.getCertificadoTrazabilidad(inventarioId, token);
            console.log('📄 Certificado:', certificado);
            
            certificadoData = certificado;
            inventarioIdSeleccionado = inventarioId;

            // Llenar datos
            // Identificador
            document.getElementById('cert-id').textContent = certificado.identificador_trazabilidad || 'N/A';
            
            // Origen
            document.getElementById('cert-origen-finca').textContent = certificado.origen?.finca_nombre || 'N/A';
            document.getElementById('cert-origen-productor').textContent = `Productor ID: ${certificado.origen?.productor_id || 'N/A'}`;
            
            // Fecha
            const fecha = new Date(certificado.fecha_emision);
            document.getElementById('cert-fecha').textContent = fecha.toLocaleDateString('es-ES', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            });
            
            // EUDR
            const eudrAprobado = certificado.cumplimiento_eudr?.aprobado_cero_deforestacion || false;
            document.getElementById('cert-eudr-text').textContent = eudrAprobado ? 'Aprobado' : 'No aprobado';
            document.getElementById('cert-eudr-text').className = eudrAprobado 
                ? 'text-sm font-medium text-emerald-700' 
                : 'text-sm font-medium text-red-700';
            document.getElementById('cert-eudr-icon').innerHTML = eudrAprobado 
                ? '<i data-lucide="check-circle" class="w-5 h-5 text-emerald-600"></i>'
                : '<i data-lucide="x-circle" class="w-5 h-5 text-red-600"></i>';
            document.getElementById('cert-eudr-fecha').textContent = certificado.cumplimiento_eudr?.fecha_analisis_satelital 
                ? `Análisis: ${new Date(certificado.cumplimiento_eudr.fecha_analisis_satelital).toLocaleDateString('es-ES')}`
                : '';
            
            // Perfil de Calidad
            document.getElementById('cert-clasificacion').textContent = certificado.perfil_calidad?.clasificacion || 'N/A';
            document.getElementById('cert-puntaje').textContent = certificado.perfil_calidad?.puntaje_sca 
                ? `${certificado.perfil_calidad.puntaje_sca} pts` 
                : 'N/A';
            document.getElementById('cert-humedad').textContent = certificado.perfil_calidad?.humedad_fisica 
                ? `Humedad: ${certificado.perfil_calidad.humedad_fisica}` 
                : '';
            
            // Rendimiento Industrial
            document.getElementById('cert-rendimiento-ingreso').textContent = certificado.rendimiento_industrial?.peso_ingreso_pergamino_kg 
                ? `${certificado.rendimiento_industrial.peso_ingreso_pergamino_kg} kg` 
                : 'N/A';
            document.getElementById('cert-rendimiento-factor').textContent = certificado.rendimiento_industrial?.factor_trilla 
                ? `${(parseFloat(certificado.rendimiento_industrial.factor_trilla) * 100).toFixed(0)}%` 
                : 'N/A';
            document.getElementById('cert-rendimiento-oro').textContent = certificado.rendimiento_industrial?.peso_oro_exportable_kg 
                ? `${certificado.rendimiento_industrial.peso_oro_exportable_kg} kg` 
                : 'N/A';
            
            // Despacho
            document.getElementById('cert-despacho-peso').textContent = certificado.estado_despacho?.kg_autorizados_salida 
                ? `${certificado.estado_despacho.kg_autorizados_salida} kg` 
                : 'N/A';
            document.getElementById('cert-despacho-estado').textContent = certificado.estado_despacho?.estado_bodega || 'DESPACHADO';
            
            // Mostrar certificado
            document.getElementById('certificado-cargando').classList.add('hidden');
            document.getElementById('certificado-generado').classList.remove('hidden');
            document.getElementById('certificado-generado').classList.add('certificado-animate');
            
            // Guardar inventarioId para descarga
            document.getElementById('btn-descargar-pdf').dataset.inventarioId = inventarioId;
            
            // Recrear íconos
            if (window.lucide) window.lucide.createIcons();

        } catch (error) {
            console.error('❌ Error al generar certificado:', error);
            document.getElementById('certificado-cargando').classList.add('hidden');
            document.getElementById('certificado-vacio').classList.remove('hidden');
            document.getElementById('certificado-vacio').innerHTML = `
                <span class="material-symbols-outlined text-red-400 text-5xl">error</span>
                <p class="mt-3 text-red-600 font-medium">Error al generar certificado</p>
                <p class="text-sm text-red-500 mt-1">${error.message || 'Error desconocido'}</p>
            `;
        }
    }

    // ============================================================
    // DESCARGAR PDF
    // ============================================================

    async function descargarPDF(inventarioId) {
        try {
            const token = getToken();
            if (!token) {
                alert('No hay sesión activa');
                return;
            }

            const btn = document.getElementById('btn-descargar-pdf');
            btn.disabled = true;
            btn.innerHTML = '<i data-lucide="loader-circle" class="w-4 h-4 animate-spin"></i> Descargando...';

            const blob = await AcopioService.descargarCertificadoPDF(inventarioId, token);
            
            // Crear URL de descarga
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `certificado-trazabilidad-${inventarioId}.pdf`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            window.URL.revokeObjectURL(url);

            console.log('✅ PDF descargado');

            btn.disabled = false;
            btn.innerHTML = '<i data-lucide="download" class="w-4 h-4"></i> Descargar Certificado (PDF)';
            if (window.lucide) window.lucide.createIcons();

        } catch (error) {
            console.error('❌ Error al descargar PDF:', error);
            alert('Error al descargar PDF: ' + (error.message || 'Error desconocido'));
            
            const btn = document.getElementById('btn-descargar-pdf');
            btn.disabled = false;
            btn.innerHTML = '<i data-lucide="download" class="w-4 h-4"></i> Descargar Certificado (PDF)';
            if (window.lucide) window.lucide.createIcons();
        }
    }

    // ============================================================
    // EVENTOS
    // ============================================================

    document.addEventListener('DOMContentLoaded', () => {
        console.log('🔧 Inicializando eventos...');

        // ---- Botones Generar Certificado ----
        document.querySelectorAll('.btn-generar-certificado').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.stopPropagation();
                const inventarioId = parseInt(this.dataset.inventarioId);
                if (inventarioId) {
                    generarCertificado(inventarioId);
                    // Seleccionar visualmente el lote
                    const parent = this.closest('.lote-item');
                    if (parent) {
                        document.querySelectorAll('.lote-item').forEach(el => el.classList.remove('selected'));
                        parent.classList.add('selected');
                    }
                }
            });
        });

        // ---- Descargar PDF ----
        document.getElementById('btn-descargar-pdf')?.addEventListener('click', function() {
            const inventarioId = parseInt(this.dataset.inventarioId);
            if (inventarioId) {
                descargarPDF(inventarioId);
            } else {
                alert('No hay certificado generado para descargar');
            }
        });

        // ---- Recrear íconos Lucide ----
        if (window.lucide) {
            window.lucide.createIcons();
        }

        console.log('✅ Eventos inicializados correctamente');
    });

    document.addEventListener('astro:after-swap', () => {
        if (window.lucide) {
            window.lucide.createIcons();
        }
    });
</script>