<!-- Estilos CSS Inyectados -->
<style is:global>
    @keyframes modalIn {
        from {
            opacity: 0;
            transform: scale(0.95) translateY(10px);
        }
        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }
    .animate-modal-in {
        animation: modalIn 0.2s ease-out;
    }
</style>

<script is:inline src="https://unpkg.com/lucide@latest"></script>

<script>
    import { AuthService } from "/src/services/auth.service.ts";
    import { AcopioService } from "/src/services/acopio.service.ts";
    import { FincaService } from "../services/finca.service.ts";

    console.log("🔬 Página de Laboratorio cargada");

    const API_URL = "https://geoguard-exped.onrender.com";
    let muestraSeleccionada = null;

    function getCookie(name) {
        const match = document.cookie.match(new RegExp(`(?:^|; )${name}=([^;]*)`));
        return match ? decodeURIComponent(match[1]) : "";
    }

    function getToken() {
        return getCookie('token');
    }

    // ============================================================
    // FUNCIONES DE LOS MODALES
    // ============================================================

    function toggleModalFisico(show, muestraId = null) {
        const modal = document.getElementById('modal-analisis-fisico');
        if (show && muestraId) {
            document.getElementById('fisico-muestra-id').value = muestraId;
            
            // Limpiar campos
            document.getElementById('fisico-humedad').value = '';
            document.getElementById('fisico-criba').value = '';
            document.getElementById('fisico-densidad').value = '';
            document.getElementById('fisico-defectos-prim').value = '';
            document.getElementById('fisico-defectos-sec').value = '';
            
            document.getElementById('fisico-error').classList.add('hidden');
            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
            if (window.lucide) window.lucide.createIcons();
        } else {
            modal.classList.add('hidden');
            document.body.style.overflow = '';
        }
    }

    function toggleModalCatacion(show, muestraId = null) {
        const modal = document.getElementById('modal-catacion');
        if (show && muestraId) {
            document.getElementById('catacion-muestra-id').value = muestraId;
            
            // Limpiar campos
            document.getElementById('catacion-fragancia').value = '';
            document.getElementById('catacion-sabor').value = '';
            document.getElementById('catacion-residual').value = '';
            document.getElementById('catacion-acidez').value = '';
            document.getElementById('catacion-cuerpo').value = '';
            document.getElementById('catacion-uniformidad').value = '';
            document.getElementById('catacion-balance').value = '';
            document.getElementById('catacion-taza-limpia').value = '';
            document.getElementById('catacion-dulzor').value = '';
            document.getElementById('catacion-puntaje-catador').value = '';
            document.getElementById('catacion-defectos').value = '';
            document.getElementById('catacion-tueste').value = '';
            
            document.getElementById('catacion-error').classList.add('hidden');
            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
            if (window.lucide) window.lucide.createIcons();
        } else {
            modal.classList.add('hidden');
            document.body.style.overflow = '';
        }
    }

    function toggleModalDetalle(show, muestraData = null) {
        const modal = document.getElementById('modal-detalle-muestra');
        if (show && muestraData) {
            document.getElementById('detalle-id').textContent = muestraData.id || 'N/A';
            document.getElementById('detalle-qr').textContent = muestraData.codigoQR || 'N/A';
            document.getElementById('detalle-finca').textContent = muestraData.fincaNombre || 'N/A';
            document.getElementById('detalle-productor').textContent = muestraData.productorId || 'N/A';
            document.getElementById('detalle-tipo').textContent = muestraData.tipoProceso || 'N/A';
            document.getElementById('detalle-peso').textContent = muestraData.pesoKg ? `${muestraData.pesoKg} kg` : 'N/A';
            document.getElementById('detalle-fecha').textContent = muestraData.creadoEn ? new Date(muestraData.creadoEn).toLocaleDateString('es-ES') : 'N/A';
            document.getElementById('detalle-estado').textContent = muestraData.estado || 'Pendiente';
            
            // Foto
            const fotoContainer = document.getElementById('detalle-foto-container');
            const fotoImg = document.getElementById('detalle-foto');
            if (muestraData.evidenciaFoto) {
                fotoImg.src = muestraData.evidenciaFoto;
                fotoContainer.classList.remove('hidden');
            } else {
                fotoContainer.classList.add('hidden');
            }

            // Cargar análisis
            cargarAnalisisMuestra(muestraData.id);
            
            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
            if (window.lucide) window.lucide.createIcons();
        } else {
            modal.classList.add('hidden');
            document.body.style.overflow = '';
        }
    }

    // ============================================================
    // CARGAR ANÁLISIS DE MUESTRA
    // ============================================================

    async function cargarAnalisisMuestra(muestraId) {
        try {
            const token = getToken();
            if (!token) {
                console.warn('⚠️ No hay token para cargar análisis');
                return;
            }

            console.log('🔍 Cargando análisis para muestra:', muestraId);

            // Cargar análisis físico
            try {
                const fisico = await AcopioService.getAnalisisFisico(muestraId, token);
                const statusEl = document.getElementById('detalle-fisico-status');
                if (fisico) {
                    statusEl.textContent = `✅ Realizado - Humedad: ${fisico.humedad}% | Criba: ${fisico.criba}mm`;
                    statusEl.className = 'font-medium text-emerald-600';
                } else {
                    statusEl.textContent = '⏳ Pendiente de análisis físico';
                    statusEl.className = 'font-medium text-yellow-600';
                }
            } catch (error) {
                console.warn('⚠️ Error cargando análisis físico:', error);
                const statusEl = document.getElementById('detalle-fisico-status');
                statusEl.textContent = '❌ Error al cargar';
                statusEl.className = 'font-medium text-red-500';
            }

            // Cargar análisis sensorial
            try {
                const sensorial = await AcopioService.getAnalisisSensorial(muestraId, token);
                const statusEl = document.getElementById('detalle-sensorial-status');
                if (sensorial) {
                    statusEl.textContent = `✅ Realizado - Puntaje: ${sensorial.puntajeTotal} | ${sensorial.clasificacion || 'N/A'}`;
                    statusEl.className = 'font-medium text-emerald-600';
                } else {
                    statusEl.textContent = '⏳ Pendiente de catación SCA';
                    statusEl.className = 'font-medium text-yellow-600';
                }
            } catch (error) {
                console.warn('⚠️ Error cargando análisis sensorial:', error);
                const statusEl = document.getElementById('detalle-sensorial-status');
                statusEl.textContent = '❌ Error al cargar';
                statusEl.className = 'font-medium text-red-500';
            }
        } catch (error) {
            console.error('❌ Error cargando análisis:', error);
        }
    }

    // ============================================================
    // REGISTRAR ANÁLISIS FÍSICO
    // ============================================================

    async function registrarAnalisisFisico(event) {
        event.preventDefault();

        const muestraId = document.getElementById('fisico-muestra-id').value;
        const humedad = parseFloat(document.getElementById('fisico-humedad').value);
        const criba = document.getElementById('fisico-criba').value.trim();
        const densidad = parseFloat(document.getElementById('fisico-densidad').value);
        const defectosPrim = parseInt(document.getElementById('fisico-defectos-prim').value);
        const defectosSec = parseInt(document.getElementById('fisico-defectos-sec').value);

        if (!muestraId || isNaN(humedad) || !criba || criba === '' || isNaN(densidad) || isNaN(defectosPrim) || isNaN(defectosSec)) {
            const errorDiv = document.getElementById('fisico-error');
            errorDiv.classList.remove('hidden');
            errorDiv.classList.add('text-red-500');
            document.getElementById('fisico-error-text').textContent = 'Todos los campos son obligatorios';
            return;
        }

        const payload = {
            muestraId,
            humedad,
            criba,
            densidad,
            defectosPrim,
            defectosSec
        };

        console.log('📦 Payload análisis físico:', JSON.stringify(payload, null, 2));

        try {
            const token = getToken();
            if (!token) {
                const errorDiv = document.getElementById('fisico-error');
                errorDiv.classList.remove('hidden');
                errorDiv.classList.add('text-red-500');
                document.getElementById('fisico-error-text').textContent = 'No hay sesión activa';
                return;
            }

            const btnGuardar = document.getElementById('btn-guardar-fisico');
            btnGuardar.disabled = true;
            btnGuardar.innerHTML = '<i data-lucide="loader-circle" class="w-4 h-4 animate-spin"></i> Guardando...';

            const resultado = await AcopioService.registrarAnalisisFisico(payload, token);
            console.log('✅ Análisis físico registrado:', resultado);

            const errorDiv = document.getElementById('fisico-error');
            errorDiv.classList.remove('hidden', 'text-red-500');
            errorDiv.classList.add('text-emerald-500');
            document.getElementById('fisico-error-text').textContent = '✅ Análisis físico registrado correctamente';

            setTimeout(() => {
                toggleModalFisico(false);
                window.location.reload();
            }, 1500);

        } catch (error) {
            console.error('❌ Error al registrar análisis físico:', error);
            const errorDiv = document.getElementById('fisico-error');
            errorDiv.classList.remove('hidden');
            errorDiv.classList.add('text-red-500');
            document.getElementById('fisico-error-text').textContent = error.message || 'Error al registrar análisis físico';
            
            const btnGuardar = document.getElementById('btn-guardar-fisico');
            btnGuardar.disabled = false;
            btnGuardar.innerHTML = '<i data-lucide="save" class="w-4 h-4"></i> Guardar Análisis';
            if (window.lucide) window.lucide.createIcons();
        }
    }

    // ============================================================
    // REGISTRAR CATACIÓN SCA
    // ============================================================

    async function registrarCatacion(event) {
        event.preventDefault();

        const muestraId = document.getElementById('catacion-muestra-id').value;
        const fraganciaAroma = parseFloat(document.getElementById('catacion-fragancia').value);
        const sabor = parseFloat(document.getElementById('catacion-sabor').value);
        const saborResidual = parseFloat(document.getElementById('catacion-residual').value);
        const acidez = parseFloat(document.getElementById('catacion-acidez').value);
        const cuerpo = parseFloat(document.getElementById('catacion-cuerpo').value);
        const uniformidad = parseFloat(document.getElementById('catacion-uniformidad').value);
        const balance = parseFloat(document.getElementById('catacion-balance').value);
        const tazaLimpia = parseFloat(document.getElementById('catacion-taza-limpia').value);
        const dulzor = parseFloat(document.getElementById('catacion-dulzor').value);
        const puntajeCatador = parseFloat(document.getElementById('catacion-puntaje-catador').value);
        const defectos = parseFloat(document.getElementById('catacion-defectos').value);
        const nivelTueste = document.getElementById('catacion-tueste').value;

        if (!muestraId || !nivelTueste) {
            const errorDiv = document.getElementById('catacion-error');
            errorDiv.classList.remove('hidden');
            errorDiv.classList.add('text-red-500');
            document.getElementById('catacion-error-text').textContent = 'Todos los campos son obligatorios';
            return;
        }

        const payload = {
            muestraId,
            fraganciaAroma,
            sabor,
            saborResidual,
            acidez,
            cuerpo,
            uniformidad,
            balance,
            tazaLimpia,
            dulzor,
            puntajeCatador,
            defectos,
            nivelTueste
        };

        console.log('📦 Payload catación:', JSON.stringify(payload, null, 2));

        try {
            const token = getToken();
            if (!token) {
                const errorDiv = document.getElementById('catacion-error');
                errorDiv.classList.remove('hidden');
                errorDiv.classList.add('text-red-500');
                document.getElementById('catacion-error-text').textContent = 'No hay sesión activa';
                return;
            }

            const btnGuardar = document.getElementById('btn-guardar-catacion');
            btnGuardar.disabled = true;
            btnGuardar.innerHTML = '<i data-lucide="loader-circle" class="w-4 h-4 animate-spin"></i> Guardando...';

            const resultado = await AcopioService.registrarAnalisisSensorial(payload, token);
            console.log('✅ Catación registrada:', resultado);

            const errorDiv = document.getElementById('catacion-error');
            errorDiv.classList.remove('hidden', 'text-red-500');
            errorDiv.classList.add('text-emerald-500');
            document.getElementById('catacion-error-text').textContent = `✅ Catación registrada - Puntaje: ${resultado.puntajeTotal} | ${resultado.clasificacion || 'N/A'}`;

            setTimeout(() => {
                toggleModalCatacion(false);
                window.location.reload();
            }, 1500);

        } catch (error) {
            console.error('❌ Error al registrar catación:', error);
            const errorDiv = document.getElementById('catacion-error');
            errorDiv.classList.remove('hidden');
            errorDiv.classList.add('text-red-500');
            document.getElementById('catacion-error-text').textContent = error.message || 'Error al registrar catación';
            
            const btnGuardar = document.getElementById('btn-guardar-catacion');
            btnGuardar.disabled = false;
            btnGuardar.innerHTML = '<i data-lucide="save" class="w-4 h-4"></i> Guardar Catación';
            if (window.lucide) window.lucide.createIcons();
        }
    }

    // ============================================================
    // EVENTOS
    // ============================================================

    document.addEventListener('DOMContentLoaded', () => {
        console.log('🔧 Inicializando eventos...');

        // ---- Botones Análisis Físico ----
        document.querySelectorAll('.btn-analisis-fisico').forEach(btn => {
            btn.addEventListener('click', function() {
                const muestraId = this.dataset.muestraId;
                if (muestraId) {
                    toggleModalFisico(true, muestraId);
                }
            });
        });

        // ---- Botones Catación ----
        document.querySelectorAll('.btn-catacion').forEach(btn => {
            btn.addEventListener('click', function() {
                const muestraId = this.dataset.muestraId;
                if (muestraId) {
                    toggleModalCatacion(true, muestraId);
                }
            });
        });

        // ---- Botones Ver Detalle ----
        document.querySelectorAll('.btn-ver-detalle').forEach(btn => {
            btn.addEventListener('click', function() {
                const muestraId = this.dataset.muestraId;
                const muestras = document.querySelectorAll('.muestra-item');
                let muestra = null;
                muestras.forEach(el => {
                    if (el.dataset.muestraId == muestraId) {
                        try {
                            muestra = JSON.parse(el.dataset.muestraData);
                            const fincasStr = document.querySelector('script[data-fincas]')?.textContent || '[]';
                            const fincas = JSON.parse(fincasStr);
                            const finca = fincas.find(f => f.id === muestra.fincaId);
                            muestra.fincaNombre = finca?.nombre || 'Finca no encontrada';
                        } catch (e) {
                            console.warn('Error parseando muestra:', e);
                        }
                    }
                });
                if (muestra) {
                    toggleModalDetalle(true, muestra);
                } else {
                    alert('Error: No se pudo obtener el detalle de la muestra');
                }
            });
        });

        // ---- Cerrar Modales ----
        document.getElementById('btn-cerrar-fisico')?.addEventListener('click', () => toggleModalFisico(false));
        document.getElementById('btn-cancelar-fisico')?.addEventListener('click', () => toggleModalFisico(false));
        document.getElementById('modal-analisis-fisico')?.addEventListener('click', (e) => {
            if (e.target === e.currentTarget) toggleModalFisico(false);
        });

        document.getElementById('btn-cerrar-catacion')?.addEventListener('click', () => toggleModalCatacion(false));
        document.getElementById('btn-cancelar-catacion')?.addEventListener('click', () => toggleModalCatacion(false));
        document.getElementById('modal-catacion')?.addEventListener('click', (e) => {
            if (e.target === e.currentTarget) toggleModalCatacion(false);
        });

        document.getElementById('btn-cerrar-detalle')?.addEventListener('click', () => toggleModalDetalle(false));
        document.getElementById('btn-cerrar-detalle-btn')?.addEventListener('click', () => toggleModalDetalle(false));
        document.getElementById('modal-detalle-muestra')?.addEventListener('click', (e) => {
            if (e.target === e.currentTarget) toggleModalDetalle(false);
        });

        // ---- Formularios ----
        document.getElementById('form-analisis-fisico')?.addEventListener('submit', registrarAnalisisFisico);
        document.getElementById('form-catacion')?.addEventListener('submit', registrarCatacion);

        // ---- Recrear íconos Lucide ----
        if (window.lucide) {
            window.lucide.createIcons();
        }

        console.log('✅ Eventos inicializados correctamente');
    });

    document.addEventListener('astro:after-swap', () => {
        if (window.lucide) {
            window.lucide.createIcons();
        }
    });
</script>