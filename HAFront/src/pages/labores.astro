---
// src/pages/ledger.astro
import DashboardLayout from "../layouts/LayoutVariable.astro";
import { AuthService } from "../services/auth.service.ts";
import { FincaService } from "../services/finca.service.ts";
import { LaboresService } from "../services/labores.service.ts";

// Obtener token de las cookies
const token = Astro.cookies.get("token")?.value;

let userData = null;
let fincaId = null;
let ledgerData = null;
let error = null;
let isLoading = true;

if (token) {
  try {
    userData = await AuthService.getMe(token);
    console.log("👤 Usuario:", userData?.first_name, userData?.last_name);
    
    if (userData?.id) {
      try {
        const fincas = await FincaService.getByUsuarioId(userData.id, token);
        if (fincas && fincas.length > 0) {
          fincaId = fincas[0].id;
          console.log("✅ Finca encontrada:", fincas[0].nombre);
          console.log("🆔 Finca ID:", fincaId);
          
          try {
            const response = await LaboresService.obtenerLedger(fincaId, token);
            ledgerData = response;
            console.log("📋 Ledger cargado:", JSON.stringify(ledgerData, null, 2));
          } catch (e) {
            console.warn("⚠️ Error obteniendo ledger:", e.message);
            ledgerData = null;
          }
        }
      } catch (e) {
        console.warn("⚠️ Error obteniendo finca:", e.message);
      }
    }
    
    isLoading = false;
  } catch (e) {
    error = e.message;
    console.error("❌ Error:", e);
    isLoading = false;
  }
} else {
  isLoading = false;
  error = "No hay sesión activa";
}

// Pasar datos al cliente
const fincaIdStr = fincaId ? String(fincaId) : '';
const ledgerDataStr = ledgerData ? JSON.stringify(ledgerData) : 'null';
const userDataStr = userData ? JSON.stringify(userData) : 'null';
const API_URL = "https://huellaaltura.onrender.com"; // o la URL de tu backend
---

<DashboardLayout title="Ledger de Labores">
  <div class="space-y-6 max-w-[1400px] mx-auto">
    
    <!-- HEADER DEL LEDGER -->
    <div>
      <h1 class="text-xl font-bold text-slate-900 tracking-tight">
        Ledger de Trazabilidad e Integridad Agronómica
      </h1>
      <p class="mt-1 text-sm text-slate-500 max-w-3xl">
        Historial inmutable de procesos agrícolas ejecutados con evidencia fotográfica digital in-situ.
      </p>
    </div>

    <!-- BANNER ESTADO DEL NODO -->
    <div class="bg-white border border-slate-200 rounded-xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-sm">
      <div class="flex items-center gap-2.5">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-600 animate-pulse"></span>
        <h2 class="text-sm font-bold text-slate-900">
          Libro Contable de Evidencias (Append-Only)
        </h2>
      </div>
      <div class="flex items-center gap-6 text-xs font-semibold">
        <div class="flex items-center gap-2 text-slate-500">
          <span>Estado del Nodo:</span>
          <span class="bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded text-[11px] font-bold tracking-wide uppercase">
            Sincronizado
          </span>
        </div>
        <div class="text-slate-500 border-l border-slate-200 pl-6">
          Total Registros: <span class="text-slate-900 font-bold text-sm ml-1" id="total-registros">0</span>
        </div>
      </div>
    </div>

    <!-- CONTENEDOR PRINCIPAL -->
    <div id="ledger-container" class="relative pl-6 sm:pl-8 space-y-6 before:absolute before:top-3 before:left-[11px] before:bottom-3 before:w-[1px] before:bg-dashed before:border-l before:border-dashed before:border-slate-300">
      
      {isLoading && (
        <div class="text-center py-12">
          <span class="material-symbols-outlined animate-spin text-primary text-4xl">progress_activity</span>
          <p class="mt-2 text-slate-500">Cargando ledger...</p>
        </div>
      )}

      {error && (
        <div class="bg-red-50 border border-red-200 rounded-xl p-6 text-center">
          <span class="material-symbols-outlined text-red-500 text-4xl">error</span>
          <p class="mt-2 text-red-600">{error}</p>
        </div>
      )}

    </div>

    <!-- FOOTER -->
    <div class="pt-6 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-medium text-slate-400">
      <p>© 2026 <span class="font-bold text-slate-600">Huella de Altura</span>. Powered by GeoTrace</p>
      <div class="flex items-center gap-4">
        <a href="#" class="hover:text-slate-600 transition">Privacy Policy</a>
        <a href="#" class="hover:text-slate-600 transition">Terms of Service</a>
        <a href="#" class="hover:text-slate-600 transition">Compliance Standards</a>
      </div>
    </div>

  </div>
</DashboardLayout>

<!-- Lucide Icons Setup -->
<script is:inline src="https://unpkg.com/lucide@latest"></script>

<script define:vars={{ 
  ledgerData: ledgerDataStr, 
  userData: userDataStr,
  API_URL: API_URL 
}}>
  console.log("📋 Ledger Data recibido:", ledgerData);
  console.log("🔗 API_URL:", API_URL);

  function formatDate(dateStr) {
    if (!dateStr) return 'Fecha no disponible';
    try {
      const date = new Date(dateStr);
      return date.toLocaleDateString('es-ES', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit'
      });
    } catch {
      return dateStr;
    }
  }

  function getEstadoColor(estado) {
    const colores = {
      'REGISTRADO': 'bg-blue-100 text-blue-700 border-blue-200',
      'AUDITADO': 'bg-purple-100 text-purple-700 border-purple-200',
      'EJECUTADO': 'bg-green-100 text-green-700 border-green-200',
      'PRE_VALIDADO': 'bg-yellow-100 text-yellow-700 border-yellow-200'
    };
    return colores[estado] || 'bg-slate-100 text-slate-700 border-slate-200';
  }

  function getEstadoLabel(estado) {
    const labels = {
      'REGISTRADO': 'Registrado',
      'AUDITADO': 'Auditado',
      'EJECUTADO': 'Ejecutado',
      'PRE_VALIDADO': 'Pre-validado'
    };
    return labels[estado] || estado || 'Desconocido';
  }

  function getInitials(nombre) {
    if (!nombre) return 'U';
    const partes = nombre.trim().split(' ');
    if (partes.length === 1) return partes[0].charAt(0).toUpperCase();
    return (partes[0].charAt(0) + partes[partes.length - 1].charAt(0)).toUpperCase();
  }

  // 🔥 Función para construir URL completa de la foto
  function getFotoUrl(fotoUrl) {
    if (!fotoUrl) return null;
    // Si ya es una URL completa, devolverla
    if (fotoUrl.startsWith('http://') || fotoUrl.startsWith('https://')) {
      return fotoUrl;
    }
    // Si es una URL relativa, construirla con la base
    if (fotoUrl.startsWith('/')) {
      return `${API_URL}${fotoUrl}`;
    }
    // Si es un path relativo sin slash
    return `${API_URL}/${fotoUrl}`;
  }

  function renderLedger() {
    const container = document.getElementById('ledger-container');
    const totalRegistros = document.getElementById('total-registros');
    
    if (!container) return;

    let data = null;
    try {
      if (ledgerData && ledgerData !== 'null') {
        data = typeof ledgerData === 'string' ? JSON.parse(ledgerData) : ledgerData;
      }
    } catch (e) {
      console.warn("⚠️ Error parseando ledgerData:", e);
      container.innerHTML = `
        <div class="bg-red-50 border border-red-200 rounded-xl p-6 text-center">
          <span class="material-symbols-outlined text-red-500 text-4xl">error</span>
          <p class="mt-2 text-red-600">Error al cargar los datos del ledger</p>
        </div>
      `;
      return;
    }

    if (!data || data.total_registros === 0) {
      if (totalRegistros) totalRegistros.textContent = '0';
      container.innerHTML = `
        <div class="bg-slate-50 border border-slate-200 rounded-xl p-8 text-center">
          <span class="material-symbols-outlined text-slate-400 text-4xl">inbox</span>
          <p class="mt-2 font-semibold text-slate-700">No hay labores ejecutadas</p>
          <p class="text-sm text-slate-500 mt-1">
            Las labores ejecutadas aparecerán aquí cuando se registren.
          </p>
        </div>
      `;
      return;
    }

    if (totalRegistros) {
      totalRegistros.textContent = data.total_registros;
    }

    container.innerHTML = '';

    const ledgerItems = data.ledger || [];
    
    ledgerItems.forEach((item, index) => {
      const bloqueNum = data.total_registros - index;
      const fechaFormateada = formatDate(item.fecha);
      const estadoColor = getEstadoColor(item.estado);
      const estadoLabel = getEstadoLabel(item.estado);
      const initials = getInitials(item.persona);
      
      const hashSimulado = item.id_ejecucion ? item.id_ejecucion.substring(0, 4) + '...' + item.id_ejecucion.substring(item.id_ejecucion.length - 4) : '0000...0000';
      
      const itemDiv = document.createElement('div');
      itemDiv.className = 'relative group';
      
      const nodeSpan = document.createElement('span');
      nodeSpan.className = 'absolute -left-[21px] top-6 w-4 h-4 rounded-full bg-emerald-100 border-4 border-emerald-600 z-10 transition group-hover:scale-110';
      
      const contentDiv = document.createElement('div');
      contentDiv.className = 'grid grid-cols-1 lg:grid-cols-3 gap-4 items-stretch';
      
      // Tarjeta de Datos
      const cardData = document.createElement('div');
      cardData.className = 'lg:col-span-2 bg-white border border-slate-200 rounded-xl p-5 shadow-xs flex flex-col justify-between';
      
      const estadoBadge = document.createElement('span');
      estadoBadge.className = `inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold ${estadoColor}`;
      estadoBadge.textContent = estadoLabel;
      
      let insumosHTML = '';
      if (item.insumos && item.insumos.length > 0) {
        insumosHTML = item.insumos.map(i => 
          `<span class="text-xs font-medium text-slate-700">${i.nombre} (${i.cantidad} ${i.unidad})</span>`
        ).join(', ');
      }
      
      let herramientasHTML = '';
      if (item.herramientas && item.herramientas.length > 0) {
        herramientasHTML = item.herramientas.map(h => 
          `<span class="text-xs font-medium text-slate-700">${h}</span>`
        ).join(', ');
      }
      
      cardData.innerHTML = `
        <div>
          <div class="flex justify-between items-start gap-4">
            <div>
              <div class="flex items-center gap-2 text-slate-950 font-bold">
                <span class="text-sm tracking-wide uppercase">Bloque #${String(bloqueNum).padStart(5, '0')}</span>
                ${estadoBadge.outerHTML}
              </div>
              <h3 class="mt-1 text-base font-bold text-slate-800">
                ${item.actividad || 'Actividad no especificada'}
              </h3>
              <p class="text-xs text-slate-400 mt-0.5 font-medium">
                ${fechaFormateada} • ${item.tipo_proceso || 'N/A'}
              </p>
            </div>
            <span class="font-mono text-[10px] bg-slate-50 text-slate-500 border border-slate-100 px-2 py-0.5 rounded">
              Hash: ${hashSimulado}
            </span>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-5">
          ${item.detalle_aplicacion ? `
          <div class="bg-slate-50/60 border border-slate-100 rounded-lg p-3 col-span-2">
            <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">Detalle de Aplicación</span>
            <p class="text-xs font-bold text-slate-800 mt-1">${item.detalle_aplicacion}</p>
          </div>
          ` : ''}
          
          ${item.persona ? `
          <div class="bg-slate-50/60 border border-slate-100 rounded-lg p-3">
            <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">Persona Desarrollo</span>
            <p class="text-xs font-bold text-slate-800 mt-1 flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center text-[10px] font-bold">${initials}</span>
              ${item.persona}
            </p>
          </div>
          ` : ''}
          
          ${item.nombre_jornalero ? `
          <div class="bg-slate-50/60 border border-slate-100 rounded-lg p-3">
            <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">Jornalero</span>
            <p class="text-xs font-bold text-slate-800 mt-1">${item.nombre_jornalero}</p>
          </div>
          ` : ''}
          
          ${item.costo ? `
          <div class="bg-slate-50/60 border border-slate-100 rounded-lg p-3">
            <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">Costo (USD)</span>
            <p class="text-xs font-bold text-slate-800 mt-1">$ ${item.costo.toFixed(2)}</p>
          </div>
          ` : ''}
          
          ${insumosHTML ? `
          <div class="bg-slate-50/60 border border-slate-100 rounded-lg p-3">
            <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">Insumos</span>
            <p class="text-xs font-bold text-slate-800 mt-1">${insumosHTML}</p>
          </div>
          ` : ''}
          
          ${herramientasHTML ? `
          <div class="bg-slate-50/60 border border-slate-100 rounded-lg p-3">
            <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">Herramientas</span>
            <p class="text-xs font-bold text-slate-800 mt-1">${herramientasHTML}</p>
          </div>
          ` : ''}
        </div>
      `;
      
      contentDiv.appendChild(cardData);
      
      // 🔥 Tarjeta de Evidencia Fotográfica - MEJORADA
      const cardFoto = document.createElement('div');
      cardFoto.className = 'relative rounded-xl overflow-hidden shadow-xs min-h-[180px] bg-slate-100 group/img';
      
      // Obtener URL de la foto
      const fotoUrl = item.evidencia?.foto_url || null;
      const fotoCompleta = getFotoUrl(fotoUrl);
      
      console.log(`📸 Bloque #${bloqueNum} - Foto URL:`, fotoUrl);
      console.log(`📸 Bloque #${bloqueNum} - Foto Completa:`, fotoCompleta);
      
      if (fotoCompleta) {
        // Intentar cargar la foto
        cardFoto.innerHTML = `
          <img 
            src="${fotoCompleta}" 
            alt="Evidencia Agronómica" 
            class="w-full h-full object-cover transition duration-500 group-hover/img:scale-105"
            onerror="this.style.display='none'; this.parentElement.querySelector('.placeholder-evidence').style.display='flex';"
            onload="this.style.display='block'; this.parentElement.querySelector('.placeholder-evidence').style.display='none';"
          />
          <div class="placeholder-evidence hidden absolute inset-0 flex flex-col items-center justify-center bg-slate-200">
            <i data-lucide="image-off" class="w-8 h-8 text-slate-400"></i>
            <span class="text-xs text-slate-500 mt-1">Error al cargar imagen</span>
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent flex flex-col justify-end p-4">
            <div class="flex items-center gap-1.5 text-[10px] text-white/90 font-medium">
              <i data-lucide="map-pin" class="w-3.5 h-3.5 text-emerald-400"></i>
              ${item.evidencia?.ubicacion?.latitud && item.evidencia?.ubicacion?.longitud 
                ? `${item.evidencia.ubicacion.latitud.toFixed(4)}, ${item.evidencia.ubicacion.longitud.toFixed(4)}`
                : 'Ubicación no disponible'}
            </div>
            <p class="text-[9px] text-white/60 mt-0.5 tracking-wide">Evidencia Georreferenciada</p>
          </div>
        `;
      } else {
        // No hay foto
        cardFoto.innerHTML = `
          <div class="absolute inset-0 flex flex-col items-center justify-center bg-slate-100">
            <i data-lucide="camera-off" class="w-12 h-12 text-slate-300"></i>
            <p class="text-sm text-slate-400 mt-2">Sin evidencia fotográfica</p>
          </div>
        `;
      }
      
      contentDiv.appendChild(cardFoto);
      
      itemDiv.appendChild(nodeSpan);
      itemDiv.appendChild(contentDiv);
      container.appendChild(itemDiv);
    });
    
    if (window.lucide) {
      window.lucide.createIcons();
    }
  }

  document.addEventListener('DOMContentLoaded', renderLedger);
  document.addEventListener('astro:after-swap', renderLedger);
  
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    renderLedger();
  }
</script>