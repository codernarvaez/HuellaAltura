{
  "name": "huella-de-altura",
  "private": true,
  "packageManager": "npm@10.9.7",
  "workspaces": [
    "HAFront",
    "HAMobile"
  ],
  "overrides": {
    "ws": "8.21.3",
    "postcss": "8.5.28",
    "nanoid": "3.3.19",
    "js-yaml": "4.3.2",
    "smol-toml": "1.9.0",
    "svgo": "4.1.0",
    "sharp": "0.35.4",
    "devalue": "5.9.1",
    "fast-uri": "3.1.8",
    "esbuild": "0.28.1",
    "brace-expansion": "2.1.7",
    "shell-quote": "1.10.0",
    "image-size": "2.0.4",
    "@xmldom/xmldom": "0.9.12",
    "browserslist": "4.29.1",
    "dompurify": "3.4.16",
    "yaml": "2.8.3",
    "uuid": "11.1.1",
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "scripts": {
    "build": "npm run build:hafront && npm run build:hamobile",
    "build:hafront": "npm -w hafront run build",
    "build:hamobile": "npm -w hamobile run build",
    "check": "npm run check:hafront",
    "check:hafront": "npm -w hafront run check",
    "lint": "npm run lint:hafront && npm run lint:hamobile",
    "lint:hafront": "npm -w hafront run lint",
    "lint:hamobile": "npm -w hamobile run lint",
    "lint:haback": "pants run HABack/auth-service:lint && pants run HABack/exped-service:lint",
    "test:haback": "pants run HABack/auth-service:ci && pants run HABack/exped-service:ci",
    "ci": "npm run ci:hafront && npm run ci:hamobile && npm run ci:haback",
    "ci:hafront": "pants run HAFront:ci",
    "ci:hamobile": "pants run HAMobile:ci",
    "ci:hafront:npm": "npm -w hafront run ci",
    "ci:hamobile:npm": "npm -w hamobile run ci",
    "ci:haback": "pants run HABack/auth-service:ci && pants run HABack/exped-service:ci",
    "ci:haback:auth": "pants run HABack/auth-service:ci",
    "ci:haback:exped": "pants run HABack/exped-service:ci",
    "ci:haback:direct": "./HABack/auth-service/pants_ci.sh && ./HABack/exped-service/pants_ci.sh",
    "dev": "npm run dev:hafront",
    "dev:hafront": "npm -w hafront run dev",
    "dev:hamobile": "npm -w hamobile run dev",
    "preview:hafront": "npm -w hafront run preview",
    "pants:list": "pants list ::"
  },
  "dependencies": {
    "js-yaml": "4.3.2"
  }
}
