# Auth-service — copy to `.env` and fill locally. Never commit real secrets.
#
# GitHub Actions (see .github/workflows/haback-ci.yml):
#   CI / Neon test branch:  NEON_TEST_DB_URL  (or NEON_TEST_DB_URL_AUTH)
#   Prod schema push:       NEON_PROD_DB_URL  (or NEON_PROD_DB_URL_AUTH)
# Runtime on Render/etc. may still use DATABASE_URL for the process env.

ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_ALGORITHM=HS256
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
ENVIRONMENT=development

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_TLS=True
FRONTEND_URL="http://127.0.0.1:4321"

SECRET_KEY="change-me-in-production"
INTERNAL_API_KEY="change-me-in-production"
