# Auth-service — copy to `.env` and fill locally. Never commit real secrets.
#
# GitHub Actions (see .github/workflows/haback-ci.yml):
#   CI / Neon test branch:  NEON_TEST_DB_URL  (or NEON_TEST_DB_URL_AUTH)
#   Prod schema push:       NEON_PROD_DB_URL  (or NEON_PROD_DB_URL_AUTH)
# Runtime uses DATABASE_URL. CI injects NEON_TEST_DATABASE_URL. Do not commit real URLs.

ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_ALGORITHM=HS256
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
ENVIRONMENT=development

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_TLS=True
FRONTEND_URL="http://127.0.0.1:4321"

SECRET_KEY="change-me-in-production"
INTERNAL_API_KEY="change-me-in-production"

# Proyecto Firebase cuyos ID tokens acepta POST /api/auth/firebase
FIREBASE_PROJECT_ID="agrobamba-cia-ltda"

# Seed (python seed.py): admin opcional + cuentas demo por rol
# SEED_ADMIN_EMAIL="admin@tudominio.com"
# SEED_ADMIN_PASSWORD="cambia-esto"
# SEED_DEMO_USERS=1
# SEED_DEMO_PASSWORD="cambia-esto"
# SEED_DEMO_DOMAIN="demo.huellaaltura.local"
# → emails: super_admin@..., tenant_admin@..., productor@..., bodeguero@..., etc.
