# sender-service — never commit real secrets.
# Local: copy to `.env`. Render: inject as env vars.

APP_NAME=sender-service
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
PORT=8040
API_PREFIX=/api/v1

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx
# Remitente verificado en Resend (dominio o onboarding@resend.dev en pruebas)
RESEND_FROM_EMAIL="Huella de Altura <noreply@tudominio.com>"
RESEND_REPLY_TO=

# URL base del frontend (enlaces en plantillas)
FRONTEND_URL=http://127.0.0.1:4321

# S2S — misma clave que auth-service / exped-service
INTERNAL_API_KEY=change-me-in-production
