# bcregister-service — never commit real secrets.
# Local: copy to `.env`. Render: inject as env vars.

APP_NAME=bcregister-service
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
PORT=8050
API_PREFIX=/api/v1

# S2S — misma INTERNAL_API_KEY que auth / exped / sender
INTERNAL_API_KEY=change-me-in-production

# Correos: solo vía sender-service (Resend vive ahí)
SENDER_SERVICE_URL=http://127.0.0.1:8040
SENDER_TIMEOUT_SECONDS=15

# Polygon PoS (Amoy testnet: chain_id=80002)
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_CHAIN_ID=80002
POLYGON_PRIVATE_KEY=0xYOUR_WALLET_PRIVATE_KEY_64_HEX
# Opcional: contrato Notary; si vacío → tx con data = marcador+hash
POLYGON_CONTRACT_ADDRESS=
POLYGON_CONFIRMATIONS=1
# true = no envía tx real (CI / desarrollo sin gas)
POLYGON_DRY_RUN=false
